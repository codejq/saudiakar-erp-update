<script>
(function () {
    const fields = <?= json_encode($depFieldList, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE) ?>;
    const depId = <?= $depFieldId ?>;
    const csrf = '<?= $depFieldH($_SESSION['dep_fields_csrf']) ?>';
    const canAdd = <?= $depFieldCanAdd ? 'true' : 'false' ?>;
    const pageUrl = '/aqary/admin/departments_sub.hnt?dep_id=' + depId;
    const byId = id => document.getElementById(id);
    const form = byId('dfForm');

    async function send(data) {
        const response = await fetch('/aqary/admin/departments_sub.hnt', { method: 'POST', body: data, credentials: 'same-origin' });
        try { return await response.json(); }
        catch (error) { return { success: false, message: 'تعذر قراءة رد الخادم' }; }
    }

    function finish(result) {
        showBootstrapNotification(result.message || 'حدث خطأ غير متوقع', result.success ? 'success' : 'error', result.success ? 1500 : 5000);
        if (result.success) setTimeout(() => { window.location.href = pageUrl; }, 800);
    }

    if (form) {
        const name = byId('dfName'), values = byId('dfValues'), preview = byId('dfPreview'), save = byId('dfSave');
        const type = () => Number((form.querySelector('[name=fld_type]:checked') || {}).value || 0);
        const isChoice = () => type() === 3 || type() === 4;
        const options = () => values.value.split(/[\n;,،]/).map(v => v.trim()).filter(Boolean);

        function element(tag, className, text) {
            const node = document.createElement(tag);
            if (className) node.className = className;
            if (text) node.textContent = text;
            return node;
        }

        function refresh() {
            const current = type();
            const texts = isChoice()
                ? ['القيم', 'اكتب كل قيمة في سطر، أو افصل بينها بفاصلة.']
                : current === 5 ? ['النص بجانب المربع', 'يظهر بعد اسم الحقل ويُحفظ عند التأشير.']
                : ['نص توضيحي', 'اختياري، يظهر عند المرور على الحقل.'];
            byId('dfValuesLabel').textContent = texts[0];
            byId('dfValuesHelp').textContent = texts[1];
            byId('dfValuesBox').hidden = current === 6 || current === 7;

            preview.replaceChildren();
            const title = element('div', 'form-label', name.value.trim() || 'اسم الحقل');
            if (byId('dfRequired').checked) title.append(element('span', 'text-danger', ' *'));
            if (current !== 5) preview.append(title);
            if (current === 2) {
                const area = element('textarea', 'form-control'); area.rows = 2; preview.append(area);
            } else if (current === 3) {
                const list = element('div', 'd-flex flex-wrap gap-1');
                options().forEach(o => list.append(element('span', 'badge text-bg-light border', o)));
                preview.append(list.children.length ? list : element('div', 'text-muted small', 'أدخل القيم لتظهر هنا'));
            } else if (current === 4 || current === 5) {
                const items = current === 5 ? [(name.value.trim() || 'اسم الحقل') + (values.value.trim() ? ': ' + values.value.trim() : '')] : options();
                items.forEach((text, i) => {
                    const row = element('div', 'form-check'), input = element('input', 'form-check-input'), label = element('label', 'form-check-label', text);
                    input.type = current === 4 ? 'radio' : 'checkbox';
                    input.name = 'dfPreviewInput'; input.id = 'dfPreviewInput' + i; label.htmlFor = input.id;
                    input.setAttribute('form', 'dfPreviewNoForm');
                    row.append(input, label); preview.append(row);
                });
                if (!items.length) preview.append(element('div', 'text-muted small', 'أدخل القيم لتظهر هنا'));
            } else if (current === 7) {
                preview.append(element('div', 'text-muted', 'يحدد المستخدم الموقع على الخريطة في نهاية النموذج.'));
            } else {
                const input = element('input', 'form-control');
                input.type = current === 6 ? 'file' : 'text';
                input.title = current === 6 ? '' : values.value;
                preview.append(input);
            }
        }

        function setMode(field) {
            byId('dfId').value = field ? field.fld_id : '';
            byId('dfFormTitle').textContent = field ? 'تعديل الحقل' : 'إضافة حقل جديد';
            byId('dfFormIcon').className = 'bi me-1 ' + (field ? 'bi-pencil-square' : 'bi-plus-circle');
            save.querySelector('span').textContent = field ? 'حفظ التعديل' : 'إضافة الحقل';
            save.disabled = !field && !canAdd;
            byId('dfCancel').hidden = !field;
            name.value = field ? field.fld_name : '';
            values.value = field ? field.fld_values : '';
            byId('dfActive').checked = field ? String(field.fld_isactive) === '1' : true;
            byId('dfRequired').checked = field ? String(field.fld_required) === '1' : false;
            form.querySelectorAll('[name=fld_type]').forEach(r => { r.checked = String(r.value) === String(field ? field.fld_type : 1); });
            name.classList.remove('is-invalid'); values.classList.remove('is-invalid');
            document.querySelectorAll('.dep-fields .df-row').forEach(r => r.classList.toggle('is-editing', !!field && r.dataset.id === String(field.fld_id)));
            refresh();
        }

        window.depFieldEdit = function (id) {
            const field = fields.find(f => String(f.fld_id) === String(id));
            if (!field) return;
            setMode(field);
            byId('dfFormPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            name.focus({ preventScroll: true });
        };

        form.addEventListener('input', event => { event.target.classList.remove('is-invalid'); refresh(); });
        form.addEventListener('change', refresh);
        byId('dfCancel').addEventListener('click', () => setMode(null));
        form.addEventListener('submit', async event => {
            event.preventDefault();
            name.classList.toggle('is-invalid', !name.value.trim());
            values.classList.toggle('is-invalid', isChoice() && !options().length);
            const invalid = form.querySelector('.is-invalid');
            if (invalid) { invalid.focus(); return; }
            if (!type()) { showBootstrapNotification('اختر نوع الحقل', 'warning', 3000); return; }
            save.disabled = true;
            let result;
            try { result = await send(new FormData(form)); }
            catch (error) { result = { success: false, message: 'تعذر الاتصال بالخادم' }; }
            if (!result.success) save.disabled = false;
            finish(result);
        });

        setMode(null);
        <?php if ($depFieldEditId && $depFieldCanEdit) { ?>window.depFieldEdit(<?= $depFieldEditId ?>);<?php } ?>
    }

    byId('dfList').addEventListener('click', event => {
        const button = event.target.closest('[data-df]');
        if (!button) return;
        const row = button.closest('.df-row');
        if (button.dataset.df === 'edit') { window.depFieldEdit(row.dataset.id); return; }
        const label = row.querySelector('.df-row-name').textContent;
        const safeLabel = label.replace(/[&<>"']/g, c => '&#' + c.charCodeAt(0) + ';');
        confirm('هل أنت متأكد من حذف الحقل "' + safeLabel + '"؟', 'حذف الحقل', async function () {
            const data = new FormData();
            data.append('ajax_submit', '1');
            data.append('field_action', 'delete');
            data.append('dep_id', depId);
            data.append('update_fld_id', row.dataset.id);
            data.append('csrf', csrf);
            button.disabled = true;
            let result;
            try { result = await send(data); }
            catch (error) { result = { success: false, message: 'تعذر الاتصال بالخادم' }; }
            button.disabled = false;
            finish(result);
        });
    });

    byId('dfSearch').addEventListener('input', event => {
        const term = event.target.value.trim().toLowerCase();
        let shown = 0;
        const rows = document.querySelectorAll('.dep-fields .df-row');
        rows.forEach(row => {
            const match = row.querySelector('.df-row-main').textContent.toLowerCase().includes(term);
            row.hidden = !match;
            row.style.display = match ? '' : 'none';
            if (match) shown++;
        });
        byId('dfNoMatch').hidden = shown > 0 || !rows.length;
    });
})();
</script>
<?php } ?>
</div>

<?php require '../foter.hnt'; ?>
