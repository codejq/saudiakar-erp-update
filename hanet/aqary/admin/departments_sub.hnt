.dep-fields .df-panel-title { padding: .85rem 1.1rem; border-bottom: 1px solid var(--df-line); font-weight: 700; color: var(--df-main); }
.dep-fields .df-types { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: .5rem; }
