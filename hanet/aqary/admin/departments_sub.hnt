.dep-fields .df-row.is-off .df-row-icon, .dep-fields .df-row.is-off .df-row-name { opacity: .5; }
.dep-fields .df-row-icon { width: 40px; height: 40px; border-radius: 8px; background: #ecfeff; color: var(--df-main); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex: none; }
.dep-fields .df-row-main { flex: 1; min-width: 0; }
.dep-fields .df-row-name { font-weight: 700; overflow-wrap: anywhere; }
.dep-fields .df-row-col { color: #64748b; font-size: .8rem; overflow-wrap: anywhere; }
.dep-fields .df-values { color: #475569; font-size: .83rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
@media (min-width: 992px) { .dep-fields .df-sticky { position: sticky; top: 80px; } }
</style>

