<?php
/**
 * Department fields: add, edit, and remove the custom fields of one generic department.
 * GET renders the page; POST with ajax_submit=1 answers JSON.
 */

$sc_title = 'حقول القسم';
$sc_id = '84';
$is_ajax_request = ($_SERVER['REQUEST_METHOD'] ?? '') === 'POST' && ($_POST['ajax_submit'] ?? '') === '1';

/** Field types as rendered by include/geniric_departments/dep_add_edit.hnt. */
function depFieldTypes()
{
    return array(
        1 => array('label' => 'مربع نص', 'icon' => 'bi-input-cursor-text', 'hint' => 'نص قصير في سطر واحد'),
        2 => array('label' => 'مساحة نص', 'icon' => 'bi-textarea-t', 'hint' => 'نص طويل متعدد الأسطر'),
        3 => array('label' => 'قائمة منسدلة', 'icon' => 'bi-menu-button-wide', 'hint' => 'اختيار قيمة واحدة من قائمة'),
        4 => array('label' => 'أزرار اختيار', 'icon' => 'bi-ui-radios', 'hint' => 'اختيار قيمة واحدة ظاهرة'),
        5 => array('label' => 'مربع تأشير', 'icon' => 'bi-check2-square', 'hint' => 'نعم أو لا'),
        6 => array('label' => 'ملف مرفق', 'icon' => 'bi-paperclip', 'hint' => 'رفع ملف أو صورة'),
        7 => array('label' => 'موقع على الخريطة', 'icon' => 'bi-geo-alt', 'hint' => 'تحديد الموقع على الخريطة'),
    );
}

/** Prepared statement on the active company connection; throws on failure. */
function depFieldQuery($link, $sql, array $params = array())
{
    $stmt = mysqli_prepare($link, $sql);
    if (!$stmt || !$stmt->execute($params)) {
        throw new RuntimeException($stmt ? $stmt->error : mysqli_error($link));
    }
    return $stmt;
}

function depFieldRows($link, $sql, array $params = array())
{
    $result = depFieldQuery($link, $sql, $params)->get_result();
    return $result ? $result->fetch_all(MYSQLI_ASSOC) : array();
}

function depFieldDepartment($link, $depId)
{
    $rows = depFieldRows($link, 'SELECT * FROM departments_name WHERE dep_id=? LIMIT 1', array($depId));
    return $rows ? $rows[0] : null;
}

/** Table and column names cannot be bound, so only plain identifiers are accepted. */
function depFieldIdentifier($name)
{
    return (bool)preg_match('/^[A-Za-z0-9_]{1,64}$/', (string)$name);
}

function depFieldColumnExists($link, $table, $column)
{
    return (bool)depFieldRows($link, 'SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=? AND COLUMN_NAME=? LIMIT 1', array($table, $column));
}

/** Latin column name from an Arabic label, unique by time as before. */
function depFieldColumnName($label)
{
    $map = array('ا'=>'a','أ'=>'a','إ'=>'i','آ'=>'a','ب'=>'b','ت'=>'t','ث'=>'th','ج'=>'j','ح'=>'h','خ'=>'kh',
        'د'=>'d','ذ'=>'th','ر'=>'r','ز'=>'z','س'=>'s','ش'=>'sh','ص'=>'s','ض'=>'d','ط'=>'t','ظ'=>'z','ع'=>'a',
        'غ'=>'gh','ف'=>'f','ق'=>'q','ك'=>'k','ل'=>'l','م'=>'m','ن'=>'n','ه'=>'h','و'=>'w','ؤ'=>'w','ي'=>'y',
        'ى'=>'a','ئ'=>'y','ة'=>'h');
    $name = preg_replace('/[^a-z]/', '', strtolower(strtr($label, $map)));
    return ($name === '' ? 'field' : substr($name, 0, 45)) . '_' . time();
}

function depFieldRespond($ok, $message, $status = 200)
{
    while (ob_get_level() > 0) ob_end_clean();
    http_response_code($status);
    header('Content-Type: application/json; charset=utf-8');
    echo json_encode(array('success' => $ok, 'message' => $message), JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
    exit;
}

if ($is_ajax_request) {
    ob_start();
    include_once '../reqloginajax.hnt';
    require_once __DIR__ . '/../lib/screen_permissions.hnt';

    if (empty($_SESSION['useridv'])) depFieldRespond(false, 'انتهت الجلسة، يرجى تسجيل الدخول من جديد', 401);
    $fieldToken = (string)($_SESSION['dep_fields_csrf'] ?? '');
    if ($fieldToken === '' || !hash_equals($fieldToken, (string)($_POST['csrf'] ?? ''))) {
        depFieldRespond(false, 'انتهت صلاحية الصفحة، يرجى تحديثها والمحاولة من جديد', 403);
    }

    $fieldAction = (string)($_POST['field_action'] ?? '');
    $fieldId = intval($_POST['update_fld_id'] ?? 0);
    $fieldOperation = $fieldAction === 'delete' ? 'deleetes' : ($fieldId > 0 ? 'edits' : 'adds');
    if (!aqaryScreenCan($link, '84', $fieldOperation)) {
        depFieldRespond(false, 'ليس لديك صلاحية لهذا الإجراء', 403);
    }

    try {
        $depId = intval($_POST['dep_id'] ?? 0);
        $department = depFieldDepartment($link, $depId);
        if (!$department) depFieldRespond(false, 'القسم غير موجود', 404);

        $currentField = null;
        if ($fieldId > 0) {
            $rows = depFieldRows($link, 'SELECT * FROM department_field WHERE fld_id=? AND dep_id=? LIMIT 1', array($fieldId, $depId));
            $currentField = $rows ? $rows[0] : null;
            if (!$currentField) depFieldRespond(false, 'الحقل غير موجود', 404);
        }

        if ($fieldAction === 'delete') {
            if (!$currentField) depFieldRespond(false, 'الحقل غير موجود', 404);
            // The data column is kept, as before, so saved values are not lost.
            depFieldQuery($link, 'DELETE FROM department_field WHERE fld_id=? AND dep_id=?', array($fieldId, $depId));
            depFieldRespond(true, 'تم حذف الحقل');
        }
        if ($fieldAction !== 'save') depFieldRespond(false, 'طلب غير معروف', 400);

        $types = depFieldTypes();
        $label = trim((string)($_POST['fld_name'] ?? ''));
        $type = intval($_POST['fld_type'] ?? 0);
        $values = trim((string)($_POST['fld_values'] ?? ''));
        $formUid = substr(preg_replace('/[^0-9a-f]/', '', (string)($_POST['formuid'] ?? '')), 0, 64);
        $active = ($_POST['fld_isactive'] ?? '') === '1' ? '1' : '2';
        $required = ($_POST['fld_required'] ?? '') === '1' ? '1' : '2';

        if ($label === '') depFieldRespond(false, 'اسم الحقل مطلوب', 422);
        if (mb_strlen($label, 'UTF-8') > 100) depFieldRespond(false, 'اسم الحقل طويل جداً (الحد الأقصى 100 حرف)', 422);
        if (!isset($types[$type])) depFieldRespond(false, 'اختر نوع الحقل', 422);
        // Only choice fields hold a list; other types keep their text unchanged.
        if ($type === 3 || $type === 4) {
            $options = array_filter(array_map('trim', preg_split('/\r\n|\r|\n|;|,|،/u', $values) ?: array()), 'strlen');
            if (!$options) depFieldRespond(false, 'أدخل قيمة واحدة على الأقل لهذا النوع', 422);
            $values = implode("\r\n", array_unique($options));
        } else {
            $values = preg_replace('/\r\n|\r|\n/', "\r\n", $values);
        }

        if ($currentField) {
            depFieldQuery($link, 'UPDATE department_field SET fld_name=?, fld_isactive=?, fld_required=?, fld_values=?, fld_type=?
                WHERE fld_id=? AND dep_id=?', array($label, $active, $required, $values, (string)$type, $fieldId, $depId));
            depFieldRespond(true, 'تم تعديل الحقل');
        }

        if ($formUid === '') depFieldRespond(false, 'طلب غير مكتمل', 400);
        if (depFieldRows($link, 'SELECT fld_id FROM department_field WHERE formuid=? LIMIT 1', array($formUid))) {
            depFieldRespond(false, 'تم حفظ هذا الحقل مسبقاً', 409);
        }
        $table = (string)$department['dep_table_name'];
        $column = depFieldColumnName($label);
        if (!depFieldIdentifier($table) || !depFieldIdentifier($column)) {
            depFieldRespond(false, 'اسم جدول القسم غير صالح', 422);
        }
        // Create the column first, so a failure never leaves a field without storage.
        if (!depFieldColumnExists($link, $table, $column)) {
            depFieldQuery($link, "ALTER TABLE `$table` ADD `$column` " . ($type === 2 ? 'TEXT NOT NULL' : 'VARCHAR(600) NOT NULL'));
        } else {
            depFieldRespond(false, 'يوجد حقل بالاسم نفسه، حاول مرة أخرى بعد لحظات', 409);
        }
        depFieldQuery($link, 'INSERT INTO department_field
            (fld_name, fld_en_name, fld_table_name, fld_isactive, fld_required, fld_values, dep_id, fld_type, formuid)
            VALUES (?,?,?,?,?,?,?,?,?)',
            array($label, $column, $table, $active, $required, $values, $depId, (string)$type, $formUid));
        depFieldRespond(true, 'تمت إضافة الحقل');
    } catch (Throwable $error) {
        error_log('departments_sub: ' . $error->getMessage());
        depFieldRespond(false, 'تعذر حفظ التغيير، يرجى المحاولة لاحقاً', 500);
    }
}

include_once '../nocash.hnt';
include_once '../header.hnt';
require_once __DIR__ . '/../lib/screen_permissions.hnt';

if (empty($_SESSION['dep_fields_csrf'])) $_SESSION['dep_fields_csrf'] = bin2hex(random_bytes(32));

$depFieldH = function ($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
};
$depFieldId = intval($_GET['dep_id'] ?? 0);
$depFieldList = array();
$depFieldDep = null;
try {
    $depFieldDep = depFieldDepartment($link, $depFieldId);
    if ($depFieldDep) {
        $depFieldList = depFieldRows($link, 'SELECT fld_id, fld_name, fld_en_name, fld_isactive, fld_required, fld_values, fld_type
            FROM department_field WHERE dep_id=? ORDER BY fld_id', array($depFieldId));
    }
} catch (Throwable $error) {
    error_log('departments_sub: ' . $error->getMessage());
}
$depFieldTypeList = depFieldTypes();
$depFieldCanAdd = aqaryScreenCan($link, '84', 'adds');
$depFieldCanEdit = aqaryScreenCan($link, '84', 'edits');
$depFieldCanDelete = aqaryScreenCan($link, '84', 'deleetes');
$depFieldShowForm = $depFieldCanAdd || $depFieldCanEdit;
$depFieldActive = count(array_filter($depFieldList, function ($row) { return $row['fld_isactive'] == 1; }));
$depFieldRequired = count(array_filter($depFieldList, function ($row) { return $row['fld_required'] == 1; }));
$depFieldEditId = intval($_GET['edit_field_id'] ?? 0);
?>

<style>
