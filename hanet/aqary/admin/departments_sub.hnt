.dep-fields .df-preview { background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: .85rem; min-height: 80px; }
.dep-fields .df-row { display: flex; align-items: center; gap: .9rem; padding: .8rem 1.1rem; border-bottom: 1px solid var(--df-line); }
