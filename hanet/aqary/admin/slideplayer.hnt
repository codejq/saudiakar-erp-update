<script language='javascript'>
function trim(stringToTrim) {
return stringToTrim.replace(/^\s+|\s+$/g,"");
}


function intval(x)
{
xp =parseInt(x,10);
if(isNaN(xp)){xp=0;}
return xp;
}

function floatval(x)
{
xp =parseFloat(x);
if(isNaN(xp)){xp=0;}
return xp;
}

function createXmlHttpObject()
	{
	var xmlHttp=null;
	try
	 {
	 // Firefox, Opera 8.0+, Safari
	 xmlHttp=new XMLHttpRequest();
	 }
	catch (e)
	 {
	 // Internet Explorer
	 try
	  {
	  xmlHttp=new ActiveXObject("Msxml2.XMLHTTP");
	  }
	 catch (e)
	  {
	  xmlHttp=new ActiveXObject("Microsoft.XMLHTTP");

	  }
	 }
	return xmlHttp;
	}

function ajaxmysqlrow(sqlstr,returntxtid,mylink)
{

if(typeof(mylink)=='undefined'){mylink='';}
if(typeof(returntxtid)=='undefined' || returntxtid==''){var returntxt="";returntxtid="";
}else{var returntxt=document.getElementById(returntxtid)}
	var xmlHttp=createXmlHttpObject();
	url="/aqary/ajaxmysqlrow.do.hnt?"
	xmlHttp.onreadystatechange=stateChanged;
	xmlHttp.open("POST",url, true);
	xmlHttp.setRequestHeader("Content-type", "application/x-www-form-urlencoded;charset=utf-8");
	xmlHttp.send("sqlstr="+encodeURIComponent(sqlstr)+"&mylink="+encodeURIComponent(mylink));


	//xmlDoc=xmlHttp.responseText;
	//xmlHttp.open("POST", "demo_dom_http.asp", false);
	//xmlHttp.send(xmlDoc);

	function stateChanged(){

		if(xmlHttp.readyState==4){
		  if(xmlHttp.status== 200){

			returntxt.value=xmlHttp.responseText;


		  }
		  else
		  {
			//alert('Œÿ√ ›Ï «·Ê÷Ê· ··»Ì«‰«  error:') ;

		  }

		}


	}


}

