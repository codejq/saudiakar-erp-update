function gox()
{
idcurrent=intval(document.getElementById('iddata').value);
	<?if($slideid<4){?>
	if(idcurrent==0)
	{
	sqladdtameento=" select max("+idname+") as dd from "+tablename+"  where enbleslideshow='1' and statusx!=3 ";
	}
	else
	{
	sqladdtameento=" select "+idname+" as dd from  "+tablename+"  where "+idname+" < '";
	sqladdtameento +=idcurrent + "' and enbleslideshow='1' and statusx!=3 order by "+idname+" desc limit 1";
	}
	<?}?>
	<?if($slideid==4){?>
	if(idcurrent==0)
	{
	sqladdtameento=" select max("+idname+") as dd from "+tablename+"  where rakam3akdid<1 ";
