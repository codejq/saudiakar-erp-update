<?
include_once"../connectdb.hnt";


$rs=mysql_list_tables ("aqary",$link);

while($re=mysql_fetch_array($rs))



{

//1010 here we insert table names------------------------- 
$isdublicated=mysql_fetch_array(mysql_query("
select id  from  controltable 
where 
t_fieldname='".$re[0]."' and 
t_tablename='".$re[0]."' and           
t_fieldtype='table'  

",$link));
if(!$isdublicated['id']){
 
mysql_query("
insert into controltable set 

t_fieldname='".$re[0]."',
t_tablename='".$re[0]."' ,              
t_fieldtype='table'  


",$link);
}
//1010 end -----------------------------------




//---------files of the table ------------ 
$result = mysql_query("DESCRIBE ".$re[0],$link);

 while($row=mysql_fetch_array($result))
{

 
$isdublicated=mysql_fetch_array(mysql_query("
select id  from  controltable 
where 
t_fieldname='".$row[0]."' and 
t_tablename='".$re[0]."' and           
t_fieldtype='".$row[1]."'  

",$link));
if($isdublicated['id']){continue;}
 
mysql_query("
insert into controltable set 

t_fieldname='".$row[0]."',
t_tablename='".$re[0]."' ,              
t_fieldtype='".$row[1]."'  


",$link);





}





//-------------end filds ------------------------


}


if(mysql_error())
{

mysql_query("
CREATE TABLE `controltable` (
  `id` int(11) NOT NULL auto_increment,
  `t_fieldname` varchar(50) NOT NULL default '',
  `t_tablename` varchar(50) NOT NULL default '',
  `t_caption` varchar(245) NOT NULL default '',
  `t_caption_en` varchar(140) NOT NULL default '',
  `t_fieldtype` varchar(100) NOT NULL default '',
  `t_t` varchar(100) NOT NULL default '',
  PRIMARY KEY  (`id`)
) TYPE=MyISAM AUTO_INCREMENT=0
  
",$link);

}


?>