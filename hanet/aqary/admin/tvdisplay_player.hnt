            $is_media_slide = $slide['slide_type'] !== 'property' && $media_kind !== '';
            $title = htmlspecialchars((string)$slide['display_title'], ENT_QUOTES, 'UTF-8');
            $text = nl2br(htmlspecialchars((string)$slide['slide_content'], ENT_QUOTES, 'UTF-8'));
            $duration = intval($slide['slide_duration'] ?: $display['transition_duration']) ?: 5;
        ?>
            <div class="slide tvbg-<?= $slide_background ?><?= $is_media_slide ? ' media-slide' : '' ?> <?= $index === 0 ? 'active' : '' ?>" data-duration="<?= $duration ?>">
                <?php if ($is_media_slide) { ?>
                    <?php if ($media_kind === 'youtube') {
                        $youtube_id = tv_youtube_id($slide['media_url']);
                        // Muted so browsers allow autoplay; looped through its own playlist.
                        $embed = 'https://www.youtube-nocookie.com/embed/' . $youtube_id . '?autoplay=1&mute=1&controls=0&loop=1&playlist=' . $youtube_id . '&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1';
                    ?>
                        <div class="slide-media"><iframe data-src="<?= htmlspecialchars($embed, ENT_QUOTES, 'UTF-8') ?>" allow="autoplay; encrypted-media; picture-in-picture" title="<?= $title ?>"></iframe></div>
                    <?php } elseif ($media_kind === 'video') { ?>
                        <div class="slide-media"><video src="<?= htmlspecialchars($media_src, ENT_QUOTES, 'UTF-8') ?>" muted loop playsinline preload="auto"></video></div>
                    <?php } else { ?>
                        <div class="slide-background" style="background-image: url('<?= htmlspecialchars($media_src, ENT_QUOTES, 'UTF-8') ?>');"></div>
                        <div class="slide-media"><img src="<?= htmlspecialchars($media_src, ENT_QUOTES, 'UTF-8') ?>" alt="<?= $title ?>"></div>
                    <?php } ?>
                    <?php if ($title !== '' || $text !== '') { ?>
                        <div class="slide-caption">
