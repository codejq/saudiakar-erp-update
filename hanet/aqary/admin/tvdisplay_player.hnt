                            <?php if ($text !== '') { ?><p><?= $text ?></p><?php } ?>
                        </div>
                    <?php } ?>
                <?php } else { ?>
                <?php if ($media_kind === 'image') { ?>
                    <div class="slide-background" style="background-image: url('<?= htmlspecialchars($media_src, ENT_QUOTES, 'UTF-8') ?>');"></div>
                <?php } ?>
