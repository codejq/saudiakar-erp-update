            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .company-logo { display: flex; align-items: center; gap: .9rem; }
        .company-logo-img { height: 64px; width: auto; max-width: 180px; object-fit: contain; background: #fff; border-radius: 10px; padding: 4px; }

        /* Full-screen hint, shown until the screen is full screen */
        .fs-hint { position: fixed; left: 50%; bottom: 80px; transform: translateX(-50%); z-index: 2000; display: flex; align-items: center; gap: .75rem;
            background: rgba(0, 0, 0, .75); border: 1px solid rgba(255, 255, 255, .25); color: #fff; border-radius: 10px; padding: .7rem 1.2rem; font-size: 1.15rem; cursor: pointer; transition: opacity .4s; }
        .fs-hint:hover { background: rgba(31, 78, 95, .95); }
        .fs-hint i { font-size: 1.5rem; }
        .fs-hint.hidden { opacity: 0; pointer-events: none; }
        body.idle, body.idle * { cursor: none !important; }

        .header-info {
            display: flex;
            gap: 3rem;
            align-items: center;
        }

        .clock {
            font-size: 2.5rem;
            font-weight: 600;
            font-family: 'Courier New', monospace;
        }

        .date {
            font-size: 1.3rem;
            opacity: 0.9;
        }

        /* Footer Bar */
        .footer-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 60px;
            background: linear-gradient(0deg, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0) 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .slide-indicator {
            display: flex;
            gap: 0.5rem;
        }

        .indicator-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transition: all 0.3s;
        }

        .indicator-dot.active {
            background: #10b981;
            transform: scale(1.3);
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        /* Media for property slides */
        .property-image {
            max-width: 60%;
            max-height: 50vh;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            margin-bottom: 2rem;
            animation: fadeInUp 0.8s ease-out;
        }

        /* Full-screen media: image, own video or YouTube */
        .slide.media-slide { padding: 0; }
        .slide-media { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; }
        .slide-media img, .slide-media video { width: 100%; height: 100%; object-fit: contain; }
        .slide-media iframe { width: 100%; height: 100%; border: 0; pointer-events: none; }
        .slide-caption { position: absolute; left: 0; right: 0; bottom: 60px; z-index: 2; padding: 1.25rem 3rem; text-align: center; background: rgba(0, 0, 0, .55); }
        .slide-caption h2 { font-size: 2.6rem; font-weight: 700; margin: 0; }
        .slide-caption p { font-size: 1.5rem; margin: .4rem 0 0; opacity: .9; }

        .gradient-overlay {
            position: absolute;
