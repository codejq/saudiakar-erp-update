    <link rel="stylesheet" href="<?= $urlh ?>/css/bootstrap-5.3.8-dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="<?= $urlh ?>/css/bootstrap-icons-1.13.1/bootstrap-icons.min.css">
    <!-- Bootstrap 5 Compatibility -->
    <script src="<?= $urlh ?>/css/bootstrap-5.3.8-dist/js/bootstrap.bundle.min.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #000;
            color: white;
            overflow: hidden;
            height: 100vh;
        }

        .slide-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            background: #000;
            overflow: hidden;
        }

        /* Ready-made backgrounds */
<?= tv_background_css('        .slide.tvbg-') ?>

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 1s ease-in-out;
            display: flex;
            flex-direction: column;
            padding: 3rem;
        }

        .slide.active {
            opacity: 1;
            z-index: 1;
        }

        /* Transition effects: the leaving slide stays on top while it animates out. */
        .slide.leaving { z-index: 2; }
        .slide:not(.active):not(.leaving) { transition: none !important; }
        .fx-none .slide { transition: none; }
        .fx-slide .slide { opacity: 1; transform: translateX(-100%); transition: transform 1s ease-in-out; }
        .fx-slide .slide.active { transform: translateX(0); }
        .fx-slide .slide.leaving { transform: translateX(100%); z-index: 0; }
        .fx-zoom .slide { transform: scale(1.12); transition: opacity 1s ease-in-out, transform 1s ease-in-out; }
        .fx-zoom .slide.active { transform: scale(1); }
        .fx-zoom .slide.leaving { transform: scale(.92); opacity: 0; }
        .fx-rise .slide { transform: translateY(8%); transition: opacity .9s ease-out, transform .9s ease-out; }
        .fx-rise .slide.active { transform: translateY(0); }
        .fx-rise .slide.leaving { transform: translateY(-8%); opacity: 0; }
        .fx-flip { perspective: 1800px; }
        .fx-flip .slide { backface-visibility: hidden; transform: rotateY(-90deg); transition: transform .6s ease-in, opacity .6s; }
        .fx-flip .slide.active { transform: rotateY(0); transition: transform .6s ease-out .6s, opacity 0s .6s; }
        .fx-flip .slide.leaving { transform: rotateY(90deg); opacity: 1; }

        .slide-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            filter: blur(8px) brightness(0.4);
            z-index: 0;
        }

        .slide-content {
            position: relative;
            z-index: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .slide-title {
            font-size: 4rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
