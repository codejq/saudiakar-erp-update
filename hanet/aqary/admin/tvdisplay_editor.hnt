<?php
/**
 * TV Display Editor
 * Create and edit TV displays with slides
 */

$sc_title = "محرر شاشات العرض";
$sc_id = "146";

extract($_REQUEST);

require_once __DIR__ . '/tvdisplay_presets.hnt';

// Check if AJAX request
$is_ajax = isset($_POST['ajax_submit']) && $_POST['ajax_submit'] == '1';

if ($is_ajax) {
    include_once "../nocash.hnt";
    include_once "../reqloginajax.hnt";
    header('Content-Type: application/json; charset=utf-8');

    $action = isset($_POST['action']) ? $_POST['action'] : '';

    // Save display
    if ($action == 'save_display') {
        $display_id = isset($_POST['display_id']) ? intval($_POST['display_id']) : 0;
        $display_name = addslashes(trim($_POST['display_name']));
        $display_description = addslashes(trim($_POST['display_description']));
        $transition_duration = max(1, min(60, intval($_POST['transition_duration'])));
        $is_active = isset($_POST['is_active']) ? 1 : 0;
        $show_clock = isset($_POST['show_clock']) ? 1 : 0;
        $show_weather = isset($_POST['show_weather']) ? 1 : 0;

        if ($display_name === '') {
            echo json_encode(['success' => false, 'error' => 'اسم الشاشة مطلوب'], JSON_UNESCAPED_UNICODE);
            exit;
        }

        // The look columns arrive with the migration; older copies simply skip them.
        $look = '';
        if (tv_has_column($link, 'tv_displays', 'transition_effect')) {
            $look .= ", transition_effect = '" . tv_pick_transition($_POST['transition_effect'] ?? '') . "'";
        }
        if (tv_has_column($link, 'tv_displays', 'background_theme')) {
            $look .= ", background_theme = '" . tv_pick_background($_POST['background_theme'] ?? '') . "'";
        }
        if (tv_has_column($link, 'tv_displays', 'show_logo')) {
            $look .= ", show_logo = '" . (isset($_POST['show_logo']) ? 1 : 0) . "'";
        }

        if ($display_id > 0) {
            // Update
            $sql = "UPDATE tv_displays SET
                    display_name = '$display_name',
                    display_description = '$display_description',
                    transition_duration = '$transition_duration',
                    is_active = '$is_active',
                    show_clock = '$show_clock',
                    show_weather = '$show_weather'$look
                    WHERE display_id = '$display_id'";
        } else {
            // Insert
            $sql = "INSERT INTO tv_displays SET
                    display_name = '$display_name',
                    display_description = '$display_description',
                    transition_duration = '$transition_duration',
                    is_active = '$is_active',
                    show_clock = '$show_clock',
                    show_weather = '$show_weather',
                    display_order = 0$look";
        }

        if (mysql_query($sql, $link)) {
            $new_id = $display_id > 0 ? $display_id : mysql_insert_id($link);
            echo json_encode([
                'success' => true,
                'message' => 'تم حفظ شاشة العرض بنجاح',
                'display_id' => $new_id
            ], JSON_UNESCAPED_UNICODE);
        } else {
            echo json_encode([
                'success' => false,
                'error' => 'حدث خطأ أثناء الحفظ'
            ], JSON_UNESCAPED_UNICODE);
        }
        exit;
    }

    // Save slide
    if ($action == 'save_slide') {
        $slide_id = isset($_POST['slide_id']) ? intval($_POST['slide_id']) : 0;
        $display_id = intval($_POST['display_id']);
        $slide_title = addslashes(trim($_POST['slide_title']));
        $slide_content = addslashes(trim($_POST['slide_content']));
        $picked_type = in_array($_POST['slide_type'] ?? '', ['custom', 'image', 'video', 'youtube', 'property'], true) ? $_POST['slide_type'] : 'custom';
        // YouTube is kept as a video slide whose media is the link, so the table's type list stays as it is.
        $slide_type = $picked_type === 'youtube' ? 'video' : $picked_type;
        $property_id = isset($_POST['property_id']) ? intval($_POST['property_id']) : 0;
        $slide_duration = max(1, min(600, intval($_POST['slide_duration'])));

        $old_media = '';
        if ($slide_id > 0) {
            $old_row = mysql_fetch_array(mysql_query("SELECT media_url FROM tv_slides WHERE slide_id = '$slide_id'", $link));
            $old_media = (string)($old_row['media_url'] ?? '');
        }
        $fail = function ($message) {
            echo json_encode(['success' => false, 'error' => $message], JSON_UNESCAPED_UNICODE);
            exit;
        };

        // Work out the slide's media: a YouTube link, a new uploaded file, the old file, or nothing.
        $new_media = $old_media;
        $uploaded = null;
        if ($picked_type === 'youtube') {
            $youtube_id = tv_youtube_id($_POST['youtube_url'] ?? '');
            if ($youtube_id === '') $fail('رابط يوتيوب غير صحيح');
            $new_media = 'https://www.youtube.com/watch?v=' . $youtube_id;
        } elseif (in_array($picked_type, ['image', 'video', 'property'], true)) {
            $kind = $picked_type === 'video' ? 'video' : 'image';
            $file = $_FILES['media_file'] ?? null;
            if ($file && ($file['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_NO_FILE) {
                if ($file['error'] === UPLOAD_ERR_INI_SIZE || $file['error'] === UPLOAD_ERR_FORM_SIZE) $fail('حجم الملف أكبر من المسموح في الخادم');
                if ($file['error'] !== UPLOAD_ERR_OK || !is_uploaded_file($file['tmp_name'])) $fail('تعذر رفع الملف');
                $types = tv_upload_types($kind);
                $ext = strtolower(pathinfo((string)$file['name'], PATHINFO_EXTENSION));
                $mime = function_exists('finfo_open') ? (string)finfo_file(finfo_open(FILEINFO_MIME_TYPE), $file['tmp_name']) : '';
                if (!isset($types[$ext]) || ($mime !== '' && strpos($mime, $types[$ext]) !== 0)) {
                    $fail($kind === 'video' ? 'نوع الفيديو غير مدعوم (MP4 أو WebM)' : 'نوع الصورة غير مدعوم (JPG أو PNG أو GIF أو WebP)');
                }
                $folder = upload_path('media.tvdisplay');
                if (!is_dir($folder)) @mkdir($folder, 0755, true);
                $name = 'tv_' . $display_id . '_' . date('Ymd_His') . '_' . bin2hex(random_bytes(4)) . '.' . $ext;
                if (!move_uploaded_file($file['tmp_name'], upload_path('media.tvdisplay', $name))) $fail('تعذر حفظ الملف');
                $uploaded = $name;
                $new_media = $name;
            } elseif (tv_media_is_link($old_media) || ($old_media !== '' && tv_media_kind(['media_url' => $old_media]) !== $kind)) {
                // Switching from YouTube or from the other file kind: the old media no longer fits.
                $new_media = '';
            }
            if (!empty($_POST['remove_media']) && !$uploaded) $new_media = '';
            if ($new_media === '' && $picked_type !== 'property') {
                $fail($kind === 'video' ? 'اختر ملف الفيديو' : 'اختر الصورة');
            }
        } else {
            $new_media = '';
        }
        if ($picked_type === 'custom' && $slide_title === '') $fail('العنوان مطلوب');
        $media_sql = addslashes($new_media);

        $look = ", media_url = '$media_sql'";
        if (tv_has_column($link, 'tv_slides', 'background_theme')) {
            $look .= ", background_theme = '" . tv_pick_background($_POST['background_theme'] ?? '', true) . "'";
        }

        if ($slide_id > 0) {
            $sql = "UPDATE tv_slides SET
                    slide_title = '$slide_title',
                    slide_content = '$slide_content',
                    slide_type = '$slide_type',
                    property_id = '$property_id',
                    slide_duration = '$slide_duration'$look
                    WHERE slide_id = '$slide_id'";
        } else {
            $order_result = mysql_query("SELECT MAX(slide_order) as max_order FROM tv_slides WHERE display_id = '$display_id'", $link);
            $order_row = mysql_fetch_array($order_result);
            $next_order = ($order_row['max_order'] ?? 0) + 1;

            $sql = "INSERT INTO tv_slides SET
                    display_id = '$display_id',
                    slide_title = '$slide_title',
                    slide_content = '$slide_content',
                    slide_type = '$slide_type',
                    property_id = '$property_id',
                    slide_duration = '$slide_duration',
                    slide_order = '$next_order'$look";
        }

        if (mysql_query($sql, $link)) {
            $new_slide_id = $slide_id > 0 ? $slide_id : mysql_insert_id($link);
            // The replaced file is removed only once the new media is saved.
            if ($old_media !== '' && $old_media !== $new_media && !tv_media_is_link($old_media)) {
                $old_path = upload_path('media.tvdisplay', basename($old_media));
                if (is_file($old_path)) @unlink($old_path);
            }
            echo json_encode([
                'success' => true,
                'message' => 'تم حفظ الشريحة بنجاح',
                'slide_id' => $new_slide_id
            ], JSON_UNESCAPED_UNICODE);
        } else {
            if ($uploaded) @unlink(upload_path('media.tvdisplay', $uploaded));
            echo json_encode([
                'success' => false,
                'error' => 'حدث خطأ أثناء حفظ الشريحة'
            ], JSON_UNESCAPED_UNICODE);
        }
        exit;
    }

    // Get slide data for editing
    if ($action == 'get_slide') {
        $slide_id = intval($_POST['slide_id']);

        $slide_query = mysql_query("SELECT * FROM tv_slides WHERE slide_id = '$slide_id'", $link);
        if ($slide = mysql_fetch_array($slide_query)) {
            echo json_encode([
                'success' => true,
                'slide' => [
                    'slide_id' => $slide['slide_id'],
                    'slide_title' => $slide['slide_title'],
                    'slide_content' => $slide['slide_content'],
                    'slide_type' => tv_media_kind($slide) === 'youtube' ? 'youtube' : $slide['slide_type'],
                    'youtube_url' => tv_media_kind($slide) === 'youtube' ? (string)$slide['media_url'] : '',
                    'media_kind' => tv_media_kind($slide),
                    'media_src' => tv_media_src($slide['media_url']),
                    'property_id' => $slide['property_id'],
                    'slide_duration' => $slide['slide_duration'],
                    'background_theme' => (string)($slide['background_theme'] ?? '')
                ]
            ], JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
        } else {
            echo json_encode([
                'success' => false,
                'error' => 'الشريحة غير موجودة'
            ], JSON_UNESCAPED_UNICODE);
        }
        exit;
    }

    // Move a slide one place up or down. Orders are renumbered 1..n so gaps and ties never block a move.
    if ($action == 'move_slide') {
        $slide_id = intval($_POST['slide_id']);
        $direction = ($_POST['direction'] ?? '') === 'up' ? -1 : 1;

        $owner = mysql_fetch_array(mysql_query("SELECT display_id FROM tv_slides WHERE slide_id = '$slide_id'", $link));
        if (!$owner) {
            echo json_encode(['success' => false, 'error' => 'الشريحة غير موجودة'], JSON_UNESCAPED_UNICODE);
            exit;
        }
        $display_id = intval($owner['display_id']);

        $ids = [];
        $order_query = mysql_query("SELECT slide_id FROM tv_slides WHERE display_id = '$display_id' ORDER BY slide_order, slide_id", $link);
        while ($row = mysql_fetch_array($order_query)) {
            $ids[] = intval($row['slide_id']);
        }
        $position = array_search($slide_id, $ids, true);
        $target = $position + $direction;
        if ($position === false || $target < 0 || $target >= count($ids)) {
            echo json_encode(['success' => false, 'error' => 'لا يمكن تحريك الشريحة أكثر'], JSON_UNESCAPED_UNICODE);
            exit;
        }
        [$ids[$position], $ids[$target]] = [$ids[$target], $ids[$position]];

        $ok = mysql_query("START TRANSACTION", $link);
        foreach ($ids as $index => $id) {
            $ok = $ok && mysql_query("UPDATE tv_slides SET slide_order = '" . ($index + 1) . "' WHERE slide_id = '$id'", $link);
        }
        mysql_query($ok ? "COMMIT" : "ROLLBACK", $link);

        echo json_encode($ok
            ? ['success' => true, 'order' => $ids]
            : ['success' => false, 'error' => 'حدث خطأ أثناء ترتيب الشرائح'], JSON_UNESCAPED_UNICODE);
        exit;
    }

    // Delete slide
    if ($action == 'delete_slide') {
        $slide_id = intval($_POST['slide_id']);

        // Get media file to delete
        $media_query = mysql_query("SELECT media_url FROM tv_slides WHERE slide_id = '$slide_id'", $link);
        if ($media_row = mysql_fetch_array($media_query)) {
            if ($media_row['media_url'] && !tv_media_is_link($media_row['media_url'])) {
                $media_path = upload_path('media.tvdisplay', basename($media_row['media_url']));
                if (file_exists($media_path)) {
                    @unlink($media_path);
                }
            }
        }

        if (mysql_query("DELETE FROM tv_slides WHERE slide_id = '$slide_id'", $link)) {
            echo json_encode([
                'success' => true,
                'message' => 'تم حذف الشريحة بنجاح'
            ], JSON_UNESCAPED_UNICODE);
        } else {
            echo json_encode([
                'success' => false,
                'error' => 'حدث خطأ أثناء الحذف'
            ], JSON_UNESCAPED_UNICODE);
        }
        exit;
    }

    echo json_encode(['success' => false, 'error' => 'إجراء غير صالح'], JSON_UNESCAPED_UNICODE);
    exit;
}

include_once "../nocash.hnt";
include_once "../header.hnt";

// Include Select2 CSS and JS (jQuery should already be loaded from header)
echo '<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />';
echo '<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />';
echo '<script>';
echo 'if (typeof jQuery === "undefined") { document.write(\'<script src="https://code.jquery.com/jquery-3.7.1.min.js"><\\/script>\'); }';
echo '</script>';
echo '<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>';

// Handle delete display
if (isset($_GET['action']) && $_GET['action'] == 'delete' && isset($_GET['id'])) {
    $delete_id = intval($_GET['id']);

    // Delete all slides and their media
    $slides_query = mysql_query("SELECT media_url FROM tv_slides WHERE display_id = '$delete_id'", $link);
    while ($slide = mysql_fetch_array($slides_query)) {
        if ($slide['media_url'] && !tv_media_is_link($slide['media_url'])) {
            $slide_media_path = upload_path('media.tvdisplay', basename($slide['media_url']));
            if (file_exists($slide_media_path)) {
                @unlink($slide_media_path);
            }
        }
    }
    mysql_query("DELETE FROM tv_slides WHERE display_id = '$delete_id'", $link);
    mysql_query("DELETE FROM tv_displays WHERE display_id = '$delete_id'", $link);

    echo "<script>window.location.href='tvdisplay.hnt';</script>";
    exit;
}

// Get display data if editing
$display_data = null;
$slides = [];
if (isset($_GET['id'])) {
    $display_id = intval($_GET['id']);
    $display_query = mysql_query("SELECT * FROM tv_displays WHERE display_id = '$display_id'", $link);
    $display_data = mysql_fetch_array($display_query);

    // Get slides
    $slides_query = mysql_query("SELECT * FROM tv_slides WHERE display_id = '$display_id' ORDER BY slide_order, slide_id", $link);
    while ($row = mysql_fetch_array($slides_query)) {
        $slides[] = $row;
    }
}

$h = function ($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
$transitions = tv_transition_presets();
$backgrounds = tv_background_presets();
$current_transition = tv_pick_transition($display_data['transition_effect'] ?? 'fade');
$current_background = tv_pick_background($display_data['background_theme'] ?? 'classic');
$look_ready = tv_has_column($link, 'tv_displays', 'transition_effect') && tv_has_column($link, 'tv_displays', 'background_theme');
$slide_look_ready = tv_has_column($link, 'tv_slides', 'background_theme');

$type_icons = ['property' => 'building', 'video' => 'camera-video', 'youtube' => 'youtube', 'image' => 'image', 'custom' => 'text-paragraph'];
$type_labels = ['property' => 'عقار', 'video' => 'فيديو', 'youtube' => 'يوتيوب', 'image' => 'صورة', 'custom' => 'نص مخصص'];
?>

<style>
<?= tv_background_css() ?>
.tv-head { background: #1f4e5f; }
.tv-section-title { font-size: .8rem; font-weight: 700; color: #5c6b7a; margin: 0 0 .5rem; }
.tv-section + .tv-section { border-top: 1px solid #edf0f2; padding-top: 1rem; margin-top: 1rem; }

/* Preset pickers: hidden radios with clickable tiles. */
.tv-picker { display: grid; gap: .5rem; }
.tv-picker.fx { grid-template-columns: repeat(3, 1fr); }
.tv-picker.bg { grid-template-columns: repeat(4, 1fr); }
.tv-picker input { position: absolute; opacity: 0; pointer-events: none; }
.tv-tile { display: block; cursor: pointer; border: 2px solid #dfe3e8; border-radius: 8px; text-align: center; font-size: .78rem; color: #3b4652; margin: 0; background: #fff; }
.tv-tile:hover { border-color: #9fb3bf; }
.tv-picker input:checked + .tv-tile { border-color: #1f4e5f; box-shadow: 0 0 0 2px rgba(31, 78, 95, .18); color: #1f4e5f; font-weight: 700; }
.tv-picker input:focus-visible + .tv-tile { outline: 2px solid #1f4e5f; outline-offset: 2px; }
.fx .tv-tile { padding: .55rem .25rem; }
.fx-demo { display: block; height: 34px; margin: 0 auto .35rem; width: 56px; border-radius: 4px; background: #e7eef3; position: relative; overflow: hidden; perspective: 200px; }
.fx-demo span { position: absolute; inset: 5px; border-radius: 3px; background: #1f4e5f; }
.fx .tv-tile:hover .fx-demo span, .fx input:checked + .tv-tile .fx-demo span { animation: 1.6s ease-in-out infinite; }
.tv-tile[data-fx="fade"] .fx-demo span { animation-name: demoFade !important; }
.tv-tile[data-fx="slide"] .fx-demo span { animation-name: demoSlide !important; }
.tv-tile[data-fx="zoom"] .fx-demo span { animation-name: demoZoom !important; }
.tv-tile[data-fx="rise"] .fx-demo span { animation-name: demoRise !important; }
.tv-tile[data-fx="flip"] .fx-demo span { animation-name: demoFlip !important; }
.tv-tile[data-fx="none"] .fx-demo span { animation: none !important; }
@keyframes demoFade { 0%, 100% { opacity: 1; } 50% { opacity: .1; } }
@keyframes demoSlide { 0% { transform: translateX(110%); } 35%, 65% { transform: translateX(0); } 100% { transform: translateX(-110%); } }
@keyframes demoZoom { 0%, 100% { transform: scale(.4); opacity: .2; } 50% { transform: scale(1); opacity: 1; } }
@keyframes demoRise { 0% { transform: translateY(110%); } 40%, 70% { transform: translateY(0); } 100% { transform: translateY(-110%); } }
@keyframes demoFlip { 0%, 100% { transform: rotateY(90deg); } 40%, 60% { transform: rotateY(0); } }
.bg .tv-tile { padding: .3rem .3rem .35rem; }
.bg-swatch { display: block; height: 38px; border-radius: 5px; margin-bottom: .25rem; }

/* Slide list */
.slide-item { border: 1px solid #dfe3e8; border-radius: 8px; padding: .75rem; margin-bottom: .6rem; background: #fff; display: flex; align-items: center; gap: .85rem; }
.slide-item:hover { border-color: #b9c3cb; }
.slide-item.moved { animation: movedFlash .9s ease-out; }
@keyframes movedFlash { from { background: #e7eef3; } to { background: #fff; } }
.slide-order { width: 30px; height: 30px; border-radius: 50%; background: #e7eef3; color: #1f4e5f; font-weight: 700; display: flex; align-items: center; justify-content: center; flex: none; }
.slide-move { display: flex; flex-direction: column; gap: 2px; flex: none; }
.slide-move .btn { padding: 0 .4rem; line-height: 1.3; }
.slide-preview { width: 96px; height: 56px; border-radius: 5px; display: flex; align-items: center; justify-content: center; color: rgba(255, 255, 255, .9); font-size: 22px; flex: none; position: relative; }
.slide-preview.has-thumb i { display: none; }
#displayForm .form-check-input:checked { background-color: #1f4e5f; border-color: #1f4e5f; }
.slide-preview .bg-own { position: absolute; bottom: 3px; left: 3px; font-size: 10px; background: rgba(0, 0, 0, .45); border-radius: 3px; padding: 0 4px; }
.slide-text { min-width: 0; flex: 1; }
.slide-text h6 { margin: 0 0 .2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.slide-text p { margin: 0 0 .3rem; color: #6b7785; font-size: .82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.slide-type { font-size: .72rem; border: 1px solid #c9d3da; color: #3b4652; border-radius: 4px; padding: 1px 6px; }
.slide-controls { display: flex; gap: .35rem; flex: none; }
#slideModal .modal-header { background: #1f4e5f; color: #fff; }
.media-preview:empty { display: none; }
.media-preview img, .media-preview video { max-width: 100%; max-height: 220px; border-radius: 6px; border: 1px solid #dfe3e8; background: #000; display: block; }
#slideModal .btn-close { filter: invert(1); }
.btn-tv { background: #1f4e5f; border-color: #1f4e5f; color: #fff; }
.btn-tv:hover, .btn-tv:focus { background: #163a47; border-color: #163a47; color: #fff; }
@media (max-width: 575px) {
    .tv-picker.bg { grid-template-columns: repeat(3, 1fr); }
    .slide-preview { display: none; }
}
</style>

