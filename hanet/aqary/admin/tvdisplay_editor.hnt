                        رجوع
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Display Settings -->
        <div class="col-lg-5 col-xl-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-gear me-2"></i>إعدادات الشاشة</h5>
                </div>
                <div class="card-body">
                    <form id="displayForm" dir="rtl">
                        <input type="hidden" name="display_id" value="<?= intval($display_data['display_id'] ?? 0) ?: '' ?>">

                        <div class="tv-section">
                            <div class="mb-3">
                                <label class="form-label">اسم الشاشة <span class="text-danger">*</span></label>
                                <input type="text" name="display_name" class="form-control"
                                       value="<?= $h($display_data['display_name'] ?? '') ?>" required>
                            </div>

