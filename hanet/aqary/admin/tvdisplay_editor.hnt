<script>
let slideModal;

// Opens the TV player in its own window covering the screen; the player then goes full screen on the first click.
function openTvPlayer(url) {
    const features = 'popup=yes,left=0,top=0,width=' + screen.availWidth + ',height=' + screen.availHeight;
    const win = window.open(url, 'tvplayer', features);
    if (!win) return true;   // popup blocked: follow the link in a new tab instead
    win.focus();
    return false;
}

function postEditor(fields) {
    const formData = fields instanceof FormData ? fields : new FormData();
    if (!(fields instanceof FormData)) {
        Object.keys(fields).forEach(key => formData.append(key, fields[key]));
    }
    formData.append('ajax_submit', '1');
    return fetch('tvdisplay_editor.hnt', { method: 'POST', body: formData }).then(response => response.json());
}

// Number the slides and disable the arrows at both ends.
function refreshSlideOrder() {
    const items = document.querySelectorAll('#slidesList .slide-item');
    items.forEach((item, index) => {
        item.querySelector('.slide-order').textContent = index + 1;
        item.querySelector('[data-move="up"]').disabled = index === 0;
        item.querySelector('[data-move="down"]').disabled = index === items.length - 1;
    });
}

document.addEventListener('DOMContentLoaded', function() {
    slideModal = new bootstrap.Modal(document.getElementById('slideModal'));
    refreshSlideOrder();

    // Fix for Select2 in Bootstrap Modal - Allow focus on search input
    $(document).on('select2:open', () => {
        const field = document.querySelector('.select2-container--open .select2-search__field');
        if (field) field.focus();
    });

    // The header turns selects into Select2, which only fires jQuery change events.
    jQuery('#slide_type').on('change', updateSlideForm);
    document.getElementById('media_file').addEventListener('change', function() { showMediaPreview(this.files[0] || null); });
    document.getElementById('youtube_url').addEventListener('input', showYoutubePreview);

    // Initialize Select2 for property search
    $('#property_id').select2({
        theme: 'bootstrap-5',
        dir: 'rtl',
        dropdownParent: $('#slideModal'),  // CRITICAL: Attach to modal to fix focus issue
        language: {
            inputTooShort: function() {
                return 'اكتب للبحث...';
            },
            searching: function() {
                return 'جاري البحث...';
            },
            noResults: function() {
                return 'لا توجد نتائج';
            },
            loadingMore: function() {
                return 'جاري تحميل المزيد...';
            }
        },
        placeholder: '-- ابحث عن عقار أو أرض أو عمارة أو فيلا --',
        allowClear: true,
        ajax: {
            url: 'tvdisplay_ajax_properties.hnt',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term,
                    page: params.page || 1
                };
            },
            processResults: function (data) {
                return {
                    results: data.results,
                    pagination: data.pagination
                };
            },
            cache: true
        },
        minimumInputLength: 1
    });

    // Move up / down without reloading the page.
    document.getElementById('slidesList').addEventListener('click', function(e) {
        const button = e.target.closest('[data-move]');
        if (!button) return;
        const item = button.closest('.slide-item');
        const direction = button.dataset.move;
        const buttons = document.querySelectorAll('#slidesList [data-move]');
        buttons.forEach(b => b.disabled = true);

        postEditor({ action: 'move_slide', slide_id: item.dataset.slideId, direction: direction })
            .then(data => {
                if (!data.success) {
                    alert(data.error);
                    return;
                }
                const list = document.getElementById('slidesList');
                data.order.forEach(id => {
                    const el = list.querySelector('.slide-item[data-slide-id="' + id + '"]');
                    if (el) list.appendChild(el);
                });
                item.classList.remove('moved');
                void item.offsetWidth;
                item.classList.add('moved');
            })
            .catch(() => alert('حدث خطأ في الاتصال'))
            .finally(refreshSlideOrder);
    });
});

// Save display settings
document.getElementById('displayForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    formData.append('action', 'save_display');

    postEditor(formData)
    .then(data => {
        if (data.success) {
            if (!document.querySelector('input[name="display_id"]').value) {
                window.location.href = 'tvdisplay_editor.hnt?id=' + data.display_id;
                return;
            }
            // Previews follow the new display background straight away.
            const picked = document.querySelector('#displayForm input[name="background_theme"]:checked');
            if (picked) {
                document.querySelectorAll('#slidesList .slide-item').forEach(item => {
                    if (item.dataset.ownBg) return;
                    const preview = item.querySelector('.slide-preview');
                    preview.className = preview.className.replace(/\btvbg-\S+/g, '').trim() + ' tvbg-' + picked.value;
                });
                const inherit = document.querySelector('#sbg_inherit + .tv-tile .bg-swatch');
                if (inherit) inherit.className = 'bg-swatch tvbg-' + picked.value;
            }
            alert(data.message);
        } else {
            alert(data.error);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('حدث خطأ في الاتصال');
    });
});

function youtubeId(url) {
    url = (url || '').trim();
    if (/^[A-Za-z0-9_-]{11}$/.test(url)) return url;
    if (!/^(https?:\/\/)?(www\.|m\.|music\.)?(youtube\.com|youtube-nocookie\.com|youtu\.be)\//i.test(url)) return '';
    const m = url.match(/youtu\.be\/([A-Za-z0-9_-]{11})/i) || url.match(/\/(?:shorts|embed|live|v)\/([A-Za-z0-9_-]{11})/i) || url.match(/[?&]v=([A-Za-z0-9_-]{11})/);
    return m ? m[1] : '';
}

function showYoutubePreview() {
    const id = youtubeId(document.getElementById('youtube_url').value);
    const box = document.getElementById('youtube_preview');
    box.innerHTML = '';
    if (id) {
        const img = document.createElement('img');
        img.src = 'https://img.youtube.com/vi/' + id + '/hqdefault.jpg';
        img.alt = '';
        box.appendChild(img);
    }
}

// Current file of the slide being edited: {kind, src}.
let currentMedia = { kind: '', src: '' };

function showMediaPreview(file) {
    const box = document.getElementById('media_preview');
    const wrap = document.getElementById('media_current');
    const removeWrap = document.getElementById('remove_media_wrap');
    box.innerHTML = '';
    let kind = currentMedia.kind, src = currentMedia.src;
    if (file) {
        kind = file.type.indexOf('video/') === 0 ? 'video' : 'image';
        src = URL.createObjectURL(file);
    }
    const type = document.getElementById('slide_type').value;
    const wanted = type === 'video' ? 'video' : 'image';
    if (!src || kind !== wanted) { wrap.style.display = 'none'; return; }
    const el = document.createElement(kind === 'video' ? 'video' : 'img');
    el.src = src;
    if (kind === 'video') { el.muted = true; el.controls = true; el.playsInline = true; }
    box.appendChild(el);
    wrap.style.display = 'block';
    // Only a property may be left without a picture.
    removeWrap.style.display = !file && type === 'property' ? 'block' : 'none';
}

function setSlideBackground(value) {
    const radio = document.querySelector('#slideForm input[name="background_theme"][value="' + (value || '') + '"]')
        || document.getElementById('sbg_inherit');
    if (radio) radio.checked = true;
}

function addNewSlide() {
    document.getElementById('slideForm').reset();
    document.getElementById('slide_id').value = '';
    document.getElementById('modalTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i>إضافة شريحة جديدة';
    document.getElementById('saveSlideBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>حفظ';

    // Clear Select2
    $('#property_id').val(null).trigger('change');
    jQuery('#slide_type').val('custom').trigger('change.select2');
    setSlideBackground('');
    currentMedia = { kind: '', src: '' };
    showYoutubePreview();

    updateSlideForm();
    slideModal.show();
}

function editSlide(slideId) {
    postEditor({ action: 'get_slide', slide_id: slideId })
    .then(data => {
        if (data.success) {
            const slide = data.slide;

            // Populate form fields
            document.getElementById('slide_id').value = slide.slide_id;
            document.getElementById('slide_title').value = slide.slide_title;
            document.getElementById('slide_content').value = slide.slide_content || '';
            jQuery('#slide_type').val(slide.slide_type).trigger('change.select2');
            document.getElementById('slide_duration').value = slide.slide_duration;
            setSlideBackground(slide.background_theme);
            document.getElementById('media_file').value = '';
            document.getElementById('remove_media').checked = false;
            document.getElementById('youtube_url').value = slide.youtube_url || '';
            currentMedia = { kind: slide.media_kind === 'youtube' ? '' : slide.media_kind, src: slide.media_src || '' };
            showYoutubePreview();

            // Update modal title and button
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>تعديل الشريحة';
            document.getElementById('saveSlideBtn').innerHTML = '<i class="bi bi-save me-1"></i>حفظ التعديلات';

            // Clear Select2 first
            $('#property_id').val(null).trigger('change');

            // Set property_id for Select2 if exists
            if (slide.property_id && slide.property_id != '0') {
                $('#property_id').val(slide.property_id).trigger('change');
            }

            // Update form visibility based on slide type
            updateSlideForm();

            // Show modal
            slideModal.show();
        } else {
            alert(data.error || 'حدث خطأ في تحميل بيانات الشريحة');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('حدث خطأ في الاتصال');
    });
}

function saveSlide() {
    const type = document.getElementById('slide_type').value;
    const fileInput = document.getElementById('media_file');
    if (type === 'custom' && !document.getElementById('slide_title').value.trim()) {
        alert('العنوان مطلوب');
        return;
    }
    if (type === 'youtube' && !youtubeId(document.getElementById('youtube_url').value)) {
        alert('رابط يوتيوب غير صحيح');
        return;
    }
    const wanted = type === 'video' ? 'video' : 'image';
    if ((type === 'image' || type === 'video') && !fileInput.files.length && (!currentMedia.src || currentMedia.kind !== wanted)) {
        alert(type === 'video' ? 'اختر ملف الفيديو' : 'اختر الصورة');
        return;
    }

    const formData = new FormData(document.getElementById('slideForm'));
    formData.append('action', 'save_slide');
    const saveBtn = document.getElementById('saveSlideBtn');
    const saveHtml = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + (fileInput.files.length ? 'جاري الرفع...' : 'جاري الحفظ...');

    postEditor(formData)
    .finally(() => { saveBtn.disabled = false; saveBtn.innerHTML = saveHtml; })
    .then(data => {
        if (data.success) {
            slideModal.hide();
            window.location.reload();
        } else {
            alert(data.error);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('حدث خطأ في الاتصال');
    });
}

function deleteSlide(slideId) {
    if (!confirm('هل أنت متأكد من حذف هذه الشريحة؟')) return;

    postEditor({ action: 'delete_slide', slide_id: slideId })
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error);
        }
    });
}

function updateSlideForm() {
    const slideType = document.getElementById('slide_type').value;
    const fileInput = document.getElementById('media_file');
    const hasFile = slideType === 'image' || slideType === 'video' || slideType === 'property';
    document.getElementById('property_select_div').style.display = slideType === 'property' ? 'block' : 'none';
    document.getElementById('youtube_div').style.display = slideType === 'youtube' ? 'block' : 'none';
    document.getElementById('media_file_div').style.display = hasFile ? 'block' : 'none';
    document.getElementById('title_required').style.display = slideType === 'custom' ? '' : 'none';
    document.getElementById('duration_hint').style.display = slideType === 'video' || slideType === 'youtube' ? '' : 'none';
    if (slideType === 'video') {
        fileInput.accept = 'video/mp4,video/webm,.mp4,.webm,.m4v';
        document.getElementById('media_file_label').textContent = 'ملف الفيديو';
        document.getElementById('media_file_hint').textContent = 'MP4 أو WebM. يعمل تلقائياً وبدون صوت في شاشة العرض.';
    } else {
        fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp';
        document.getElementById('media_file_label').textContent = slideType === 'property' ? 'صورة العقار (اختياري)' : 'الصورة';
        document.getElementById('media_file_hint').textContent = 'JPG أو PNG أو GIF أو WebP.';
    }
    if (fileInput.files.length) {
        const kind = fileInput.files[0].type.indexOf('video/') === 0 ? 'video' : 'image';
        if (kind !== (slideType === 'video' ? 'video' : 'image')) fileInput.value = '';
    }
    showMediaPreview(fileInput.files[0] || null);
}
</script>

<?php
require("../foter.hnt");
?>
