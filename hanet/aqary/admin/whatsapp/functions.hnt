/**
 * Replace template variables
 * @param string $template Template content
 * @param array $variables Variables array
 * @return string
 */
function wa_replace_template_vars($template, $variables)
{
    foreach ($variables as $key => $value) {
        $template = str_replace('{' . $key . '}', $value, $template);
    }

    return $template;
}

/**
 * Compress image before sending
 * @param string $sourcePath Source image path
 * @param string $targetPath Target image path
 * @param int $quality Quality (0-100)
 * @return bool
 */
function wa_compress_image($sourcePath, $targetPath, $quality = 75)
{
    $imageInfo = getimagesize($sourcePath);

    if (!$imageInfo) {
        return false;
    }

    $imageType = $imageInfo[2];

    switch ($imageType) {
        case IMAGETYPE_JPEG:
            $image = imagecreatefromjpeg($sourcePath);
            break;
        case IMAGETYPE_PNG:
            $image = imagecreatefrompng($sourcePath);
            break;
        case IMAGETYPE_GIF:
            $image = imagecreatefromgif($sourcePath);
            break;
        default:
            return false;
    }

    if (!$image) {
        return false;
    }

    // Save compressed image
    $result = imagejpeg($image, $targetPath, $quality);
    imagedestroy($image);

    return $result;
}

/**
 * Clean old logs
 * @param int $days Days to keep
 * @return bool
 */
function wa_clean_old_logs($days = 90)
{
    global $db;

    $stmt = $db->prepare("
        DELETE FROM whatsapp_sent_log
        WHERE sent_at < DATE_SUB(NOW(), INTERVAL ? DAY)
    ");
    $stmt->bind_param("i", $days);
    $stmt->execute();

    $stmt = $db->prepare("
        DELETE FROM whatsapp_service_log
        WHERE created_at < DATE_SUB(NOW(), INTERVAL ? DAY)
    ");
    $stmt->bind_param("i", $days);
    return $stmt->execute();
}

/**
 * Format file size
 * @param int $bytes Bytes
 * @return string
 */
function wa_format_file_size($bytes)
{
    if ($bytes >= 1073741824) {
        return number_format($bytes / 1073741824, 2) . ' GB';
    } elseif ($bytes >= 1048576) {
        return number_format($bytes / 1048576, 2) . ' MB';
    } elseif ($bytes >= 1024) {
        return number_format($bytes / 1024, 2) . ' KB';
    } else {
        return $bytes . ' B';
    }
}

/**
 * Format date time in Arabic
 * @param string $datetime DateTime string
 * @return string
 */
function wa_format_datetime($datetime)
{
    if (!$datetime) return '-';

    $timestamp = strtotime($datetime);
    return date('Y/m/d - h:i A', $timestamp);
}

/**
 * Get status label in Arabic
 * @param string $status Status
 * @return string
 */
function wa_get_status_label($status)
{
    $labels = array(
        'pending' => 'قيد الانتظار',
        'sending' => 'تم الارسال مجدول',
        'sent' => 'تم الإرسال',
        'failed' => 'فشل الإرسال',
        'cancelled' => 'تم الإلغاء'
    );

    return isset($labels[$status]) ? $labels[$status] : $status;
}

/**
 * Get status color class for Bootstrap
 * @param string $status Status
 * @return string
 */
function wa_get_status_color($status)
{
    $colors = array(
        'pending' => 'warning',
        'sending' => 'info',
        'sent' => 'success',
        'failed' => 'danger',
        'cancelled' => 'secondary'
    );

    return isset($colors[$status]) ? $colors[$status] : 'secondary';
}

/**
 * Check if service is running
 * @return bool
 */
function wa_is_service_running()
{
    // Check if cURL extension is available
    if (!function_exists('curl_init')) {
        error_log("WhatsApp Module Error: cURL extension is not enabled. Please enable cURL in php.ini");
        return false;
    }

    $serviceUrl = wa_get_setting('service_url', 'http://127.0.0.1:8010');

    $ch = curl_init($serviceUrl);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_TIMEOUT, 3);
    curl_setopt($ch, CURLOPT_FOLLOWLOCATION, false);
    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
    curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
    curl_setopt($ch, CURLOPT_NOBODY, true); // HEAD request only

    curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $error = curl_error($ch);
    //curl_close($ch);

    // Service is running if we get any HTTP response (200, 404, etc)
    // Connection refused or timeout means service is down
    return (!$error && $httpCode > 0);
}

/**
 * Check if account is connected
 * @return bool
 */
function wa_is_account_connected()
{
    return (wa_get_setting('account_connected', '0') == '1');
}

/**
 * Sanitize input
 * @param string $input Input string
 * @return string
 */
function wa_sanitize($input)
{
    return htmlspecialchars(trim($input), ENT_QUOTES, 'UTF-8');
}

/**
 * Generate random string
 * @param int $length Length
 * @return string
 */
function wa_generate_random_string($length = 10)
{
    return substr(str_shuffle('0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'), 0, $length);
}

