/**
 * Redirect to database installer if tables don't exist
 */
function wa_redirect_to_installer($error)
{
    // Get the current script path
    $currentScript = $_SERVER['SCRIPT_NAME'];
    $baseDir = dirname($currentScript);

    // Don't redirect if already on installer page
    if (strpos($currentScript, 'database_install.php') !== false) {
        return;
    }

    // Build installer URL
    $protocol = isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? 'https' : 'http';
    $host = $_SERVER['HTTP_HOST'];
    $installerPath = $baseDir . '/database_install.php';
    $installerUrl = $protocol . '://' . $host . $installerPath;

    // Redirect
	echo $error;exit();
    echo "<script> window.location.href = '$installerUrl'; </script>";
    exit();
}

/**
 * Get setting value from database
 * @param string $key Setting key
 * @param string $default Default value
 * @return string
 */
function wa_get_setting($key, $default = '')
{
    global $db;

    $stmt = $db->prepare("SELECT setting_value FROM whatsapp_settings WHERE setting_key = ?");

    // Check if prepare failed (table doesn't exist or other error)
    if ($stmt === false) {
        error_log("WhatsApp Module Error: Failed to prepare statement. Database tables may not exist. Error: " . $db->error);
		echo ("xc  ;WhatsApp Module Error: Failed to prepare statement. Database tables may not exist. Error: " . $db->error);
		echo "<hr>";
		print_r($db);
		echo "<hr>";
        // Check if error is related to missing table
        if (strpos($db->error, "doesn't exist") !== false || strpos($db->error, "Table") !== false) {
            wa_redirect_to_installer($db->error);
        }

        return $default;
    }

    $stmt->bind_param("s", $key);
    $stmt->execute();
    $result = $stmt->get_result();

    if ($row = $result->fetch_assoc()) {
        return $row['setting_value'];
    }

    return $default;
}

/**
 * Update setting value
 * @param string $key Setting key
 * @param string $value Setting value
 * @return bool
 */
function wa_update_setting($key, $value)
{
    global $db;

    $stmt = $db->prepare("UPDATE whatsapp_settings SET setting_value = ? WHERE setting_key = ?");

    if ($stmt === false) {
        error_log("WhatsApp Module Error: Failed to prepare update statement. Error: " . $db->error);

        // Check if error is related to missing table
        if (strpos($db->error, "doesn't exist") !== false || strpos($db->error, "Table") !== false) {
            wa_redirect_to_installer($db->error);
        }

        return false;
    }

    $stmt->bind_param("ss", $value, $key);
    return $stmt->execute();
}

/**
 * Log activity to service log
 * @param string $action Action type
 * @param string $description Description
 * @param int $userId User ID
 * @return bool
 */
function wa_log_activity($action, $description, $userId = null)
{
    global $db;

    $ipAddress = $_SERVER['REMOTE_ADDR'];

    if ($userId === null && isset($_SESSION['user_id'])) {
        $userId = $_SESSION['user_id'];
    }

    $stmt = $db->prepare("INSERT INTO whatsapp_service_log (action_type, description, user_id, ip_address) VALUES (?, ?, ?, ?)");

    if ($stmt === false) {
        error_log("WhatsApp Module Error: Failed to prepare log statement. Error: " . $db->error);

        // Check if error is related to missing table
        if (strpos($db->error, "doesn't exist") !== false || strpos($db->error, "Table") !== false) {
            wa_redirect_to_installer($db->error);
        }

        return false;
    }

    $stmt->bind_param("ssis", $action, $description, $userId, $ipAddress);
    return $stmt->execute();
}

/**
 * Format phone number for display
 * @param string $phone Phone number
 * @return string
 */
function wa_format_phone_display($phone)
{
    // Remove @s.whatsapp.net
    $phone = str_replace('@s.whatsapp.net', '', $phone);

    // Format: +966 50 123 4567
    if (strlen($phone) >= 12) {
        return '' . substr($phone, 0, 3) . '-' . substr($phone, 3, 2) . '-' . substr($phone, 5, 3) . '-' . substr($phone, 8);
    }

    return $phone;
}

/**
 * Validate phone number
 * @param string $phone Phone number
 * @return bool
 */
function wa_validate_phone($phone)
{
    // Remove all non-numeric characters
    $phone = preg_replace('/[^0-9]/', '', $phone);

    // Check length (Saudi numbers: 9 digits without country code)
    if (strlen($phone) < 9 || strlen($phone) > 15) {
        return false;
    }

    return true;
}

/**
 * Add message to queue
 * @param array $data Message data
 * @return int|bool Queue ID or false
 */
function wa_add_to_queue($data)
{
    global $db;

    $recipient = isset($data['recipient']) ? $data['recipient'] : '';
    $recipientName = isset($data['recipient_name']) ? $data['recipient_name'] : '';
    $messageText = isset($data['message_text']) ? $data['message_text'] : '';
    $attachmentPath = isset($data['attachment_path']) ? $data['attachment_path'] : null;
    $attachmentType = isset($data['attachment_type']) ? $data['attachment_type'] : null;
    $attachmentSize = isset($data['attachment_size']) ? $data['attachment_size'] : null;
    $scheduledTime = isset($data['scheduled_time']) ? $data['scheduled_time'] : null;
    $priority = isset($data['priority']) ? $data['priority'] : 5;
    $createdBy = isset($data['created_by']) ? $data['created_by'] : (isset($_SESSION['user_id']) ? $_SESSION['user_id'] : null);
    $metadata = isset($data['metadata']) ? json_encode($data['metadata']) : null;

    $stmt = $db->prepare("
        INSERT INTO whatsapp_queue
        (recipient, recipient_name, message_text, attachment_path, attachment_type, attachment_size,
         scheduled_time, priority, created_by, metadata)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    ");

    $stmt->bind_param(
        "sssssisiss",
        $recipient,
        $recipientName,
        $messageText,
        $attachmentPath,
        $attachmentType,
        $attachmentSize,
        $scheduledTime,
        $priority,
        $createdBy,
        $metadata
    );

    if ($stmt->execute()) {
        return $db->insert_id;
    }

    return false;
}

/**
 * Get message from queue by ID
 * @param int $id Queue ID
 * @return array|null
 */
function wa_get_queue_message($id)
{
    global $db;

    $stmt = $db->prepare("SELECT * FROM whatsapp_queue WHERE id = ?");

    if ($stmt === false) {
        error_log("WhatsApp Module Error: Failed to prepare queue query. Error: " . $db->error);

        // Check if error is related to missing table
        if (strpos($db->error, "doesn't exist") !== false || strpos($db->error, "Table") !== false) {
            wa_redirect_to_installer($db->error);
        }

        return null;
    }

    $stmt->bind_param("i", $id);
    $stmt->execute();
    $result = $stmt->get_result();

    return $result->fetch_assoc();
}

/**
 * Update message status
 * @param int $id Queue ID
 * @param string $status New status
 * @param string $error Error message
 * @return bool
 */
function wa_update_message_status($id, $status, $error = '')
{
    global $db;

    if ($status == 'sent') {
        $stmt = $db->prepare("
            UPDATE whatsapp_queue
            SET status = ?, sent_at = NOW(), error_message = ?
            WHERE id = ?
        ");
    } else {
        $stmt = $db->prepare("
            UPDATE whatsapp_queue
            SET status = ?, error_message = ?, retry_count = retry_count + 1
            WHERE id = ?
        ");
    }

    $stmt->bind_param("ssi", $status, $error, $id);
    return $stmt->execute();
}

/**
 * Get pending messages for processing
 * @param int $limit Maximum number of messages
 * @return array
 */
function wa_get_pending_messages($limit = 10)
{
    global $db;

    $stmt = $db->prepare("
        SELECT * FROM whatsapp_queue
        WHERE status = 'pending'
        AND (scheduled_time IS NULL OR scheduled_time <= NOW())
        AND retry_count < max_retries
        ORDER BY priority ASC, scheduled_time ASC
        LIMIT ?
    ");

    $stmt->bind_param("i", $limit);
    $stmt->execute();
    $result = $stmt->get_result();

    $messages = array();
    while ($row = $result->fetch_assoc()) {
        $messages[] = $row;
    }

    return $messages;
}

/**
 * Get message statistics
 * @param string $dateFrom Date from (Y-m-d)
 * @param string $dateTo Date to (Y-m-d)
 * @return array
 */
function wa_get_statistics($dateFrom = null, $dateTo = null)
{
    global $db;

    $where = "1=1";
    $params = array();
    $types = "";

    if ($dateFrom) {
        $where .= " AND DATE(created_at) >= ?";
        $params[] = $dateFrom;
        $types .= "s";
    }

    if ($dateTo) {
        $where .= " AND DATE(created_at) <= ?";
        $params[] = $dateTo;
        $types .= "s";
    }

    $sql = "
        SELECT
            COUNT(*) as total,
            SUM(CASE WHEN status = 'sent' THEN 1 ELSE 0 END) as sent,
            SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) as failed,
            SUM(CASE WHEN status = 'pending' THEN 1 ELSE 0 END) as pending,
            SUM(CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END) as cancelled
        FROM whatsapp_queue
        WHERE $where
    ";

    $stmt = $db->prepare($sql);

    if (!empty($params)) {
        $stmt->bind_param($types, ...$params);
    }

    $stmt->execute();
    $result = $stmt->get_result();

    return $result->fetch_assoc();
}

/**
 * Get message templates
 * @param bool $activeOnly Get only active templates
 * @return array
 */
function wa_get_templates($activeOnly = true)
{
    global $db;

    $sql = "SELECT * FROM whatsapp_templates";

    if ($activeOnly) {
        $sql .= " WHERE is_active = 1";
    }

    $sql .= " ORDER BY template_name";

    $result = $db->query($sql);

    $templates = array();
    while ($row = $result->fetch_assoc()) {
        $templates[] = $row;
    }

    return $templates;
}

