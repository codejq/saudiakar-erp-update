<?php

/**
 * Amlak Data Synchronization
 * مزامنة بيانات العقارات مع المحاسبة
 *
 * @charset UTF-8
 * @version 1.0
 */

$sc_title = "مزامنة بيانات العقارات";
$sc_id = "211";
include_once "../../nocash.hnt";
include_once "../../connectdb.hnt";
include_once "../../header.hnt";
include_once "includes/accounting_class.hnt";
include_once "includes/amlak_integration.hnt";

$currentAccountingUserId = isset($_SESSION['useridv']) ? (int)$_SESSION['useridv'] : (int)($_SESSION['userid'] ?? 0);
$accountingManager = new AccountingManager($db, $currentAccountingUserId);
$amlakIntegration = new AmlakAccountingIntegration($db, $accountingManager);

if (empty($_SESSION['accounting_sync_csrf'])) {
    try {
        $_SESSION['accounting_sync_csrf'] = bin2hex(random_bytes(24));
    } catch (Throwable $exception) {
        $_SESSION['accounting_sync_csrf'] = hash('sha256', session_id() . microtime(true) . mt_rand());
    }
}

$syncLog = [];
$syncStats = [
    'cost_centers_created' => 0,
    'tenants_synced' => 0,
    'owners_synced' => 0,
    'invoices_created' => 0,
    'receipts_synced' => 0,
    'expenses_synced' => 0,
    'settlements_synced' => 0,
    'existing_linked' => 0,
    'entries_created' => 0,
    'errors' => 0
];
$toastMessage = '';

// Handle sync actions
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['sync_action'])) {
    $action = $_POST['sync_action'];

    $postedToken = isset($_POST['csrf_token']) ? (string)$_POST['csrf_token'] : '';
    if ($postedToken === '' || !hash_equals((string)$_SESSION['accounting_sync_csrf'], $postedToken)) {
        $syncLog[] = "✗ انتهت صلاحية نموذج المزامنة. أعد تحميل الصفحة.";
        $syncStats['errors']++;
        $action = '';
    }

    switch ($action) {
        case 'sync_cost_centers':
            $propertiesQuery = "SELECT idaqar, aqarname FROM amlak WHERE aqarname != '' ORDER BY idaqar";
            $propertiesResult = $db->query($propertiesQuery);

            if (!$propertiesResult) {
                $syncLog[] = "✗ خطأ في استعلام العقارات: " . $db->error;
                $syncStats['errors']++;
                break;
            }

            if ($propertiesResult->num_rows == 0) {
                $toastMessage = "لا توجد عقارات لإنشاء مراكز تكلفة";
                break;
            }

            while ($property = $propertiesResult->fetch_assoc()) {
                $result = $accountingManager->ensurePropertyCostCenter($property['idaqar'], $property['aqarname']);
                if (!empty($result['success'])) {
                    if (!empty($result['created'])) {
                        $syncStats['cost_centers_created']++;
                        $syncLog[] = "✓ تم إنشاء مركز تكلفة للعقار: {$property['aqarname']}";
                    } else {
                        $syncLog[] = "✓ مركز التكلفة موجود مسبقاً للعقار: {$property['aqarname']}";
                    }
                } else {
                    $syncStats['errors']++;
                    $syncLog[] = "✗ فشل إنشاء مركز تكلفة للعقار: {$property['aqarname']} - " . ($result['message'] ?? 'خطأ غير معروف');
                }
            }
            break;

        case 'sync_tenants':
            // Sync all tenants as customers
            $tenantsQuery = "SELECT mostagerid, mostagername FROM mostagereen WHERE mostagername != '' ORDER BY mostagerid";
            $tenantsResult = $db->query($tenantsQuery);

            while ($tenant = $tenantsResult->fetch_assoc()) {
                $result = $amlakIntegration->syncMostagerAsCustomer($tenant['mostagerid']);
                if ($result['success']) {
                    $syncStats['tenants_synced']++;
                    $syncLog[] = "✓ تم مزامنة المستأجر: {$tenant['mostagername']}";
                } else {
                    $syncStats['errors']++;
                    $syncLog[] = "✗ فشل مزامنة المستأجر: {$tenant['mostagername']}";
                }
            }
            break;

        case 'sync_owners':
            // Sync all owners as customers
            $ownersQuery = "SELECT malekid, malekbayan1 as malekname FROM malek WHERE malekbayan1 != '' ORDER BY malekid";
            $ownersResult = $db->query($ownersQuery);

            if (!$ownersResult) {
                $syncLog[] = "✗ خطأ في استعلام الملاك: " . $db->error;
                $syncStats['errors']++;
                break;
            }

            if ($ownersResult->num_rows == 0) {
                $syncLog[] = "⚠ لا يوجد ملاك للمزامنة";
                break;
            }

            while ($owner = $ownersResult->fetch_assoc()) {
                $result = $amlakIntegration->syncMalekAsCustomer($owner['malekid']);
                if ($result['success']) {
                    $syncStats['owners_synced']++;
                    $syncLog[] = "✓ تم مزامنة المالك: {$owner['malekname']}";
                } else {
                    $syncStats['errors']++;
                    $syncLog[] = "✗ فشل مزامنة المالك: {$owner['malekname']} - " . ($result['message'] ?? 'خطأ غير معروف');
                }
            }
            break;

        case 'create_invoices':
            // Create invoices from active contracts
            $contractsQuery = "SELECT e.rakam3akdid as egarid, e.rakam3akd, m.mostagername
                              FROM egar e
                              LEFT JOIN mostagereen m ON e.mostagerid = m.mostagerid
                              WHERE e.endegar >= UNIX_TIMESTAMP(CURDATE()) * 1000
                              AND (e.invoice_id IS NULL OR e.invoice_id=0)
                              ORDER BY e.rakam3akdid
                              LIMIT 50";
            $contractsResult = $db->query($contractsQuery);

            if (!$contractsResult) {
                $syncLog[] = "✗ خطأ في استعلام العقود: " . $db->error;
                $syncStats['errors']++;
                break;
            }

            if ($contractsResult->num_rows == 0) {
                $toastMessage = "لا توجد عقود نشطة لإنشاء فواتير";
                break;
            }

            while ($contract = $contractsResult->fetch_assoc()) {
                $result = $amlakIntegration->createInvoiceFromEgar($contract['egarid']);
                if ($result['success']) {
                    $syncStats['invoices_created']++;
                    $syncLog[] = (!empty($result['existing']) ? "✓ تم ربط العقد بفاتورته: " : "✓ تم إنشاء فاتورة للعقد: ") . $contract['rakam3akd'] . ' - ' . $contract['mostagername'];
                } else {
                    $syncStats['errors']++;
                    $syncLog[] = "✗ فشل إنشاء فاتورة للعقد: {$contract['rakam3akd']} - " . ($result['message'] ?? 'خطأ غير معروف');
                }
            }
            break;

        case 'sync_payments':
            // Source columns are installed by schema_migrations.hnt from the
            // accounting dashboard.  Process a bounded batch on every run.
            $vouchersQuery = "SELECT idsanad as sanadid, sanadrakam as sanadnumber, mybyan as sanaddescription
                             FROM sanad
                             WHERE accounting_entry_id IS NULL OR accounting_entry_id = 0
                             ORDER BY idsanad DESC
                             LIMIT 100";
            $vouchersResult = $db->query($vouchersQuery);

            if (!$vouchersResult) {
                $syncLog[] = "✗ خطأ في استعلام السندات: " . $db->error;
                $syncStats['errors']++;
                break;
            }

            if ($vouchersResult->num_rows == 0) {
                $toastMessage = "لا توجد سندات جديدة للمزامنة (جميع السندات تمت مزامنتها بالفعل)";
                break;
            }

            $syncLog[] = "⚙ بدء مزامنة {$vouchersResult->num_rows} سند قبض...";

            while ($voucher = $vouchersResult->fetch_assoc()) {
                $result = $amlakIntegration->createEntryFromSanad($voucher['sanadid']);
                if ($result['success']) {
                    $entryId = $result['entry_id'] ?? 0;
                    if ($entryId > 0) {
                        $updateQuery = "UPDATE sanad SET accounting_entry_id=? WHERE idsanad=? AND (accounting_entry_id IS NULL OR accounting_entry_id=0)";
                        $stmt = $db->prepare($updateQuery);
                        if ($stmt) {
                            $stmt->bind_param('ii', $entryId, $voucher['sanadid']);
                            $stmt->execute();
                            $stmt->close();
                        }
                    }
                    $syncStats['entries_created']++;
                    $syncStats['receipts_synced']++;
                    if (!empty($result['existing'])) $syncStats['existing_linked']++;
                    $syncLog[] = (!empty($result['existing']) ? "✓ تم ربط السند بقيده الموجود: " : "✓ تم إنشاء قيد من سند: ") . $voucher['sanadnumber'];
                } else {
                    $syncStats['errors']++;
                    $syncLog[] = "✗ فشل إنشاء قيد من سند: {$voucher['sanadnumber']} - " . ($result['message'] ?? 'خطأ غير معروف');
                }
            }
            break;

        case 'sync_expenses':
            $expensesResult = $db->query("SELECT idmasrof, idaqar, payeddue
                FROM masrofat
                WHERE fund_source=0 AND (accounting_entry_id IS NULL OR accounting_entry_id=0)
                ORDER BY idmasrof DESC LIMIT 100");
            if (!$expensesResult) {
                $syncStats['errors']++;
                $syncLog[] = "✗ تعذر قراءة المصروفات غير المزامنة.";
                break;
            }
            if ($expensesResult->num_rows === 0) {
                $toastMessage = "لا توجد مصروفات جديدة للمزامنة";
                break;
            }
            while ($expense = $expensesResult->fetch_assoc()) {
                $result = $amlakIntegration->createEntryFromMasrofat((int)$expense['idmasrof']);
                if (!empty($result['success']) && !empty($result['entry_id'])) {
                    $entryId = (int)$result['entry_id'];
                    $expenseId = (int)$expense['idmasrof'];
                    $stmt = $db->prepare("UPDATE masrofat SET accounting_entry_id=? WHERE idmasrof=? AND (accounting_entry_id IS NULL OR accounting_entry_id=0)");
                    if ($stmt) {
                        $stmt->bind_param('ii', $entryId, $expenseId);
                        $stmt->execute();
                        $stmt->close();
                    }
                    $syncStats['entries_created']++;
                    $syncStats['expenses_synced']++;
                    if (!empty($result['existing'])) $syncStats['existing_linked']++;
                    $syncLog[] = "✓ تمت مزامنة المصروف #{$expenseId}" . ((int)$expense['idaqar'] === 0 ? ' (مصروف مكتب)' : '');
                } else {
                    $syncStats['errors']++;
                    $syncLog[] = "✗ فشلت مزامنة المصروف #" . (int)$expense['idmasrof'] . ' - ' . ($result['message'] ?? 'خطأ غير معروف');
                }
            }
            break;

        case 'sync_owner_settlements':
            $settlementsResult = $db->query("SELECT sanadid, bayan
                FROM sanadsarf
                WHERE aqarid>0 AND iderad>0 AND (accounting_entry_id IS NULL OR accounting_entry_id=0)
                ORDER BY sanadid DESC LIMIT 100");
            if (!$settlementsResult) {
                $syncStats['errors']++;
                $syncLog[] = "✗ تعذر قراءة تسليمات الملاك غير المزامنة.";
                break;
            }
            if ($settlementsResult->num_rows === 0) {
                $toastMessage = "لا توجد تسليمات ملاك جديدة للمزامنة";
                break;
            }
            while ($settlement = $settlementsResult->fetch_assoc()) {
                $result = $amlakIntegration->createEntryFromSanadsarf((int)$settlement['sanadid']);
                if (!empty($result['success']) && !empty($result['entry_id'])) {
                    $entryId = (int)$result['entry_id'];
                    $settlementId = (int)$settlement['sanadid'];
                    $stmt = $db->prepare("UPDATE sanadsarf SET accounting_entry_id=? WHERE sanadid=? AND (accounting_entry_id IS NULL OR accounting_entry_id=0)");
                    if ($stmt) {
                        $stmt->bind_param('ii', $entryId, $settlementId);
                        $stmt->execute();
                        $stmt->close();
                    }
                    $syncStats['entries_created']++;
                    $syncStats['settlements_synced']++;
                    if (!empty($result['existing'])) $syncStats['existing_linked']++;
                    $syncLog[] = "✓ تمت مزامنة سند تسليم المالك #{$settlementId}";
                } else {
                    $syncStats['errors']++;
                    $syncLog[] = "✗ فشلت مزامنة سند تسليم المالك #" . (int)$settlement['sanadid'] . ' - ' . ($result['message'] ?? 'خطأ غير معروف');
                }
            }
            break;
    }
}

// Get current counts with error checking
$tenantsCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM mostagereen");
if ($result) $tenantsCount = $result->fetch_assoc()['count'];

$ownersCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM malek");
if ($result) $ownersCount = $result->fetch_assoc()['count'];

$contractsCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM egar WHERE endegar >= UNIX_TIMESTAMP(CURDATE()) * 1000");
if ($result) $contractsCount = $result->fetch_assoc()['count'];

$propertiesCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM amlak");
if ($result) $propertiesCount = $result->fetch_assoc()['count'];

$sanadCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM sanad WHERE accounting_entry_id IS NULL OR accounting_entry_id=0");
if ($result) $sanadCount = $result->fetch_assoc()['count'];

$expenseSyncCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM masrofat WHERE fund_source=0 AND (accounting_entry_id IS NULL OR accounting_entry_id=0)");
if ($result) $expenseSyncCount = $result->fetch_assoc()['count'];

$ownerSettlementSyncCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM sanadsarf WHERE aqarid>0 AND iderad>0 AND (accounting_entry_id IS NULL OR accounting_entry_id=0)");
if ($result) $ownerSettlementSyncCount = $result->fetch_assoc()['count'];

$customersCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM acc_customers");
if ($result) $customersCount = $result->fetch_assoc()['count'];

$invoicesCount = 0;
$result = $db->query("SELECT COUNT(*) as count FROM acc_invoices");
if ($result) $invoicesCount = $result->fetch_assoc()['count'];
?>

