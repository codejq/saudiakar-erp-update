<?php
/** Compatibility entry point; all migration SQL now belongs to the shared runner. */
require_once dirname(__DIR__) . '/include/amlak/migrations.hnt';

function runAccountingSchemaMigrations($db) {
    $success = AmlakMigrations::run($db);
    $errors = $success ? [] : ['تعذر إكمال تحديث المحاسبة. افتح الواجهة الرئيسية أو صفحة إصلاح الجداول وأعد المحاولة.'];
    return ['success'=>$success,'message'=>implode("\n",$errors),'errors'=>$errors,'applied'=>[]];
}
