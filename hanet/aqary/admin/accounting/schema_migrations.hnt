<?php
function runAccountingSchemaMigrations($db) {
    $errors = [];
    $applied = [];

    $invoiceColumnMigrations = [
        'journal_id' => "ALTER TABLE acc_invoices ADD COLUMN journal_id INT NULL AFTER due_date",
        'cost_center_id' => "ALTER TABLE acc_invoices ADD COLUMN cost_center_id INT NULL AFTER journal_id",
        'tenant_id' => "ALTER TABLE acc_invoices ADD COLUMN tenant_id INT NULL AFTER cost_center_id",
        'owner_id' => "ALTER TABLE acc_invoices ADD COLUMN owner_id INT NULL AFTER tenant_id",
        'aqar_id' => "ALTER TABLE acc_invoices ADD COLUMN aqar_id INT NULL AFTER owner_id",
        'subaqar_id' => "ALTER TABLE acc_invoices ADD COLUMN subaqar_id INT NULL AFTER aqar_id",
        'egar_id' => "ALTER TABLE acc_invoices ADD COLUMN egar_id INT NULL AFTER subaqar_id",
        'vat_rate' => "ALTER TABLE acc_invoices ADD COLUMN vat_rate DECIMAL(5,2) DEFAULT 15.00 AFTER subtotal",
        'remaining_amount' => "ALTER TABLE acc_invoices ADD COLUMN remaining_amount DECIMAL(15,2) DEFAULT 0 AFTER paid_amount",
        'payment_method' => "ALTER TABLE acc_invoices ADD COLUMN payment_method VARCHAR(50) NULL AFTER payment_status",
        'status' => "ALTER TABLE acc_invoices ADD COLUMN status ENUM('draft','approved','posted','cancelled') DEFAULT 'draft' AFTER payment_status",
        'updated_at' => "ALTER TABLE acc_invoices ADD COLUMN updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER created_at"
    ];

    foreach ($invoiceColumnMigrations as $columnName => $alterSql) {
        $columnCheck = $db->query("SHOW COLUMNS FROM acc_invoices LIKE '{$columnName}'");
        if (!$columnCheck) {
            $errors[] = 'فشل في فحص أعمدة جدول الفواتير: ' . $db->error;
            continue;
        }
        if ($columnCheck->num_rows == 0 && !$db->query($alterSql)) {
            $errors[] = 'فشل في تحديث بنية جدول الفواتير: ' . $db->error;
        }
    }

    $journalTableCheck = $db->query("SHOW TABLES LIKE 'acc_journals'");
    if (!$journalTableCheck) {
        $errors[] = 'فشل في فحص جدول اليومية: ' . $db->error;
    } elseif ($journalTableCheck->num_rows == 0) {
        $createJournalTableSql = "CREATE TABLE acc_journals (
            journal_id INT(11) NOT NULL AUTO_INCREMENT,
            journal_code VARCHAR(50) NOT NULL,
            journal_name_ar VARCHAR(255) NOT NULL,
            journal_name_en VARCHAR(255) DEFAULT NULL,
            journal_type VARCHAR(50) DEFAULT 'general',
            is_active TINYINT(1) DEFAULT 1,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
            formuid VARCHAR(500) NOT NULL,
            PRIMARY KEY (journal_id),
            UNIQUE KEY idx_journal_code (journal_code),
            KEY idx_journal_active (is_active)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci";
        if (!$db->query($createJournalTableSql)) {
            $errors[] = 'فشل في إنشاء جدول اليوميات: ' . $db->error;
        }
    }

    $defaultJournals = [
        [
            'journal_code' => 'GEN',
            'journal_name_ar' => 'دفتر اليومية العام',
            'journal_name_en' => 'General Journal',
            'journal_type' => 'general'
        ],
        [
            'journal_code' => 'REC',
            'journal_name_ar' => 'دفتر المقبوضات',
            'journal_name_en' => 'Receipts Journal',
            'journal_type' => 'receipt'
        ],
        [
            'journal_code' => 'PAY',
            'journal_name_ar' => 'دفتر المدفوعات',
            'journal_name_en' => 'Payments Journal',
            'journal_type' => 'payment'
        ],
        [
            'journal_code' => 'SAL',
            'journal_name_ar' => 'دفتر المبيعات',
            'journal_name_en' => 'Sales Journal',
            'journal_type' => 'sales'
        ],
        [
            'journal_code' => 'ADJ',
            'journal_name_ar' => 'دفتر التسويات',
            'journal_name_en' => 'Adjustments Journal',
            'journal_type' => 'adjustment'
        ]
    ];

    foreach ($defaultJournals as $journal) {
        $journalCheck = $db->query("SELECT journal_id FROM acc_journals WHERE journal_code = '" . $db->real_escape_string($journal['journal_code']) . "' LIMIT 1");
        if (!$journalCheck) {
            $errors[] = 'فشل في فحص اليوميات الافتراضية: ' . $db->error;
            continue;
        }
        if ($journalCheck->num_rows == 0) {
            $journalInsert = $db->prepare("INSERT INTO acc_journals (journal_code, journal_name_ar, journal_name_en, journal_type, is_active, formuid) VALUES (?, ?, ?, ?, 1, UUID())");
            if (!$journalInsert) {
                $errors[] = 'فشل في تجهيز إدراج دفتر يومية افتراضي: ' . $db->error;
                continue;
            }
            $journalInsert->bind_param('ssss', $journal['journal_code'], $journal['journal_name_ar'], $journal['journal_name_en'], $journal['journal_type']);
            if (!$journalInsert->execute()) {
                $errors[] = 'فشل في إضافة دفتر يومية افتراضي: ' . $journalInsert->error;
            }
            $journalInsert->close();
        }
    }

    $costCenterTableCheck = $db->query("SHOW TABLES LIKE 'acc_cost_centers'");
    if (!$costCenterTableCheck) {
        $errors[] = 'فشل في فحص جدول مراكز التكلفة: ' . $db->error;
    } elseif ($costCenterTableCheck->num_rows == 0) {
        $createCostCenterTableSql = "CREATE TABLE acc_cost_centers (
            cost_center_id INT(11) NOT NULL AUTO_INCREMENT,
            cost_center_code VARCHAR(50) NOT NULL,
            cost_center_name_ar VARCHAR(255) NOT NULL,
            cost_center_name_en VARCHAR(255) DEFAULT NULL,
            parent_cost_center_id INT(11) DEFAULT NULL,
            aqar_id INT(11) DEFAULT NULL,
            subaqar_id INT(11) DEFAULT NULL,
            is_active TINYINT(1) DEFAULT 1,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
            formuid VARCHAR(500) NOT NULL,
            PRIMARY KEY (cost_center_id),
            UNIQUE KEY idx_cost_center_code (cost_center_code),
            KEY idx_cost_center_parent (parent_cost_center_id),
            KEY idx_cost_center_aqar (aqar_id),
            KEY idx_cost_center_subaqar (subaqar_id),
            KEY idx_cost_center_active (is_active)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci";
        if (!$db->query($createCostCenterTableSql)) {
            $errors[] = 'فشل في إنشاء جدول مراكز التكلفة: ' . $db->error;
        }
    }

    $journalEntryColumnMigrations = [
        'journal_id' => "ALTER TABLE acc_journal_entries ADD COLUMN journal_id INT(11) NULL AFTER entry_type",
        'tenant_id' => "ALTER TABLE acc_journal_entries ADD COLUMN tenant_id INT(11) NULL AFTER journal_id",
        'owner_id' => "ALTER TABLE acc_journal_entries ADD COLUMN owner_id INT(11) NULL AFTER tenant_id",
        'aqar_id' => "ALTER TABLE acc_journal_entries ADD COLUMN aqar_id INT(11) NULL AFTER owner_id",
        'subaqar_id' => "ALTER TABLE acc_journal_entries ADD COLUMN subaqar_id INT(11) NULL AFTER aqar_id",
        'egar_id' => "ALTER TABLE acc_journal_entries ADD COLUMN egar_id INT(11) NULL AFTER subaqar_id",
        'sanad_id' => "ALTER TABLE acc_journal_entries ADD COLUMN sanad_id INT(11) NULL AFTER egar_id",
        'sanadsarf_id' => "ALTER TABLE acc_journal_entries ADD COLUMN sanadsarf_id INT(11) NULL AFTER sanad_id",
        'masrofat_id' => "ALTER TABLE acc_journal_entries ADD COLUMN masrofat_id INT(11) NULL AFTER sanadsarf_id",
        'invoice_id' => "ALTER TABLE acc_journal_entries ADD COLUMN invoice_id INT(11) NULL AFTER masrofat_id",
        'sales_representative_userid' => "ALTER TABLE acc_journal_entries ADD COLUMN sales_representative_userid INT(11) NULL AFTER invoice_id"
    ];

    foreach ($journalEntryColumnMigrations as $columnName => $alterSql) {
        $columnCheck = $db->query("SHOW COLUMNS FROM acc_journal_entries LIKE '{$columnName}'");
        if (!$columnCheck) {
            $errors[] = 'فشل في فحص أعمدة القيود اليومية: ' . $db->error;
            continue;
        }
        if ($columnCheck->num_rows == 0 && !$db->query($alterSql)) {
            $errors[] = 'فشل في تحديث جدول القيود اليومية: ' . $db->error;
        } elseif ($columnCheck->num_rows == 0) {
            $applied[] = 'تمت إضافة حقل ' . $columnName . ' للقيود المحاسبية.';
        }
    }

    // The original enum did not include the values already used by payment
    // and expense code.  On installations without strict SQL mode those rows
    // were silently stored with an empty entry_type.
    if (!$db->query("UPDATE acc_journal_entries SET entry_type='manual' WHERE entry_type IS NULL")) {
        $errors[] = 'فشل في تصحيح القيود التي لا تحمل نوعاً: ' . $db->error;
    }
    $entryTypeCheck = $db->query("SHOW COLUMNS FROM acc_journal_entries LIKE 'entry_type'");
    if (!$entryTypeCheck) {
        $errors[] = 'فشل في فحص نوع القيد المحاسبي: ' . $db->error;
    } else {
        $entryTypeDefinition = $entryTypeCheck->fetch_assoc();
        if (strpos((string)($entryTypeDefinition['Type'] ?? ''), "'owner_settlement'") === false) {
            $entryTypeSql = "ALTER TABLE acc_journal_entries MODIFY COLUMN entry_type
                ENUM('','manual','auto','opening','closing','adjustment','invoice','payment','receipt','expense','owner_settlement','commission')
                NOT NULL DEFAULT 'manual'";
            if (!$db->query($entryTypeSql)) {
                $errors[] = 'فشل في توسيع أنواع القيود المحاسبية: ' . $db->error;
            } else {
                $applied[] = 'تم توسيع أنواع القيود لتشمل المقبوضات والمصروفات وتسليمات الملاك.';
            }
        }
    }

    if (!$db->query("UPDATE acc_journal_entries SET entry_type='receipt' WHERE entry_type='' AND reference_type='sanad'")) {
        $errors[] = 'فشل في تصحيح أنواع قيود سندات القبض: ' . $db->error;
    }
    if (!$db->query("UPDATE acc_journal_entries SET entry_type='payment' WHERE entry_type='' AND reference_type='invoice'")) {
        $errors[] = 'فشل في تصحيح أنواع قيود دفعات الفواتير: ' . $db->error;
    }
    $emptyEntryTypes = $db->query("SELECT COUNT(*) AS total FROM acc_journal_entries WHERE entry_type='' ");
    $emptyEntryTypeRow = $emptyEntryTypes ? $emptyEntryTypes->fetch_assoc() : ['total' => 1];
    if ((int)($emptyEntryTypeRow['total'] ?? 1) === 0) {
        $finalEntryTypeSql = "ALTER TABLE acc_journal_entries MODIFY COLUMN entry_type
            ENUM('manual','auto','opening','closing','adjustment','invoice','payment','receipt','expense','owner_settlement','commission')
            NOT NULL DEFAULT 'manual'";
        $currentTypeCheck = $db->query("SHOW COLUMNS FROM acc_journal_entries LIKE 'entry_type'");
        $currentTypeRow = $currentTypeCheck ? $currentTypeCheck->fetch_assoc() : [];
        if (strpos((string)($currentTypeRow['Type'] ?? ''), "enum('','manual'") !== false && !$db->query($finalEntryTypeSql)) {
            $errors[] = 'فشل في إنهاء تصحيح نوع القيد المحاسبي: ' . $db->error;
        }
    }

    $journalEntryIndexes = [
        'idx_journal_entries_journal_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_journal_id (journal_id)",
        'idx_journal_entries_tenant_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_tenant_id (tenant_id)",
        'idx_journal_entries_owner_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_owner_id (owner_id)",
        'idx_journal_entries_aqar_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_aqar_id (aqar_id)",
        'idx_journal_entries_subaqar_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_subaqar_id (subaqar_id)",
        'idx_journal_entries_egar_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_egar_id (egar_id)",
        'idx_journal_entries_sanad_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_sanad_id (sanad_id)",
        'idx_journal_entries_sanadsarf_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_sanadsarf_id (sanadsarf_id)",
        'idx_journal_entries_masrofat_id' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_masrofat_id (masrofat_id)",
        'idx_journal_entries_sales_rep' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_sales_rep (sales_representative_userid, entry_date)",
        'idx_journal_entries_reference' => "ALTER TABLE acc_journal_entries ADD INDEX idx_journal_entries_reference (reference_type, reference_id)"
    ];

    foreach ($journalEntryIndexes as $indexName => $alterSql) {
        $indexCheck = $db->query("SHOW INDEX FROM acc_journal_entries WHERE Key_name = '{$indexName}'");
        if (!$indexCheck) {
            $errors[] = 'فشل في فحص فهارس القيود اليومية: ' . $db->error;
            continue;
        }
        if ($indexCheck->num_rows == 0 && !$db->query($alterSql)) {
            $errors[] = 'فشل في إضافة فهرس إلى جدول القيود اليومية: ' . $db->error;
        }
    }

    $lineCostCenterIndexCheck = $db->query("SHOW INDEX FROM acc_journal_entry_lines WHERE Key_name = 'idx_cost_center_id'");
    if (!$lineCostCenterIndexCheck) {
        $errors[] = 'فشل في فحص فهرس مراكز التكلفة في بنود القيود: ' . $db->error;
    } elseif ($lineCostCenterIndexCheck->num_rows == 0 && !$db->query("ALTER TABLE acc_journal_entry_lines ADD INDEX idx_cost_center_id (cost_center_id)")) {
        $errors[] = 'فشل في إضافة فهرس مراكز التكلفة في بنود القيود: ' . $db->error;
    }

    // Source markers keep synchronization repeatable.  They are intentionally
    // installed from the accounting dashboard rather than mutating schemas in
    // every receipt or expense page.
    $sourceMigrations = [
        'sanad' => [
            'column' => "ALTER TABLE sanad ADD COLUMN accounting_entry_id INT(11) NULL",
            'index' => 'idx_sanad_accounting_entry'
        ],
        'masrofat' => [
            'column' => "ALTER TABLE masrofat ADD COLUMN accounting_entry_id INT(11) NULL",
            'index' => 'idx_masrofat_accounting_entry'
        ],
        'sanadsarf' => [
            'column' => "ALTER TABLE sanadsarf ADD COLUMN accounting_entry_id INT(11) NULL",
            'index' => 'idx_sanadsarf_accounting_entry'
        ]
    ];

    foreach ($sourceMigrations as $tableName => $migration) {
        $tableCheck = $db->query("SHOW TABLES LIKE '" . $db->real_escape_string($tableName) . "'");
        if (!$tableCheck || $tableCheck->num_rows === 0) {
            continue;
        }
        $columnCheck = $db->query("SHOW COLUMNS FROM `{$tableName}` LIKE 'accounting_entry_id'");
        if (!$columnCheck) {
            $errors[] = 'فشل في فحص ربط ' . $tableName . ' بالمحاسبة: ' . $db->error;
            continue;
        }
        if ($columnCheck->num_rows === 0) {
            if (!$db->query($migration['column'])) {
                $errors[] = 'فشل في إضافة ربط ' . $tableName . ' بالمحاسبة: ' . $db->error;
                continue;
            }
            $applied[] = 'تم ربط جدول ' . $tableName . ' بالقيود المحاسبية.';
        }
        $indexName = $migration['index'];
        $indexCheck = $db->query("SHOW INDEX FROM `{$tableName}` WHERE Column_name='accounting_entry_id'");
        if ($indexCheck && $indexCheck->num_rows === 0) {
            if (!$db->query("ALTER TABLE `{$tableName}` ADD INDEX `{$indexName}` (accounting_entry_id)")) {
                $errors[] = 'فشل في إضافة فهرس الربط المحاسبي لجدول ' . $tableName . ': ' . $db->error;
            }
        }
    }

    $contractTableCheck = $db->query("SHOW TABLES LIKE 'egar'");
    if ($contractTableCheck && $contractTableCheck->num_rows > 0) {
        $contractInvoiceColumn = $db->query("SHOW COLUMNS FROM egar LIKE 'invoice_id'");
        if ($contractInvoiceColumn && $contractInvoiceColumn->num_rows === 0) {
            if (!$db->query("ALTER TABLE egar ADD COLUMN invoice_id INT(11) NULL")) {
                $errors[] = 'فشل في إضافة ربط العقد بالفاتورة المحاسبية: ' . $db->error;
            } else {
                $applied[] = 'تم ربط العقود بالفواتير المحاسبية.';
            }
        }
        $contractInvoiceIndex = $db->query("SHOW INDEX FROM egar WHERE Column_name='invoice_id'");
        if ($contractInvoiceIndex && $contractInvoiceIndex->num_rows === 0) {
            if (!$db->query("ALTER TABLE egar ADD INDEX idx_egar_accounting_invoice (invoice_id)")) {
                $errors[] = 'فشل في إضافة فهرس ربط العقود بالفواتير: ' . $db->error;
            }
        }
    }

    // Accounts required by the newer Amlak flows.  Codes are stable across
    // customers; IDs are resolved after insertion and stored in settings.
    $defaultIntegrationAccounts = [
        ['1130', 'تحصيلات مودعة في حسابات الملاك', 'Owner-held collections', 'asset', 'owner_clearing', '1100'],
        ['2111', 'ذمم الملاك', 'Property owner payables', 'liability', 'owner_payable', '2000'],
        ['2112', 'عمولات مندوبي المبيعات المستحقة', 'Sales commissions payable', 'liability', 'commission_payable', '2000'],
        ['5120', 'عمولات مندوبي المبيعات', 'Sales representative commissions', 'expense', 'sales_commission', '5000'],
        ['5190', 'مصروفات تشغيلية عامة', 'General operating expenses', 'expense', 'operating_expense', '5000'],
        ['5210', 'مبالغ مسلمة للملاك', 'Property owner settlements', 'expense', 'owner_settlement', '5000']
    ];

    foreach ($defaultIntegrationAccounts as $account) {
        [$code, $nameAr, $nameEn, $type, $category, $parentCode] = $account;
        $accountCheck = $db->prepare("SELECT account_id FROM acc_chart_of_accounts WHERE account_code=? LIMIT 1");
        if (!$accountCheck) {
            $errors[] = 'فشل في فحص حساب التكامل ' . $code . ': ' . $db->error;
            continue;
        }
        $accountCheck->bind_param('s', $code);
        $accountCheck->execute();
        $existingAccount = $accountCheck->get_result()->fetch_assoc();
        $accountCheck->close();
        if ($existingAccount) {
            continue;
        }

        $parentId = null;
        $accountLevel = 2;
        $parentCheck = $db->prepare("SELECT account_id, account_level FROM acc_chart_of_accounts WHERE account_code=? LIMIT 1");
        if ($parentCheck) {
            $parentCheck->bind_param('s', $parentCode);
            $parentCheck->execute();
            $parentRow = $parentCheck->get_result()->fetch_assoc();
            $parentId = $parentRow ? (int)$parentRow['account_id'] : null;
            $accountLevel = $parentRow ? ((int)$parentRow['account_level'] + 1) : 2;
            $parentCheck->close();
        }
        $createdBy = isset($_SESSION['useridv']) ? (int)$_SESSION['useridv'] : 0;
        $insertAccount = $db->prepare("INSERT INTO acc_chart_of_accounts
            (account_code, account_name_ar, account_name_en, parent_account_id, account_type,
             account_category, account_level, is_leaf, is_active, created_by, formuid)
            VALUES (?, ?, ?, ?, ?, ?, ?, 1, 1, ?, UUID())");
        if (!$insertAccount) {
            $errors[] = 'فشل في تجهيز حساب التكامل ' . $code . ': ' . $db->error;
            continue;
        }
        $insertAccount->bind_param('sssissii', $code, $nameAr, $nameEn, $parentId, $type, $category, $accountLevel, $createdBy);
        if (!$insertAccount->execute()) {
            $errors[] = 'فشل في إضافة حساب التكامل ' . $code . ': ' . $insertAccount->error;
        } else {
            $applied[] = 'تم إضافة الحساب ' . $code . ' - ' . $nameAr . '.';
        }
        $insertAccount->close();
    }

    $integrationSettings = [
        'default_receipt_cash_account_id' => '1111',
        'default_receipt_bank_account_id' => '1112',
        'default_receivable_account_id' => '1121',
        'default_expense_account_id' => '5190',
        'default_payment_cash_account_id' => '1111',
        'default_payment_bank_account_id' => '1112',
        'default_owner_funds_clearing_account_id' => '1130',
        'default_owner_payable_account_id' => '2111',
        'default_sales_commission_payable_account_id' => '2112',
        'default_sales_commission_expense_account_id' => '5120',
        'default_owner_settlement_account_id' => '5210'
    ];

    foreach ($integrationSettings as $settingKey => $accountCode) {
        $accountResult = $db->prepare("SELECT account_id FROM acc_chart_of_accounts WHERE account_code=? LIMIT 1");
        if (!$accountResult) {
            continue;
        }
        $accountResult->bind_param('s', $accountCode);
        $accountResult->execute();
        $accountRow = $accountResult->get_result()->fetch_assoc();
        $accountResult->close();
        if (!$accountRow) {
            continue;
        }
        $settingValue = (string)(int)$accountRow['account_id'];
        $settingCategory = 'amlak_integration';
        $description = 'حساب افتراضي لتكامل إدارة الأملاك';
        $settingInsert = $db->prepare("INSERT INTO acc_system_settings
            (setting_key, setting_value, setting_category, description_ar, formuid)
            VALUES (?, ?, ?, ?, UUID())
            ON DUPLICATE KEY UPDATE setting_value=IF(TRIM(COALESCE(setting_value,''))='', VALUES(setting_value), setting_value)");
        if (!$settingInsert) {
            $errors[] = 'فشل في تجهيز إعداد التكامل ' . $settingKey . ': ' . $db->error;
            continue;
        }
        $settingInsert->bind_param('ssss', $settingKey, $settingValue, $settingCategory, $description);
        if (!$settingInsert->execute()) {
            $errors[] = 'فشل في حفظ إعداد التكامل ' . $settingKey . ': ' . $settingInsert->error;
        }
        $settingInsert->close();
    }

    return [
        'success' => count($errors) === 0,
        'message' => count($errors) === 0 ? '' : implode("\n", $errors),
        'errors' => $errors,
        'applied' => $applied
    ];
}
