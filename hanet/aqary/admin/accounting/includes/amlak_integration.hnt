<?php
/**
 * Amlak (Property Management) Integration
 * تكامل نظام إدارة العقارات مع المحاسبة
 *
 * @charset UTF-8
 * @version 1.0
 */

require_once __DIR__ . '/../../include/amlak/receipt_commission_helpers.hnt';
require_once __DIR__ . '/../../include/amlak/expense_payment_voucher_helpers.hnt';
require_once __DIR__ . '/customer_identity.hnt';
require_once __DIR__ . '/sync_start_date.hnt';
require_once __DIR__ . '/receipt_sync.hnt';
require_once __DIR__ . '/entry_reversal.hnt';
require_once __DIR__ . '/deposit_sync.hnt';
require_once __DIR__ . '/transfer_sync.hnt';

class AmlakAccountingIntegration {
    use ReceiptInvoiceSync;
    use EntryReversal;
    use DepositSync;
    use TransferSync;

    private $db;
    private $accountingManager;

    public function __construct($db, $accountingManager) {
        $this->db = $db;
        $this->accountingManager = $accountingManager;
    }

    private function sourceEntry($column, $sourceId, $referenceType) {
        $allowedColumns = ['sanad_id', 'sanadsarf_id', 'masrofat_id'];
        if (!in_array($column, $allowedColumns, true) || (int)$sourceId <= 0) {
            return null;
        }

        $stmt = $this->db->prepare("SELECT entry_id, entry_number, status FROM acc_journal_entries
            WHERE ({$column}=? OR (reference_type=? AND reference_id=?))" . accountingLiveEntrySql($this->db) . "
            ORDER BY entry_id DESC LIMIT 2");
        if (!$stmt) {
            throw new RuntimeException('تعذر التحقق من القيد المرتبط بالحركة.');
        }
        $sourceId = (int)$sourceId;
        $stmt->bind_param('isi', $sourceId, $referenceType, $sourceId);
        $stmt->execute();
        $matches = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
        $stmt->close();
        if (count($matches)>1) throw new RuntimeException('للحركة أكثر من قيد مرتبط؛ راجع القيود قبل إعادة المزامنة.');
        $entry=$matches[0] ?? null;
        if ($entry && $entry['status']!=='posted') {
            throw new RuntimeException('القيد المرتبط بالحركة مسودة أو ملغى. سوّ حالته في المحاسبة قبل إعادة المزامنة.');
        }
        return $entry ?: null;
    }

    private function accountId($settingKey, $fallbackCode) {
        $configuredId = (int)$this->accountingManager->getSetting($settingKey, 0);
        if ($configuredId > 0) {
            $configured = $this->db->prepare("SELECT account_id FROM acc_chart_of_accounts WHERE account_id=? AND is_active=1 LIMIT 1");
            if ($configured) {
                $configured->bind_param('i', $configuredId);
                $configured->execute();
                $row = $configured->get_result()->fetch_assoc();
                $configured->close();
                if ($row) {
                    return (int)$row['account_id'];
                }
            }
        }

        $fallback = $this->db->prepare("SELECT account_id FROM acc_chart_of_accounts WHERE account_code=? AND is_active=1 LIMIT 1");
        if (!$fallback) {
            return 0;
        }
        $fallback->bind_param('s', $fallbackCode);
        $fallback->execute();
        $row = $fallback->get_result()->fetch_assoc();
        $fallback->close();
        return $row ? (int)$row['account_id'] : 0;
    }

    private function timestampDate($value) {
        $timestamp = (int)$value;
        if ($timestamp > 20000000000) {
            $timestamp = (int)floor($timestamp / 1000);
        }
        return $timestamp > 0 ? date('Y-m-d', $timestamp) : date('Y-m-d');
    }

    private function buildPropertyContext($aqarId, $subaqarId = null) {
        $aqarId = (int)$aqarId;
        $subaqarId = !empty($subaqarId) ? (int)$subaqarId : null;

        if ($aqarId <= 0) {
            return [
                'aqar_id' => null,
                'subaqar_id' => $subaqarId,
                'property_name' => null,
                'owner_id' => null,
                'sub_property_name' => null,
                'cost_center_id' => null,
                'cost_center_message' => null
            ];
        }

        $propertyStmt = $this->db->prepare("SELECT aqarname, ownerid FROM amlak WHERE idaqar = ? LIMIT 1");
        $propertyName = null;
        $ownerId = null;
        if ($propertyStmt) {
            $propertyStmt->bind_param('i', $aqarId);
            $propertyStmt->execute();
            $propertyRow = $propertyStmt->get_result()->fetch_assoc();
            $propertyName = $propertyRow['aqarname'] ?? null;
            $ownerId = !empty($propertyRow['ownerid']) ? (int)$propertyRow['ownerid'] : null;
            $propertyStmt->close();
        }

        $subPropertyName = null;
        if ($subaqarId) {
            $subStmt = $this->db->prepare("SELECT rakam AS aqarname FROM amlakdetails WHERE idsubaqar = ? LIMIT 1");
            if ($subStmt) {
                $subStmt->bind_param('i', $subaqarId);
                $subStmt->execute();
                $subRow = $subStmt->get_result()->fetch_assoc();
                $subPropertyName = $subRow['aqarname'] ?? null;
                $subStmt->close();
            }
        }

        $costCenterResult = $this->accountingManager->ensurePropertyCostCenter($aqarId, $propertyName ?: ('عقار رقم ' . $aqarId), $subaqarId);

        return [
            'aqar_id' => $aqarId,
            'subaqar_id' => $subaqarId,
            'property_name' => $propertyName,
            'owner_id' => $ownerId,
            'sub_property_name' => $subPropertyName,
            'cost_center_id' => $costCenterResult['success'] ? ($costCenterResult['cost_center']['cost_center_id'] ?? null) : null,
            'cost_center_message' => $costCenterResult['success'] ? null : ($costCenterResult['message'] ?? null)
        ];
    }

    private function resolveSanadContext($sanad) {
        $context = [
            'tenant_id' => !empty($sanad['mostagerid']) ? (int)$sanad['mostagerid'] : null,
            'owner_id' => !empty($sanad['malekid']) ? (int)$sanad['malekid'] : null,
            'aqar_id' => !empty($sanad['idaqar']) ? (int)$sanad['idaqar'] : null,
            'subaqar_id' => !empty($sanad['idsubaqar']) ? (int)$sanad['idsubaqar'] : null,
            'egar_id' => null,
            'invoice_id' => null,
            'property_name' => null,
            'cost_center_id' => null
        ];

        if (!empty($sanad['egarid'])) {
            $context['egar_id'] = (int)$sanad['egarid'];
        }

        if (empty($context['egar_id']) && !empty($sanad['invoice_id'])) {
            $context['invoice_id'] = (int)$sanad['invoice_id'];
        }

        if ($context['egar_id']) {
            $stmt = $this->db->prepare("SELECT e.rakam3akdid, e.mostagerid, d.idaqar, d.idsubaqar FROM egar e
                LEFT JOIN amlakdetails d ON d.rakam3akdid=e.rakam3akdid WHERE e.rakam3akdid = ? LIMIT 1");
            if ($stmt) {
                $stmt->bind_param('i', $context['egar_id']);
                $stmt->execute();
                $egar = $stmt->get_result()->fetch_assoc();
                $stmt->close();

                if ($egar) {
                    $context['tenant_id'] = $context['tenant_id'] ?: (!empty($egar['mostagerid']) ? (int)$egar['mostagerid'] : null);
                    $context['aqar_id'] = $context['aqar_id'] ?: (!empty($egar['idaqar']) ? (int)$egar['idaqar'] : null);
                    $context['subaqar_id'] = $context['subaqar_id'] ?: (!empty($egar['idsubaqar']) ? (int)$egar['idsubaqar'] : null);
                }
            }
        }

        if (!$context['egar_id'] && !empty($sanad['kastid'])) {
            $installmentId = (int)$sanad['kastid'];
            if ($installmentId > 0) {
                $stmt = $this->db->prepare("SELECT e.rakam3akdid, e.mostagerid, d.idaqar, d.idsubaqar
                    FROM aksat k
                    INNER JOIN egar e ON e.rakam3akdid=k.egar_id
                    LEFT JOIN amlakdetails d ON d.idsubaqar=ABS(k.idsubaqar)
                    WHERE k.kastid=? LIMIT 1");
                if ($stmt) {
                    $stmt->bind_param('i', $installmentId);
                    $stmt->execute();
                    $egar = $stmt->get_result()->fetch_assoc();
                    $stmt->close();
                    if ($egar) {
                        $context['egar_id'] = (int)$egar['rakam3akdid'];
                        $context['tenant_id'] = $context['tenant_id'] ?: (!empty($egar['mostagerid']) ? (int)$egar['mostagerid'] : null);
                        $context['aqar_id'] = $context['aqar_id'] ?: (!empty($egar['idaqar']) ? (int)$egar['idaqar'] : null);
                        $context['subaqar_id'] = $context['subaqar_id'] ?: (!empty($egar['idsubaqar']) ? (int)$egar['idsubaqar'] : null);
                    }
                }
            }
        }

        if (!$context['egar_id'] && !$context['aqar_id'] && !$context['tenant_id']) {
            $referenceText = trim((string)($sanad['mybyan'] ?? ''));
            // Only a bare contract number; a description that starts with digits is not one.
            if ($referenceText !== '' && ctype_digit($referenceText)) {
                $stmt = $this->db->prepare("SELECT e.rakam3akdid, e.mostagerid, d.idaqar, d.idsubaqar FROM egar e
                    LEFT JOIN amlakdetails d ON d.rakam3akdid=e.rakam3akdid WHERE e.rakam3akd = ? OR e.rakam3akdid = ? LIMIT 1");
                if ($stmt) {
                    $numericReference = (int)$referenceText;
                    $stmt->bind_param('si', $referenceText, $numericReference);
                    $stmt->execute();
                    $egar = $stmt->get_result()->fetch_assoc();
                    $stmt->close();
                    if ($egar) {
                        $context['egar_id'] = (int)$egar['rakam3akdid'];
                        $context['tenant_id'] = !empty($egar['mostagerid']) ? (int)$egar['mostagerid'] : null;
                        $context['aqar_id'] = !empty($egar['idaqar']) ? (int)$egar['idaqar'] : null;
                        $context['subaqar_id'] = !empty($egar['idsubaqar']) ? (int)$egar['idsubaqar'] : null;
                    }
                }
            }
        }

        $propertyContext = $this->buildPropertyContext($context['aqar_id'], $context['subaqar_id']);
        $context['property_name'] = $propertyContext['property_name'];
        $context['cost_center_id'] = $propertyContext['cost_center_id'];
        $context['owner_id'] = $context['owner_id'] ?: $propertyContext['owner_id'];

        // Allocate only when a contract identifies exactly one invoice.
        if (!$context['invoice_id'] && $context['egar_id']) {
            $invoices=receiptCommissionRows($this->db,'SELECT invoice_id FROM acc_invoices WHERE egar_id=? ORDER BY invoice_id LIMIT 2',[(int)$context['egar_id']]);
            if (count($invoices)===1) $context['invoice_id']=(int)$invoices[0]['invoice_id'];
        }
        return $context;
    }

    /**
     * Create invoice from rental contract (egar)
     * إنشاء فاتورة من عقد الإيجار
     */
    public function createInvoiceFromEgar($egarId) {
        // Get contract details
        $egarQuery = "SELECT e.*, m.mostagername, m.mostagervatnumber,
                      ad.aqarname, a.aqarname as main_aqar
                      FROM egar e
                      LEFT JOIN mostagereen m ON e.mostagerid = m.mostagerid
                      LEFT JOIN amlakdetails ad ON e.idsubaqar = ad.idsubaqar
                      LEFT JOIN amlak a ON e.idaqar = a.idaqar
                      WHERE e.rakam3akdid = ?";
        $stmt = $this->db->prepare($egarQuery);
        $stmt->bind_param('i', $egarId);
        $stmt->execute();
        $egar = $stmt->get_result()->fetch_assoc();

        if (!$egar) {
            return ['success' => false, 'message' => 'Contract not found'];
        }

        if (!empty($egar['invoice_id'])) {
            $invoiceCheck = $this->db->prepare("SELECT invoice_id, invoice_number FROM acc_invoices WHERE invoice_id=? LIMIT 1");
            if ($invoiceCheck) {
                $invoiceId = (int)$egar['invoice_id'];
                $invoiceCheck->bind_param('i', $invoiceId);
                $invoiceCheck->execute();
                $existingInvoice = $invoiceCheck->get_result()->fetch_assoc();
                $invoiceCheck->close();
                if ($existingInvoice) {
                    return [
                        'success' => true,
                        'existing' => true,
                        'invoice_id' => (int)$existingInvoice['invoice_id'],
                        'invoice_number' => $existingInvoice['invoice_number']
                    ];
                }
            }
        }

        $invoiceByContract = $this->db->prepare("SELECT invoice_id, invoice_number FROM acc_invoices WHERE egar_id=? ORDER BY invoice_id LIMIT 1");
        if ($invoiceByContract) {
            $invoiceByContract->bind_param('i', $egarId);
            $invoiceByContract->execute();
            $existingInvoice = $invoiceByContract->get_result()->fetch_assoc();
            $invoiceByContract->close();
            if ($existingInvoice) {
                $updateContract = $this->db->prepare("UPDATE egar SET invoice_id=? WHERE rakam3akdid=?");
                if ($updateContract) {
                    $existingInvoiceId = (int)$existingInvoice['invoice_id'];
                    $updateContract->bind_param('ii', $existingInvoiceId, $egarId);
                    $updateContract->execute();
                    $updateContract->close();
                }
                return [
                    'success' => true,
                    'existing' => true,
                    'invoice_id' => (int)$existingInvoice['invoice_id'],
                    'invoice_number' => $existingInvoice['invoice_number']
                ];
            }
        }

        $propertyContext = $this->buildPropertyContext($egar['idaqar'] ?? 0, $egar['idsubaqar'] ?? null);
        $salesJournalId = $this->accountingManager->getDefaultJournalIdByCode('SAL');
        $customer=$this->syncMostagerAsCustomer((int)$egar['mostagerid']);
        if (empty($customer['success'])) return $customer;

        // Calculate amounts
        $annualPrice = $egar['annualprice'] ?? 0;
        $subtotal = $annualPrice / 1.15; // Remove VAT
        $vatAmount = $annualPrice - $subtotal;

        // Prepare invoice data
        $invoiceData = [
            'invoice_type' => 'standard',
            'customer_type' => 'tenant',
            'customer_id' => (int)$customer['customer_id'],
            'customer_name' => $egar['mostagername'] ?? 'مستأجر',
            'customer_vat_number' => $egar['mostagervatnumber'] ?? null,
            'customer_address' => null,
            'invoice_date' => date('Y-m-d'),
            'due_date' => $this->timestampDate($egar['endegar'] ?? 0),
            'payment_method' => 'bank_transfer',
            'notes' => "إيجار {$egar['aqarname']} - عقد رقم {$egar['rakam3akdid']}",
            'journal_id' => $salesJournalId,
            'tenant_id' => $egar['mostagerid'] ?? null,
            'owner_id' => $propertyContext['owner_id'],
            'aqar_id' => $propertyContext['aqar_id'],
            'subaqar_id' => $propertyContext['subaqar_id'],
            'egar_id' => $egarId,
            'cost_center_id' => $propertyContext['cost_center_id']
        ];

        // Prepare items
        $items = [
            [
                'description' => "إيجار {$egar['aqarname']} - عقد {$egar['rakam3akdid']}",
                'quantity' => 1,
                'unit_price' => $subtotal,
                'vat_rate' => 15,
                'vat_amount' => $vatAmount,
                'total_amount' => $annualPrice
            ]
        ];

        // Create invoice
        $result = $this->accountingManager->createInvoice($invoiceData, $items);

        if ($result['success']) {
            // Update egar with invoice reference
            $updateQuery = "UPDATE egar SET invoice_id = ? WHERE rakam3akdid = ?";
            $stmt = $this->db->prepare($updateQuery);
            $stmt->bind_param('ii', $result['invoice_id'], $egarId);
            $stmt->execute();
        }

        return $result;
    }

    /**
     * A receipt is posted only by approving its invoice (approveReceiptInvoice).
     * Salesman payouts call this to make sure the receipt is already posted.
     */
    public function createEntryFromSanad($sanadId) {
        try {
            $existing = $this->sourceEntry('sanad_id', (int)$sanadId, 'sanad');
            if ($existing) return ['success' => true, 'existing' => true, 'entry_id' => (int)$existing['entry_id'], 'entry_number' => $existing['entry_number']];
            return ['success' => false, 'message' => 'اعتمد فاتورة سند القبض #' . (int)$sanadId . ' أولاً.'];
        } catch (Throwable $error) {
            return ['success' => false, 'message' => $error instanceof RuntimeException ? $error->getMessage() : 'تعذر التحقق من قيد السند.'];
        }
    }

    /** $editor receives the default lines and returns the lines to post; false returns them without posting. */
    private function buildEntryFromSanad($sanadId, $invoiceId, $editor = null) {
        $sanadId = (int)$sanadId;
        $existingEntry = $this->sourceEntry('sanad_id', $sanadId, 'sanad');
        if ($existingEntry) {
            return [
                'success' => true,
                'existing' => true,
                'entry_id' => (int)$existingEntry['entry_id'],
                'entry_number' => $existingEntry['entry_number']
            ];
        }

        $sanadQuery = "SELECT s.*, COALESCE(b.ownerid2,0) AS bank_owner_id
                       FROM sanad s
                       LEFT JOIN bankacounts b ON b.id=s.bankid
                       WHERE s.idsanad=? LIMIT 1";
        $stmt = $this->db->prepare($sanadQuery);
        $stmt->bind_param('i', $sanadId);
        $stmt->execute();
        $sanad = $stmt->get_result()->fetch_assoc();
        $stmt->close();

        if (!$sanad) {
            return ['success' => false, 'message' => 'Voucher not found'];
        }

        $sanadContext = $this->resolveSanadContext($sanad);
        $sanadContext['invoice_id'] = (int)$invoiceId;
        $receiptJournalId = $this->accountingManager->getDefaultJournalIdByCode('REC');

        // Get the correct amount - try multiple fields
        $amount = 0;
        if (!empty($sanad['depositeamount'])) {
            $amount = floatval($sanad['depositeamount']);
        } elseif (!empty($sanad['price'])) {
            $amount = floatval($sanad['price']);
        } elseif (!empty($sanad['mablagh'])) {
            $amount = floatval($sanad['mablagh']);
        }

        // Validate amount
        if ($amount <= 0) {
            return ['success' => false, 'message' => 'Invalid amount in voucher'];
        }

        $sanadDate = $this->timestampDate($sanad['sanaddate'] ?? 0);

        // Prepare journal entry
        $entryData = [
            'entry_date' => $sanadDate,
            'entry_type' => 'receipt',
            'journal_id' => $receiptJournalId,
            'tenant_id' => $sanadContext['tenant_id'],
            'owner_id' => $sanadContext['owner_id'],
            'aqar_id' => $sanadContext['aqar_id'],
            'subaqar_id' => $sanadContext['subaqar_id'],
            'egar_id' => $sanadContext['egar_id'],
            'sanad_id' => $sanadId,
            'invoice_id' => $sanadContext['invoice_id'],
            'sales_representative_userid' => ($sanad['sales_commission_type'] ?? '')!=='split' && !empty($sanad['sales_representative_userid'])
                ? (int)$sanad['sales_representative_userid'] : null,
            'reference_type' => 'sanad',
            'reference_id' => $sanadId,
            'description' => $sanad['mybyan'] ?? "سند قبض رقم " . ($sanad['sanadrakam'] ?? $sanadId),
            'status' => 'posted'
        ];

        $cashAccountId = $this->accountId('default_receipt_cash_account_id', '1111');
        $bankAccountId = $this->accountId('default_receipt_bank_account_id', '1112');
        $ownerFundsAccountId = $this->accountId('default_owner_funds_clearing_account_id', '1130');
        $receivableAccountId = $this->accountId('default_receivable_account_id', '1121');

        // Determine payment account based on type
        $sanadType = (int)($sanad['payment_type'] ?? 0);
        $isOwnerBank = (int)($sanad['bank_owner_id'] ?? 0) > 0;
        $usesBank = (int)($sanad['bankid'] ?? 0) > 0 || in_array($sanadType, [2, 4, 5], true);
        $paymentAccountId = $isOwnerBank ? $ownerFundsAccountId : ($usesBank ? $this->bankLedgerAccount($sanad['bankid'] ?? 0, $bankAccountId) : $cashAccountId);
        if ($paymentAccountId <= 0 || $receivableAccountId <= 0) {
            return ['success' => false, 'message' => 'حسابات المقبوضات أو ذمم المستأجرين غير مهيأة.'];
        }

        $description = $sanad['mybyan'] ?? 'دفعة';

        $lines = [
            [
                'key' => 'cash',
                'account_id' => $paymentAccountId,
                'description' => "استلام دفعة - {$description}",
                'debit_amount' => $amount,
                'credit_amount' => 0,
                'cost_center_id' => $sanadContext['cost_center_id']
            ],
            [
                'key' => 'receivable',
                'account_id' => $receivableAccountId,
                'description' => "تسديد - {$description}",
                'debit_amount' => 0,
                'credit_amount' => $amount,
                'cost_center_id' => $sanadContext['cost_center_id']
            ]
        ];

        $commissionShares = receiptCommissionLoad($this->db,$sanad);
        foreach ($commissionShares as $shareIndex => $commissionShare) {
            $commissionAmount = max(0,round((float)$commissionShare['commission_amount'],2));
            if ($commissionAmount<=0 || empty($commissionShare['representative_userid'])) continue;
            $commissionExpenseId = $this->accountId('default_sales_commission_expense_account_id', '5120');
            $commissionPayableId = $this->accountId('default_sales_commission_payable_account_id', '2112');
            if ($commissionExpenseId <= 0 || $commissionPayableId <= 0) {
                return ['success' => false, 'message' => 'حسابات عمولة مندوب المبيعات غير مهيأة.'];
            }
            $representativeLabel = 'عمولة مندوب #' . (int)$commissionShare['representative_userid']
                . ' / سند #' . $sanadId . ' / حصة #' . (int)($commissionShare['split_id'] ?? 0);
            $lines[] = [
                'key' => 'cexp' . $shareIndex,
                'account_id' => $commissionExpenseId,
                'description' => $representativeLabel,
                'debit_amount' => $commissionAmount,
                'credit_amount' => 0,
                'cost_center_id' => $sanadContext['cost_center_id']
            ];
            $lines[] = [
                'key' => 'cpay' . $shareIndex,
                'account_id' => $commissionPayableId,
                'description' => 'عمولة مستحقة - ' . $representativeLabel,
                'debit_amount' => 0,
                'credit_amount' => $commissionAmount,
                'cost_center_id' => $sanadContext['cost_center_id']
            ];
        }

        if ($editor === false) return ['success' => true, 'lines' => $lines];
        if ($editor) $lines = $editor($lines);
        return $this->accountingManager->createJournalEntry($entryData, $lines);
    }

    /**
     * Create journal entry from expense (masrofat)
     * إنشاء قيد من المصروفات
     */
    public function createEntryFromMasrofat($masrofatId) {
        try {
            $sourceExpense=receiptCommissionRows($this->db,'SELECT * FROM masrofat WHERE idmasrof=?',array((int)$masrofatId));
            if ($this->depositOfExpense($masrofatId)) return ['success'=>false,'message'=>'المصروف تابع لتسوية تأمين وترحّله مزامنة تسويات التأمين.'];
            if (!amlakSyncIsInPeriod($this->db, $sourceExpense[0]['payeddate'] ?? 0)) throw new RuntimeException('تاريخ الحركة يسبق تاريخ بدء المزامنة.');
            if (!empty($sourceExpense[0]['commission_split_id'])) {
                $share=receiptCommissionRows($this->db,'SELECT c.idsanad,s.sanaddate FROM sanad_commission_splits c
                    JOIN sanad s ON s.idsanad=c.idsanad WHERE c.split_id=?',
                    array((int)$sourceExpense[0]['commission_split_id']));
                if (!$share) return ['success'=>false,'message'=>'حصة عمولة المصروف غير موجودة.'];
                // Finish receipt accrual before starting the payout transaction. An older
                // receipt's payable is part of the opening entry, so it is not accrued here.
                if (amlakSyncIsInPeriod($this->db, $share[0]['sanaddate'])) {
                    $accrual=$this->createEntryFromSanad((int)$share[0]['idsanad']);
                    if (empty($accrual['success'])) return $accrual;
                }
            }
            $this->db->begin_transaction();
            receiptCommissionRows($this->db,'SELECT idmasrof FROM masrofat WHERE idmasrof=? FOR UPDATE',array((int)$masrofatId));
            $result=$this->buildEntryFromMasrofat($masrofatId);
            if (!empty($result['success'])) {
                receiptCommissionQuery($this->db,'UPDATE masrofat SET accounting_entry_id=? WHERE idmasrof=?',
                    array((int)$result['entry_id'],(int)$masrofatId))->close();
                $this->db->commit();
            } else $this->db->rollback();
            return $result;
        } catch (Throwable $error) {
            $this->db->rollback();
            error_log('Expense accounting sync: '.$error->getMessage());
            return ['success'=>false,'message'=>$error instanceof RuntimeException ? $error->getMessage() : 'تعذر ترحيل مصروف المكتب. راجع سجل الخادم.'];
        }
    }

    private function buildEntryFromMasrofat($masrofatId) {
        $masrofatId = (int)$masrofatId;
        $existingEntry = $this->sourceEntry('masrofat_id', $masrofatId, 'masrofat');
        if (!$existingEntry) {
            $existingEntry = $this->sourceEntry('masrofat_id', $masrofatId, 'office_expense');
        }
        if ($existingEntry) {
            return [
                'success' => true,
                'existing' => true,
                'entry_id' => (int)$existingEntry['entry_id'],
                'entry_number' => $existingEntry['entry_number']
            ];
        }

        $masrofatQuery = "SELECT m.*, c.masrofkind AS category_name
                           FROM masrofat m
                           LEFT JOIN masrofattakweed c ON c.idmasrofcod=m.idmasrofcod
                           WHERE m.fund_source=0 AND m.idmasrof=? LIMIT 1";
        $stmt = $this->db->prepare($masrofatQuery);
        $stmt->bind_param('i', $masrofatId);
        $stmt->execute();
        $masrofat = $stmt->get_result()->fetch_assoc();
        $stmt->close();

        if (!$masrofat) {
            return ['success' => false, 'error' => 'Expense not found'];
        }

        if ((int)($masrofat['idaqar'] ?? 0) < 0) return ['success' => false, 'message' => 'مصروف عقار تمت تصفيته بالطريقة القديمة؛ راجعه يدوياً.'];
        $propertyContext = $this->buildPropertyContext($masrofat['idaqar'] ?? 0, $masrofat['idsubaqar'] ?? null);
        $paymentJournalId = $this->accountingManager->getDefaultJournalIdByCode('PAY');

        $amount = max(0, round((float)($masrofat['amount'] ?? 0), 2));
        if ($amount <= 0) {
            return ['success' => false, 'message' => 'مبلغ المصروف غير صحيح'];
        }
        $description = trim((string)($masrofat['payeddue'] ?? ''));
        if ($description === '') {
            $description = trim((string)($masrofat['category_name'] ?? '')) ?: ('مصروف رقم ' . $masrofatId);
        }
        $referenceType = (int)($masrofat['idaqar'] ?? 0) > 0 ? 'masrofat' : 'office_expense';

        // Prepare journal entry
        $entryData = [
            'entry_date' => $this->timestampDate($masrofat['payeddate'] ?? 0),
            'entry_type' => 'expense',
            'journal_id' => $paymentJournalId,
            'owner_id' => $propertyContext['owner_id'],
            'aqar_id' => $propertyContext['aqar_id'],
            'subaqar_id' => $propertyContext['subaqar_id'],
            'masrofat_id' => $masrofatId,
            'reference_type' => $referenceType,
            'reference_id' => $masrofatId,
            'description' => $description,
            'status' => 'posted'
        ];

        $paymentMethod=(int)($masrofat['payment_type'] ?? 1);
        if ((int)($masrofat['idaqar'] ?? 0)===0 && expensePaymentVoucherReady($this->db)) {
            $paymentVouchers=receiptCommissionRows($this->db,'SELECT id,payment_type,chekorcash,vat,suppliervatnumber FROM payment_voucher WHERE expense_id=? FOR UPDATE',array($masrofatId));
            if ($paymentVouchers) {
                $voucher=$paymentVouchers[0];
                if (!empty($masrofat['payment_voucher_id']) && (int)$masrofat['payment_voucher_id']!==(int)$voucher['id']) {
                    throw new RuntimeException('ربط سند الصرف بالمصروف غير متطابق.');
                }
                $paymentMethod=(int)($voucher['payment_type'] ?: $voucher['chekorcash']);
            } elseif (!empty($masrofat['payment_voucher_id'])) {
                throw new RuntimeException('سند صرف المصروف المرتبط غير موجود.');
            }
        }
        if (!in_array($paymentMethod,[1,2,3,4,5],true)) throw new RuntimeException('طريقة دفع المصروف غير صحيحة؛ صحح سند الصرف قبل الترحيل.');
        $usesBank=(int)($masrofat['bankid'] ?? 0)>0 || in_array($paymentMethod,[2,4,5],true);
        $paymentAccountId=$usesBank ? $this->accountId('default_payment_bank_account_id','1112')
            : $this->accountId('default_payment_cash_account_id','1111');
        $expenseAccountId = $this->accountId('default_expense_account_id', '5190');
        // The office pays a property expense on the owner's behalf, unless it owns the property.
        if ((int)($masrofat['idaqar'] ?? 0) > 0) {
            $expenseProperty = receiptCommissionRows($this->db, 'SELECT * FROM amlak WHERE idaqar=?', [(int)$masrofat['idaqar']])[0] ?? null;
            if (!$expenseProperty) return ['success' => false, 'message' => 'عقار المصروف غير موجود.'];
            if (($expenseProperty['rent_income_to'] ?? 'owner') !== 'office') $expenseAccountId = $this->receiptInvoiceSettingId('default_owner_recoverable_account_id', 'مصروفات مستردة من الملاك');
        }
        // Input VAT only with a supplier VAT number; otherwise it stays part of the cost.
        $inputVat = 0;
        if (!empty($paymentVouchers) && trim((string)$paymentVouchers[0]['suppliervatnumber']) !== '' && empty($masrofat['commission_split_id'])) {
            $inputVat = round((float)$paymentVouchers[0]['vat'], 2);
            if ($inputVat < 0 || $inputVat >= $amount) return ['success' => false, 'message' => 'ضريبة سند الصرف غير صحيحة.'];
        }
        if ((int)($masrofat['idaqar'] ?? 0) === 0 && strpos((string)($masrofat['category_name'] ?? ''), 'رواتب') !== false) {
            $salaryAccountId = $this->accountId('default_salary_expense_account_id', '5110');
            if ($salaryAccountId > 0) {
                $expenseAccountId = $salaryAccountId;
            }
        }
        if (!empty($masrofat['commission_split_id'])) {
            $commissionPayout = receiptCommissionRows($this->db,'SELECT c.idsanad,c.representative_userid,s.sanaddate
                FROM sanad_commission_splits c JOIN sanad s ON s.idsanad=c.idsanad WHERE c.split_id=?',array((int)$masrofat['commission_split_id']));
            if (!$commissionPayout) return ['success'=>false,'message'=>'حصة عمولة المصروف غير موجودة.'];
            if (amlakSyncIsInPeriod($this->db, $commissionPayout[0]['sanaddate'])
                && !$this->sourceEntry('sanad_id',(int)$commissionPayout[0]['idsanad'],'sanad')) {
                return ['success'=>false,'message'=>'يجب ترحيل استحقاق العمولة قبل تسويتها.'];
            }
            $expenseAccountId = $this->accountId('default_sales_commission_payable_account_id','2112');
            $entryData['sales_representative_userid'] = (int)$commissionPayout[0]['representative_userid'];
            $entryData['description'] = 'تسوية عمولة سند #' . (int)$commissionPayout[0]['idsanad'] . ' - ' . $description;
        }
        if ($paymentAccountId <= 0 || $expenseAccountId <= 0) {
            return ['success' => false, 'message' => 'حساب المصروفات أو حساب الدفع غير مهيأ.'];
        }

        $lines = [
            [
                'account_id' => $expenseAccountId,
                'description' => $description,
                'debit_amount' => round($amount - $inputVat, 2),
                'credit_amount' => 0,
                'cost_center_id' => $propertyContext['cost_center_id']
            ],
            [
                'account_id' => $paymentAccountId,
                'description' => "صرف - {$description}",
                'debit_amount' => 0,
                'credit_amount' => $amount,
                'cost_center_id' => $propertyContext['cost_center_id']
            ]
        ];
        if ($inputVat > 0) {
            $lines[] = ['account_id' => $this->receiptInvoiceSettingId('default_input_vat_account_id', 'ضريبة المدخلات'), 'description' => "ضريبة مدخلات - {$description}",
                'debit_amount' => $inputVat, 'credit_amount' => 0, 'cost_center_id' => $propertyContext['cost_center_id']];
        }

        return $this->accountingManager->createJournalEntry($entryData, $lines);
    }

    /**
     * Create a journal entry for a rent collection delivered to the owner.
     * Office-funded settlements credit cash/bank.  Collections already held
     * in an owner's bank account credit the owner-held collections clearing
     * account, so no office cash is invented.
     */
    public function createEntryFromSanadsarf($sanadsarfId) {
        try {
            $this->db->begin_transaction();
            $lockedSettlement=receiptCommissionRows($this->db,'SELECT sanadid,sanadate FROM sanadsarf WHERE sanadid=? FOR UPDATE',[(int)$sanadsarfId]);
            if (!amlakSyncIsInPeriod($this->db, $lockedSettlement[0]['sanadate'] ?? 0)) throw new RuntimeException('تاريخ الحركة يسبق تاريخ بدء المزامنة.');
            $result=$this->buildEntryFromSanadsarf($sanadsarfId);
            if (!empty($result['success'])) {
                receiptCommissionQuery($this->db,'UPDATE sanadsarf SET accounting_entry_id=? WHERE sanadid=?',[(int)$result['entry_id'],(int)$sanadsarfId])->close();
                $this->db->commit();
            } else $this->db->rollback();
            return $result;
        } catch (Throwable $error) {
            $this->db->rollback();
            error_log('Owner settlement sync: '.$error->getMessage());
            return ['success'=>false,'message'=>$error instanceof RuntimeException ? $error->getMessage() : 'تعذر ترحيل سند التسليم.'];
        }
    }

    private function buildEntryFromSanadsarf($sanadsarfId) {
        $sanadsarfId = (int)$sanadsarfId;
        $existingEntry = $this->sourceEntry('sanadsarf_id', $sanadsarfId, 'sanadsarf');
        if ($existingEntry) {
            return [
                'success' => true,
                'existing' => true,
                'entry_id' => (int)$existingEntry['entry_id'],
                'entry_number' => $existingEntry['entry_number']
            ];
        }

        $stmt = $this->db->prepare("SELECT ss.*, e.mostagerid, e.idsubaqar AS eradat_subaqar
            FROM sanadsarf ss
            LEFT JOIN eradat e ON e.iderad=ss.iderad
            WHERE ss.sanadid=? AND ss.aqarid>0 AND ss.iderad>0 LIMIT 1");
        if (!$stmt) {
            return ['success' => false, 'message' => 'تعذر قراءة سند التسليم.'];
        }
        $stmt->bind_param('i', $sanadsarfId);
        $stmt->execute();
        $voucher = $stmt->get_result()->fetch_assoc();
        $stmt->close();
        if (!$voucher) {
            return ['success' => false, 'message' => 'سند التسليم غير موجود أو ليس مرتبطاً بتحصيل إيجار.'];
        }

        $amount = max(0, round((float)($voucher['amount'] ?? 0), 2));
        if ($amount <= 0) {
            return ['success' => false, 'message' => 'مبلغ سند التسليم غير صحيح.'];
        }

        $subaqarId = !empty($voucher['idsubaqar']) ? (int)$voucher['idsubaqar'] : (int)($voucher['eradat_subaqar'] ?? 0);
        $propertyContext = $this->buildPropertyContext((int)$voucher['aqarid'], $subaqarId ?: null);
        $settlementProperty = receiptCommissionRows($this->db, 'SELECT * FROM amlak WHERE idaqar=?', [(int)$voucher['aqarid']])[0] ?? null;
        $settlementIncome = receiptCommissionRows($this->db, 'SELECT * FROM eradat WHERE iderad=?', [(int)$voucher['iderad']])[0] ?? null;
        if (!$settlementProperty || !$settlementIncome) return ['success' => false, 'message' => 'عقار أو إيراد التسليم غير موجود.'];
        if (($settlementProperty['rent_income_to'] ?? 'owner') === 'office') return ['success' => false, 'message' => 'العقار مملوك للمكتب؛ لا يوجد تسليم لمالك.'];
        $settlementReceipt = receiptCommissionRows($this->db, 'SELECT idsanad,sanaddate FROM sanad WHERE idsanad=?', [(int)$settlementIncome['sanadrakam']])[0] ?? null;
        if ($settlementReceipt && amlakSyncIsInPeriod($this->db, $settlementReceipt['sanaddate'])
            && !$this->sourceEntry('sanad_id', (int)$settlementReceipt['idsanad'], 'sanad')) {
            return ['success' => false, 'message' => 'اعتمد فاتورة سند القبض #' . (int)$settlementReceipt['idsanad'] . ' أولاً.'];
        }
        $ownerShare = receiptDeliveryBreakdowns($this->db, [$settlementIncome], $settlementProperty)[(int)$voucher['iderad']];
        $depositCredit = $this->depositCreditOfDelivery($sanadsarfId);
        if ($depositCredit === null) return ['success' => false, 'message' => 'زامن تسوية التأمين المرتبطة بالتسليم أولاً.'];
        $deductedExpenses = round($ownerShare['owner_net'] + $depositCredit - $amount, 2);
        if ($deductedExpenses < -0.02) return ['success' => false, 'message' => 'مبلغ التسليم أكبر من المستحق للمالك حسب تفاصيل السند.'];
        $deductedExpenses = $deductedExpenses > 0.02 ? $deductedExpenses : 0;
        $settlementAccountId = $this->accountId('default_owner_payable_account_id', '2111');
        $cashAccountId = $this->accountId('default_payment_cash_account_id', '1111');
        $bankAccountId = $this->accountId('default_payment_bank_account_id', '1112');
        $ownerFundsAccountId = $this->accountId('default_owner_funds_clearing_account_id', '1130');
        $paymentType = (int)($voucher['payment_type'] ?? 0);
        $usesBank = (int)($voucher['bankid'] ?? 0) > 0 || in_array($paymentType, [2, 4, 5], true);
        $creditAccountId = (int)($voucher['money_source'] ?? 0) === 1
            ? $ownerFundsAccountId
            : ($usesBank ? $this->bankLedgerAccount($voucher['bankid'] ?? 0, $bankAccountId) : $cashAccountId);
        if ($settlementAccountId <= 0 || $creditAccountId <= 0) {
            return ['success' => false, 'message' => 'حسابات تسليم الملاك غير مهيأة.'];
        }

        $description = trim((string)($voucher['bayan'] ?? '')) ?: ('تسليم تحصيل للمالك #' . $sanadsarfId);
        $entryData = [
            'entry_date' => $this->timestampDate($voucher['sanadate'] ?? 0),
            'entry_type' => 'owner_settlement',
            'journal_id' => $this->accountingManager->getDefaultJournalIdByCode('PAY'),
            'tenant_id' => !empty($voucher['mostagerid']) ? (int)$voucher['mostagerid'] : null,
            'owner_id' => $propertyContext['owner_id'],
            'aqar_id' => $propertyContext['aqar_id'],
            'subaqar_id' => $propertyContext['subaqar_id'],
            'sanadsarf_id' => $sanadsarfId,
            'reference_type' => 'sanadsarf',
            'reference_id' => $sanadsarfId,
            'description' => $description,
            'status' => 'posted'
        ];
        $costCenter = $propertyContext['cost_center_id'];
        $fee = round($ownerShare['fee'], 2);
        $lines = [['account_id' => $settlementAccountId, 'description' => $description, 'debit_amount' => round($amount + $fee + $deductedExpenses, 2), 'credit_amount' => 0, 'cost_center_id' => $costCenter]];
        if ($fee > 0) $lines[] = ['account_id' => $this->receiptInvoiceSettingId('default_management_fee_account_id', 'إيراد أتعاب الإدارة'),
            'description' => 'أتعاب إدارة - ' . $description, 'debit_amount' => 0, 'credit_amount' => $fee, 'cost_center_id' => $costCenter];
        if ($deductedExpenses > 0) $lines[] = ['account_id' => $this->receiptInvoiceSettingId('default_owner_recoverable_account_id', 'مصروفات مستردة من الملاك'),
            'description' => 'مصروفات مخصومة - ' . $description, 'debit_amount' => 0, 'credit_amount' => $deductedExpenses, 'cost_center_id' => $costCenter];
        $lines[] = ['account_id' => $creditAccountId, 'description' => 'تسليم للمالك - ' . $description, 'debit_amount' => 0, 'credit_amount' => $amount, 'cost_center_id' => $costCenter];

        return $this->accountingManager->createJournalEntry($entryData, $lines);
    }

    /**
     * Sync property owner as customer
     * مزامنة مالك العقار كعميل
     */
    public function syncMalekAsCustomer($malekId) {
        // Get malek details
        $malekQuery = "SELECT * FROM malek WHERE malekid = ?";
        $stmt = $this->db->prepare($malekQuery);
        $stmt->bind_param('i', $malekId);
        $stmt->execute();
        $malek = $stmt->get_result()->fetch_assoc();

        if (!$malek) {
            return ['success' => false, 'message' => 'Owner not found'];
        }

        // Check if customer already exists
        $checkQuery = "SELECT customer_id FROM acc_customers WHERE customer_name = ?";
        $stmt = $this->db->prepare($checkQuery);
        $malekName = $malek['malekbayan1'] ?? 'مالك';
        $stmt->bind_param('s', $malekName);
        $stmt->execute();
        $existing = $stmt->get_result()->fetch_assoc();

        if ($existing) {
            return ['success' => true, 'customer_id' => $existing['customer_id'], 'message' => 'Customer already exists'];
        }

        // Create customer
        $insertQuery = "INSERT INTO acc_customers (customer_name, phone, address, is_active, created_at)
                       VALUES (?, ?, ?, 1, NOW())";
        $stmt = $this->db->prepare($insertQuery);
        $phone = $malek['malekbayan2'] ?? null; // malekbayan2 might be phone
        $address = $malek['malekbayan3'] ?? null; // malekbayan3 might be address
        $stmt->bind_param('sss', $malekName, $phone, $address);

        if ($stmt->execute()) {
            return ['success' => true, 'customer_id' => $this->db->insert_id];
        }

        return ['success' => false, 'message' => 'Failed to create customer: ' . $this->db->error];
    }

    /**
     * Sync tenant as customer
     * مزامنة المستأجر كعميل
     */
    public function syncMostagerAsCustomer($mostagerId) {
        if (!accountingCustomerLinksReady($this->db)) return ['success'=>false,'message'=>'افتح إدارة الأملاك لتثبيت ربط المستأجرين بعملاء المحاسبة.'];
        $mostagerId=(int)$mostagerId;
        $tenant=receiptCommissionRows($this->db,'SELECT * FROM mostagereen WHERE mostagerid=?',[$mostagerId]);
        if (!$tenant) return ['success'=>false,'message'=>'المستأجر غير موجود.'];
        $tenant=$tenant[0];
        $database=receiptCommissionRows($this->db,'SELECT DATABASE() db')[0]['db'];
        $lockName='acc-customer:'.substr(hash('sha256',$database.':'.$mostagerId),0,45);
        $lock=receiptCommissionRows($this->db,'SELECT GET_LOCK(?,5) acquired',[$lockName]);
        if (empty($lock[0]['acquired'])) return ['success'=>false,'message'=>'ربط العميل قيد المعالجة. حاول مجدداً.'];
        try {
            $this->db->begin_transaction();
            $linked=receiptCommissionRows($this->db,'SELECT c.customer_id FROM acc_customer_tenants t JOIN acc_customers c ON c.customer_id=t.customer_id WHERE t.tenant_id=? FOR UPDATE',[$mostagerId]);
            if ($linked) {
                $this->db->commit();
                return ['success'=>true,'customer_id'=>(int)$linked[0]['customer_id'],'existing'=>true];
            }
            $candidates=receiptCommissionRows($this->db,'SELECT customer_id FROM acc_customers WHERE customer_name=? ORDER BY customer_id LIMIT 2',[$tenant['mostagername']]);
            $customerId=0;
            if (count($candidates)===1) {
                $candidate=(int)$candidates[0]['customer_id'];
                foreach (accountingLegacyCustomerTenants($this->db,$candidate) as $possible) {
                    if ((int)$possible['tenant_id']===$mostagerId) $customerId=$candidate;
                }
                if (receiptCommissionRows($this->db,'SELECT tenant_id FROM acc_customer_tenants WHERE customer_id=? AND tenant_id<>?',[$candidate,$mostagerId])) $customerId=0;
            }
            if (!$customerId) {
                receiptCommissionQuery($this->db,'INSERT INTO acc_customers (customer_name,vat_number,phone,email,address,is_active,created_at) VALUES (?,?,?,?,?,1,NOW())',
                    [$tenant['mostagername'],$tenant['mostagervatnumber'] ?? null,$tenant['mostagerphone'] ?? null,$tenant['mostageremail'] ?? null,$tenant['mostageraddress'] ?? null])->close();
                $customerId=(int)$this->db->insert_id;
            }
            receiptCommissionQuery($this->db,'INSERT INTO acc_customer_tenants (tenant_id,customer_id) VALUES (?,?)',[$mostagerId,$customerId])->close();
            $this->db->commit();
            return ['success'=>true,'customer_id'=>$customerId];
        } catch (Throwable $error) {
            $this->db->rollback();
            error_log('Accounting customer link: '.$error->getMessage());
            return ['success'=>false,'message'=>'تعذر ربط المستأجر بعميل المحاسبة.'];
        } finally {
            receiptCommissionRows($this->db,'SELECT RELEASE_LOCK(?) released',[$lockName]);
        }
    }

    /**
     * Get property financial summary
     * ملخص مالي للعقار
     */
    public function getPropertyFinancialSummary($idaqar, $dateFrom = null, $dateTo = null) {
        if (!$dateFrom) $dateFrom = date('Y-01-01');
        if (!$dateTo) $dateTo = date('Y-m-d');
        $dateFromTimestamp = strtotime($dateFrom . ' 00:00:00');
        $dateToTimestamp = strtotime($dateTo . ' 23:59:59');

        // Get total rental income
        $incomeQuery = "SELECT SUM(annualprice) as total_income
                       FROM egar
                       WHERE idaqar = ?
                       AND (CASE WHEN startegar > 20000000000 THEN FLOOR(startegar / 1000) ELSE startegar END) BETWEEN ? AND ?";
        $stmt = $this->db->prepare($incomeQuery);
        $stmt->bind_param('iii', $idaqar, $dateFromTimestamp, $dateToTimestamp);
        $stmt->execute();
        $income = $stmt->get_result()->fetch_assoc();

        // Get total expenses
        $expenseQuery = "SELECT SUM(amount) as total_expense
                        FROM masrofat
                        WHERE idaqar = ?
                        AND payeddate BETWEEN ? AND ?";
        $stmt = $this->db->prepare($expenseQuery);
        $stmt->bind_param('iii', $idaqar, $dateFromTimestamp, $dateToTimestamp);
        $stmt->execute();
        $expense = $stmt->get_result()->fetch_assoc();

        $totalIncome = $income['total_income'] ?? 0;
        $totalExpense = $expense['total_expense'] ?? 0;
        $netIncome = $totalIncome - $totalExpense;

        return [
            'total_income' => $totalIncome,
            'total_expense' => $totalExpense,
            'net_income' => $netIncome,
            'date_from' => $dateFrom,
            'date_to' => $dateTo
        ];
    }
}
?>
