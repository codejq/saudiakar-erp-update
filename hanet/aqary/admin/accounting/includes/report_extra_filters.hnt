<?php
/** Unit and invoice filters shared by the dimension reports. Expects $dimensionOptions and $filters. */
?>
                <div class="col-md-3">
                    <label class="form-label">الوحدة</label>
                    <select class="form-select" name="subaqar_id">
                        <option value="">الكل</option>
                        <?php foreach ($dimensionOptions['units'] as $unit): ?>
                        <option value="<?php echo (int)$unit['unit_id']; ?>" <?php echo (int)($filters['subaqar_id'] ?? 0) === (int)$unit['unit_id'] ? 'selected' : ''; ?>>
                            <?php echo htmlspecialchars($unit['unit_name'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?>
                        </option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">الفاتورة</label>
                    <select class="form-select" name="invoice_id">
                        <option value="">الكل</option>
                        <?php foreach ($dimensionOptions['invoices'] as $invoiceOption): ?>
                        <option value="<?php echo (int)$invoiceOption['invoice_id']; ?>" <?php echo (int)($filters['invoice_id'] ?? 0) === (int)$invoiceOption['invoice_id'] ? 'selected' : ''; ?>>
                            <?php echo htmlspecialchars($invoiceOption['invoice_number'] . ' - ' . $invoiceOption['customer_name'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?>
                        </option>
                        <?php endforeach; ?>
                    </select>
                </div>
