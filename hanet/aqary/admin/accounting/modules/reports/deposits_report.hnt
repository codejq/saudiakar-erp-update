<?php
/** Tenant insurance: received, settled and still held, per contract. */
$sc_title = 'تأمينات المستأجرين';
$syncReport = [
    'key' => 'deposits', 'icon' => 'bi-shield-check', 'desc' => 'التأمين المحصل والمردود والتلفيات والمتبقي لكل عقد',
    'filters' => ['as_of', 'owner_id', 'aqar_id', 'subaqar_id', 'tenant_id', 'egar_id'],
    'selects' => ['state' => ['الحالة', ['held' => 'قائم', 'settled' => 'تمت التسوية']], 'holder' => ['التأمين لدى', ['office' => 'المكتب', 'owner' => 'المالك']]],
    'build' => function ($db, $f) {
        syncReportNeed(receiptSyncReady($db) && depositSettlementReady($db));
        $end = (int)strtotime($f['date_to'] . ' 23:59:59');
        $time = syncReportTime('s.sanaddate');
        // Receipts with a saved split are preferred; older income rows are used only for contracts without one.
        $rows = receiptCommissionRows($db, "SELECT x.*,p.ownerid,p.aqarname,p.rent_income_to,p.addtameento,d.rakam unit_name,COALESCE(NULLIF(t.mostagername,''),x.tenant_name) tenant_label,e.rakam3akd,
                ds.settlement_id,ds.insurance settled,ds.damages,ds.damages_to,ds.refund,ds.holder settled_holder,ds.settlement_date,ds.accounting_entry_id,je.entry_number
            FROM (
                SELECT g.egar_id,SUM(g.amount) received,MAX(g.source) source,COALESCE(MAX(d0.idaqar),0) property,g.unit,COALESCE(MAX(NULLIF(e0.mostagerid,0)),0) tenant,'' tenant_name
                FROM (
                    SELECT k.egar_id,SUM(c.insurance) amount,'receipts' source,MAX(ABS(k.idsubaqar)) unit FROM sanad_components c JOIN sanad s ON s.idsanad=c.idsanad
                        JOIN aksat k ON k.kastid=c.kastid WHERE c.insurance>0 AND k.egar_id>0 AND {$time}<={$end} GROUP BY k.egar_id
                    UNION ALL
                    SELECT k.egar_id,SUM(i.tamen),'income',MAX(ABS(k.idsubaqar)) FROM eradat i JOIN sanad s ON s.idsanad=CAST(i.sanadrakam AS UNSIGNED)
                        JOIN aksat k ON k.kastid=CAST(s.kastid AS UNSIGNED) WHERE i.tamen>0 AND k.egar_id>0 AND {$time}<={$end}
                        AND NOT EXISTS (SELECT 1 FROM sanad_components c2 JOIN aksat k2 ON k2.kastid=c2.kastid WHERE c2.insurance>0 AND k2.egar_id=k.egar_id) GROUP BY k.egar_id
                ) g LEFT JOIN egar e0 ON e0.rakam3akdid=g.egar_id LEFT JOIN amlakdetails d0 ON d0.idsubaqar=IF(g.unit>0,g.unit,(SELECT MIN(d9.idsubaqar) FROM amlakdetails d9 WHERE d9.rakam3akdid=g.egar_id))
                GROUP BY g.egar_id,g.unit
                UNION ALL
                SELECT z.egar_id,z.insurance,'contract',z.idaqar,z.idsubaqar,z.mostagerid,z.tenant_name FROM deposit_settlements z WHERE z.settlement_date<={$end}
                    AND NOT EXISTS (SELECT 1 FROM sanad_components c3 JOIN aksat k3 ON k3.kastid=c3.kastid WHERE c3.insurance>0 AND k3.egar_id=z.egar_id)
                    AND NOT EXISTS (SELECT 1 FROM aksat k4 JOIN sanad s4 ON CAST(s4.kastid AS UNSIGNED)=k4.kastid JOIN eradat i4 ON CAST(i4.sanadrakam AS UNSIGNED)=s4.idsanad WHERE i4.tamen>0 AND k4.egar_id=z.egar_id)
            ) x LEFT JOIN amlak p ON p.idaqar=x.property LEFT JOIN amlakdetails d ON d.idsubaqar=x.unit LEFT JOIN mostagereen t ON t.mostagerid=x.tenant LEFT JOIN egar e ON e.rakam3akdid=x.egar_id
            LEFT JOIN deposit_settlements ds ON ds.egar_id=x.egar_id AND ds.settlement_date<={$end} LEFT JOIN acc_journal_entries je ON je.entry_id=ds.accounting_entry_id
            ORDER BY p.aqarname,x.egar_id DESC");
        $sources = ['receipts' => 'تفاصيل السندات', 'income' => 'إيراد قديم', 'contract' => 'مؤكد عند التسوية'];
        $holders = ['office' => 'المكتب', 'owner' => 'المالك'];
        $list = [];
        $filterColumns = ['owner_id' => 'ownerid', 'aqar_id' => 'property', 'subaqar_id' => 'unit', 'tenant_id' => 'tenant', 'egar_id' => 'egar_id'];
        foreach ($rows as $row) {
            foreach ($filterColumns as $name => $column) if ($f[$name] && (int)$row[$column] !== $f[$name]) continue 2;
            $done = (int)$row['settlement_id'] > 0;
            $holder = $done ? $row['settled_holder'] : depositHolder($row);
            if (($f['state'] !== '' && $f['state'] !== ($done ? 'settled' : 'held')) || ($f['holder'] !== '' && $f['holder'] !== $holder)) continue;
            $list[] = ['contract' => [$row['rakam3akd'] !== '' && $row['rakam3akd'] !== null ? $row['rakam3akd'] : '#' . $row['egar_id'], '/aqary/admin/accounting/modules/journal_entries/index.hnt?egar_id=' . (int)$row['egar_id']],
                'tenant' => $row['tenant_label'], 'property' => $row['aqarname'], 'unit' => $row['unit_name'], 'holder' => $holders[$holder] ?? $holder, 'source' => $sources[$row['source']] ?? '',
                'received' => $row['received'], 'refund' => $row['refund'] ?? 0, 'damages' => $row['damages'] ?? 0,
                'damages_to' => $done && (float)$row['damages'] > 0 ? ($holders[$row['damages_to']] ?? '') : '', 'held' => (float)$row['received'] - (float)($row['refund'] ?? 0) - (float)($row['damages'] ?? 0),
                'settled' => $done ? syncReportDay($row['settlement_date']) : '', 'entry' => $row['entry_number'] ? [$row['entry_number'], '/aqary/admin/accounting/modules/journal_entries/index.hnt?entry_id=' . (int)$row['accounting_entry_id']] : '',
                'state' => $done ? ['تمت التسوية', 'success'] : ['قائم', 'warning'], 'office' => $holder === 'office'];
        }
        $account = syncReportAccount($db, 'default_deposits_account_id', 'تأمينات المستأجرين');
        $ledger = (float)receiptCommissionRows($db, "SELECT COALESCE(SUM(l.credit_amount-l.debit_amount),0) t FROM acc_journal_entry_lines l JOIN acc_journal_entries je ON je.entry_id=l.entry_id
            WHERE je.status='posted' AND je.entry_date<=? AND l.account_id=?", [$f['date_to'], $account])[0]['t'];
        $held = function ($office) use ($list) { return (float)array_sum(array_map(function ($row) use ($office) { return $row['office'] === $office ? $row['held'] : 0; }, $list)); };
        return ['columns' => ['contract' => ['العقد', 'text'], 'tenant' => ['المستأجر', 'text'], 'property' => ['العقار', 'text'], 'unit' => ['الوحدة', 'text'], 'holder' => ['لدى', 'text'], 'source' => ['مصدر المبلغ', 'text'],
            'received' => ['المحصل', 'money', true], 'refund' => ['المردود', 'money', true], 'damages' => ['التلفيات', 'money', true], 'damages_to' => ['التلفيات لصالح', 'text'], 'held' => ['المتبقي', 'money', true],
            'settled' => ['تاريخ التسوية', 'date'], 'entry' => ['القيد', 'text'], 'state' => ['الحالة', 'badge']], 'rows' => $list,
            'cards' => ['قائم لدى المكتب' => $held(true), 'قائم لدى الملاك' => $held(false), 'رصيد حساب التأمينات (كل العقارات)' => $ledger],
            'notes' => ['رصيد الحساب يشمل القيود المرحّلة فقط، وقد يختلف عن القائم بسبب تأمينات قديمة قبل بدء المزامنة أو سندات لم تعتمد بعد.']];
    },
];
require __DIR__ . '/../../includes/sync_report_page.hnt';
