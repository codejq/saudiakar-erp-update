<?php
/** What each receipt contains, and where it stands in accounting. */
$sc_title = 'تفصيل سندات القبض';
$syncReport = [
    'key' => 'receipt_breakdown', 'icon' => 'bi-list-columns-reverse', 'desc' => 'إيجار وضريبة وعمولة ومياه وخدمات وتأمين لكل سند مع فاتورته وحالته',
    'filters' => ['date', 'owner_id', 'aqar_id', 'subaqar_id', 'tenant_id', 'egar_id'],
    'selects' => ['state' => ['الحالة', ['posted' => 'مرحّل', 'draft' => 'مسودة', 'review' => 'محجوز للمراجعة', 'pending' => 'بانتظار المزامنة', 'before' => 'قبل بدء المزامنة']]],
    'build' => function ($db, $f) {
        syncReportNeed(receiptSyncReady($db));
        $start = (int)strtotime(amlakSyncStartDate($db) . ' 00:00:00');
        [$where, $params] = syncReportWhere($f, ['owner_id' => 'p.ownerid', 'aqar_id' => 's.idaqar', 'subaqar_id' => 'ABS(s.idsubaqar)', 'tenant_id' => 'CAST(s.mostagerid AS UNSIGNED)', 'egar_id' => 'k.egar_id']);
        $rows = receiptCommissionRows($db, "SELECT s.idsanad,s.kastid,s.sanaddate,s.mostagername,s.depositeamount,p.aqarname,d.rakam unit_name,c.rent,c.rent_vat,c.commission,c.commission_vat,c.water,c.services,c.insurance,
                c.other,c.other_vat,c.unclassified,c.idsanad has_split,i.invoice_id,i.invoice_number,
                CASE WHEN i.status IN ('posted','approved') THEN 'posted' WHEN i.status='draft' THEN 'draft' WHEN je.entry_id IS NOT NULL THEN 'posted' WHEN " . syncReportTime('s.sanaddate') . "<{$start} THEN 'before'
                    WHEN c.status='review' THEN 'review' ELSE 'pending' END state
            FROM sanad s LEFT JOIN sanad_components c ON c.idsanad=s.idsanad
            LEFT JOIN (SELECT sanad_id,MAX(invoice_id) id FROM acc_invoices WHERE sanad_id>0 AND status<>'cancelled' GROUP BY sanad_id) li ON li.sanad_id=s.idsanad LEFT JOIN acc_invoices i ON i.invoice_id=li.id
            LEFT JOIN acc_journal_entries je ON je.entry_id=s.accounting_entry_id AND je.status='posted'
            LEFT JOIN amlak p ON p.idaqar=s.idaqar LEFT JOIN amlakdetails d ON d.idsubaqar=ABS(s.idsubaqar) LEFT JOIN aksat k ON k.kastid=CAST(s.kastid AS UNSIGNED)
            WHERE " . syncReportPeriod('s.sanaddate', $f) . "{$where} ORDER BY s.sanaddate,s.idsanad", $params);
        $states = ['posted' => ['مرحّل', 'success'], 'draft' => ['مسودة', 'warning'], 'review' => ['محجوز للمراجعة', 'danger'], 'pending' => ['بانتظار المزامنة', 'info'], 'before' => ['قبل بدء المزامنة', 'secondary']];
        $list = [];
        foreach ($rows as $row) {
            if ($f['state'] !== '' && $f['state'] !== $row['state']) continue;
            if (!$row['has_split']) $row['unclassified'] = $row['depositeamount'];
            $row['receipt'] = syncReportReceiptCell($row['idsanad'], $row['kastid']);
            $row['date'] = syncReportDay($row['sanaddate']);
            $row['invoice'] = syncReportInvoiceCell($row['invoice_id'], $row['invoice_number']);
            $row['state'] = $states[$row['state']];
            $list[] = $row;
        }
        $columns = ['date' => ['التاريخ', 'date'], 'receipt' => ['السند', 'text'], 'invoice' => ['الفاتورة', 'text'], 'mostagername' => ['المستأجر', 'text'], 'aqarname' => ['العقار', 'text'], 'unit_name' => ['الوحدة', 'text'],
            'rent' => ['إيجار', 'money', true], 'rent_vat' => ['ضريبة الإيجار', 'money', true], 'commission' => ['عمولة', 'money', true], 'commission_vat' => ['ضريبة العمولة', 'money', true], 'water' => ['مياه', 'money', true],
            'services' => ['خدمات', 'money', true], 'insurance' => ['تأمين', 'money', true], 'other' => ['أخرى', 'money', true], 'other_vat' => ['ضريبة أخرى', 'money', true], 'unclassified' => ['غير مفصل', 'money', true],
            'depositeamount' => ['مبلغ السند', 'money', true], 'state' => ['الحالة', 'badge']];
        $sum = function (array $keys) use ($list) { $total = 0.0; foreach ($keys as $key) $total += array_sum(array_column($list, $key)); return $total; };
        return ['columns' => $columns, 'rows' => $list, 'cards' => ['عدد السندات' => count($list), 'إجمالي السندات' => $sum(['depositeamount']), 'إجمالي الضريبة' => $sum(['rent_vat', 'commission_vat', 'other_vat']), 'إجمالي التأمين' => $sum(['insurance'])],
            'notes' => ['"غير مفصل": سند قديم بلا تفاصيل محفوظة أو محجوز للمراجعة.']];
    },
];
require __DIR__ . '/../../includes/sync_report_page.hnt';
