<?php
/**
 * View Supplier Details
 * عرض تفاصيل المورد
 *
 * @charset UTF-8
 * @version 1.0
 */

$sc_title = "تفاصيل المورد";
$sc_id = "207";
include_once "../../../../header.hnt";
include_once "../../includes/accounting_class.hnt";

$accountingManager = new AccountingManager($db, $_SESSION['userid'] ?? 1);

// Get supplier ID
$supplierId = isset($_GET['id']) ? intval($_GET['id']) : 0;

if ($supplierId == 0) {
    echo "<div class='alert alert-danger'>رقم المورد غير صحيح</div>";
    exit;
}

// Get supplier details
$stmt = $db->prepare("SELECT * FROM acc_suppliers WHERE supplier_id = ?");
$stmt->bind_param("i", $supplierId);
$stmt->execute();
$result = $stmt->get_result();
$supplier = $result->fetch_assoc();

if (!$supplier) {
    echo "<div class='alert alert-danger'>المورد غير موجود</div>";
    exit;
}

// Get supplier invoices (purchases)
$invoicesQuery = "
    SELECT
        invoice_id,
        invoice_number,
        invoice_date,
        total_amount,
        paid_amount,
        payment_status,
        zatca_status
    FROM acc_invoices
    WHERE invoice_type = 'purchase'
    AND customer_id = ?
    ORDER BY invoice_date DESC
    LIMIT 10
";
$stmt = $db->prepare($invoicesQuery);
$stmt->bind_param("i", $supplierId);
$stmt->execute();
$invoicesResult = $stmt->get_result();
$invoices = [];
while ($row = $invoicesResult->fetch_assoc()) {
    $invoices[] = $row;
}

// Calculate statistics
$totalInvoices = count($invoices);
$totalPurchases = 0;
$totalPaid = 0;
$totalOutstanding = 0;

foreach ($invoices as $invoice) {
    $totalPurchases += $invoice['total_amount'];
    $totalPaid += $invoice['paid_amount'];
    $totalOutstanding += ($invoice['total_amount'] - $invoice['paid_amount']);
}
?>

