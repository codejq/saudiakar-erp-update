<?php
/**
 * Invoice Print View
 * طباعة الفاتورة
 * 
 * @charset UTF-8
 * @version 1.0
 */

include_once "../../../../reqlogin.hnt";
include_once "../../../../connectdb.hnt";
require __DIR__ . '/../../includes/active_database.hnt';
include_once "../../includes/zatca_helper.hnt";

$invoiceId = intval($_GET['id'] ?? 0);

// Get invoice
$invoiceQuery = "SELECT * FROM acc_invoices WHERE invoice_id = ?";
$stmt = $db->prepare($invoiceQuery);
$stmt->bind_param('i', $invoiceId);
$stmt->execute();
$invoice = $stmt->get_result()->fetch_assoc();

if (!$invoice) {
    die('Invoice not found');
}

// Get invoice items (from description - simplified)
$items = [];
// In production, you'd have a separate invoice_items table

// Seller: the values stored on the invoice, otherwise the company settings
$companySettings = [];
$settingsResult = $db->query("SELECT setting_key, setting_value FROM acc_system_settings
    WHERE setting_key IN ('company_name_ar','company_vat_number','company_address','company_phone')");
while ($settingsResult && ($settingRow = $settingsResult->fetch_assoc())) {
    $companySettings[$settingRow['setting_key']] = trim((string)$settingRow['setting_value']);
}
$companyName = trim((string)($invoice['seller_name'] ?? '')) ?: ($companySettings['company_name_ar'] ?? '');
$companyVAT = trim((string)($invoice['seller_vat_number'] ?? '')) ?: ($companySettings['company_vat_number'] ?? '');
$companyAddress = trim((string)($invoice['seller_address'] ?? '')) ?: ($companySettings['company_address'] ?? '');
// The stored phone belongs to the company, so it is shown only when the company is the seller
$companyPhone = trim((string)($invoice['seller_name'] ?? '')) === '' || $companyName === ($companySettings['company_name_ar'] ?? '')
    ? ($companySettings['company_phone'] ?? '') : '';

// Generate QR Code
$invoice['seller_name'] = $companyName;
$invoice['seller_vat_number'] = $companyVAT;
$qrData = ZATCAHelper::generateQRCode($invoice);
$qrImage = ZATCAHelper::generateQRCodeImage($qrData, 150);

$h = function ($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
};
?>
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فاتورة <?php echo $h($invoice['invoice_number']); ?></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            background: white;
        }
        
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border: 2px solid #667eea;
            border-radius: 10px;
            overflow: hidden;
        }
        
        .invoice-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        
        .invoice-header h1 {
            font-size: 2rem;
            margin-bottom: 10px;
        }
        
        .invoice-number {
            font-size: 1.2rem;
            opacity: 0.9;
        }
        
        .invoice-body {
            padding: 30px;
        }
        
        .company-info, .customer-info {
            margin-bottom: 30px;
        }
        
        .info-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        .info-box {
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        
        .info-box h3 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }
        
        .info-box p {
            margin: 8px 0;
            line-height: 1.6;
        }
        
        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin: 30px 0;
        }
        
        .invoice-table th {
            background: #667eea;
            color: white;
            padding: 15px;
            text-align: right;
            font-weight: 600;
        }
        
        .invoice-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #e9ecef;
        }
        
        .invoice-table tbody tr:hover {
            background: #f8f9fa;
        }
        
        .totals-section {
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            font-size: 1.1rem;
        }
        
        .total-row.grand-total {
            border-top: 2px solid #667eea;
            margin-top: 10px;
            padding-top: 15px;
            font-size: 1.3rem;
            font-weight: 700;
            color: #667eea;
        }
        
        .qr-section {
            text-align: center;
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        
        .qr-section img {
            border: 2px solid #667eea;
            border-radius: 8px;
            padding: 10px;
            background: white;
        }
        
        .footer {
            margin-top: 30px;
            padding: 20px;
            text-align: center;
            background: #667eea;
            color: white;
            border-radius: 8px;
        }
        
        @media print {
            body {
                padding: 0;
            }
            
            .invoice-container {
                border: none;
                border-radius: 0;
            }
            
            .no-print {
                display: none;
            }
        }
        
        .print-button {
            position: fixed;
            top: 20px;
            left: 20px;
            background: #667eea;
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .print-button:hover {
            background: #764ba2;
        }
    </style>
</head>
<body>
    <button class="print-button no-print" onclick="window.print()">
        🖨️ طباعة الفاتورة
    </button>
    
    <div class="invoice-container">
        <!-- Header -->
        <div class="invoice-header">
            <h1>فاتورة ضريبية</h1>
            <div class="invoice-number">TAX INVOICE</div>
            <div class="invoice-number" style="margin-top: 15px;">
                <?php echo $h($invoice['invoice_number']); ?>
            </div>
        </div>
        
        <!-- Body -->
        <div class="invoice-body">
            <!-- Company & Customer Info -->
            <div class="info-row">
                <div class="info-box">
                    <h3>بيانات الشركة</h3>
                    <p><strong><?php echo $h($companyName); ?></strong></p>
                    <p>الرقم الضريبي: <?php echo $h($companyVAT); ?></p>
                    <p><?php echo $h($companyAddress); ?></p>
                    <?php if ($companyPhone !== ''): ?><p>هاتف: <?php echo $h($companyPhone); ?></p><?php endif; ?>
                </div>
                
                <div class="info-box">
                    <h3>بيانات العميل</h3>
                    <p><strong><?php echo $h($invoice['customer_name']); ?></strong></p>
                    <?php if ($invoice['customer_vat_number']): ?>
                    <p>الرقم الضريبي: <?php echo $h($invoice['customer_vat_number']); ?></p>
                    <?php endif; ?>
                    <?php if ($invoice['customer_address']): ?>
                    <p><?php echo $h($invoice['customer_address']); ?></p>
                    <?php endif; ?>
                </div>
            </div>
            
            <!-- Invoice Details -->
            <div class="info-row">
                <div class="info-box">
                    <p><strong>تاريخ الفاتورة:</strong> <?php echo $h($invoice['invoice_date']); ?></p>
                    <?php if ($invoice['due_date']): ?>
                    <p><strong>تاريخ الاستحقاق:</strong> <?php echo $h($invoice['due_date']); ?></p>
                    <?php endif; ?>
                </div>
                
                <div class="info-box">
                    <p><strong>طريقة الدفع:</strong> 
                        <?php 
                        $methods = [
                            'cash' => 'نقداً',
                            'bank_transfer' => 'تحويل بنكي',
                            'credit_card' => 'بطاقة ائتمان',
                            'cheque' => 'شيك'
                        ];
                        echo $methods[$invoice['payment_method']] ?? $invoice['payment_method'];
                        ?>
                    </p>
                    <p><strong>حالة الدفع:</strong> 
                        <?php 
                        $statuses = [
                            'unpaid' => 'غير مدفوعة',
                            'partial' => 'مدفوعة جزئياً',
                            'paid' => 'مدفوعة'
                        ];
                        echo $statuses[$invoice['payment_status']] ?? $invoice['payment_status'];
                        ?>
                    </p>
                </div>
            </div>
            
            <!-- Items Table -->
            <table class="invoice-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>الوصف</th>
                        <th style="width: 100px;">الكمية</th>
                        <th style="width: 120px;">السعر</th>
                        <th style="width: 120px;">الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td><?php echo $h($invoice['notes'] ?: 'خدمات عقارية'); ?></td>
                        <td>1</td>
                        <td><?php echo number_format($invoice['subtotal'], 2); ?> ر.س</td>
                        <td><?php echo number_format($invoice['subtotal'], 2); ?> ر.س</td>
                    </tr>
                </tbody>
            </table>
            
            <!-- Totals -->
            <div class="totals-section">
                <div class="total-row">
                    <span>المجموع قبل الضريبة:</span>
                    <span><?php echo number_format($invoice['subtotal'], 2); ?> ر.س</span>
                </div>
                <div class="total-row">
                    <span>ضريبة القيمة المضافة (<?php echo rtrim(rtrim(number_format((float)$invoice['vat_rate'], 2), '0'), '.'); ?>%):</span>
                    <span><?php echo number_format($invoice['vat_amount'], 2); ?> ر.س</span>
                </div>
                <div class="total-row grand-total">
                    <span>الإجمالي النهائي:</span>
                    <span><?php echo number_format($invoice['total_amount'], 2); ?> ر.س</span>
                </div>
            </div>
            
            <!-- QR Code -->
            <div class="qr-section">
                <h3 style="color: #667eea; margin-bottom: 15px;">رمز الاستجابة السريعة - ZATCA</h3>
                <img src="<?php echo $qrImage; ?>" alt="QR Code" width="150" height="150">
                <p style="margin-top: 15px; color: #6c757d; font-size: 0.9rem;">
                    امسح الرمز للتحقق من صحة الفاتورة
                </p>
            </div>
            
            <!-- Footer -->
            <div class="footer">
                <p style="margin-bottom: 10px;">شكراً لتعاملكم معنا</p>
                <p style="font-size: 0.9rem; opacity: 0.9;">
                    هذه فاتورة إلكترونية صادرة وفقاً لمتطلبات هيئة الزكاة والضريبة والجمارك
                </p>
            </div>
        </div>
    </div>
    
    <script>
        // Auto print on load (optional)
