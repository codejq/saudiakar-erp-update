    <div id="installLog" class="install-log" style="display: none;">
        <div id="logContent"></div>
    </div>

    <div id="successMessage" class="alert alert-success" style="display: none;">
        <h4 class="alert-heading">
            <i class="bi bi-check-circle me-2"></i>
            تم التثبيت بنجاح!
        </h4>
        <p>تم إنشاء جميع الجداول المطلوبة بنجاح</p>
        <hr>
        <div class="d-flex gap-2">
            <a href="modules/suppliers/index.hnt" class="btn btn-success">
                <i class="bi bi-truck me-2"></i>إدارة الموردين
            </a>
            <a href="modules/customers/index.hnt" class="btn btn-primary">
                <i class="bi bi-people me-2"></i>إدارة العملاء
            </a>
