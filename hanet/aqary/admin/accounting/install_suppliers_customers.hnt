    <?php if ($alreadyInstalled): ?>
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>تحذير:</strong> يبدو أن الجداول مثبتة مسبقاً. إذا تابعت سيتم حذف البيانات الموجودة.
    </div>
    <?php endif; ?>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-info-circle me-2"></i>
                ما الذي سيتم تثبيته؟
            </h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">✅ جدول الموردين (acc_suppliers)</li>
                <li class="list-group-item">✅ جدول العملاء (acc_customers)</li>
            </ul>
        </div>
