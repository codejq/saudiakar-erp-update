<script>
function log(message, type = 'info') {
    const logContent = document.getElementById('logContent');
    const className = type === 'success' ? 'log-success' : (type === 'error' ? 'log-error' : 'log-info');
    logContent.innerHTML += `<div class="${className}">${message}</div>`;
    logContent.scrollTop = logContent.scrollHeight;
}

async function startInstallation() {
    document.getElementById('installLog').style.display = 'block';
    document.getElementById('logContent').innerHTML = '';

    log('⏳ بدء التثبيت...', 'info');

    try {
        const response = await fetch('install_suppliers_customers.hnt?action=install', {
            method: 'POST'
        });

        const result = await response.json();

        if (result.success) {
            result.logs.forEach(logMsg => {
                log(logMsg.message, logMsg.type);
            });

            log('✅ تم التثبيت بنجاح!', 'success');
            document.getElementById('successMessage').style.display = 'block';
        } else {
            log('❌ فشل التثبيت: ' + result.error, 'error');
        }
    } catch (error) {
        log('❌ خطأ في الاتصال: ' + error.message, 'error');
    }
}
</script>

