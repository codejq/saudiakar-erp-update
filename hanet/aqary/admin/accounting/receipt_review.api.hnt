<?php
/** JSON for receipt_review.hnt: preview the entries of a draft, or approve it with edits. */
$is_ajax_request = true;
require_once '../../reqloginajax.hnt';
require_once __DIR__ . '/includes/accounting_class.hnt';
require_once __DIR__ . '/includes/amlak_integration.hnt';
header('Content-Type: application/json; charset=utf-8');

function receiptReviewJson(array $data) {
    echo json_encode($data, JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
    exit;
}

$token = $_POST['csrf_token'] ?? '';
if ($_SERVER['REQUEST_METHOD'] !== 'POST' || !is_string($token) || empty($_SESSION['receipt_review_csrf']) || !hash_equals($_SESSION['receipt_review_csrf'], $token)) {
    receiptReviewJson(['success' => false, 'message' => 'انتهت صلاحية الصفحة. أعد تحميلها.']);
}
$action = is_string($_POST['action'] ?? null) ? $_POST['action'] : '';
$canEdit = receiptCommissionCan($db, 'accounting_receipt_review', 'edits');
if (!receiptCommissionCan($db, 'accounting_receipt_review', 'sees') || (in_array($action, ['approve', 'rebuild'], true) && !$canEdit)) {
    receiptReviewJson(['success' => false, 'message' => 'ليس لديك صلاحية.']);
}
$integration = new AmlakAccountingIntegration($db, new AccountingManager($db, (int)($_SESSION['useridv'] ?? 0)));
$invoiceId = (int)($_POST['invoice_id'] ?? 0);

if ($action === 'preview') receiptReviewJson($integration->previewReceiptInvoice($invoiceId));
if ($action === 'rebuild') receiptReviewJson($integration->rebuildReceiptInvoice($invoiceId));
if ($action === 'approve') {
    $edited = json_decode(is_string($_POST['entries'] ?? null) ? $_POST['entries'] : '', true);
    if (!is_array($edited) || !is_array($edited['invoice'] ?? null) || !is_array($edited['receipt'] ?? null)) {
        receiptReviewJson(['success' => false, 'message' => 'بيانات القيد غير صحيحة.']);
    }
    receiptReviewJson($integration->approveReceiptInvoice($invoiceId, $edited, !empty($_POST['confirm_owner'])));
}
receiptReviewJson(['success' => false, 'message' => 'عملية غير معروفة.']);
