<?php
// Force no cache - prevent browser from showing old version
header("Cache-Control: no-store, no-cache, must-revalidate, max-age=0");
header("Cache-Control: post-check=0, pre-check=0", false);
header("Pragma: no-cache");

// Extract POST variables early for processing
extract($_REQUEST);

// Initialize variables to prevent undefined warnings
$viewreport = isset($viewreport) ? $viewreport : '';

// Check if this is an AJAX form submission - handle it BEFORE any HTML output
$is_ajax_request = isset($_POST['ajax_submit']) && $_POST['ajax_submit'] == '1';

// Set page variables
$sc_title = "إنشاء تقرير مخصص";
$sc_id = "83";

// Only include headers if NOT an AJAX request
if (!$is_ajax_request) {
    include_once "../nocash.hnt";
    include_once "../header.hnt";
} else {
    // Always include authentication and database for AJAX
    include_once "../reqloginajax.hnt";
}

// Handle report creation/update
if (isset($sqlfeilds) && $sqlfeilds) {
    mysql_query("ALTER TABLE `custumreport` ADD `sumfields` VARCHAR(1000), CHANGE `reportdefault` `reportdefault` VARCHAR(1002)");

    $sqlfeilds = addslashes($sqlfeilds);
    $reportname = isset($reportname) ? addslashes($reportname) : '';
    $reportorderby = isset($reportorderby) ? addslashes($reportorderby) : '';
    $reportdaesc = isset($reportdaesc) ? addslashes($reportdaesc) : '';
    $sumfields = isset($_POST['sumfields']) ? addslashes($_POST['sumfields']) : '';
    $reporttype = isset($reporttype) ? addslashes($reporttype) : '';
    $editreportid = isset($_POST['editreportid']) ? intval($_POST['editreportid']) : 0;

    // Check if updating existing report
    if ($editreportid > 0) {
        $sql = "UPDATE custumreport SET
               reportname='" . $reportname . "',
               sqlfeilds='" . $sqlfeilds . "',
               reportorderby='" . $reportorderby . "',
               reportdaesc='" . $reportdaesc . "',
               sumfields='" . $sumfields . "',
               reporttype='" . $reporttype . "'
               WHERE id='" . $editreportid . "' LIMIT 1";
        $success_message = 'تم تحديث التقرير بنجاح';
    } else {
        $sql = "INSERT INTO custumreport SET
               reportname='" . $reportname . "',
               sqlfeilds='" . $sqlfeilds . "',
               reportorderby='" . $reportorderby . "',
               reportdaesc='" . $reportdaesc . "',
               userid='" . intval($_SESSION['useridv']) . "',
               sumfields='" . $sumfields . "',
               reporttype='" . $reporttype . "'";
        $success_message = 'تم إنشاء التقرير بنجاح';
    }

    if (mysql_query($sql, $link)) {
        // Handle AJAX response
        if ($is_ajax_request) {
            header('Content-Type: application/json; charset=utf-8');
            echo json_encode(array(
                'success' => true,
                'message' => $success_message,
                'redirect_url' => 'custumreport.hnt?viewreport=' . urlencode($reporttype)
            ), JSON_UNESCAPED_UNICODE);
            exit;
        } else {
            echo "<div class='alert alert-success alert-dismissible fade show' role='alert'>
                    <i class='bi bi-check-circle me-2'></i>" . $success_message . "
                    <button type='button' class='btn-close' data-bs-dismiss='alert'></button>
                  </div>";
        }
    }
}

// Handle report deletion
if (isset($deletereport) && $deletereport) {
    $sql = "DELETE FROM custumreport WHERE id='" . intval($deletereport) . "'";
    if (mysql_query($sql, $link)) {
        // Handle AJAX response
        if ($is_ajax_request) {
            header('Content-Type: application/json; charset=utf-8');
            echo json_encode(array(
                'success' => true,
                'message' => 'تم حذف التقرير',
                'redirect_url' => 'custumreport.hnt?viewreport=' . urlencode($viewreport)
            ), JSON_UNESCAPED_UNICODE);
            exit;
        } else {
            echo "<div class='alert alert-info alert-dismissible fade show' role='alert'>
                    <i class='bi bi-trash me-2'></i>تم حذف التقرير
                    <button type='button' class='btn-close' data-bs-dismiss='alert'></button>
                  </div>";
        }
    }
}
?>


<script type="text/javascript">
/** Modern Report Builder JavaScript
 * Replaces legacy 2001 code with ES6+ syntax
 */

// Add option to select element
function addOption(select, text, value) {
    const option = new Option(text, value);
    select.options[select.length] = option;
}

// Delete option from select element
function deleteOption(select, index) {
    if (select.length > 0) {
        select.options[index] = null;
    }
}

// Move selected options between two select elements
function moveOptions(selectFrom, selectTo) {
    const selectedOptions = [];

    // Collect selected options in reverse order
    for (let i = selectFrom.length - 1; i >= 0; i--) {
        if (selectFrom.options[i].selected) {
            selectedOptions.push({
                text: selectFrom.options[i].text,
                value: selectFrom.options[i].value
            });
            deleteOption(selectFrom, i);
        }
    }

    // Add options to target select in reverse order (maintains original order)
    for (let i = selectedOptions.length - 1; i >= 0; i--) {
        addOption(selectTo, selectedOptions[i].text, selectedOptions[i].value);
    }
}

// Convert select options to SQL field string
function warivaluetotxt(selectElement, txtInput, txtFields) {
    let sqlFields = '';
    let fieldNames = '';

    for (let i = 0; i < selectElement.length; i++) {
        const separator = i > 0 ? ', ' : '';
        const option = selectElement.options[i];

        sqlFields += separator + option.value + " as '" + option.text + "'";
        fieldNames += separator + option.value;
    }

    txtInput.value = sqlFields;

    if (txtFields) {
        txtFields.value = fieldNames;
    }

    return false;
}

// AJAX form submission - following maktab.hnt pattern
function submitReportForm(formElement) {
    const formData = new FormData(formElement);
    formData.append('ajax_submit', '1'); // Mark as AJAX request

    // Show loading indicator
    const submitBtn = formElement.querySelector('input[type="submit"], button[type="submit"]');
    const originalBtnText = submitBtn ? submitBtn.value || submitBtn.innerHTML : '';
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.value = 'جاري الحفظ...';
    }

    fetch('custumreport.hnt', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Show success notification
            if (typeof showBootstrapNotification === 'function') {
                showBootstrapNotification(data.message, 'success', 3000);
            } else {
                alert(data.message);
            }

            // Redirect if URL provided
            if (data.redirect_url) {
                setTimeout(() => {
                    window.location.href = data.redirect_url;
                }, 1500);
            }
        } else {
            // Show error
            if (typeof showBootstrapNotification === 'function') {
                showBootstrapNotification(data.error || 'حدث خطأ', 'error', 5000);
            } else {
                alert(data.error || 'حدث خطأ');
            }

            // Re-enable submit button
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.value = originalBtnText;
            }
        }
    })
    .catch(error => {
        console.error('Error:', error);
        if (typeof showBootstrapNotification === 'function') {
            showBootstrapNotification('حدث خطأ أثناء حفظ التقرير', 'error', 5000);
        } else {
            alert('حدث خطأ أثناء حفظ التقرير');
        }

        // Re-enable submit button
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.value = originalBtnText;
        }
    });

    return false;
}

// Attach AJAX submission to all report forms on page load
$(document).ready(function() {
    // The report builder uses native multiple selects as two movable field
    // lists. Global Select2 initialization hides that list and prevents the
    // move buttons from reflecting all available fields.
    $('form.report-form select[multiple]').each(function() {
        const $select = $(this);
        if ($select.hasClass('select2-hidden-accessible')) {
            $select.select2('destroy');
        }
    });

    // Attach to all forms with class 'report-form'
    $('form.report-form').on('submit', function(e) {
        e.preventDefault();
        submitReportForm(this);
        return false;
    });

    // Also attach to legacy forms without class
    $('form[action="custumreport.hnt"]').addClass('report-form').on('submit', function(e) {
        e.preventDefault();
        submitReportForm(this);
        return false;
    });
});
</script>

<style>
/* Modern Report Builder Styling - Following PROJECT_GUIDE */
.report-form {
    background: #ffffff;
    border-radius: 8px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.report-form .form-label {
    font-weight: 600;
    color: #495057;
    margin-bottom: 0.5rem;
}

.report-form input[type="text"],
.report-form select {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 0.5rem;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
}

.report-form input[type="text"]:focus,
.report-form select:focus {
    border-color: #189c2aff;
    outline: 0;
    box-shadow: 0 0 0 0.2rem rgba(24, 156, 42, 0.25);
}

/* Select boxes styling */
select[multiple].form-select {
    min-height: 250px;
    font-size: 0.95rem;
}

/* Button hover effects */
.btn {
    transition: all 0.2s ease-in-out;
}

.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
}

.btn-submit-report {
    background: linear-gradient(135deg, #189c2aff 0%, #066d96ff 100%);
    color: white;
    border: none;
    padding: 0.75rem 2rem;
    border-radius: 4px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}

.btn-submit-report:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0,0,0,0.2);
}

.btn-submit-report:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

/* Responsive adjustments */
@media (max-width: 992px) {
    .field-selector-container {
        flex-direction: column;
    }

    .field-selector {
        max-width: 100%;
        width: 100%;
    }

    .field-selector-buttons {
        flex-direction: row;
        padding-top: 0;
    }
}

/* Ensure proper RTL layout */
[dir="rtl"] .field-selector-container {
    direction: rtl;
}
</style>

