<?php
// Set page variables
$sc_title = "مركز التنبيهات والمتابعة";
$sc_id = "139";

// Include authentication and headers
include_once "../nocash.hnt";
include_once "../header.hnt";

// Create notifications table if not exists
mysql_query("CREATE TABLE IF NOT EXISTS `notifications` (
    `id` INT(11) NOT NULL AUTO_INCREMENT PRIMARY KEY,
    `notifitext` VARCHAR(3500) NOT NULL,
    `notifiuserid` INT(11),
    `notifisender` VARCHAR(100) NOT NULL,
    `notifitype` VARCHAR(50) NOT NULL,
    `notifitime` INT(11) NOT NULL,
    `notifiisseen` INT(11) NOT NULL,
    INDEX `idx_user` (`notifiuserid`),
    INDEX `idx_time` (`notifitime`)
)", $link);

// Add notifications count column if not exists
@mysql_query("ALTER TABLE user ADD sanad.hn INT(11) NOT NULL DEFAULT 0", $link);

// Reset notification count for current user
mysql_query("UPDATE user SET notificationscount = 0 WHERE userid='" . intval($_SESSION['useridv']) . "'", $link);

// Add welcome notification if this is first time
$ncount = mysql_fetch_array(mysql_query("SELECT COUNT(id) as dd FROM notifications", $link));
if (isset($ncount['dd']) && $ncount['dd'] < 1) {
    addnotifi(
        "مرحباً بك في مركز الرسائل والمتابعة. سيظهر لك كل التنبيهات في هذه الشاشة وسيظهر لك تنبيهات الطلبات والتوافق وتنبيهات التعديل والتحصيل والتذكير من المذكرة اليومية.",
        0, 0, 0, $link
    );
}

// Search and pagination. Fifty records is the default page size.
$search_notification = isset($_GET['search_notification']) ? trim($_GET['search_notification']) : '';
$allowedPageSizes = array(25, 50, 100);
$currentUserId = intval($_SESSION['useridv']);
$pageSizeCookieName = 'notificationcenter_per_page_' . $currentUserId;
$savedPageSize = isset($_COOKIE[$pageSizeCookieName]) ? intval($_COOKIE[$pageSizeCookieName]) : 50;
$perPage = isset($_GET['per_page']) ? intval($_GET['per_page']) : $savedPageSize;
if (!in_array($perPage, $allowedPageSizes, true)) {
    $perPage = 50;
}
$currentPage = isset($_GET['page']) ? max(1, intval($_GET['page'])) : 1;
$notificationWhere = "(notifiuserid='{$currentUserId}' OR notifiuserid=0)";

if ($search_notification !== '') {
    $normalizedSearchTerm = preg_replace('/\s+/u', ' ', trim($search_notification));
    $search_term = mysql_real_escape_string($normalizedSearchTerm, $link);
    // Search one combined value so LIKE covers the readable message, the full
    // serialized/JSON details and every notification metadata field.
    $notificationSearchValue = "CONCAT_WS(' ',
        CAST(id AS CHAR),
        COALESCE(notifitext, ''),
        CAST(COALESCE(notifiuserid, 0) AS CHAR),
        COALESCE(notifisender, ''),
        COALESCE(notifitype, ''),
        CAST(COALESCE(notifitime, 0) AS CHAR),
        DATE_FORMAT(FROM_UNIXTIME(notifitime), '%d/%m/%Y %H:%i'),
        CAST(COALESCE(notifiisseen, 0) AS CHAR)
    )";
    // Browsers collapse repeated whitespace when users copy displayed text.
    // Normalize database line breaks, tabs and repeated spaces before LIKE so
    // the copied text still matches the stored serialization.
    $normalizedNotificationSearchValue = "REPLACE(REPLACE(REPLACE({$notificationSearchValue}, CHAR(13), ' '), CHAR(10), ' '), CHAR(9), ' ')";
    for ($spacePass = 0; $spacePass < 6; $spacePass++) {
        $normalizedNotificationSearchValue = "REPLACE({$normalizedNotificationSearchValue}, '  ', ' ')";
    }
    $notificationWhere .= " AND {$normalizedNotificationSearchValue} LIKE '%{$search_term}%'";
}

$totalNotifications = 0;
$countResult = mysql_query("SELECT COUNT(*) AS total FROM notifications WHERE {$notificationWhere}", $link);
if ($countResult && ($countRow = mysql_fetch_assoc($countResult))) {
    $totalNotifications = intval($countRow['total']);
}
$totalPages = max(1, intval(ceil($totalNotifications / $perPage)));
$currentPage = min($currentPage, $totalPages);
$offset = ($currentPage - 1) * $perPage;
$firstRecordNumber = $totalNotifications > 0 ? $offset + 1 : 0;
$lastRecordNumber = min($offset + $perPage, $totalNotifications);

$sql = "SELECT * FROM notifications
        WHERE {$notificationWhere}
        ORDER BY id DESC
        LIMIT {$offset}, {$perPage}";
$rs = mysql_query($sql, $link);
$notifications = array();
while ($rs && ($row = mysql_fetch_assoc($rs))) {
    $notifications[] = $row;
}

function notificationCenterPageUrl($page, $search, $perPage) {
    $parameters = array(
        'page' => max(1, intval($page)),
        'per_page' => intval($perPage)
    );
    if ($search !== '') {
        $parameters['search_notification'] = $search;
    }
    return '?' . http_build_query($parameters, '', '&');
}

$paginationPages = array(1, $totalPages);
for ($pageNumber = max(1, $currentPage - 2); $pageNumber <= min($totalPages, $currentPage + 2); $pageNumber++) {
    $paginationPages[] = $pageNumber;
}
$paginationPages = array_values(array_unique($paginationPages));
sort($paginationPages);

/**
 * Split a notification into its readable message and technical record data.
 * New log entries use a JSON marker; older entries used an unlabeled value dump.
 */
function notificationCenterParseText($text) {
    $result = array(
        'summary' => (string)$text,
        'details' => array(),
        'legacy' => ''
    );
    $marker = '[[LOG_DETAILS_JSON]]';
    $markerPosition = strpos($result['summary'], $marker);
    if ($markerPosition !== false) {
        $json = trim(substr($result['summary'], $markerPosition + strlen($marker)));
        $result['summary'] = trim(substr($result['summary'], 0, $markerPosition));
        $decoded = json_decode($json, true);
        if (is_array($decoded)) {
            $result['details'] = $decoded;
        } else {
            $result['legacy'] = $json;
        }
        return $result;
    }

    // Legacy critical logs appended every database value with " - " and no
    // field names. Separate that dump without discarding the original data.
    $normalized = str_replace(array("\r\n", "\r"), "\n", $result['summary']);
    $lines = explode("\n", $normalized);
    $summaryLines = array();
    $legacyLines = array();
    foreach ($lines as $line) {
        if (substr_count($line, ' - ') >= 8) {
            $legacyLines[] = trim($line);
        } else {
            $summaryLines[] = $line;
        }
    }

    // Some old delete logs contain the message and dump on the same line.
    if (count($legacyLines) === 0 && substr_count($normalized, ' - ') >= 8) {
        $firstSeparator = strpos($normalized, ' - ');
        if ($firstSeparator !== false) {
            $result['summary'] = trim(substr($normalized, 0, $firstSeparator));
            $result['legacy'] = trim(substr($normalized, $firstSeparator + 3));
            return $result;
        }
    }

    if (count($legacyLines) > 0) {
        $result['summary'] = trim(implode("\n", $summaryLines));
        $result['legacy'] = trim(implode("\n", $legacyLines));
    }
    return $result;
}

function notificationCenterFieldLabel($fieldName) {
    $labels = array(
        'idsanad' => 'رقم السند',
        'sanadrakam' => 'رقم السند',
        'mostagername' => 'اسم العميل',
        'depositeamount' => 'المبلغ',
        'recivername' => 'المستلم',
        'mybyan' => 'البيان',
        'sanaddate' => 'تاريخ السند',
        'paymentdate' => 'تاريخ الدفع',
        'kastid' => 'رقم القسط',
        'idsubaqar' => 'رقم الوحدة',
        'idaqar' => 'رقم العقار',
        'userid' => 'رقم المستخدم',
        '_notice' => 'ملاحظة تقنية'
    );
    return isset($labels[$fieldName]) ? $labels[$fieldName] : str_replace('_', ' ', $fieldName);
}

function notificationCenterRenderText($text) {
    $parsed = notificationCenterParseText($text);
    $lines = preg_split('/\R/u', trim($parsed['summary']));
    $html = '<div class="notification-summary">';
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '') {
            continue;
        }
        if (preg_match('/^([^:：]{1,60})\s*[:：]\s*(.*)$/u', $line, $matches)) {
            $label = htmlspecialchars(trim($matches[1]), ENT_QUOTES, 'UTF-8');
            $value = trim($matches[2]) !== '' ? trim($matches[2]) : '—';
            $html .= '<div class="notification-summary-row"><span class="notification-summary-label">'
                . $label . '</span><span class="notification-summary-value">'
                . htmlspecialchars($value, ENT_QUOTES, 'UTF-8') . '</span></div>';
        } else {
            $html .= '<p class="notification-summary-line">'
                . htmlspecialchars($line, ENT_QUOTES, 'UTF-8') . '</p>';
        }
    }
    $html .= '</div>';

    if (count($parsed['details']) > 0) {
        $html .= '<details class="notification-details"><summary><i class="bi bi-list-ul me-1"></i>تفاصيل السجل</summary>';
        $html .= '<div class="table-responsive mt-2"><table class="table table-sm table-striped notification-details-table"><tbody>';
        foreach ($parsed['details'] as $field => $value) {
            $html .= '<tr><th>' . htmlspecialchars(notificationCenterFieldLabel($field), ENT_QUOTES, 'UTF-8')
                . '<small>' . htmlspecialchars($field, ENT_QUOTES, 'UTF-8') . '</small></th><td>'
                . nl2br(htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8')) . '</td></tr>';
        }
        $html .= '</tbody></table></div></details>';
    } elseif ($parsed['legacy'] !== '') {
        $html .= '<details class="notification-details notification-legacy"><summary><i class="bi bi-archive me-1"></i>بيانات تقنية قديمة</summary>'
            . '<div class="notification-legacy-data">'
            . htmlspecialchars($parsed['legacy'], ENT_QUOTES, 'UTF-8')
            . '</div></details>';
    }

    return $html;
}
?>

