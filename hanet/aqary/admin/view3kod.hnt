<?php
// Contract view page
include_once "../nocash.hnt";
$canscroll = 1;
include_once "../report_header.hnt";

// Load contract data
if (isset($custummerid) && $custummerid) {
    $sql = "SELECT * FROM custummer WHERE custummerid='" . intval($custummerid) . "' LIMIT 1";
    $row = mysql_fetch_array(mysql_query($sql, $link));

    if ($row) {
        require_once __DIR__ . '/include/sale_contract_data.hnt';
        $desc = saleContractData($row['descrption']);
    } else {
        echo "<div class='alert alert-danger'>العقد غير موجود</div>";
        exit;
    }
} else {
    echo "<div class='alert alert-warning'>الرجاء تحديد رقم العقد</div>";
    exit;
}

function contractValue($array, $key) {
    return isset($array[$key]) && is_scalar($array[$key]) ? trim((string)$array[$key]) : '';
}

function contractEsc($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

/** One label and value; an empty value stays a blank to fill by hand. */
function contractCell($label, $value, $span = 1, $unit = '') {
    $text = $value !== '' ? contractEsc($value) . ($unit !== '' && preg_match('/^[\d.,]+$/', $value) ? ' ' . contractEsc($unit) : '') : '&nbsp;';
    return '<th>' . $label . '</th><td' . ($span > 1 ? ' colspan="' . $span . '"' : '') . '>' . $text . '</td>';
}

function contractParty($desc, $title, $n) {
    $html = '<h2>' . $title . '</h2><table class="grid">'
        . '<tr>' . contractCell('الاسم الكامل', contractValue($desc, "part{$n}name")) . contractCell('الجنسية', contractValue($desc, "part{$n}nationality")) . '</tr>'
        . '<tr>' . contractCell('رقم الهوية', contractValue($desc, "hawia{$n}")) . contractCell('المهنة', contractValue($desc, "part{$n}job")) . '</tr>';
    if (contractValue($desc, "hawia{$n}kind") !== '' || contractValue($desc, "hawia{$n}masder") !== '' || contractValue($desc, "hawia{$n}date") !== '') {
        $html .= '<tr>' . contractCell('نوع الهوية', contractValue($desc, "hawia{$n}kind")) . contractCell('مصدر الهوية', contractValue($desc, "hawia{$n}masder")) . '</tr>'
            . '<tr>' . contractCell('تاريخ الهوية', contractValue($desc, "hawia{$n}date"), 3) . '</tr>';
    }
    $html .= '<tr>' . contractCell('الجوال', contractValue($desc, "part{$n}jawal")) . contractCell('العنوان', contractValue($desc, "part{$n}address")) . '</tr>';
    if (contractValue($desc, "part{$n}momasel") !== '') $html .= '<tr>' . contractCell('يمثله في هذا العقد', contractValue($desc, "part{$n}momasel"), 3) . '</tr>';
    return $html . '</table>';
}

function contractMoney($desc, $label, $key, $currency, $always) {
    $value = contractValue($desc, $key);
    $words = contractValue($desc, $key . 'ketaba');
    if (!$always && $value === '') return '';
    return '<tr>' . contractCell($label, $value, 1, $value !== '' ? $currency : '') . contractCell('كتابة', $words) . '</tr>';
}

function contractWitness($desc, $label, $n) {
    $html = '<td class="witness"><table class="grid"><tr><th colspan="2" class="center">' . $label . '</th></tr>'
        . '<tr>' . contractCell('الاسم', contractValue($desc, "witnes{$n}")) . '</tr><tr>' . contractCell('رقم الهوية', contractValue($desc, "hawiaw{$n}")) . '</tr>';
    foreach (['kind' => 'نوع الهوية', 'masder' => 'مصدر الهوية', 'date' => 'تاريخ الهوية'] as $field => $name) {
        if (contractValue($desc, "hawiaw{$n}{$field}") !== '') $html .= '<tr>' . contractCell($name, contractValue($desc, "hawiaw{$n}{$field}")) . '</tr>';
    }
    return $html . '<tr class="sign-row">' . contractCell('التوقيع', '') . '</tr></table></td>';
}

$contractCurrency = trim((string)($myomla ?? ''));
// Older contracts may hold line-break tags in their conditions.
$contractConditions = trim(html_entity_decode(strip_tags(preg_replace('~<(br|/p|/div)\s*/?>~i', "\n", contractValue($desc, 'okodconditions'))), ENT_QUOTES, 'UTF-8'));
$contractPhone = trim((string)($bayantel ?? ''));
$contractAddress = trim((string)($bayanaddress ?? ''));
?>

<style>
.contract-view {
    max-width: 190mm;
    margin: 0 auto;
    padding: 4mm 2mm;
    background: #fff;
    color: #000;
    font-family: 'mothnna', 'F-DFont', 'GE SS', 'Traditional Arabic', Arial, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    direction: rtl;
    text-align: right;
}
.contract-view h1 {
    margin: 0 0 4mm;
    padding: 0;
    color: #000;
    font-size: 24px;
    font-weight: bold;
    text-align: center;
}
.contract-view h2 {
    margin: 5mm 0 0;
    padding: 1.5mm 3mm;
    border: 1px solid #555;
    border-bottom: 0;
    background: #f0f0f0;
    color: #000;
    font-size: 16px;
    font-weight: bold;
    break-after: avoid;
    page-break-after: avoid;
}
.contract-view table { width: 100%; border-collapse: collapse; }
.contract-view table.grid { table-layout: fixed; }
.contract-view table.grid th,
.contract-view table.grid td {
    padding: 1.5mm 2.5mm;
    border: 1px solid #555;
    color: #000;
    text-align: right;
    vertical-align: top;
    overflow-wrap: anywhere;
}
.contract-view table.grid th { width: 17%; background: #fafafa; font-weight: bold; }
.contract-view table.grid td { width: 33%; font-weight: normal; }
.contract-view table.grid tr { break-inside: avoid; page-break-inside: avoid; }
.contract-view table.grid .center { width: auto; text-align: center; }
.contract-view table.meta td { padding: 1mm 0; border: 0; font-weight: bold; }
.contract-view .intro { margin: 3mm 0 0; text-align: center; }
.contract-conditions { padding: 3mm 4mm; border: 1px solid #555; line-height: 1.9; text-align: justify; }
.contract-view .signatures { margin-top: 10mm; break-inside: avoid; page-break-inside: avoid; }
.contract-view .signatures td { width: 33.33%; padding: 0 4mm; border: 0; text-align: center; font-weight: bold; }
.contract-view .signatures .line { height: 22mm; border-bottom: 1px solid #000; }
.contract-view .witnesses { margin-top: 6mm; break-inside: avoid; page-break-inside: avoid; }
.contract-view .witnesses td.witness { width: 50%; padding: 0 0 0 2mm; border: 0; vertical-align: top; }
.contract-view .witnesses td.witness + td.witness { padding: 0 2mm 0 0; }
.contract-view .witness table.grid th { width: 32%; }
.contract-view .witness table.grid td { width: 68%; }
.contract-view .witness .sign-row td { height: 14mm; }
.contract-foot { margin-top: 8mm; padding-top: 2mm; border-top: 1px solid #555; font-size: 13px; text-align: center; }
@page { size: A4; margin: 12mm; }
@media print {
    .contract-view { max-width: none; padding: 0; font-size: 13px; line-height: 1.5; }
    .contract-view h2, .contract-view table.grid th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
@media (max-width: 600px) {
    .contract-view { font-size: 13px; }
    .contract-view table.grid th, .contract-view table.grid td { padding: 1mm; }
}
</style>

<div class="contract-view" dir="rtl">
    <h1>عقد بيع عقار</h1>
    <table class="meta"><tr>
        <td>رقم العقد: <?= contractEsc(contractValue($row, 'custummerid')) ?></td>
        <td style="text-align:left">التاريخ: <?= contractEsc(contractValue($row, 'custummerfax')) ?></td>
    </tr></table>
    <p class="intro">إنه في يوم التاريخ المبين أعلاه قد تم التعاقد بين كل من:</p>

    <?= contractParty($desc, 'الطرف الأول (البائع)', 1) ?>
    <?= contractParty($desc, 'الطرف الثاني (المشتري)', 2) ?>

    <h2>بيانات العقار موضوع التعاقد</h2>
    <table class="grid">
        <tr><?= contractCell('نوع العقار', contractValue($row, 'custumeremail')) . contractCell('موقع العقار', contractValue($desc, 'aqarmoqe')) ?></tr>
        <?php if (contractValue($desc, 'aqardescription') !== '') { ?><tr><?= contractCell('وصف العقار', contractValue($desc, 'aqardescription'), 3) ?></tr><?php } ?>
        <tr><?= contractCell('رقم الصك', contractValue($row, 'custummeraddres')) . contractCell('تاريخ الصك', contractValue($desc, 'sakdate')) ?></tr>
        <tr><?= contractCell('مصدر الصك', contractValue($desc, 'sakplace')) . contractCell('رقم العقار', contractValue($row, 'custummertel')) ?></tr>
        <tr><?= contractCell('رقم المخطط', contractValue($desc, 'mokhatatnumber')) . contractCell('رقم البلوك', contractValue($desc, 'blocknumber')) ?></tr>
        <tr><?= contractCell('رقم القطعة', contractValue($desc, 'ket3anumber')) . contractCell('المساحة', contractValue($desc, 'mesaha'), 1, 'متر مربع') ?></tr>
        <?php if (contractValue($desc, 'mesahaketaba') !== '') { ?><tr><?= contractCell('المساحة كتابة', contractValue($desc, 'mesahaketaba'), 3) ?></tr><?php } ?>
    </table>

    <h2>حدود العقار</h2>
    <table class="grid">
        <?php foreach (['shamal' => 'الحد الشمالي', 'ganob' => 'الحد الجنوبي', 'sharq' => 'الحد الشرقي', 'gharb' => 'الحد الغربي'] as $side => $sideLabel) { ?>
        <tr><?= contractCell($sideLabel, contractValue($desc, $side)) . contractCell('بطول', contractValue($desc, $side . 'tol'), 1, 'متر') ?></tr>
        <?php } ?>
    </table>

    <h2>بيانات السعر والمدفوعات</h2>
    <table class="grid">
        <?= contractMoney($desc, 'القيمة الإجمالية', 'price', $contractCurrency, true) ?>
        <?= contractMoney($desc, 'المدفوع مقدماً', 'payedprice', $contractCurrency, true) ?>
        <?= contractMoney($desc, 'الباقي من ثمن الشراء', 'priceremainder', $contractCurrency, false) ?>
        <?= contractMoney($desc, 'أجرة المكتب', 'maktabprice', $contractCurrency, false) ?>
    </table>

    <?php if ($contractConditions !== '') { ?>
    <h2>شروط وبنود العقد</h2>
    <div class="contract-conditions"><?= nl2br(contractEsc($contractConditions)) ?></div>
    <?php } ?>

    <table class="signatures"><tr>
        <td>توقيع الطرف الأول<div class="line"></div></td>
        <td>ختم المكتب<div class="line"></div></td>
        <td>توقيع الطرف الثاني<div class="line"></div></td>
    </tr></table>

    <?php if (contractValue($desc, 'witnes1') !== '' || contractValue($desc, 'witnes2') !== '') { ?>
    <table class="witnesses"><tr>
        <?= contractWitness($desc, 'الشاهد الأول', 1) . contractWitness($desc, 'الشاهد الثاني', 2) ?>
    </tr></table>
    <?php } ?>

    <?php if ($contractPhone !== '' || $contractAddress !== '') { ?>
    <div class="contract-foot"><?= contractEsc(implode(' - ', array_filter([$contractPhone !== '' ? 'هاتف: ' . $contractPhone : '', $contractAddress !== '' ? 'العنوان: ' . $contractAddress : '']))) ?></div>
    <?php } ?>
</div>
