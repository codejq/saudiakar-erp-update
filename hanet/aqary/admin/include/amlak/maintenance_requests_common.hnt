<?php
/** Presentation helpers for the maintenance-request module. */
function mrNormalizeLegacyUtf8($value)
{
    $value = (string)$value;
    if ($value === '' || !preg_match('/(?:Ã|Â|Ø|Ù|â)/u', $value)) {
        return $value;
    }

    // Repair legacy Arabic labels whose UTF-8 bytes were previously read as Windows-1252.
    if (function_exists('mb_convert_encoding')) {
        $converted = @mb_convert_encoding($value, 'Windows-1252', 'UTF-8');
    } elseif (function_exists('iconv')) {
        $converted = @iconv('UTF-8', 'Windows-1252//IGNORE', $value);
    } else {
        return $value;
    }

    if (!is_string($converted) || $converted === '' || !preg_match('//u', $converted)) {
        return $value;
    }

    $beforeArabic = preg_match_all('/[\x{0600}-\x{06FF}]/u', $value, $unusedBefore);
    $afterArabic = preg_match_all('/[\x{0600}-\x{06FF}]/u', $converted, $unusedAfter);
    return $afterArabic > $beforeArabic ? $converted : $value;
}

function mrEsc($value)
{
    return htmlspecialchars(mrNormalizeLegacyUtf8($value), ENT_QUOTES, 'UTF-8');
}

function mrMoney($value)
{
    return number_format(floatval($value), 2);
}

function mrStatusLabel($status)
{
    return MaintenanceRequestService::statusLabel($status);
}

function mrStatusClass($status)
{
    $classes = array(
        'new'=>'secondary','assigned'=>'primary','scheduled'=>'info','in_progress'=>'warning',
        'waiting_parts'=>'dark','on_hold'=>'danger','completed'=>'success','verified'=>'success','cancelled'=>'secondary'
    );
    return $classes[$status] ?? 'secondary';
}

function mrPriorityLabel($priority)
{
    $labels = array('low'=>'منخفض','normal'=>'عادي','high'=>'مرتفع','urgent'=>'عاجل');
    return $labels[$priority] ?? $priority;
}

function mrCategoryLabel($category)
{
    $labels = array('plumbing'=>'سباكة','electricity'=>'كهرباء','air_conditioning'=>'تكييف','carpentry'=>'نجارة','elevator'=>'مصاعد','appliance'=>'أجهزة','structural'=>'إنشائي','cleaning'=>'نظافة','safety'=>'سلامة','other'=>'أخرى');
    return $labels[$category] ?? $category;
}

function mrItemStatusLabel($status)
{
    $labels = array('requested'=>'مطلوب','ordered'=>'تم الطلب','received'=>'تم الاستلام','used'=>'تم الاستخدام','returned'=>'مرتجع','cancelled'=>'ملغي');
    return $labels[$status] ?? $status;
}

function mrDateTimeLocal($value)
{
    if (!$value) return '';
    $time = strtotime($value);
    return $time ? date('Y-m-d\TH:i', $time) : '';
}

function mrPageUrl($overrides = array())
{
    $params = array_filter(array(
        'search' => $_GET['search'] ?? '', 'status' => $_GET['status'] ?? '',
        'priority' => $_GET['priority'] ?? '', 'assigned_userid' => intval($_GET['assigned_userid'] ?? 0),
        'idaqar' => intval($_GET['idaqar'] ?? 0), 'mostagerid' => intval($_GET['mostagerid'] ?? 0),
        'page' => intval($_GET['page'] ?? 1)
    ), function ($value) { return $value !== '' && $value !== 0; });
    foreach ($overrides as $key => $value) {
        if ($value === null || $value === '' || $value === 0) unset($params[$key]); else $params[$key] = $value;
    }
    return '?' . http_build_query($params, '', '&');
}

