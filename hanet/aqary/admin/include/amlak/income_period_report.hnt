.income-table-card td{white-space:nowrap}
.income-formula{border-inline-start:4px solid #0ea5e9;background:#f0f9ff}
@media print{.income-screen-only{display:none!important}.income-table-card,.income-kpi{box-shadow:none}.container-fluid{max-width:none!important}.income-table-card td,.income-table-card th{font-size:10px!important;padding:4px!important}}
</style>

<div class="container-fluid py-4" dir="rtl">
