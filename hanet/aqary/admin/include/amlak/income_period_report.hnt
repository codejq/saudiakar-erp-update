            </a>
            <a class="btn btn-outline-light" href="reports.hnt"><i class="bi bi-arrow-return-right me-1"></i>التقارير</a>
        </div>
        <?php } ?>
    </div>

    <?php if ($inputWarning !== '') { ?><div class="alert alert-warning"><?= incomePeriodEsc($inputWarning) ?></div><?php } ?>
    <?php if (!$hasRepresentativeCommission) { ?>
        <div class="alert alert-warning">أعمدة عمولات مندوبي المبيعات غير مطبقة على قاعدة البيانات الحالية؛ لذلك تظهر عمولة المندوب بصفر، بينما تبقى حسابات دخل وعمولة المكتب متاحة.</div>
    <?php } ?>
    <?php if ($reportError !== '') { ?>
        <div class="alert alert-danger">تعذر تحميل التقرير: <?= incomePeriodEsc($reportError) ?></div>
    <?php } ?>

    <?php if ($reportMode !== 1) { ?>
    <form method="get" class="card income-filter-card mb-4 income-screen-only" id="incomePeriodFilters">
        <div class="card-body row g-3 align-items-end">
            <div class="col-sm-6 col-lg-2">
                <label class="form-label" for="period_type">الفترة</label>
                <select class="form-select" name="period_type" id="period_type">
                    <option value="day" <?= $periodType === 'day' ? 'selected' : '' ?>>يومي</option>
                    <option value="month" <?= $periodType === 'month' ? 'selected' : '' ?>>شهري</option>
                    <option value="year" <?= $periodType === 'year' ? 'selected' : '' ?>>سنوي</option>
