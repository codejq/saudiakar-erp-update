                <label class="form-label" for="day">اليوم</label>
                <input class="form-control" type="date" name="day" id="day" value="<?= incomePeriodEsc($dayValue) ?>">
            </div>
            <div class="col-sm-6 col-lg-2 income-period-input" data-period="month">
                <label class="form-label" for="month">الشهر</label>
                <input class="form-control" type="month" name="month" id="month" value="<?= incomePeriodEsc($monthValue) ?>">
            </div>
            <div class="col-sm-6 col-lg-2 income-period-input" data-period="year">
                <label class="form-label" for="year">السنة</label>
                <input class="form-control" type="number" min="2000" max="2100" name="year" id="year" value="<?= intval($yearValue) ?>">
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label" for="detail_level">مستوى التفاصيل</label>
                <select class="form-select" name="detail_level" id="detail_level">
                    <option value="summary" <?= $detailLevel === 'summary' ? 'selected' : '' ?>>ملخص الفترة</option>
                    <option value="property" <?= $detailLevel === 'property' ? 'selected' : '' ?>>حسب العقار</option>
                    <option value="transactions" <?= $detailLevel === 'transactions' ? 'selected' : '' ?>>تفاصيل العمليات</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="idaqar">العقار</label>
                <select class="form-select" name="idaqar" id="idaqar">
                    <option value="0">جميع العقارات</option>
                    <?php foreach ($propertyOptions as $property) { ?>
                        <option value="<?= intval($property['idaqar']) ?>" <?= intval($property['idaqar']) === $selectedProperty ? 'selected' : '' ?>>
                            <?= incomePeriodEsc($property['aqarname']) ?>
                        </option>
                    <?php } ?>
                </select>
            </div>
            <div class="col-sm-6 col-lg-1" id="perPageContainer">
                <label class="form-label" for="per_page">لكل صفحة</label>
                <select class="form-select" name="per_page" id="per_page">
                    <?php foreach (array(50,100,250) as $size) { ?><option value="<?= $size ?>" <?= $size === $perPage ? 'selected' : '' ?>><?= $size ?></option><?php } ?>
                </select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <button class="btn btn-success w-100" type="submit"><i class="bi bi-search me-1"></i>عرض التقرير</button>
            </div>
        </div>
    </form>
    <?php } ?>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2"><div class="card income-kpi" style="--income-color:#2563eb"><div class="card-body"><div class="income-label">إجمالي التحصيل</div><div class="income-value"><?= incomePeriodMoney($totals['gross_amount']) ?></div><small><?= incomePeriodEsc($currency) ?></small></div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="card income-kpi" style="--income-color:#7c3aed"><div class="card-body"><div class="income-label">عمولة المكتب بالنسبة</div><div class="income-value"><?= incomePeriodMoney($totals['office_percentage_commission']) ?></div><small><?= incomePeriodEsc($currency) ?></small></div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="card income-kpi" style="--income-color:#0891b2"><div class="card-body"><div class="income-label">دخل المكتب المباشر</div><div class="income-value"><?= incomePeriodMoney($totals['office_direct_income']) ?></div><small><?= incomePeriodEsc($currency) ?></small></div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="card income-kpi" style="--income-color:#16a34a"><div class="card-body"><div class="income-label">إجمالي دخل المكتب</div><div class="income-value"><?= incomePeriodMoney($totals['office_total_income']) ?></div><small><?= incomePeriodEsc($currency) ?></small></div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="card income-kpi" style="--income-color:#dc2626"><div class="card-body"><div class="income-label">عمولات المندوبين</div><div class="income-value"><?= incomePeriodMoney($totals['representative_commission']) ?></div><small><?= incomePeriodEsc($currency) ?></small></div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="card income-kpi" style="--income-color:#0f766e"><div class="card-body"><div class="income-label">صافي دخل المكتب</div><div class="income-value"><?= incomePeriodMoney($totals['office_net_income']) ?></div><small><?= incomePeriodEsc($currency) ?></small></div></div></div>
    </div>

    <div class="alert income-formula mb-4">
        <strong>طريقة الحساب:</strong>
        عمولة المكتب بالنسبة تعتمد على النسبة الحالية المضبوطة داخل بيانات كل عقار.
        إجمالي دخل المكتب = العمولة بالنسبة + السعي/التجديد + الخدمات + المياه والتأمين المخصصان للمكتب.
        صافي دخل المكتب يطرح عمولات مندوبي المبيعات المحفوظة على سندات القبض.
    </div>

    <div class="card income-table-card">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
            <strong><i class="bi bi-table me-1"></i><?= incomePeriodEsc($periodLabel) ?></strong>
            <span class="badge bg-primary"><?= number_format(intval($totals['transaction_count'])) ?> عملية</span>
        </div>
        <div class="table-responsive">
            <?php if ($detailLevel === 'transactions') { ?>
            <table class="table table-hover table-striped align-middle mb-0">
                <thead><tr>
                    <th>السند</th><th>التاريخ</th><th>العقار / الوحدة</th><th>المستأجر</th><th>البيان</th><th>الدفع</th>
                    <th>المحصل</th><th>نسبة المكتب</th><th>عمولة النسبة</th><th>الدخل المباشر</th><th>إجمالي المكتب</th><th>عمولة المندوب</th><th>صافي المكتب</th><th>صافي المالك</th>
                </tr></thead>
                <tbody>
                <?php foreach ($rows as $row) { ?>
                    <tr>
                        <td><?php if (intval($row['idsanad']) > 0) { ?><a target="_blank" href="read_recive_voucher_template.hnt?idsanad=<?= intval($row['idsanad']) ?>&paymentvou=0&voucer_type=">#<?= intval($row['idsanad']) ?></a><?php } else { ?><?= incomePeriodEsc($row['sanadrakam']) ?><?php } ?></td>
                        <td><?= date('d/m/Y', intval($row['paymentdate'])) ?></td>
                        <td><?= incomePeriodEsc($row['aqarname']) ?> / <?= intval($row['idsubaqar']) ?></td>
                        <td><?= incomePeriodEsc($row['mostagername']) ?></td>
                        <td title="<?= incomePeriodEsc($row['pymentdesription']) ?>"><?= incomePeriodEsc(mb_strimwidth($row['pymentdesription'], 0, 45, '…', 'UTF-8')) ?></td>
                        <td><?= incomePeriodEsc(incomePeriodPaymentLabel($row['payment_type'])) ?></td>
                        <td><?= incomePeriodMoney($row['gross_amount']) ?></td>
                        <td><?= incomePeriodMoney($row['configured_rate']) ?>%</td>
                        <td><?= incomePeriodMoney($row['office_percentage_commission']) ?></td>
                        <td><?= incomePeriodMoney($row['office_direct_income']) ?></td>
                        <td class="fw-bold text-success"><?= incomePeriodMoney($row['office_total_income']) ?></td>
                        <td class="text-danger"><?= incomePeriodMoney($row['representative_commission']) ?></td>
                        <td class="fw-bold"><?= incomePeriodMoney($row['office_net_income']) ?></td>
                        <td><?= incomePeriodMoney($row['owner_net_amount']) ?></td>
                    </tr>
                <?php } ?>
                <?php if (empty($rows)) { ?><tr><td colspan="14" class="text-center text-muted py-5">لا توجد عمليات في الفترة المحددة.</td></tr><?php } ?>
                </tbody>
            </table>
            <?php } else { ?>
            <table class="table table-hover table-striped align-middle mb-0">
                <thead><tr>
                    <th><?= $detailLevel === 'property' ? 'العقار' : 'الفترة' ?></th>
                    <?php if ($detailLevel === 'property') { ?><th>نسبة المكتب</th><?php } ?>
                    <th>العمليات</th><th>المحصل</th><th>السعي/التجديد</th><th>الخدمات</th><th>مياه وتأمين المكتب</th>
                    <th>عمولة النسبة</th><th>إجمالي المكتب</th><th>عمولة المندوب</th><th>صافي المكتب</th><th>صافي المالك</th>
                </tr></thead>
                <tbody>
                <?php foreach ($rows as $row) {
                    if ($detailLevel === 'property') {
                        $rowLabel = $row['aqarname'];
                    } elseif ($periodType === 'year') {
                        $parts = explode('-', $row['bucket_key']);
                        $rowLabel = (isset($parts[1], $monthNames[$parts[1]]) ? $monthNames[$parts[1]] : $row['bucket_key']) . ' ' . (isset($parts[0]) ? $parts[0] : '');
                    } else {
                        $rowLabel = date('d/m/Y', intval($row['bucket_sort']));
                    }
                ?>
                    <tr>
                        <td class="fw-bold"><?= incomePeriodEsc($rowLabel) ?></td>
                        <?php if ($detailLevel === 'property') { ?><td><?= incomePeriodMoney($row['configured_rate']) ?>%</td><?php } ?>
                        <td><?= number_format(intval($row['transaction_count'])) ?></td>
                        <td><?= incomePeriodMoney($row['gross_amount']) ?></td>
                        <td><?= incomePeriodMoney($row['renewal_commission']) ?></td>
                        <td><?= incomePeriodMoney($row['services_amount']) ?></td>
                        <td><?= incomePeriodMoney(floatval($row['office_water']) + floatval($row['office_insurance'])) ?></td>
                        <td><?= incomePeriodMoney($row['office_percentage_commission']) ?></td>
                        <td class="fw-bold text-success"><?= incomePeriodMoney($row['office_total_income']) ?></td>
                        <td class="text-danger"><?= incomePeriodMoney($row['representative_commission']) ?></td>
                        <td class="fw-bold"><?= incomePeriodMoney($row['office_net_income']) ?></td>
                        <td><?= incomePeriodMoney($row['owner_net_amount']) ?></td>
                    </tr>
                <?php } ?>
                <?php if (empty($rows)) { ?><tr><td colspan="<?= $detailLevel === 'property' ? 12 : 11 ?>" class="text-center text-muted py-5">لا توجد عمليات في الفترة المحددة.</td></tr><?php } ?>
                </tbody>
                <tfoot class="table-dark"><tr>
                    <th>الإجمالي</th>
                    <?php if ($detailLevel === 'property') { ?><th>—</th><?php } ?>
                    <th><?= number_format(intval($totals['transaction_count'])) ?></th>
                    <th><?= incomePeriodMoney($totals['gross_amount']) ?></th>
                    <th><?= incomePeriodMoney($totals['renewal_commission']) ?></th>
                    <th><?= incomePeriodMoney($totals['services_amount']) ?></th>
                    <th><?= incomePeriodMoney(floatval($totals['office_water']) + floatval($totals['office_insurance'])) ?></th>
                    <th><?= incomePeriodMoney($totals['office_percentage_commission']) ?></th>
                    <th><?= incomePeriodMoney($totals['office_total_income']) ?></th>
                    <th><?= incomePeriodMoney($totals['representative_commission']) ?></th>
                    <th><?= incomePeriodMoney($totals['office_net_income']) ?></th>
                    <th><?= incomePeriodMoney($totals['owner_net_amount']) ?></th>
                </tr></tfoot>
            </table>
            <?php } ?>
        </div>
    </div>

    <?php if ($detailLevel === 'transactions' && $totalPages > 1 && $reportMode !== 1) { ?>
    <nav class="mt-4 income-screen-only" aria-label="صفحات التقرير"><ul class="pagination justify-content-center flex-wrap">
        <?php for ($pageNumber = max(1, $page - 3); $pageNumber <= min($totalPages, $page + 3); $pageNumber++) {
            $pageQuery = $baseQuery;
            $pageQuery['page'] = $pageNumber;
        ?>
            <li class="page-item <?= $pageNumber === $page ? 'active' : '' ?>"><a class="page-link" href="income_period_report.hnt?<?= incomePeriodEsc(http_build_query($pageQuery)) ?>"><?= $pageNumber ?></a></li>
        <?php } ?>
    </ul></nav>
    <?php } ?>

    <?php if ($detailLevel === 'transactions' && $reportMode === 1 && $totalPages > 1) { ?>
        <div class="alert alert-warning mt-3">نسخة الطباعة تعرض الصفحة الحالية فقط (<?= intval($page) ?> من <?= intval($totalPages) ?>).</div>
    <?php } ?>
</div>

<?php if ($reportMode !== 1) { ?>
<script>
(function () {
    const periodType = document.getElementById('period_type');
    const detailLevel = document.getElementById('detail_level');
    const perPageContainer = document.getElementById('perPageContainer');
    function refreshIncomeFilters() {
        document.querySelectorAll('.income-period-input').forEach(function (element) {
            element.style.display = element.getAttribute('data-period') === periodType.value ? '' : 'none';
        });
        perPageContainer.style.display = detailLevel.value === 'transactions' ? '' : 'none';
    }
    periodType.addEventListener('change', refreshIncomeFilters);
    detailLevel.addEventListener('change', refreshIncomeFilters);
    refreshIncomeFilters();
})();
</script>
<?php require '../../../foter.hnt'; ?>
<?php } else { require '../../../reportfooter.hnt'; } ?>
