<?php
/**
 * Daily, monthly and yearly rental income report.
 *
 * Office percentage commission follows the same property-level formula used by
 * the owner and multi-property statements. Representative commission uses the
 * immutable snapshot saved on each receipt when the column is available.
 */
$sc_title = 'تقرير الدخل اليومي والشهري والسنوي';
$sc_id = '49';

include_once '../../../nocash.hnt';

$reportMode = isset($_GET['report']) ? intval($_GET['report']) : 0;
if ($reportMode === 1) {
    include_once '../../../report_header.hnt';
} else {
    include_once '../../../header.hnt';
}

date_default_timezone_set('Asia/Riyadh');

function incomePeriodEsc($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function incomePeriodMoney($value) {
    return number_format(floatval($value), 2);
}

function incomePeriodValidDate($value, $format, DateTimeZone $timezone) {
    $date = DateTimeImmutable::createFromFormat('!' . $format, (string)$value, $timezone);
    $errors = DateTimeImmutable::getLastErrors();
    if ($date === false || ($errors !== false && ($errors['warning_count'] || $errors['error_count']))) {
        return false;
    }
    return $date->format($format) === $value ? $date : false;
}

function incomePeriodPaymentLabel($paymentType) {
    $labels = array(1 => 'نقدي', 2 => 'شيك', 3 => 'أخرى', 4 => 'تحويل', 5 => 'شبكة');
    $paymentType = intval($paymentType);
    return isset($labels[$paymentType]) ? $labels[$paymentType] : 'غير محدد';
}

function incomePeriodTotalsDefaults() {
    return array(
        'transaction_count' => 0,
        'gross_amount' => 0,
        'renewal_commission' => 0,
        'services_amount' => 0,
        'office_water' => 0,
        'office_insurance' => 0,
        'commission_base' => 0,
        'office_percentage_commission' => 0,
        'office_direct_income' => 0,
        'office_total_income' => 0,
        'representative_commission' => 0,
        'office_net_income' => 0,
        'owner_net_amount' => 0,
    );
}

$timezone = new DateTimeZone('Asia/Riyadh');
$now = new DateTimeImmutable('now', $timezone);
$periodType = isset($_GET['period_type']) && in_array($_GET['period_type'], array('day', 'month', 'year'), true)
    ? $_GET['period_type']
    : 'month';
$detailLevel = isset($_GET['detail_level']) && in_array($_GET['detail_level'], array('summary', 'property', 'transactions'), true)
    ? $_GET['detail_level']
    : 'summary';
$selectedProperty = isset($_GET['idaqar']) ? max(0, intval($_GET['idaqar'])) : 0;
$page = isset($_GET['page']) ? max(1, intval($_GET['page'])) : 1;
$perPage = isset($_GET['per_page']) && in_array(intval($_GET['per_page']), array(50, 100, 250), true)
    ? intval($_GET['per_page'])
    : 100;
$inputWarning = '';

$dayValue = isset($_GET['day']) ? trim($_GET['day']) : $now->format('Y-m-d');
$monthValue = isset($_GET['month']) ? trim($_GET['month']) : $now->format('Y-m');
$yearValue = isset($_GET['year']) ? intval($_GET['year']) : intval($now->format('Y'));

if ($periodType === 'day') {
    $periodStart = incomePeriodValidDate($dayValue, 'Y-m-d', $timezone);
    if ($periodStart === false) {
        $periodStart = new DateTimeImmutable('today', $timezone);
        $dayValue = $periodStart->format('Y-m-d');
        $inputWarning = 'تم استخدام تاريخ اليوم لأن التاريخ المحدد غير صحيح.';
    }
    $periodEnd = $periodStart->modify('+1 day');
    $periodLabel = 'يوم ' . $periodStart->format('d/m/Y');
} elseif ($periodType === 'year') {
    if ($yearValue < 2000 || $yearValue > 2100) {
        $yearValue = intval($now->format('Y'));
        $inputWarning = 'تم استخدام السنة الحالية لأن السنة المحددة غير صحيحة.';
    }
    $periodStart = new DateTimeImmutable($yearValue . '-01-01 00:00:00', $timezone);
    $periodEnd = $periodStart->modify('+1 year');
    $periodLabel = 'سنة ' . $yearValue;
} else {
    $periodStart = incomePeriodValidDate($monthValue, 'Y-m', $timezone);
    if ($periodStart === false) {
        $periodStart = new DateTimeImmutable($now->format('Y-m-01') . ' 00:00:00', $timezone);
        $monthValue = $periodStart->format('Y-m');
        $inputWarning = 'تم استخدام الشهر الحالي لأن الشهر المحدد غير صحيح.';
    }
    $periodEnd = $periodStart->modify('+1 month');
    $periodLabel = 'شهر ' . $periodStart->format('m/Y');
}

$startTimestamp = $periodStart->getTimestamp();
$endTimestamp = $periodEnd->getTimestamp();

$propertyOptions = array();
$propertyResult = mysql_query('SELECT idaqar, aqarname FROM amlak ORDER BY aqarname, idaqar', $link);
if ($propertyResult) {
    while ($property = mysql_fetch_assoc($propertyResult)) {
        $propertyOptions[] = $property;
    }
}

$hasRepresentativeCommission = false;
$columnResult = mysql_query("SHOW COLUMNS FROM sanad LIKE 'sales_commission_amount'", $link);
if ($columnResult && mysql_num_rows($columnResult) > 0) {
    $hasRepresentativeCommission = true;
}

$grossExpr = 'COALESCE(e.amount, 0)';
$renewalExpr = 'COALESCE(e.mysa3ee, 0)';
$servicesExpr = 'COALESCE(e.services, 0)';
$officeWaterExpr = "CASE WHEN COALESCE(a.addwaterto, '') NOT IN ('', 'malek') THEN COALESCE(e.mywater, 0) ELSE 0 END";
$officeInsuranceExpr = "CASE WHEN COALESCE(a.addtameento, '') NOT IN ('', 'malek') THEN COALESCE(e.tamen, 0) ELSE 0 END";
$rawRateExpr = "CAST(COALESCE(NULLIF(a.persentage, ''), '0') AS DECIMAL(12,4))";
$rateExpr = "CASE WHEN {$rawRateExpr} < 100 THEN {$rawRateExpr} ELSE {$rawRateExpr} / 100 END";
$commissionBaseExpr = "({$grossExpr} - {$renewalExpr} - {$servicesExpr} - {$officeWaterExpr} - {$officeInsuranceExpr})";
$percentageCommissionExpr = "({$commissionBaseExpr} * {$rateExpr} / 100)";
$directOfficeExpr = "({$renewalExpr} + {$servicesExpr} + {$officeWaterExpr} + {$officeInsuranceExpr})";
$officeTotalExpr = "({$directOfficeExpr} + {$percentageCommissionExpr})";
$representativeCommissionExpr = $hasRepresentativeCommission ? 'COALESCE(s.sales_commission_amount, 0)' : '0';
$officeNetExpr = "({$officeTotalExpr} - {$representativeCommissionExpr})";
$ownerNetExpr = "({$grossExpr} - {$officeTotalExpr})";

$aggregateColumns = "
    COUNT(*) AS transaction_count,
    COALESCE(SUM({$grossExpr}), 0) AS gross_amount,
    COALESCE(SUM({$renewalExpr}), 0) AS renewal_commission,
    COALESCE(SUM({$servicesExpr}), 0) AS services_amount,
    COALESCE(SUM({$officeWaterExpr}), 0) AS office_water,
    COALESCE(SUM({$officeInsuranceExpr}), 0) AS office_insurance,
    COALESCE(SUM({$commissionBaseExpr}), 0) AS commission_base,
    COALESCE(SUM({$percentageCommissionExpr}), 0) AS office_percentage_commission,
    COALESCE(SUM({$directOfficeExpr}), 0) AS office_direct_income,
    COALESCE(SUM({$officeTotalExpr}), 0) AS office_total_income,
    COALESCE(SUM({$representativeCommissionExpr}), 0) AS representative_commission,
    COALESCE(SUM({$officeNetExpr}), 0) AS office_net_income,
    COALESCE(SUM({$ownerNetExpr}), 0) AS owner_net_amount";

$sanadJoin = 'LEFT JOIN sanad s ON s.idsanad = CAST(e.sanadrakam AS UNSIGNED)';
$whereSql = "e.paymentdate >= '" . intval($startTimestamp) . "' AND e.paymentdate < '" . intval($endTimestamp) . "'";
if ($selectedProperty > 0) {
    $whereSql .= " AND e.idaqar='" . intval($selectedProperty) . "'";
}
$baseFromSql = "FROM eradat e LEFT JOIN amlak a ON a.idaqar=e.idaqar {$sanadJoin} WHERE {$whereSql}";

$reportError = '';
$totals = incomePeriodTotalsDefaults();
$totalsResult = mysql_query("SELECT {$aggregateColumns} {$baseFromSql}", $link);
if ($totalsResult) {
    $totalsRow = mysql_fetch_assoc($totalsResult);
    if ($totalsRow) {
        $totals = array_merge($totals, $totalsRow);
    }
} else {
    $reportError = mysql_error($link);
}

$rows = array();
$totalPages = 1;
if ($reportError === '') {
    if ($detailLevel === 'property') {
        $sql = "SELECT e.idaqar,
                       COALESCE(NULLIF(a.aqarname, ''), CONCAT('عقار #', e.idaqar)) AS aqarname,
                       MAX({$rateExpr}) AS configured_rate,
                       {$aggregateColumns}
                {$baseFromSql}
                GROUP BY e.idaqar, a.aqarname
                ORDER BY a.aqarname, e.idaqar";
    } elseif ($detailLevel === 'transactions') {
        $totalPages = max(1, intval(ceil(intval($totals['transaction_count']) / $perPage)));
        if ($page > $totalPages) {
            $page = $totalPages;
        }
        $offset = ($page - 1) * $perPage;
        $sql = "SELECT e.iderad, e.idaqar, e.idsubaqar, e.mostagername,
                       e.pymentdesription, e.paymentdate, e.sanadrakam,
                       COALESCE(NULLIF(a.aqarname, ''), CONCAT('عقار #', e.idaqar)) AS aqarname,
                       s.idsanad, s.payment_type,
                       {$rateExpr} AS configured_rate,
                       {$grossExpr} AS gross_amount,
                       {$renewalExpr} AS renewal_commission,
                       {$servicesExpr} AS services_amount,
                       {$officeWaterExpr} AS office_water,
                       {$officeInsuranceExpr} AS office_insurance,
                       {$commissionBaseExpr} AS commission_base,
                       {$percentageCommissionExpr} AS office_percentage_commission,
                       {$directOfficeExpr} AS office_direct_income,
                       {$officeTotalExpr} AS office_total_income,
                       {$representativeCommissionExpr} AS representative_commission,
                       {$officeNetExpr} AS office_net_income,
                       {$ownerNetExpr} AS owner_net_amount
                {$baseFromSql}
                ORDER BY e.paymentdate DESC, e.iderad DESC
                LIMIT " . intval($offset) . ', ' . intval($perPage);
    } else {
        if ($periodType === 'day') {
            $bucketExpr = "DATE_FORMAT(FROM_UNIXTIME(e.paymentdate), '%Y-%m-%d')";
        } elseif ($periodType === 'year') {
            $bucketExpr = "DATE_FORMAT(FROM_UNIXTIME(e.paymentdate), '%Y-%m')";
        } else {
            $bucketExpr = "DATE_FORMAT(FROM_UNIXTIME(e.paymentdate), '%Y-%m-%d')";
        }
        $sql = "SELECT {$bucketExpr} AS bucket_key, MIN(e.paymentdate) AS bucket_sort,
                       {$aggregateColumns}
                {$baseFromSql}
                GROUP BY bucket_key
                ORDER BY bucket_sort";
    }

    $dataResult = mysql_query($sql, $link);
    if ($dataResult) {
        while ($row = mysql_fetch_assoc($dataResult)) {
            $rows[] = $row;
        }
    } else {
        $reportError = mysql_error($link);
    }
}

$monthNames = array(
    '01' => 'يناير', '02' => 'فبراير', '03' => 'مارس', '04' => 'أبريل',
    '05' => 'مايو', '06' => 'يونيو', '07' => 'يوليو', '08' => 'أغسطس',
    '09' => 'سبتمبر', '10' => 'أكتوبر', '11' => 'نوفمبر', '12' => 'ديسمبر'
);

$currency = isset($myomla) && trim((string)$myomla) !== '' ? $myomla : 'ريال';
$baseQuery = array(
    'period_type' => $periodType,
    'day' => $dayValue,
    'month' => $monthValue,
    'year' => $yearValue,
    'detail_level' => $detailLevel,
    'idaqar' => $selectedProperty,
    'per_page' => $perPage,
);
$printQuery = $baseQuery;
$printQuery['page'] = $page;
$printQuery['report'] = 1;
?>

<style>
.income-filter-card,.income-table-card,.income-kpi{border:0;box-shadow:0 2px 12px rgba(15,23,42,.08)}
.income-kpi{height:100%;border-inline-start:4px solid var(--income-color,#0f766e)}
.income-kpi .income-value{font-size:1.45rem;font-weight:800;color:#0f172a}
.income-kpi .income-label{color:#64748b;font-size:.88rem}
.income-title-bar{background:linear-gradient(135deg,#0f766e,#15803d);color:#fff;border-radius:.75rem;padding:1rem 1.25rem}
