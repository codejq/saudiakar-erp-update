        </div>
        <?php if ($reportMode !== 1) { ?>
        <div class="d-flex flex-wrap gap-2 income-screen-only">
            <a class="btn btn-light" target="_blank" href="income_period_report.hnt?<?= incomePeriodEsc(http_build_query($printQuery)) ?>">
