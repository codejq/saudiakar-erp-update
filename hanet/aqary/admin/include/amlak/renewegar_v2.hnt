<script src="../../../js/jquery-3.6.0.min.js"></script>
<script src="../../../js/bootstrap.min.js"></script>

<script>
$(document).ready(function() {
    // Format number inputs as currency
    $('input[name="annualprice"], input[name="tamen"], input[name="water"], input[name="secondsa3e"], input[name="services"]').on('input', function() {
        let val = $(this).val().replace(/,/g, '');
        if (!isNaN(val) && val !== '') {
            $(this).val(parseFloat(val).toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 2}));
        }
    });

    // Handle form submission
    $('#renewalForm').on('submit', function(e) {
        e.preventDefault();

        // Confirm renewal
        if (!confirm('هل أنت متأكد من تجديد العقد؟\n\nسيتم إنشاء عقد جديد مع الاحتفاظ بجميع بيانات العقد الحالي.')) {
            return;
        }

        const $btnRenew = $('#btnRenew');
        const $messageBox = $('#messageBox');

        // Disable button
        $btnRenew.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> جاري التجديد...');
        $messageBox.hide();

        // Prepare data
        const formData = $(this).serialize();

        // Add depositeamount (same as annualprice for renewal)
        const annualprice = $('input[name="annualprice"]').val().replace(/,/g, '');
        const postData = formData + '&action=renew_contract&depositeamount=' + annualprice;

        // Submit to API
        $.ajax({
            url: 'contract_lifecycle.api.hnt',
            method: 'POST',
            data: postData,
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    $messageBox
                        .removeClass('error-box warning-box')
                        .addClass('success-box')
                        .html('<strong>نجح!</strong> ' + response.message +
                              '<br><br>رقم العقد الجديد: <strong>' + response.data.new_contract_number + '</strong>' +
                              '<br>تاريخ البداية: ' + response.data.start_date_formatted +
                              '<br>تاريخ النهاية: ' + response.data.end_date_formatted +
                              '<br>عدد الأقساط: ' + response.data.installments_count +
                              '<br><br><a href="show3akd.hnt?idsubaqar=' + response.data.new_contract_id + '" class="btn btn-primary">عرض العقد الجديد</a>')
                        .show();

                    // Scroll to message
                    $('html, body').animate({
                        scrollTop: $messageBox.offset().top - 100
                    }, 500);

                } else {
                    $messageBox
                        .removeClass('success-box warning-box')
                        .addClass('error-box')
                        .html('<strong>خطأ!</strong> ' + response.message)
                        .show();

                    $btnRenew.prop('disabled', false).html('<i class="fa fa-refresh"></i> تجديد العقد');
                }
            },
            error: function(xhr, status, error) {
                $messageBox
                    .removeClass('success-box warning-box')
                    .addClass('error-box')
                    .html('<strong>خطأ!</strong> حدث خطأ في الاتصال بالخادم. الرجاء المحاولة مرة أخرى.')
                    .show();

                $btnRenew.prop('disabled', false).html('<i class="fa fa-refresh"></i> تجديد العقد');
            }
        });
    });
});
</script>

</body>
</html>
