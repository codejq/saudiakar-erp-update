include_once"../../../nocash.hnt";
include_once "../../../connectdb.hnt";
require_once(__DIR__ . '/CalendarManager.class.hnt');

// Get contract ID from request
$contractId = isset($_REQUEST['contract_id']) ? intval($_REQUEST['contract_id']) : 0;

if (!$contractId) {
    die('معرف العقد مطلوب');
}

// Get contract details
$sql = "SELECT e.*, m.mostagername, a.idsubaqar, a.hnt_dll_type
        FROM egar e
        INNER JOIN mostagereen m ON e.mostagerid = m.mostagerid
        LEFT JOIN amlakdetails a ON e.rakam3akdid = a.rakam3akdid
        WHERE e.rakam3akdid='$contractId'
        LIMIT 1";

$result = mysql_query($sql, $link);
if (!$result || mysql_num_rows($result) == 0) {
    die('العقد غير موجود');
}

$contract = mysql_fetch_assoc($result);

// Get installment summary
$sql = "SELECT
    COUNT(*) as total_installments,
    SUM(CASE WHEN iscomplete = 1 THEN 1 ELSE 0 END) as paid_installments,
    SUM(CASE WHEN iscomplete = 0 THEN 1 ELSE 0 END) as unpaid_installments
    FROM aksat
    WHERE egar_id='$contractId'";
$installmentSummary = mysql_fetch_assoc(mysql_query($sql, $link));

// Initialize calendar
$calendar = new CalendarManager();
$calendarType = intval($contract['calendar_type']);

?>
