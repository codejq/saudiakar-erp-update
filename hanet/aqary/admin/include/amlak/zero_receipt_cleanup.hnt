<?php
/**
 * Removes empty duplicates: receipts and income rows saved with a zero amount.
 * A receipt linked to accounting, or income already delivered to the owner, is kept.
 */
require_once __DIR__ . '/receipt_commission_helpers.hnt';

function zeroReceiptCleanup($link): void {
    try {
        $linked = receiptCommissionRows($link, "SELECT TABLE_NAME t FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE()
            AND TABLE_NAME IN ('acc_invoices','acc_journal_entries') AND COLUMN_NAME='sanad_id'");
        $sql = 'DELETE FROM sanad WHERE depositeamount=0 AND COALESCE(accounting_entry_id,0)=0';
        foreach ($linked as $row) $sql .= " AND NOT EXISTS (SELECT 1 FROM {$row['t']} x WHERE x.sanad_id=sanad.idsanad)";
        receiptCommissionQuery($link, $sql)->close();
        receiptCommissionQuery($link, "DELETE FROM eradat WHERE amount=0 AND COALESCE(tasfia,'')=''")->close();
    } catch (Throwable $error) {
        // The page still opens; the helper already logged the reason.
    }
}
