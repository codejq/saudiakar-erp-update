<?php
/** Receipt commissions use the active customer connection ($link), never the base $db. */
require_once __DIR__ . '/sales_representative_helpers.hnt';

function receiptCommissionEsc($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function receiptCommissionQuery($link, $sql, $params = array()) {
    try {
        $stmt = mysqli_prepare($link, $sql);
        if (!$stmt || !$stmt->execute($params)) {
            throw new RuntimeException(mysqli_error($link));
        }
        return $stmt;
    } catch (Throwable $error) {
        error_log('Receipt commissions: ' . $error->getMessage());
        throw new RuntimeException('تعذر إتمام العملية. تحقق من تشغيل تحديثات إدارة الأملاك ثم حاول مجدداً.');
    }
}

function receiptCommissionRows($link, $sql, $params = array()) {
    $stmt = receiptCommissionQuery($link, $sql, $params);
    $rows = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
    $stmt->close();
    return $rows;
}

function receiptCommissionReady($link) {
    static $ready = array();
    $key = spl_object_id($link);
    if (!array_key_exists($key, $ready)) {
        $rows = receiptCommissionRows($link, "SELECT
            (SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE()
                AND TABLE_NAME IN ('sanad_commission_splits','sanad_commission_audit')) tables_ready,
            (SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE()
                AND TABLE_NAME='masrofat' AND COLUMN_NAME='commission_split_id') column_ready");
        $ready[$key] = intval($rows[0]['tables_ready'])===2 && intval($rows[0]['column_ready'])===1;
    }
    return $ready[$key];
}

function receiptCommissionCan($link, $screen, $operation = 'sees') {
    if (!in_array($operation, array('sees', 'adds', 'edits', 'prints'), true)) return false;
    $userid = intval($_SESSION['useridv'] ?? 0);
    if ($userid <= 0) return false;
    $rows = receiptCommissionRows($link, "SELECT g.allprevilage, MAX(COALESCE(p.{$operation},0)) permitted
        FROM user u JOIN usergroups g ON g.groupid=u.groupid
        LEFT JOIN screens s ON (s.screen_id=? OR CAST(s.screenid AS CHAR)=?)
        LEFT JOIN ugroupscreen p ON p.groupid=u.groupid AND p.screenid=s.screenid
        WHERE u.userid=? GROUP BY g.allprevilage", array((string)$screen, (string)$screen, $userid));
    return !empty($rows) && (!empty($rows[0]['allprevilage']) || !empty($rows[0]['permitted']));
}

/** Scope every receipt query, including printing and direct-ID requests. */
function receiptCommissionScope($link, $alias = 's') {
    if (!in_array($alias, array('s', 'r'), true)) throw new InvalidArgumentException('Invalid receipt alias');
    $userid = intval($_SESSION['useridv'] ?? 0);
    if ($userid <= 0) return '0=1';
    $rows = receiptCommissionRows($link, "SELECT g.allprevilage FROM user u
        JOIN usergroups g ON g.groupid=u.groupid WHERE u.userid=?", array($userid));
    if (!empty($rows[0]['allprevilage']) || !empty($_SESSION['seeothermasder'])) return '1=1';
    return "({$alias}.idaqar=0 OR EXISTS (SELECT 1 FROM amlak scope_property
        WHERE scope_property.idaqar={$alias}.idaqar
        AND FIND_IN_SET('{$userid}',REPLACE(COALESCE(scope_property.users,''),' ',''))>0))";
}

function receiptCommissionToken() {
    if (empty($_SESSION['receipt_commission_csrf'])) {
        $_SESSION['receipt_commission_csrf'] = bin2hex(random_bytes(24));
    }
    return $_SESSION['receipt_commission_csrf'];
}

function receiptCommissionCheckToken($token) {
    if (!is_string($token) || $token === '' || !hash_equals(receiptCommissionToken(), $token)) {
        throw new RuntimeException('انتهت صلاحية النموذج. أعد تحميل الصفحة.');
    }
}

/** Validate money in cents; never accept client-calculated commission amounts. */
function receiptCommissionCents($value) {
    if (!is_scalar($value) || !preg_match('/^\d{1,8}(?:\.\d{1,2})?$/D', (string)$value)) {
        throw new RuntimeException('أدخل مبلغاً أو نسبة صحيحة حتى منزلتين عشريتين.');
    }
    return (int)round((float)$value * 100);
}

function receiptCommissionParse($data, $amount, $link) {
    $amountCents = receiptCommissionCents(number_format((float)$amount, 2, '.', ''));
    if ($amountCents <= 0) throw new RuntimeException('يجب أن يكون مبلغ السند أكبر من صفر.');
    if (!isset($data['commission_userid'])) {
        $legacy = amlakCalculateSalesCommissionSnapshot($amount, intval($data['sales_representative_userid'] ?? 0), $link);
        return array(array('representative_userid' => $legacy['representative_userid'],
            'commission_type' => $legacy['type'], 'commission_value' => $legacy['value'],
            'commission_amount' => $legacy['amount']));
    }
    $ids = $data['commission_userid'];
    $types = $data['commission_type'] ?? null;
    $values = $data['commission_value'] ?? null;
    if (!is_array($ids) || !is_array($types) || !is_array($values) || !$ids || count($ids)>20
        || array_keys($ids)!==array_keys($types) || array_keys($ids)!==array_keys($values)) {
        throw new RuntimeException('أضف مندوباً واحداً على الأقل أو اختر النظام، وبحد أقصى 20 مندوباً.');
    }
    $rows = array(); $seen = array(); $total = 0;
    foreach ($ids as $key => $rawId) {
        if (!is_scalar($rawId) || !ctype_digit((string)$rawId)) throw new RuntimeException('المندوب غير صحيح.');
        $id = intval($rawId);
        if (isset($seen[$id])) throw new RuntimeException('لا يمكن تكرار المندوب في السند نفسه.');
        $seen[$id] = true;
        if ($id > 0 && amlakValidateSalesRepresentativeId($id, $link) !== $id) {
            throw new RuntimeException('أحد المندوبين المحددين غير موجود.');
        }
        $type = $types[$key];
        if (!is_string($type) || !in_array($type, array('percentage','fixed'), true)) throw new RuntimeException('نوع العمولة غير صحيح.');
        $valueCents = receiptCommissionCents($values[$key]);
        if ($type === 'percentage' && $valueCents > 10000) throw new RuntimeException('النسبة لا تتجاوز 100%.');
        if ($id === 0 && (count($ids)!==1 || $valueCents!==0)) throw new RuntimeException('النظام يكون وحده وبدون عمولة.');
        $cents = $type === 'fixed' ? $valueCents : (int)round($amountCents * $valueCents / 10000);
        $total += $cents;
        $rows[] = array('representative_userid'=>$id, 'commission_type'=>$type,
            'commission_value'=>$valueCents/100, 'commission_amount'=>$cents/100);
    }
    if ($total > $amountCents) throw new RuntimeException('مجموع عمولات المندوبين يتجاوز مبلغ السند.');
    return $rows;
}

function receiptCommissionSummary($rows) {
    $total = array_sum(array_column($rows, 'commission_amount'));
    $first = $rows[0];
    return array('representative_userid'=>intval($first['representative_userid']),
        'type'=>count($rows)>1 ? 'split' : $first['commission_type'],
        'value'=>count($rows)>1 ? 0 : $first['commission_value'], 'amount'=>round($total,2));
}

/** Caller owns the transaction. Lock the receipt before replacing unpaid, unposted shares. */
function receiptCommissionSave($link, $receiptId, $rows) {
    $receiptId = intval($receiptId);
    $receipt = receiptCommissionRows($link, 'SELECT * FROM sanad WHERE idsanad=? FOR UPDATE', array($receiptId));
    if (!$receipt) throw new RuntimeException('السند غير موجود.');
    if (!empty($receipt[0]['accounting_entry_id'])) throw new RuntimeException('السند مرحل محاسبياً؛ لا يمكن تغيير عمولاته.');
    $paid = receiptCommissionRows($link, 'SELECT m.idmasrof FROM masrofat m JOIN sanad_commission_splits c
        ON c.split_id=m.commission_split_id WHERE c.idsanad=? LIMIT 1 FOR UPDATE', array($receiptId));
    if ($paid) throw new RuntimeException('سجل صرف لهذه العمولة؛ لا يمكن تغيير التوزيع.');
    $before = receiptCommissionRows($link, 'SELECT * FROM sanad_commission_splits WHERE idsanad=? ORDER BY split_id FOR UPDATE', array($receiptId));
    receiptCommissionQuery($link, 'DELETE FROM sanad_commission_splits WHERE idsanad=?', array($receiptId))->close();
    foreach ($rows as $row) {
        receiptCommissionQuery($link, 'INSERT INTO sanad_commission_splits
            (idsanad,representative_userid,commission_type,commission_value,commission_amount,created_by_userid,created_at)
            VALUES (?,?,?,?,?,?,?)', array($receiptId,$row['representative_userid'],$row['commission_type'],
                $row['commission_value'],$row['commission_amount'],intval($_SESSION['useridv'] ?? 0),time()))->close();
    }
    $summary = receiptCommissionSummary($rows);
    receiptCommissionQuery($link, 'UPDATE sanad SET sales_representative_userid=?,sales_commission_type=?,
        sales_commission_value=?,sales_commission_amount=? WHERE idsanad=?',
        array($summary['representative_userid'],$summary['type'],$summary['value'],$summary['amount'],$receiptId))->close();
    receiptCommissionQuery($link, 'INSERT INTO sanad_commission_audit (idsanad,changed_by_userid,changed_at,before_json,after_json)
        VALUES (?,?,?,?,?)', array($receiptId,intval($_SESSION['useridv'] ?? 0),time(),
        json_encode($before,JSON_UNESCAPED_UNICODE),json_encode($rows,JSON_UNESCAPED_UNICODE)))->close();
}

/** Include legacy and newly created receipts without recalculating historical commission. */
function receiptCommissionSource($link) {
    $legacy = "SELECT 0 split_id,s.idsanad,s.sales_representative_userid representative_userid,
        s.sales_commission_type commission_type,s.sales_commission_value commission_value,
        s.sales_commission_amount commission_amount FROM sanad s";
    if (!receiptCommissionReady($link)) return '(' . $legacy . ')';
    return '(SELECT split_id,idsanad,representative_userid,commission_type,commission_value,commission_amount
        FROM sanad_commission_splits UNION ALL ' . $legacy . '
        WHERE NOT EXISTS (SELECT 1 FROM sanad_commission_splits c WHERE c.idsanad=s.idsanad))';
}

function receiptCommissionLoad($link, $receipt) {
    if (receiptCommissionReady($link)) {
        $rows = receiptCommissionRows($link, 'SELECT * FROM sanad_commission_splits WHERE idsanad=? ORDER BY split_id', array(intval($receipt['idsanad'])));
        if ($rows) return $rows;
    }
    return array(array('representative_userid'=>intval($receipt['sales_representative_userid'] ?? 0),
        'commission_type'=>$receipt['sales_commission_type'] ?? 'percentage',
        'commission_value'=>$receipt['sales_commission_value'] ?? 0,
        'commission_amount'=>$receipt['sales_commission_amount'] ?? 0));
}

/** Copy an old snapshot verbatim, including posted receipts. Caller locks the receipt. */
function receiptCommissionMaterializeLegacy($link,$receipt) {
    $id=intval($receipt['idsanad']);
    $existing=receiptCommissionRows($link,'SELECT split_id FROM sanad_commission_splits WHERE idsanad=? LIMIT 1 FOR UPDATE',array($id));
    if ($existing) return;
    if (($receipt['sales_commission_type'] ?? '')==='split') throw new RuntimeException('تفاصيل توزيع السند مفقودة؛ راجع مسؤول النظام.');
    $row=array('representative_userid'=>intval($receipt['sales_representative_userid'] ?? 0),
        'commission_type'=>$receipt['sales_commission_type'] ?? 'percentage',
        'commission_value'=>$receipt['sales_commission_value'] ?? 0,
        'commission_amount'=>$receipt['sales_commission_amount'] ?? 0);
    receiptCommissionQuery($link,'INSERT INTO sanad_commission_splits
        (idsanad,representative_userid,commission_type,commission_value,commission_amount,created_by_userid,created_at)
        VALUES (?,?,?,?,?,?,?)',array($id,$row['representative_userid'],$row['commission_type'],$row['commission_value'],
        $row['commission_amount'],intval($_SESSION['useridv'] ?? 0),time()))->close();
    receiptCommissionQuery($link,'INSERT INTO sanad_commission_audit (idsanad,changed_by_userid,changed_at,before_json,after_json)
        VALUES (?,?,?,?,?)',array($id,intval($_SESSION['useridv'] ?? 0),time(),'[]',json_encode(array($row),JSON_UNESCAPED_UNICODE)))->close();
}

function receiptCommissionCreateFree($link, $data) {
    if (!receiptCommissionCan($link,'135','adds')) throw new RuntimeException('ليس لديك صلاحية إضافة سند قبض.');
    receiptCommissionCheckToken($data['receipt_commission_token'] ?? '');
    if (!receiptCommissionReady($link)) throw new RuntimeException('افتح إدارة الأملاك أولاً لتثبيت تحديث العمولات.');
    $amount = receiptCommissionCents($data['depositeamount'] ?? '') / 100;
    $vatInput = $data['depositeamount_vat'] ?? '0';
    $vat = receiptCommissionCents($vatInput === '' ? '0' : $vatInput) / 100;
    if ($vat > $amount) throw new RuntimeException('الضريبة تتجاوز مبلغ السند.');
    $name = trim((string)($data['mostagername'] ?? ''));
    $description = trim((string)($data['mybyan'] ?? ''));
    if ($name==='' || mb_strlen($name)>245 || mb_strlen($description)>245) throw new RuntimeException('أدخل اسم المستفيد وبياناً ضمن الطول المسموح.');
    $period = trim((string)($data['period'] ?? ''));
    $date = DateTimeImmutable::createFromFormat('!d/m/Y',$period,new DateTimeZone('Asia/Riyadh'));
    if (!$date || $date->format('d/m/Y')!==$period || intval($date->format('Y'))<1900) throw new RuntimeException('أدخل تاريخ سند ميلادياً صحيحاً بصيغة يوم/شهر/سنة.');
    $uid = (string)($data['formuid'] ?? '');
    if (!preg_match('/^[a-zA-Z0-9]{20,100}$/D',$uid)) throw new RuntimeException('تعذر التحقق من النموذج. أعد تحميل الصفحة.');
    $shares = receiptCommissionParse($data,$amount,$link);
    $lockName = 'receipt:' . substr(hash('sha256',receiptCommissionRows($link,'SELECT DATABASE() db')[0]['db'] . ':' . $uid),0,48);
    $lock = receiptCommissionRows($link,'SELECT GET_LOCK(?,5) acquired',array($lockName));
    if (empty($lock[0]['acquired'])) throw new RuntimeException('السند قيد الحفظ، حاول بعد لحظات.');
    try {
        mysqli_begin_transaction($link);
        $existing = receiptCommissionRows($link,'SELECT idsanad FROM sanad WHERE formuid=? LIMIT 1',array($uid));
        if ($existing) { mysqli_commit($link); return intval($existing[0]['idsanad']); }
        $method = intval($data['payment_type'] ?? 1);
        if (!in_array($method,array(1,2,3,4,5),true)) throw new RuntimeException('طريقة الدفع غير صحيحة.');
        $creator = receiptCommissionRows($link,"SELECT COALESCE(NULLIF(name,''),username) label FROM user WHERE userid=?",array(intval($_SESSION['useridv'] ?? 0)));
        receiptCommissionQuery($link,'INSERT INTO sanad
            (period,mostagerid,mostagername,depositeamount,recivername,mybyan,sanadrakam,idaqar,idsubaqar,sanaddate,
            cheqnumber,cheqon,cheqdate1,attachedimages,kastid,commesion_vat,depositeamount_vat,payment_type,
            notes,suppliervatnumber,suppliername,mostagervatnumber,formuid)
            VALUES (?,0,?,?,?,?,?,0,0,?,?,?,?,?,0,0,?,?,?,?,?,?,?)',
            array($period,$name,$amount,$creator[0]['label'] ?? '',$description,(string)($data['sanadrakam'] ?? ''),$date->getTimestamp(),
            (string)($data['cheqnumber'] ?? ''),(string)($data['cheqon'] ?? ''),(string)($data['cheqdate1'] ?? ''),'',
            $vat,$method,(string)($data['notes'] ?? ''),(string)($data['suppliervatnumber'] ?? ''),
            (string)($data['suppliername'] ?? ''),(string)($data['mostagervatnumber'] ?? ''),$uid))->close();
        $id = mysqli_insert_id($link);
        receiptCommissionSave($link,$id,$shares);
        mysqli_commit($link);
        return $id;
    } catch (Throwable $error) {
        mysqli_rollback($link); throw $error;
    } finally {
        receiptCommissionRows($link,'SELECT RELEASE_LOCK(?) released',array($lockName));
    }
}

function receiptCommissionPaymentOptions($link,$selectedSplitId=0) {
    if (!receiptCommissionReady($link)) return array();
    $scope = receiptCommissionScope($link);
    $selectedSql = $selectedSplitId>0 ? ' AND c.split_id=?' : '';
    return receiptCommissionRows($link,"SELECT c.*,s.mostagername,s.sanaddate,
        COALESCE(NULLIF(u.name,''),u.username,CONCAT('مندوب #',c.representative_userid)) representative_name,
        COALESCE(p.paid,0) paid,c.commission_amount-COALESCE(p.paid,0) outstanding
        FROM sanad_commission_splits c JOIN sanad s ON s.idsanad=c.idsanad
        LEFT JOIN user u ON u.userid=c.representative_userid
        LEFT JOIN (SELECT commission_split_id,SUM(amount) paid FROM masrofat WHERE idaqar=0
            AND commission_split_id>0 GROUP BY commission_split_id) p ON p.commission_split_id=c.split_id
        WHERE c.representative_userid>0 AND c.commission_amount>COALESCE(p.paid,0) AND {$scope}{$selectedSql}
        ORDER BY s.sanaddate DESC,c.split_id DESC LIMIT 1000",$selectedSplitId>0 ? array(intval($selectedSplitId)) : array());
}

/** Serialize payouts on the parent receipt so concurrent requests cannot overpay. */
function receiptCommissionRecordExpense($link,$sql,$splitId,$uid,$amount,$beneficiaryId,$expenseTimestamp) {
    require_once __DIR__ . '/expense_payment_voucher_helpers.hnt';
    if (!expensePaymentVoucherReady($link)) throw new RuntimeException('افتح إدارة الأملاك أولاً لتثبيت تحديث سندات صرف المصروفات.');
    $expenseLock=expensePaymentVoucherLock($link,$uid);
    mysqli_begin_transaction($link);
    try {
        $duplicate = receiptCommissionRows($link,'SELECT idmasrof FROM masrofat WHERE idaqar=0 AND formuid=? LIMIT 1 FOR UPDATE',array($uid));
        if ($duplicate) {
            $existingId=intval($duplicate[0]['idmasrof']);
            expensePaymentVoucherEnsure($link,$existingId);
            mysqli_commit($link); return $existingId;
        }
        if ($splitId>0) {
            if (!receiptCommissionCan($link,'voucher_commissions','sees')) throw new RuntimeException('ليس لديك صلاحية تسوية عمولات المندوبين.');
            $scope = receiptCommissionScope($link);
            $rows = receiptCommissionRows($link,"SELECT s.idsanad,s.sanaddate FROM sanad s JOIN sanad_commission_splits c
                ON c.idsanad=s.idsanad WHERE c.split_id=? AND {$scope} FOR UPDATE",array($splitId));
            if (!$rows) throw new RuntimeException('العمولة غير موجودة أو خارج الصلاحيات.');
            if (date('Y-m-d',$expenseTimestamp)<date('Y-m-d',intval($rows[0]['sanaddate']))) throw new RuntimeException('تاريخ صرف العمولة لا يسبق تاريخ سند القبض.');
            $shares = receiptCommissionRows($link,'SELECT * FROM sanad_commission_splits WHERE split_id=? FOR UPDATE',array($splitId));
            if (intval($shares[0]['representative_userid'])!==$beneficiaryId || $beneficiaryId<=0) throw new RuntimeException('المستفيد لا يطابق مندوب العمولة.');
            $payments = receiptCommissionRows($link,'SELECT amount FROM masrofat WHERE commission_split_id=? FOR UPDATE',array($splitId));
            $paidAmount=array_sum(array_column($payments,'amount'));
            if ((int)round(($paidAmount+$amount)*100) > (int)round($shares[0]['commission_amount']*100)) {
                throw new RuntimeException('مبلغ الصرف يتجاوز الرصيد المتبقي للعمولة.');
            }
        }
        receiptCommissionQuery($link,$sql)->close();
        $id = mysqli_insert_id($link);
        expensePaymentVoucherEnsure($link,$id);
        mysqli_commit($link);
        return $id;
    } catch (Throwable $error) {
        mysqli_rollback($link); throw $error;
    } finally {
        receiptCommissionRows($link,'SELECT RELEASE_LOCK(?) released',array($expenseLock));
    }
}
