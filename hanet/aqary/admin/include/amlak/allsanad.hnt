// Pagination
$rownum = (int)receiptCommissionRows($link, "SELECT COUNT(*) dd FROM sanad s LEFT JOIN amlak a ON a.idaqar = s.idaqar {$receiptWhere}", $receiptValues)[0]['dd'];
$rowperpage = $receiptFilters['rowperpage'];
$pagenum = (int)ceil($rownum / $rowperpage);
$receiptPage = max(1, min($receiptFilters['page'], $pagenum));

// Display count
echo '<div class="alert alert-info mb-3">';
echo '<i class="bi bi-info-circle me-2"></i>';
echo 'عدد السندات: <strong class="text-danger">' . $rownum . '</strong> سند';
echo '</div>';

// Pagination
if ($pagenum > 1) {
    echo '<nav aria-label="Page navigation"><ul class="pagination justify-content-center">';
    for ($xi = 1; $xi <= $pagenum; $xi++) {
        $active = ($receiptPage == $xi) ? 'active' : '';
        if (($xi > ($receiptPage - 4) && $xi < ($receiptPage + 4)) || $xi == 1 || $xi == $pagenum || $xi < 4 || $xi > ($pagenum - 4)) {
            echo '<li class="page-item ' . $active . '"><a class="page-link" href="allsanad.hnt?' . htmlspecialchars(http_build_query(receiptSearchQuery($receiptFilters) + ['page' => $xi]), ENT_QUOTES, 'UTF-8') . '">' . $xi . '</a></li>';
        } elseif ($xi == ($receiptPage - 4) || $xi == ($receiptPage + 4)) {
            echo '<li class="page-item disabled"><span class="page-link">...</span></li>';
        }
    }
    echo '</ul></nav>';
}

// Get vouchers
$limit = ($receiptPage - 1) * $rowperpage;
$receiptRows = receiptCommissionRows($link, "SELECT s.*, a.aqarname FROM sanad s LEFT JOIN amlak a ON a.idaqar = s.idaqar {$receiptWhere}
    ORDER BY s.idsanad DESC LIMIT {$limit},{$rowperpage}", $receiptValues);
