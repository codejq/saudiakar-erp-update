<?php
$sc_title = 'طباعة عهدة نقدية';
require_once __DIR__ . '/cash_custody_bootstrap.hnt';
$requestId = intval($_GET['request_id'] ?? 0);
$request = $requestId ? $cashCustodyService->getRequest($requestId) : null;
$custodyId = intval($_GET['id'] ?? 0);
$custody = $request ? null : $cashCustodyService->getCustody($custodyId);
$transactions = $custody ? $cashCustodyService->listTransactions($custodyId) : array();
ccRenderStart($request ? 'طلب العهدة ' . $request['request_number'] : ($custody ? 'كشف العهدة ' . $custody['custody_number'] : 'كشف العهدة'), 'custodies');
if($request): ?>
<section class="cc-card"><div class="cc-actions cc-no-print"><button class="cc-btn cc-primary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة</button></div><h2>طلب عهدة نقدية</h2><div class="cc-form-grid"><p><strong>رقم الطلب:</strong> <?= ccEsc($request['request_number']) ?></p><p><strong>صاحب العهدة:</strong> <?= ccEsc($request['holder_name']) ?></p><p><strong>الرقم الوظيفي:</strong> <?= ccEsc($request['employee_number']) ?></p><p><strong>نوع الطلب:</strong> <?= ccEsc(ccTypeLabel($request['request_type'])) ?></p><p><strong>المبلغ:</strong> <?= ccMoney($request['requested_amount']) ?> ر.س</p><p><strong>التاريخ المطلوب:</strong> <?= ccEsc($request['required_date']) ?></p><p><strong>الحالة:</strong> <?= ccEsc(ccStatusLabel($request['status'])) ?></p></div><hr><p><strong>الغرض:</strong> <?= nl2br(ccEsc($request['purpose'])) ?></p><p><strong>ملاحظة القرار:</strong> <?= nl2br(ccEsc($request['decision_note'])) ?></p></section>
<?php elseif(!$custody): ?><div class="cc-alert error">العهدة أو الطلب غير موجود.</div><?php else: ?>
<section class="cc-card"><div class="cc-actions cc-no-print"><button class="cc-btn cc-primary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة</button></div><h2><?= ccEsc($custody['holder_name']) ?></h2><p>الرقم الوظيفي: <?= ccEsc($custody['employee_number']) ?> | تاريخ الفتح: <?= ccEsc($custody['opened_date']) ?> | الحالة: <?= ccEsc(ccStatusLabel($custody['status'])) ?></p></section>
<section class="cc-grid"><div class="cc-card cc-stat"><span>التمويل</span><strong><?= ccMoney($custody['totals']['funding']) ?></strong></div><div class="cc-card cc-stat"><span>المصروفات</span><strong><?= ccMoney($custody['totals']['expenses']) ?></strong></div><div class="cc-card cc-stat"><span>المردود</span><strong><?= ccMoney($custody['totals']['returns']) ?></strong></div><div class="cc-card cc-stat"><span>الرصيد</span><strong><?= ccMoney($custody['totals']['balance']) ?></strong></div></section>
<section class="cc-card cc-scroll"><table class="cc-table"><thead><tr><th>التاريخ</th><th>المستند</th><th>النوع</th><th>البيان</th><th>المبلغ</th><th>الحالة</th></tr></thead><tbody><?php foreach($transactions as $row): ?><tr><td><?= ccEsc($row['transaction_date']) ?></td><td><?= ccEsc($row['document_number']) ?></td><td><?= ccEsc(ccTypeLabel($row['transaction_type'])) ?></td><td><?= ccEsc($row['description']) ?></td><td><?= ccMoney($row['amount']) ?></td><td><?= ccEsc(ccStatusLabel($row['status'])) ?></td></tr><?php endforeach; ?></tbody></table></section>
<?php endif; ccRenderEnd($cashCustodyCsrf); ?>

