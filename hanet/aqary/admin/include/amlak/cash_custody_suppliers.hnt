<?php
$sc_title = 'موردو مصروفات العهد';
require_once __DIR__ . '/cash_custody_bootstrap.hnt';
$registered = $cashCustodyService->listSuppliers();
$snapshots = $cashCustodyService->listTypedSupplierSummary();
ccRenderStart('موردو مصروفات العهد', '');
?>
<div class="cc-card cc-actions cc-no-print"><a class="cc-btn cc-primary" href="/aqary/admin/accounting/modules/suppliers/index.hnt"><i class="bi bi-box-arrow-up-left"></i> إدارة الموردين في المحاسبة</a></div>
<section class="cc-card"><h2>الموردون المسجلون في المحاسبة</h2><?php if(!$registered): ?><div class="cc-alert">جدول الموردين المحاسبي غير متوفر أو لا توجد سجلات نشطة. يمكن كتابة اسم المورد داخل المصروف.</div><?php else: ?><div class="cc-scroll"><table class="cc-table"><thead><tr><th>المورد</th><th>الرقم الضريبي</th><th>رقم السجل</th></tr></thead><tbody><?php foreach($registered as $supplier): ?><tr><td><?= ccEsc($supplier['supplier_name']) ?></td><td><?= ccEsc($supplier['vat_number']) ?></td><td><?= intval($supplier['supplier_id']) ?></td></tr><?php endforeach; ?></tbody></table></div><?php endif; ?></section>
<section class="cc-card"><h2>موردون مكتوبون في حركات العهد</h2><div class="cc-scroll"><table class="cc-table"><thead><tr><th>الاسم المحفوظ</th><th>الرقم الضريبي</th><th>عدد الفواتير</th><th>المصروفات المعتمدة</th></tr></thead><tbody><?php foreach($snapshots as $supplier): ?><tr><td><?= ccEsc($supplier['supplier_name']) ?></td><td><?= ccEsc($supplier['supplier_vat_number']) ?></td><td><?= intval($supplier['invoice_count']) ?></td><td><?= ccMoney($supplier['approved_amount']) ?></td></tr><?php endforeach; ?><?php if(!$snapshots): ?><tr><td colspan="4" class="cc-empty">لا توجد أسماء موردين مكتوبة يدوياً.</td></tr><?php endif; ?></tbody></table></div></section>
<?php ccRenderEnd($cashCustodyCsrf); ?>

