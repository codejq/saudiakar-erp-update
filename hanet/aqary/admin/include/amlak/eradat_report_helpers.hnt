<?php
/**
 * Reports must never delete income rows. A row is skipped from display only when
 * every identifying value repeats one already shown; an empty receipt number is
 * shared by unrelated legacy rows and never marks a duplicate.
 */
function eradatReportIsRepeated($row, &$seen) {
    $receipt = trim((string)($row['sanadrakam'] ?? ''));
    if ($receipt === '' || $receipt === '0') return false;
    $parts = array($receipt);
    foreach (array('idaqar', 'idsubaqar', 'mostagerid', 'mostagername', 'amount', 'paymentdate',
        'mysa3ee', 'mywater', 'services', 'tamen', 'kastid') as $field) {
        $parts[] = (string)($row[$field] ?? '');
    }
    $key = implode('|', $parts);
    if (isset($seen[$key])) return true;
    $seen[$key] = true;
    return false;
}
