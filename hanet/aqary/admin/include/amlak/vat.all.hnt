        <!-- Advanced Filter Card -->
        <div class="filter-card">
            <h3>
                <i class="bi bi-funnel"></i>
                تصفية متقدمة
            </h3>
            <form method="get" action="?" id="filterForm">
                <input type="hidden" name="formuid" value="<?= str_replace('.', '', microtime() . rand(11111, 99999)); ?>">

                <div class="filter-grid">
                    <div class="form-group">
                        <label>اختر العقار</label>
                        <select name="idaqar" id="idaqar" class="form-control">
                            <option value="">جميع العقارات</option>
                            <?php
                            $sql = "SELECT idaqar, aqarname FROM amlak ORDER BY aqarname";
                            $result = mysql_query($sql, $link);
                            while ($row = mysql_fetch_array($result)) {
                                $selected = ($receiptFilters['idaqar'] === (int)$row['idaqar']) ? 'selected' : '';
                                echo "<option value='{$row['idaqar']}' {$selected}>{$row['aqarname']}</option>";
                            }
