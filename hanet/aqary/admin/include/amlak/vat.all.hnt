        <!-- Stats and Pagination Bar -->
        <div class="stats-bar">
            <div class="stats-info">
                <i class="bi bi-file-text"></i>
                عدد السندات: <span class="stats-count"><?= number_format($rownum) ?></span> سند
            </div>

            <div class="pagination">
                <?php
                $xi = 1;
                if ($pagenum == 1) {
                    $xi = 2;
                }

                while ($xi <= $pagenum) {
                    $activeClass = ($receiptPage == $xi) ? 'active' : '';

                    if (($xi > ($receiptPage - 4) && $xi < ($receiptPage + 4)) ||
                        $xi == 1 || $xi == $pagenum ||
                        $xi < 4 || $xi > ($pagenum - 4)) {
                        echo "<button type='button' class='page-btn {$activeClass}' onclick=\"window.location.href='vat.all.hnt?" . htmlspecialchars(http_build_query(receiptSearchQuery($receiptFilters) + ['page' => $xi]), ENT_QUOTES, 'UTF-8') . "'\">{$xi}</button>";
                    } elseif ($xi == ($receiptPage - 4) || $xi == ($receiptPage + 4)) {
                        echo "<span style='padding: 0 0.25rem;'>...</span>";
                    }
                    $xi++;
                }
                ?>
            </div>
        </div>

        <!-- Results Table -->
        <div class="results-table">
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>رقم السند</th>
                            <th>اسم المستأجر</th>
                            <th>المبلغ</th>
                            <th>المستلم</th>
                            <th>البيان</th>
                            <th>العقار</th>
                            <th>التاريخ</th>
                            <th>مرفقات</th>
                            <th>عرض</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php
                        $receiptRows = receiptCommissionRows($link, "SELECT s.idsanad, s.period, s.mostagerid, s.mostagername,
                                s.recivername, s.mybyan, s.sanadrakam, s.idaqar, s.idsubaqar, a.aqarname,
                                s.sanaddate, s.cheqnumber, s.cheqon, s.cheqdate1, s.attachedimages,
                                s.kastid, s.depositeamount AS receipt_amount,
                                (s.commesion_vat + s.depositeamount_vat) as depositeamount
                                FROM sanad s LEFT JOIN amlak a ON a.idaqar = s.idaqar {$receiptWhere}
                                ORDER BY " . RECEIPT_DATE_ORDER_SQL . " DESC, s.idsanad DESC
                                LIMIT {$limit}", $receiptValues);
                        $counx = 0;

                        foreach ($receiptRows as $row) {
                            $counx++;

                            // Attachment link
                            if ($row['attachedimages']) {
                                $attachedimagelink = "<a href='/aqary/admin/include/uploadcenter.hnt?ids={$row['attachedimages']}&table=sanad&tableid=idsanad&tableidvalue={$row['idsanad']}'
                                    class='attachment-link' target='_blank' title='انقر لعرض الملفات المرفقة'>
                                    <i class='bi bi-paperclip'></i></a>";
                            } else {
                                $attachedimagelink = "<a href='/aqary/admin/include/uploadcenter.hnt?ids=0,0&table=sanad&tableid=idsanad&tableidvalue={$row['idsanad']}'
                                    class='attachment-link' target='_blank' title='لا يوجد مرفقات - انقر لإضافة'>
                                    <i class='bi bi-link-45deg'></i></a>";
                            }

                            // Format date
                            if ((int)$row['sanaddate'] < 86400) {
                                $dhd = htmlspecialchars((string)$row['period'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
                            } elseif ($hnt_dll || $hnt_supper_dll == 5) {
                                $dhd = date("d/m/Y", $row['sanaddate']);
                            } else {
                                $dhd = ArabicTools::arabicDate('hj:d/m/Y', $row['sanaddate']);
                            }

                            $vatTooLarge = (float)$row['depositeamount'] > (float)$row['receipt_amount'];
                            echo "<tr" . ($vatTooLarge ? " style='background:#fde2e2' title='الضريبة أكبر من مبلغ السند - راجع السند'" : "") . ">
                                <td>{$row['idsanad']}</td>
                                <td>" . htmlspecialchars((string)$row['mostagername'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . "</td>
                                <td>" . number_format($row['depositeamount'], 2) . "</td>
                                <td>" . htmlspecialchars((string)$row['recivername'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . "</td>
                                <td>ضريبة " . htmlspecialchars((string)$row['mybyan'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . "</td>
                                <td>" . htmlspecialchars((string)$row['aqarname'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . "</td>
                                <td>{$dhd}</td>
                                <td>{$attachedimagelink}</td>
                                <td>
                                    <a href='selectprintform.hnt?formtype=recivevoucher&id={$row['idsanad']}'
                                       class='btn-view'
                                       target='_blank'>
                                       <i class='bi bi-eye'></i> عرض
                                    </a>
                                </td>
                            </tr>";
                        }

                        if ($counx == 0) {
                            echo "<tr><td colspan='9' style='padding: 2rem; text-align: center; color: #64748b;'>
                                <i class='bi bi-inbox' style='font-size: 3rem; display: block; margin-bottom: 1rem; opacity: 0.5;'></i>
                                لا توجد سندات ضريبية تطابق معايير البحث
                            </td></tr>";
                        }
                        ?>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
/**
 * VAT All Collected - Modern JavaScript
 */

document.addEventListener('DOMContentLoaded', function() {
    console.log('VAT All Collected page initialized');

    // Number input validation for date fields
    const dateInputs = document.querySelectorAll('.date-input');
    dateInputs.forEach(input => {
        input.addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    });
});
</script>

<iframe style="display:none" name="wordd" id="wordd"></iframe>

