                            <input type="text" name="dd" class="date-input" placeholder="يوم" value="<?= $daxx[3] ?>">
                            <span class="date-separator">/</span>
                            <input type="text" name="mm" class="date-input" placeholder="شهر" value="<?= $daxx[4] ?>">
                            <span class="date-separator">/</span>
                            <input type="text" name="yy" class="date-input" placeholder="سنة" value="<?= $daxx[5] ?>" style="width: 80px;">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>إلى تاريخ</label>
                        <div class="date-range">
                            <input type="text" name="dd2" class="date-input" placeholder="يوم" value="<?= $dax2[3] ?>">
                            <span class="date-separator">/</span>
                            <input type="text" name="mm2" class="date-input" placeholder="شهر" value="<?= $dax2[4] ?>">
                            <span class="date-separator">/</span>
                            <input type="text" name="yy2" class="date-input" placeholder="سنة" value="<?= $dax2[5] ?>" style="width: 80px;">
