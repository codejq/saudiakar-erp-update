<?php
/**
 * All Collected VAT Report
 * Displays all collected VAT with search and filtering capabilities
 */

$sc_title = "عرض جميع الضرائب المحصلة";
$sc_id = "136";

include_once "../../../nocash.hnt";
include_once "../../../header.hnt";
require '../arabicTools.class.hnt';
require '../uCal.class.hnt';
$dcal = new uCal;
require_once __DIR__ . '/receipt_search.hnt';
$receiptFilters = receiptSearchFilters($_GET, $dcal);

// Initialize date range
$startfrom = $receiptFilters['from'] ?: time();
$enddate = $receiptFilters['to'] ?: time() + (30 * 86400);

if (!$hnt_dll && $hnt_supper_dll != 5) {
    $dateo = $dcal->g2u(date("d", $startfrom), date("m", $startfrom), date("Y", $startfrom));
    $daxx[3] = $dateo['day'];
    $daxx[4] = $dateo['month'];
    $daxx[5] = $dateo['year'];
    $dateo = $dcal->g2u(date("d", $enddate), date("m", $enddate), date("Y", $enddate));
    $dax2[3] = $dateo['day'];
    $dax2[4] = $dateo['month'];
    $dax2[5] = $dateo['year'];
} else {
    $daxx[3] = date("d", $startfrom);
    $daxx[4] = date("m", $startfrom);
    $daxx[5] = date("Y", $startfrom);
    $dax2[3] = date("d", $enddate);
    $dax2[4] = date("m", $enddate);
    $dax2[5] = date("Y", $enddate);
}

[$receiptWhere, $receiptValues] = receiptSearchWhere($receiptFilters);
$receiptWhere .= ($receiptWhere === '' ? ' WHERE ' : ' AND ') . '(s.commesion_vat > 0 OR s.depositeamount_vat > 0)';

// Pagination
$receiptCount = receiptCommissionRows($link, "SELECT COUNT(*) AS receipts, COALESCE(SUM(s.commesion_vat + s.depositeamount_vat), 0) AS total
    FROM sanad s LEFT JOIN amlak a ON a.idaqar = s.idaqar {$receiptWhere}", $receiptValues)[0];
$rownum = (int)$receiptCount['receipts'];
$rowperpage = $receiptFilters['rowperpage'];
$pagenum = (int)ceil($rownum / $rowperpage);
$receiptPage = max(1, min($receiptFilters['page'], $pagenum));
$limit = ($receiptPage - 1) * $rowperpage . ',' . $rowperpage;
?>

<style>
