function notifi_for_rent($number_of_days , $message_type , $notifi_field_name ){
	global $link,$dcal,$lusername,$lpassword;
	$result=mysql_query("select * from global ",$link);
	while($gl=mysql_fetch_array($result))
	{
		$GLOBALS[$gl['variblename']]=$gl['valuribalevalue'];
	}


	if(strpos($notifi_field_name , "ast_re")){
		$frist_notifi_field_name =  str_replace("last_re","last_" ,$notifi_field_name);
		$condition  = " and $frist_notifi_field_name > 0 and $notifi_field_name =0 " ;
	}
	else{
		$condition  = " and  $notifi_field_name =0 " ;
	}

	$sql="SELECT  aksat.*  FROM  aksat,amlakdetails where aksat.iscomplete=0 	and aksat.idsubaqar=amlakdetails.idsubaqar
			and aksat.kastdate<'".(time() + $number_of_days  * 86400 )."'
			and aksat.kastdate > '".(time() - 60 * 86400 )."' $condition
			order by aksat.idsubaqar  limit 1   ";
	$result=mysql_query($sql,$link);

	?>
	<table border=0 bgcolor=#808080  cellspacing=1 width=98%>
	<tr style='color:#ffffff' align=center>
	<td>اسم المستأجر </td>
	<td>هاتف</td>
	<td>العقار</td>
	<td>الوحدة</td>
	<td>القسط المستحق </td>
	<td>قيمة القسط </td>
	<td>المدفوع</td>
	<td>المتبقي</td>
	<td>تاريخ الإستحقاق</td>
	 </tr>
	<?
	$counx=0;
    $local_address ="http://127.0.0.1:9009";
	while($row=mysql_fetch_array($result)){




	$mydatem=time();

	if($row['kastdate'] < $mydatem ||$row['kastdate']==$mydatem )
	{$egareded[]=$row['kastid'];}
	elseif( ($row['kastdate']-(2592000)) < $mydatem ||($row['kastdate']-(2592000))==$mydatem )
	{$egarreq[]=$row['kastid'];}

	$sqlm="select mostagereen.mostagerid,mostagereen.mostagername,mostagereen.mostagertel,mostagereen.mostageremail
	,amlakdetails.rakam,amlakdetails.aqarsubtype,amlakdetails.idaqar,amlakdetails.hnt_dll_type
	from mostagereen, amlakdetails  where  amlakdetails.mostagerid=mostagereen.mostagerid and amlakdetails.idsubaqar='".$row['idsubaqar']."' ";
	$rowm=mysql_fetch_array(mysql_query($sqlm,$link));

	if($rowm['hnt_dll_type']==1 or $rowm['hnt_dll_type']==="0"){$hnt_dll=$rowm['hnt_dll_type']; }else	{$hnt_dll=$hnt_dll_defult;}
	if($hnt_dll){
		$collection_date =  date("d/m/Y",$row['kastdate']);
	}
	else
	{
		$dateo = $dcal->g2u(date("d",$row['kastdate']),date("m",$row['kastdate']),date("Y",$row['kastdate']));
		$collection_date =  "$dateo['day']/$dateo['month']/$dateo['year']";
	}


	if($message_type == "sms"){
		//$message_to = $rowm['mostagertel'];
		$mailreadydata=file_get_contents(  $local_address."/aqary/admin/include/amlak/letter.hnt?mostagerid=$rowm['mostagerid']&idsubaqar=$row['idsubaqar']&hnt_dll=$hnt_dll&sendsms=1&username=$lusername&password=$lpassword");
		$mailreadydata=explode("##@@##",$mailreadydata);
		$message_to=$mailreadydata[1];
		$message_body=$mailreadydata[2];
	}
	if($message_type == "email"){
		//$message_to = $rowm['mostageremail'];
		$mailreadydata=file_get_contents(  $local_address."/aqary/admin/include/amlak/letter.hnt?mostagerid=$rowm['mostagerid']&idsubaqar=$row['idsubaqar']&hnt_dll=$hnt_dll&sendmail=1&username=$lusername&password=$lpassword");
		$mailreadydata=explode("##@@##",$mailreadydata);
		$message_to=$mailreadydata[1];
		$message_title=$mailreadydata[2];
		$message_body=$mailreadydata[3];
	}

	if(stripos($notifi_field_name,"collector_")){
		if($message_type == "sms"){
			$message_to = $tel_to_recive_rent_notifications;
			$message_body =   " يحل ايجار المستأجر : ".$rowm['mostagername']."\r\n هاتف : " .$rowm['mostagertel']
								."\r\nفي تاريخ " .$collection_date . "\r\n المبلغ : " .($row['kastvalue']-$row['dof3at']);
		}
		if($message_type == "email"){
			$message_to = $email_to_recive_rent_notifications;
			$message_title = "تنبيه ايجار ".$rowm['mostagername']." هاتف : " .$rowm['mostagertel'] ;
			$message_body =  " يحل ايجار المستأجر : ".$rowm['mostagername']."<br>\r\n هاتف : " .$rowm['mostagertel']
								."<br>\r\nفي تاريخ " .$collection_date . "<br>\r\n المبلغ : " .($row['kastvalue']-$row['dof3at']);
		}
	}

	sendmessage($message_to , $message_title , $message_body);

	 ?>

	<tr style='cursor:hand'   class='gridrow' id='row-<?=$row['idsubaqar'];?>_<?=$row['kastid'];?>'

	onclick="showcontextlayer(this,'<?=$row['idsubaqar'];?>%26mostagerid=<?=$rowm['mostagerid'];?>%26hnt_dll=<?=$hnt_dll;?>');"
	 align=center  bgcolor=#f2f2f2 onMouseOver=this.bgColor='#f2f2f2'; onMouseOut=this.bgColor='#f2f2f2';>


	<td><?=$rowm['mostagername'];?></td>
	<td><?=$rowm['mostagertel'];?><?=$rowm['mostageremail'];?></td>
	<td><?=displayaqarname($rowm['idaqar']);?></td>
	<td><?echo displaysubtype($rowm['aqarsubtype'])." رقم ". $rowm['rakam'];?></td>
	<td>القسط رقم <?=$row['kastname'];?> </td>
	<td><?=$row['kastvalue'];?> <?=$myomla;?></td>
	<td><?=$row['dof3at'];?></td>
	<td><?=$row['kastvalue']-$row['dof3at'];?></td>
	<td>
	<?
	if($rowm['hnt_dll_type']==1 or $rowm['hnt_dll_type']==="0")
	{$hnt_dll=$rowm['hnt_dll_type']; }else
	{$hnt_dll=$hnt_dll_defult;}

		if($hnt_dll){
			echo date("d/m/Y",$row['kastdate']);
		}
		else
		{
			//echo  ArabicTools::arabicDate('hj:d/m/Y', $row['kastdate']);
			$dateo = $dcal->g2u(date("d",$row['kastdate']),date("m",$row['kastdate']),date("Y",$row['kastdate']));
			echo"$dateo['day']/$dateo['month']/$dateo['year']";
		}
	?>
	</td></tr>



	<?
		mysql_query("update aksat set $notifi_field_name =".time()." where kastid = $row['kastid'] ");
	}
	?>
	</table>



<?
}


