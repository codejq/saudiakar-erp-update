<?php
$sc_title = 'أصحاب العهد النقدية';
require_once __DIR__ . '/cash_custody_bootstrap.hnt';
$holders = $cashCustodyService->listHolders(false);
$users = $cashCustodyService->listUsers();
$defaultPrefix = $cashCustodyService->getSetting('cash_custody_default_prefix', 'CUS');
ccRenderStart('إدارة أصحاب العهد', 'holders');
?>
<div class="cc-card cc-actions cc-no-print">
    <button class="cc-btn cc-primary policy_<?= intval($sc_id) ?>_adds" onclick="ccEditHolder()"><i class="bi bi-person-plus"></i> إضافة صاحب عهدة</button>
</div>
<section class="cc-card cc-scroll">
    <table class="cc-table">
        <thead><tr><th>المستخدم</th><th>الرقم الوظيفي</th><th>الهوية</th><th>الجوال</th><th>القسم</th><th>بادئة الرقم</th><th>الحالة</th><th class="cc-no-print">الإجراء</th></tr></thead>
        <tbody>
        <?php foreach ($holders as $holder): ?>
            <tr>
                <td><?= ccEsc($holder['user_name']) ?></td><td><?= ccEsc($holder['employee_number']) ?></td><td><?= ccEsc($holder['national_id']) ?></td>
                <td><?= ccEsc($holder['phone']) ?></td><td><?= ccEsc($holder['department']) ?></td><td><?= ccEsc($holder['number_prefix']) ?></td>
                <td><span class="cc-badge <?= intval($holder['is_active']) ? '' : 'closed' ?>"><?= intval($holder['is_active']) ? 'نشط' : 'موقوف' ?></span></td>
                <td class="cc-no-print"><button class="cc-btn cc-secondary policy_<?= intval($sc_id) ?>_edits" type="button" onclick='ccEditHolder(<?= json_encode($holder, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>)'><i class="bi bi-pencil"></i> تعديل</button></td>
            </tr>
        <?php endforeach; ?>
        <?php if (!$holders): ?><tr><td colspan="8" class="cc-empty">لم تتم إضافة أصحاب عهد بعد.</td></tr><?php endif; ?>
        </tbody>
    </table>
</section>
<div class="cc-modal" id="holderModal"><div class="cc-modal-box">
    <div class="cc-modal-head"><h2 id="holderModalTitle">إضافة صاحب عهدة</h2><button class="cc-close" onclick="ccClose('holderModal')">×</button></div>
    <form id="holderForm" onsubmit="return ccSubmit(this)">
        <input type="hidden" name="action" value="save_holder"><input type="hidden" name="holder_id" id="holder_id" value="0">
        <div class="cc-form-grid">
            <div class="cc-field"><label>مستخدم النظام *</label><select name="user_id" id="holder_user_id" required><option value="">اختر المستخدم</option><?php foreach ($users as $user): ?><option value="<?= intval($user['userid']) ?>"><?= ccEsc(trim((string)$user['name']) ?: $user['username']) ?></option><?php endforeach; ?></select></div>
            <div class="cc-field"><label>الرقم الوظيفي *</label><input name="employee_number" id="holder_employee_number" maxlength="100" required></div>
            <div class="cc-field"><label>رقم الهوية</label><input name="national_id" id="holder_national_id" maxlength="50"></div>
            <div class="cc-field"><label>رقم الجوال</label><input name="phone" id="holder_phone" maxlength="50"></div>
            <div class="cc-field"><label>القسم</label><input name="department" id="holder_department" maxlength="150"></div>
            <div class="cc-field"><label>بادئة الترقيم *</label><input name="number_prefix" id="holder_prefix" maxlength="20" value="<?= ccEsc($defaultPrefix) ?>" dir="ltr" required></div>
            <div class="cc-field"><label>الحالة</label><select name="is_active" id="holder_active"><option value="1">نشط</option><option value="0">موقوف</option></select></div>
        </div>
        <div class="cc-actions" style="margin-top:16px"><button class="cc-btn cc-primary" type="submit">حفظ</button><button class="cc-btn cc-secondary" type="button" onclick="ccClose('holderModal')">إلغاء</button></div>
    </form>
</div></div>
<script>
function ccEditHolder(row){
    row=row||{}; document.getElementById('holderModalTitle').textContent=row.holder_id?'تعديل صاحب العهدة':'إضافة صاحب عهدة';
    document.getElementById('holder_id').value=row.holder_id||0; document.getElementById('holder_user_id').value=row.user_id||'';
    document.getElementById('holder_employee_number').value=row.employee_number||''; document.getElementById('holder_national_id').value=row.national_id||'';
    document.getElementById('holder_phone').value=row.phone||''; document.getElementById('holder_department').value=row.department||'';
    document.getElementById('holder_prefix').value=row.number_prefix||<?= json_encode($defaultPrefix) ?>; document.getElementById('holder_active').value=row.holder_id?String(row.is_active):'1'; ccOpen('holderModal');
}
</script>
<?php ccRenderEnd($cashCustodyCsrf); ?>

