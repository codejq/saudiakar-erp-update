<?php
require_once __DIR__ . '/receipt_commission_helpers.hnt';

function receiptCancellationToken() {
    if (empty($_SESSION['receipt_cancellation_token'])) $_SESSION['receipt_cancellation_token']=bin2hex(random_bytes(24));
    return $_SESSION['receipt_cancellation_token'];
}

function receiptCancellationAccountingReady($link) {
    return !empty(receiptCommissionRows($link,"SELECT 1 FROM INFORMATION_SCHEMA.TABLES
        WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='acc_journal_entries' LIMIT 1"));
}

/** Caller holds the parent receipt lock. Even draft journals must be resolved first. */
function receiptCancellationGuard($link,$receipt) {
    if (!empty($receipt['accounting_entry_id'])) throw new RuntimeException('لا يمكن إلغاء سند مرتبط بالمحاسبة. عالج القيد المحاسبي أولاً.');
    if (receiptCancellationAccountingReady($link) && receiptCommissionRows($link,"SELECT entry_id FROM acc_journal_entries
        WHERE sanad_id=? OR (reference_type='sanad' AND reference_id=?) LIMIT 1 FOR UPDATE",[(int)$receipt['idsanad'],(int)$receipt['idsanad']])) {
        throw new RuntimeException('للسند قيد محاسبي مرتبط؛ لا يمكن حذفه من إدارة الأملاك.');
    }
    if (receiptCommissionReady($link) && receiptCommissionRows($link,'SELECT m.idmasrof FROM masrofat m
        JOIN sanad_commission_splits c ON c.split_id=m.commission_split_id WHERE c.idsanad=? LIMIT 1 FOR UPDATE',[(int)$receipt['idsanad']])) {
        throw new RuntimeException('تم صرف عمولة من هذا السند؛ لا يمكن إلغاؤه أو تغيير ارتباطه بالقسط.');
    }
}

function receiptCancellationLock($link,$receiptId) {
    $engines=receiptCommissionRows($link,"SELECT TABLE_NAME,ENGINE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE()
        AND TABLE_NAME IN ('sanad','aksat','eradat','sanadsarf')");
    if (count($engines)!==4) throw new RuntimeException('تعذر التحقق من جداول إلغاء السند.');
    foreach ($engines as $table) if (strcasecmp($table['ENGINE'],'InnoDB')!==0) throw new RuntimeException('افتح إدارة الأملاك لتثبيت تحديث الإلغاء الآمن للسندات.');
    $scope=receiptCommissionScope($link);
    $receipt=receiptCommissionRows($link,"SELECT s.* FROM sanad s WHERE s.idsanad=? AND {$scope} FOR UPDATE",[(int)$receiptId]);
    if (!$receipt) throw new RuntimeException('السند غير موجود أو خارج صلاحيات المستخدم.');
    receiptCancellationGuard($link,$receipt[0]);
    return $receipt[0];
}

function receiptCancellationRelink($link,$receiptId,$installmentId) {
    $link->begin_transaction();
    try {
        $receipt=receiptCancellationLock($link,$receiptId);
        $installment=receiptCommissionRows($link,'SELECT kastid FROM aksat WHERE kastid=? AND idsubaqar=? FOR UPDATE',[(int)$installmentId,(int)$receipt['idsubaqar']]);
        if (!$installment) throw new RuntimeException('القسط المحدد لا ينتمي إلى وحدة السند.');
        receiptCommissionQuery($link,'UPDATE sanad SET kastid=? WHERE idsanad=?',[(int)$installmentId,(int)$receiptId])->close();
        $link->commit();
    } catch (Throwable $error) { $link->rollback(); throw $error; }
}

function receiptCancellationDelete($link,$receiptId) {
    $link->begin_transaction();
    try {
        $receipt=receiptCancellationLock($link,$receiptId);
        $revenues=receiptCommissionRows($link,'SELECT iderad FROM eradat WHERE sanadrakam=? AND idaqar=? AND idsubaqar=? FOR UPDATE',
            [(int)$receiptId,(int)$receipt['idaqar'],(int)$receipt['idsubaqar']]);
        foreach ($revenues as $revenue) {
            $settlements=receiptCommissionRows($link,'SELECT * FROM sanadsarf WHERE iderad=? FOR UPDATE',[(int)$revenue['iderad']]);
            foreach ($settlements as $settlement) {
                if (!empty($settlement['accounting_entry_id']) || (receiptCancellationAccountingReady($link) && receiptCommissionRows($link,
                    "SELECT entry_id FROM acc_journal_entries WHERE sanadsarf_id=? OR (reference_type='sanadsarf' AND reference_id=?) LIMIT 1 FOR UPDATE",
                    [(int)$settlement['sanadid'],(int)$settlement['sanadid']]))) throw new RuntimeException('يوجد تسليم مالك مرتبط بالمحاسبة؛ لا يمكن إلغاء السند.');
            }
        }
        // Validate every dependency before deleting anything.
        foreach ($revenues as $revenue) {
            receiptCommissionQuery($link,'DELETE FROM sanadsarf WHERE iderad=?',[(int)$revenue['iderad']])->close();
            receiptCommissionQuery($link,'DELETE FROM eradat WHERE iderad=?',[(int)$revenue['iderad']])->close();
        }
        if (receiptCommissionReady($link)) {
            $shares=receiptCommissionRows($link,'SELECT * FROM sanad_commission_splits WHERE idsanad=? FOR UPDATE',[(int)$receiptId]);
            receiptCommissionQuery($link,'INSERT INTO sanad_commission_audit (idsanad,changed_by_userid,changed_at,before_json,after_json) VALUES (?,?,?,?,?)',
                [(int)$receiptId,(int)($_SESSION['useridv'] ?? 0),time(),json_encode($shares,JSON_UNESCAPED_UNICODE),'[]'])->close();
            receiptCommissionQuery($link,'DELETE FROM sanad_commission_splits WHERE idsanad=?',[(int)$receiptId])->close();
        }
        receiptCommissionQuery($link,'DELETE FROM sanad WHERE idsanad=?',[(int)$receiptId])->close();
        if ((int)$receipt['kastid']>0) receiptCommissionQuery($link,'UPDATE aksat SET dof3at=GREATEST(0,dof3at-?),iscomplete=0 WHERE kastid=?',
            [(float)$receipt['depositeamount'],(int)$receipt['kastid']])->close();
        $link->commit();
        return $receipt;
    } catch (Throwable $error) { $link->rollback(); throw $error; }
}
