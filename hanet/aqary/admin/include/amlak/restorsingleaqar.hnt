// Extract POST variables
extract($_REQUEST);

// Initialize variables
$idaqar = isset($idaqar) ? intval($idaqar) : 0;
$deleteaqar = isset($deleteaqar) ? intval($deleteaqar) : 0;
$step = isset($step) ? intval($step) : 1;
$ajax = isset($ajax) ? intval($ajax) : 0;

$sc_title = "تصفير بيانات عقار";
