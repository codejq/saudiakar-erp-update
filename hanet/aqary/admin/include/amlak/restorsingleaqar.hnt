<script>
// Modern ES6+ JavaScript

// Handle verification form submission
document.getElementById('verificationForm')?.addEventListener('submit', (e) => {
    e.preventDefault();

    const idaqar = document.getElementById('idaqar').value;
    const code = document.getElementById('code').value;
    const codeh = document.getElementById('codeh').value;

    if (!idaqar) {
        alert('يرجى اختيار العقار');
        return;
    }

    if (code !== codeh) {
        alert('كود التأكيد غير صحيح');
        return;
    }

    window.location.href = `restorsingleaqar.hnt?step=2&idaqar=${idaqar}`;
});

// Confirm and delete property
const confirmDelete = async (idaqar) => {
    const confirmText = 'هل أنت متأكد تماماً من تصفير بيانات هذا العقار؟\n\n' +
                       'سيتم حذف:\n' +
                       '- جميع الوحدات\n' +
                       '- جميع السندات\n' +
                       '- جميع الإيرادات\n' +
                       '- جميع الأقساط\n' +
                       '- جميع المصروفات\n' +
                       '- بيانات العقار\n\n' +
                       'هذا الإجراء لا يمكن التراجع عنه!';

    if (!confirm(confirmText)) {
        return;
    }

    // Second confirmation
    const secondConfirm = prompt('للتأكيد النهائي، اكتب كلمة "حذف" بالعربية:');
    if (secondConfirm !== 'حذف') {
        alert('تم إلغاء العملية');
        return;
    }

    try {
        const formData = new FormData();
        formData.append('deleteaqar', idaqar);
        formData.append('ajax', '1');

        const response = await fetch(window.location.href, {
            method: 'POST',
            body: formData
        });

        const result = await response.json();

        if (result.success) {
            // Show success message
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3';
            alertDiv.style.zIndex = '9999';
            alertDiv.innerHTML = `
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>${result.message}</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            document.body.appendChild(alertDiv);

            // Redirect after 2 seconds
            setTimeout(() => {
                window.location.href = 'reports.hnt';
            }, 2000);
        } else {
            alert(result.message || 'حدث خطأ أثناء تصفير بيانات العقار');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('حدث خطأ أثناء تصفير بيانات العقار');
    }
};

// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
    // Focus on first input
    const firstInput = document.querySelector('select, input[type="text"]:not([readonly])');
    if (firstInput) {
        firstInput.focus();
    }
});
</script>

