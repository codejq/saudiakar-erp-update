include_once "../../../nocash.hnt";
include_once "../../../header.hnt";
require '../arabicTools.class.hnt';
include_once "amlakfunctions.hnt";

// Handle AJAX delete request
if ($ajax == 1 && $deleteaqar) {
    // Get property details first
    $property_sql = "SELECT aqarname FROM amlak WHERE idaqar='" . intval($deleteaqar) . "'";
    $property_row = mysql_fetch_array(mysql_query($property_sql, $link));

    if (!$property_row) {
        echo json_encode([
            'success' => false,
            'message' => 'العقار غير موجود'
        ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        exit();
    }

    require_once __DIR__ . '/accounting_lock.hnt';
    $property_lock = accountingPropertyLockReason($link, $deleteaqar);
    if ($property_lock !== '') {
        echo json_encode(['success' => false, 'message' => $property_lock], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        exit();
    }

    // Log the deletion
    loginfo("critical", "delete", "تصفير بيانات العقار: {$property_row['aqarname']}", "", "amlak", $deleteaqar, $link);

    // Get all sub-properties
    $sql = "SELECT * FROM amlakdetails WHERE idaqar='" . intval($deleteaqar) . "'";
    $result = mysql_query($sql, $link);

    while ($row = mysql_fetch_array($result)) {
        mysql_query("DELETE FROM aksat WHERE idsubaqar='" . intval($row['idsubaqar']) . "'", $link);
        mysql_query("DELETE FROM eradat WHERE idsubaqar='" . intval($row['idsubaqar']) . "'", $link);
    }

    // Delete all related records
    mysql_query("DELETE FROM masrofat WHERE idaqar='" . intval($deleteaqar) . "'", $link);
    mysql_query("DELETE FROM sanad WHERE idaqar='" . intval($deleteaqar) . "'", $link);
    mysql_query("DELETE FROM sanadsarf WHERE aqarid='" . intval($deleteaqar) . "'", $link);
    mysql_query("DELETE FROM amlakdetails WHERE idaqar='" . intval($deleteaqar) . "'", $link);
    mysql_query("DELETE FROM amlak WHERE idaqar='" . intval($deleteaqar) . "'", $link);

    echo json_encode([
        'success' => true,
        'message' => 'تم تصفير بيانات العقار بنجاح'
    ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    exit();
}
