// Get property details
$sql_property = "SELECT amlak.aqarname, amlak.ownername, aqartype.aqartypename
                 FROM amlak
                 LEFT JOIN aqartype ON amlak.aqartype = aqartype.aqartype
                 WHERE amlak.idaqar = '" . intval($idaqar) . "'";
