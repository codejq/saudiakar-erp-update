                    </thead>
                    <tbody>
                        <?php
                        $row_counter = 0;
                        foreach ($payments_data as $row) {
                            $row_counter++;
                            $row_class = ($row_counter % 2 == 0) ? 'payment-row-even' : 'payment-row-odd';

                            // Date conversion based on calendar type
                            if ($row['hnt_dll_type']) {
                                // Gregorian calendar
                                $paymentdate = date("d/m/Y", $row['paymentdate']);
                            } else {
                                // Hijri calendar
                                $dateo = $dcal->g2u(
                                    date("d", $row['paymentdate']),
                                    date("m", $row['paymentdate']),
                                    date("Y", $row['paymentdate'])
                                );
                                $paymentdate = $dateo['day'] . "/" . $dateo['month'] . "/" . $dateo['year'];
                            }
                        ?>
                        <tr class="<?= $row_class ?>">
                            <td class="selection-col">
                                <input type="checkbox" class="form-check-input bulk-select-checkbox bulk-rent-checkbox"
                                       name="iderad_ids[]" value="<?= intval($row['iderad']) ?>"
                                       data-amount="<?= htmlspecialchars(number_format(floatval($row['amount']), 2, '.', ''), ENT_QUOTES, 'UTF-8') ?>"
                                       aria-label="تحديد التحصيل رقم <?= intval($row['iderad']) ?>">
                            </td>
                            <td>
                                <strong><?= htmlspecialchars($row['iderad']) ?></strong>
                            </td>
                            <td>
                                <?= htmlspecialchars($row['aqarsubtypename']) ?>
                                <?= htmlspecialchars($row['rakam']) ?>
                            </td>
                            <td><?= htmlspecialchars($row['mostagername']) ?></td>
                            <td><?= htmlspecialchars($row['period']) ?></td>
                            <td style="direction: ltr;"><?= $paymentdate ?></td>
                            <td>
                                <strong><?= htmlspecialchars($row['sanadrakam']) ?></strong>
                            </td>
                            <td>
                                <small><?= htmlspecialchars($row['pymentdesription']) ?></small>
                            </td>
                            <td>
                                <span class="amount-badge">
                                    <?= number_format(floatval($row['amount']), 2) ?>
                                </span>
                            </td>
                            <td><?= number_format(floatval($row['mysa3ee']), 2) ?></td>
                            <td><?= number_format(floatval($row['mywater']), 2) ?></td>
                            <td><?= number_format(floatval($row['tamen']), 2) ?></td>
                            <td><?= number_format(floatval($row['services']), 2) ?></td>
                            <td>
                                <a href="sendmony-sanad.hnt?iderad=<?= intval($row['iderad']) ?>"
                                   class="detail-badge"
                                   title="تسليم المبلغ">
                                    <i class="bi bi-arrow-left-circle"></i>
                                    تسليم
                                </a>
                            </td>
                        </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
            </form>

            <?php
            } else {
                // No records found
            ?>
