<script>
$(document).ready(function() {
    function updateBulkSelection() {
        var selected = $('.bulk-rent-checkbox:checked');
        var total = 0;
        selected.each(function () { total += parseFloat($(this).data('amount')) || 0; });
        $('#bulkSelectedCount').text(selected.length);
        $('#bulkSelectedAmount').text(total.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        $('#bulkSettlementButton').prop('disabled', selected.length === 0);
        $('.bulk-rent-checkbox').each(function () { $(this).closest('tr').toggleClass('bulk-selected', this.checked); });
        var all = $('.bulk-rent-checkbox').length;
        $('#bulkSelectAll').prop('checked', all > 0 && selected.length === all).prop('indeterminate', selected.length > 0 && selected.length < all);
    }

    $('#bulkSelectAll').on('change', function () {
        $('.bulk-rent-checkbox').prop('checked', this.checked);
        updateBulkSelection();
    });
    $('.bulk-rent-checkbox').on('change', updateBulkSelection);
    $('#bulkSettlementSelection').on('submit', function (event) {
        var count = $('.bulk-rent-checkbox:checked').length;
        if (count < 1) {
            event.preventDefault();
            alert('اختر تحصيلاً واحداً على الأقل.');
            return;
        }
        $('#bulkSettlementButton').prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i>جاري فتح المراجعة...');
    });

    // Add print functionality
    window.printSettlement = function() {
        window.print();
    };

    // Add keyboard shortcuts
    $(document).on('keydown', function(e) {
        // Ctrl+P for print
        if (e.ctrlKey && e.keyCode == 80) {
            e.preventDefault();
            window.print();
        }
    });

    // Highlight row on hover
    $('.payment-table tbody tr').hover(
        function() {
            $(this).css('cursor', 'pointer');
        },
        function() {
            $(this).css('cursor', 'default');
        }
    );
});
</script>

