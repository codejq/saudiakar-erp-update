require_once 'RentCalendarAudit.class.hnt';

function rentAuditHasScreenAccess($link, $screenId)
{
    $userId = intval($_SESSION['useridv'] ?? 0);
    if ($userId <= 0) {
        return false;
    }
    $user = mysql_fetch_assoc(mysql_query("SELECT groupid FROM user WHERE userid = {$userId} LIMIT 1", $link));
    if (!$user) {
        return false;
    }
    $groupId = intval($user['groupid']);
    $groupQuery = mysql_query("SELECT allprevilage FROM usergroups WHERE groupid = {$groupId} LIMIT 1", $link);
    $group = $groupQuery ? mysql_fetch_assoc($groupQuery) : false;
    if ($group && !empty($group['allprevilage'])) {
        return true;
    }
    $permission = mysql_query(
        "SELECT screenid FROM ugroupscreen WHERE screenid = " . intval($screenId) . " AND groupid = {$groupId} LIMIT 1",
        $link
    );
    return $permission && mysql_num_rows($permission) > 0;
}

if (!rentAuditHasScreenAccess($link, 39)) {
    http_response_code(403);
    exit('ليس لديك الصلاحية للدخول إلى هذه الشاشة.');
}

$action = isset($_REQUEST['action']) ? trim((string)$_REQUEST['action']) : '';
$reportName = isset($_REQUEST['report']) ? basename((string)$_REQUEST['report']) : '';

if ($action === 'raw') {
    $reportPath = RentCalendarAudit::reportPath($reportName);
    if (!$reportPath || !is_file($reportPath)) {
        http_response_code(404);
        exit('التقرير غير موجود.');
    }
    header('Content-Type: text/html; charset=UTF-8');
    header('Content-Disposition: inline; filename="' . $reportName . '"');
    header('X-Content-Type-Options: nosniff');
    readfile($reportPath);
    exit;
}

$viewReportPath = false;
if ($action === 'view') {
    $viewReportPath = RentCalendarAudit::reportPath($reportName);
    if (!$viewReportPath || !is_file($viewReportPath)) {
        http_response_code(404);
        exit('التقرير غير موجود.');
    }
}

if ($action === 'delete' && ($_SERVER['REQUEST_METHOD'] ?? '') === 'POST') {
    $postedToken = (string)($_POST['csrf_token'] ?? '');
    $sessionToken = (string)($_SESSION['rent_calendar_audit_csrf'] ?? '');
    if ($sessionToken === '' || !hash_equals($sessionToken, $postedToken)) {
        http_response_code(403);
        exit('تعذر التحقق من طلب حذف التقرير.');
    }
    $reportPath = RentCalendarAudit::reportPath($reportName);
    if ($reportPath && is_file($reportPath)) {
        @unlink($reportPath);
    }
    header('Location: rent_calendar_audit.hnt?deleted=1');
    exit;
}

if (empty($_SESSION['rent_calendar_audit_csrf'])) {
    try {
        $_SESSION['rent_calendar_audit_csrf'] = bin2hex(random_bytes(24));
    } catch (Throwable $exception) {
        $_SESSION['rent_calendar_audit_csrf'] = hash('sha256', session_id() . microtime(true));
    }
}

$reports = RentCalendarAudit::listReports();
$runRequested = isset($_GET['run']) && $_GET['run'] === '1';
$canscroll = 1;
include_once '../../../header.hnt';
?>

