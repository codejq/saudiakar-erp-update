if (!function_exists('editAksatDateToTimestamp')) {
	function editAksatDateToTimestamp(
		$dateValue,
		$fieldLabel,
		$dcal,
		&$detectedCalendarType = null,
		$forcedCalendarType = null
	) {
		$dateValue = trim((string)$dateValue);

		if (!preg_match('/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/', $dateValue, $matches)) {
			throw new InvalidArgumentException(
				$fieldLabel . ': صيغة التاريخ غير صحيحة. استخدم يوم/شهر/سنة'
			);
		}

		$day = intval($matches[1]);
		$month = intval($matches[2]);
		$year = intval($matches[3]);
		if ($forcedCalendarType !== null) {
			$forcedCalendarType = intval($forcedCalendarType);
			if ($forcedCalendarType !== 0 && $forcedCalendarType !== 1) {
				throw new InvalidArgumentException($fieldLabel . ': نوع التقويم غير صحيح');
			}
			$detectedCalendarType = $forcedCalendarType;
		} else {
			$detectedCalendarType = ($year < 1900) ? 0 : 1;
		}

		// Keep legacy compatibility: the entered year determines the calendar.
		if ($detectedCalendarType === 0) {
			try {
				$gregorian = $dcal->u2g($day, $month, $year);
			} catch (Exception $exception) {
				throw new InvalidArgumentException(
					$fieldLabel . ': التاريخ الهجري غير صحيح أو خارج النطاق المدعوم',
					0,
					$exception
				);
			}

			return mktime(
				0,
				0,
				0,
				intval($gregorian['month']),
				intval($gregorian['day']),
				intval($gregorian['year'])
			);
		}

		if (!checkdate($month, $day, $year)) {
			throw new InvalidArgumentException(
				$fieldLabel . ': التاريخ الميلادي غير صحيح'
			);
		}

		return mktime(0, 0, 0, $month, $day, $year);
	}
}

if (!function_exists('editAksatTimestampToDisplayDate')) {
	function editAksatTimestampToDisplayDate($timestamp, $calendarType, $dcal) {
		$timestamp = intval($timestamp);
		if ($timestamp === 0) {
			return '';
		}

		// The saved flag remains authoritative. This year check is only for
		// distinguishing the two historical Hijri storage formats.
		if (intval($calendarType) === 0) {
			$storedYear = intval(date('Y', $timestamp));
			if ($storedYear > 0 && $storedYear < 1900) {
				return date('d/m/Y', $timestamp);
			}

			$dateo = $dcal->g2u(
				date('d', $timestamp),
				date('m', $timestamp),
				date('Y', $timestamp)
			);
			return $dateo['day'] . '/' . $dateo['month'] . '/' . $dateo['year'];
		}

		return date('d/m/Y', $timestamp);
	}
}
