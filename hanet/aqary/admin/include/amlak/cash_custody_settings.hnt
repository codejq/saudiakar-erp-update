<?php
$sc_title = 'إعدادات العهد النقدية';
require_once __DIR__ . '/cash_custody_bootstrap.hnt';
$settings = array(
    'prefix'=>$cashCustodyService->getSetting('cash_custody_default_prefix','CUS'),
    'vat'=>$cashCustodyService->getSetting('cash_custody_default_vat_rate','15'),
    'negative'=>$cashCustodyService->getSetting('cash_custody_allow_negative_balance','0'),
    'attachment'=>$cashCustodyService->getSetting('cash_custody_require_expense_attachment','0'),
    'accounting'=>$cashCustodyService->getSetting('cash_custody_accounting_enabled','0'),
    'custody_account'=>$cashCustodyService->getSetting('cash_custody_account_id','0'),
    'cash_account'=>$cashCustodyService->getSetting('cash_custody_cash_account_id','0'),
    'bank_account'=>$cashCustodyService->getSetting('cash_custody_bank_account_id','0'),
    'expense_account'=>$cashCustodyService->getSetting('cash_custody_expense_account_id','0'),
    'vat_account'=>$cashCustodyService->getSetting('cash_custody_input_vat_account_id','0'),
    'journal'=>$cashCustodyService->getSetting('cash_custody_journal_id','0')
);
$accounts = $cashCustodyService->listAccountingAccounts();
$journals = $cashCustodyService->listAccountingJournals();
$accountingAvailable = !empty($accounts) && !empty($journals);
ccRenderStart('إعدادات العهد النقدية', 'settings');
?>
<section class="cc-card"><form onsubmit="return ccSubmit(this,'حفظ إعدادات العهد؟')"><input type="hidden" name="action" value="save_settings"><div class="cc-form-grid">
<div class="cc-field"><label>بادئة الترقيم الافتراضية</label><input name="cash_custody_default_prefix" dir="ltr" maxlength="20" value="<?= ccEsc($settings['prefix']) ?>" required></div><div class="cc-field"><label>نسبة الضريبة الافتراضية %</label><input type="number" step="0.01" min="0" max="100" name="cash_custody_default_vat_rate" value="<?= ccEsc($settings['vat']) ?>"></div>
<div class="cc-field"><label>سياسة الرصيد</label><label><input style="width:auto;min-height:auto" type="checkbox" name="cash_custody_allow_negative_balance" value="1" <?= intval($settings['negative'])?'checked':'' ?>> السماح باعتماد مصروف يتجاوز الرصيد</label></div><div class="cc-field"><label>المرفقات</label><label><input style="width:auto;min-height:auto" type="checkbox" name="cash_custody_require_expense_attachment" value="1" <?= intval($settings['attachment'])?'checked':'' ?>> إلزام إرفاق فاتورة مع المصروف</label></div>
<div class="cc-field"><label>الربط المحاسبي</label><label><input style="width:auto;min-height:auto" type="checkbox" name="cash_custody_accounting_enabled" value="1" <?= intval($settings['accounting'])?'checked':'' ?> <?= $accountingAvailable?'':'disabled' ?>> إنشاء وترحيل القيود المحاسبية تلقائياً</label></div>
<?php $accountFields=array('cash_custody_account_id'=>array('حساب عهد الموظفين','custody_account'),'cash_custody_cash_account_id'=>array('حساب الصندوق','cash_account'),'cash_custody_bank_account_id'=>array('حساب البنك','bank_account'),'cash_custody_expense_account_id'=>array('حساب المصروف الافتراضي','expense_account'),'cash_custody_input_vat_account_id'=>array('حساب ضريبة المدخلات','vat_account')); foreach($accountFields as $field=>$meta): ?><div class="cc-field"><label><?= ccEsc($meta[0]) ?></label><select name="<?= ccEsc($field) ?>"><option value="0">غير محدد</option><?php foreach($accounts as $account): ?><option value="<?= intval($account['account_id']) ?>" <?= intval($settings[$meta[1]])===intval($account['account_id'])?'selected':'' ?>><?= ccEsc($account['account_code'].' - '.$account['account_name_ar']) ?></option><?php endforeach; ?></select></div><?php endforeach; ?>
<div class="cc-field"><label>دفتر اليومية</label><select name="cash_custody_journal_id"><option value="0">غير محدد</option><?php foreach($journals as $journal): ?><option value="<?= intval($journal['journal_id']) ?>" <?= intval($settings['journal'])===intval($journal['journal_id'])?'selected':'' ?>><?= ccEsc($journal['journal_code'].' - '.$journal['journal_name_ar']) ?></option><?php endforeach; ?></select></div>
</div><div class="cc-alert"><?= $accountingAvailable?'لن يسمح النظام بتفعيل الربط حتى تعيين جميع الحسابات ودفتر اليومية، ويستخدم معرف الحركة لمنع تكرار القيود.':'جداول أو إعدادات المحاسبة غير متوفرة؛ ستستمر العهد بالعمل مستقلة دون قيود محاسبية.' ?></div><button class="cc-btn cc-primary policy_<?= intval($sc_id) ?>_edits">حفظ الإعدادات</button></form></section>
<?php ccRenderEnd($cashCustodyCsrf); ?>

