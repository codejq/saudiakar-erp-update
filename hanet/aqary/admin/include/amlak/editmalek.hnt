<script language=javascript>
function fillfreecontrato(pagenm){
if(typeof(pagenm)=='undefined'){pagenm=1;}

sql="select id as 'رقم',  ";
sql+="bankname as 'البنك' , ";
sql+="bankbranch as 'الفرع', ";
sql+="acountnumber as 'رقم الحساب' ";
sql+="  from bankacounts where ownerid='"+document.getElementById('bankuniqueid').value+"' or ownerid='"+document.getElementById('bankownerid').value+"' " ;
sql+=" order by id desc  "; 
ajaxfillgrid(sql,'containerid',true,pagenm);
}
fillfreecontrato();
</script>
<div align=left nowarp style="padding:5px">
<input type=button  class=smallbutton 
onclick="
tajpagenumv=parseInt(document.getElementById('tajpagenum').value)-1;
if(parseInt(tajpagenumv) < 1 ){return false;}
document.getElementById('tajpagenum').value=parseInt(document.getElementById('tajpagenum').value)-1;
fillfreecontrato(document.getElementById('tajpagenum').value);
"
value="&lt;">
<input id='tajpagenum' 
onkeypress="return ValidateNumberKeyPress(this, event);" 
onkeyup="fillfreecontrato(this.value);"
size=2 value=1>
<input type=button  class=smallbutton 
onclick="
if(document.getElementById('containerid').innerHTML==''){return false;}
tajpagenumv=parseInt(document.getElementById('tajpagenum').value)+1;
document.getElementById('tajpagenum').value=parseInt(document.getElementById('tajpagenum').value)+1;
fillfreecontrato(document.getElementById('tajpagenum').value);
"
value="&gt;">
</div>
