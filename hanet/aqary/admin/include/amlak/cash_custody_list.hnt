<?php
$sc_title = 'سجل العهد النقدية';
require_once __DIR__ . '/cash_custody_bootstrap.hnt';
$holderId = intval($_GET['holder_id'] ?? 0);
$status = trim((string)($_GET['status'] ?? ''));
$holders = $cashCustodyService->listHolders(false);
$custodies = $cashCustodyService->listCustodies(array('holder_id' => $holderId, 'status' => $status));
ccRenderStart('سجل العهد النقدية', 'custodies');
?>
<section class="cc-card cc-no-print"><form class="cc-form-grid" method="get">
    <div class="cc-field"><label>صاحب العهدة</label><select name="holder_id"><option value="0">الكل</option><?php foreach($holders as $holder): ?><option value="<?= intval($holder['holder_id']) ?>" <?= $holderId===intval($holder['holder_id'])?'selected':'' ?>><?= ccEsc($holder['user_name']) ?></option><?php endforeach; ?></select></div>
    <div class="cc-field"><label>الحالة</label><select name="status"><option value="">الكل</option><option value="open" <?= $status==='open'?'selected':'' ?>>مفتوحة</option><option value="closed" <?= $status==='closed'?'selected':'' ?>>مقفلة</option></select></div>
    <div class="cc-field"><label>&nbsp;</label><button class="cc-btn cc-info" type="submit">بحث</button></div>
</form></section>
<section class="cc-card cc-scroll"><table class="cc-table"><thead><tr><th>رقم العهدة</th><th>صاحب العهدة</th><th>الرقم الوظيفي</th><th>تاريخ الفتح</th><th>تاريخ الإقفال</th><th>الرصيد</th><th>الحالة</th><th class="cc-no-print">التفاصيل</th></tr></thead><tbody>
<?php foreach($custodies as $custody): ?><tr><td><?= ccEsc($custody['custody_number']) ?></td><td><?= ccEsc($custody['holder_name']) ?></td><td><?= ccEsc($custody['employee_number']) ?></td><td><?= ccEsc($custody['opened_date']) ?></td><td><?= ccEsc($custody['closed_date']) ?></td><td><?= ccMoney($custody['balance']) ?></td><td><span class="cc-badge <?= ccEsc($custody['status']) ?>"><?= ccEsc(ccStatusLabel($custody['status'])) ?></span></td><td class="cc-no-print"><a class="cc-btn cc-secondary" href="cash_custody_view.hnt?id=<?= intval($custody['custody_id']) ?>">فتح</a></td></tr><?php endforeach; ?>
<?php if(!$custodies): ?><tr><td colspan="8" class="cc-empty">لا توجد عهد مطابقة.</td></tr><?php endif; ?>
</tbody></table></section>
<?php ccRenderEnd($cashCustodyCsrf); ?>

