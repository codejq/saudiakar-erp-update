<?php
$sc_title = 'تفاصيل العهدة النقدية';
require_once __DIR__ . '/cash_custody_bootstrap.hnt';
$custodyId = intval($_GET['id'] ?? 0);
$custody = $cashCustodyService->getCustody($custodyId);
if (!$custody) {
    ccRenderStart('تفاصيل العهدة', 'custodies');
    echo '<div class="cc-alert error">العهدة المطلوبة غير موجودة.</div>';
    ccRenderEnd($cashCustodyCsrf);
    exit;
}
$transactions = $cashCustodyService->listTransactions($custodyId);
$transactionIds = array_map(function($row){ return intval($row['transaction_id']); }, $transactions);
$attachments = array();
foreach ($cashCustodyService->listAttachments('transaction', $transactionIds) as $attachment) {
    $attachments[intval($attachment['entity_id'])][] = $attachment;
}
$categories = $cashCustodyService->listCategories();
$suppliers = $cashCustodyService->listSuppliers();
$costCenters = $cashCustodyService->listCostCenters();
$auditRows = $cashCustodyService->listCustodyAudit($custodyId);
$vatRate = $cashCustodyService->getSetting('cash_custody_default_vat_rate', '15.00');
$attachmentRequired = intval($cashCustodyService->getSetting('cash_custody_require_expense_attachment', '0')) === 1;
ccRenderStart('تفاصيل العهدة ' . $custody['custody_number'], 'custodies');
?>
<section class="cc-grid">
    <div class="cc-card cc-stat"><span>صاحب العهدة</span><strong style="font-size:19px"><?= ccEsc($custody['holder_name']) ?></strong><small><?= ccEsc($custody['employee_number'].' / '.$custody['department']) ?></small></div>
    <div class="cc-card cc-stat"><span>إجمالي التمويل</span><strong><?= ccMoney($custody['totals']['funding']) ?></strong></div>
    <div class="cc-card cc-stat"><span>المصروفات المعتمدة</span><strong><?= ccMoney($custody['totals']['expenses']) ?></strong></div>
    <div class="cc-card cc-stat"><span>المبالغ المردودة</span><strong><?= ccMoney($custody['totals']['returns']) ?></strong></div>
    <div class="cc-card cc-stat"><span>الرصيد الحالي</span><strong><?= ccMoney($custody['totals']['balance']) ?></strong></div>
</section>
<div class="cc-card cc-actions cc-no-print">
    <?php if($custody['status']==='open'): ?>
        <button class="cc-btn cc-primary policy_<?= intval($sc_id) ?>_adds" onclick="ccOpen('expenseModal')"><i class="bi bi-receipt"></i> تسجيل مصروف</button>
        <button class="cc-btn cc-info policy_<?= intval($sc_id) ?>_adds" onclick="ccOpen('returnModal')"><i class="bi bi-arrow-return-left"></i> رد مبلغ</button>
        <button class="cc-btn cc-warning policy_<?= intval($sc_id) ?>_edits" onclick="ccOpen('settleModal')"><i class="bi bi-check2-square"></i> تسوية / إقفال</button>
    <?php endif; ?>
    <a class="cc-btn cc-secondary" href="cash_custody_print.hnt?id=<?= $custodyId ?>" target="_blank"><i class="bi bi-printer"></i> طباعة</a>
</div>
<section class="cc-card cc-scroll"><h2>حركات العهدة</h2><table class="cc-table"><thead><tr><th>المستند</th><th>التاريخ</th><th>النوع</th><th>البيان</th><th>التصنيف</th><th>المبلغ</th><th>الضريبة</th><th>المورد</th><th>الحالة</th><th>المرفقات</th><th class="cc-no-print">الإجراء</th></tr></thead><tbody>
<?php foreach($transactions as $transaction): ?><tr>
<td><?= ccEsc($transaction['document_number']) ?></td><td><?= ccEsc($transaction['transaction_date']) ?></td><td><?= ccEsc(ccTypeLabel($transaction['transaction_type'])) ?></td><td><?= ccEsc($transaction['description']) ?></td><td><?= ccEsc($transaction['category_name']) ?></td><td><?= ccMoney($transaction['amount']) ?></td><td><?= ccMoney($transaction['vat_amount']) ?></td><td><?= ccEsc($transaction['supplier_name']) ?></td><td><span class="cc-badge <?= ccEsc($transaction['status']) ?>"><?= ccEsc(ccStatusLabel($transaction['status'])) ?></span></td>
<td><?php foreach($attachments[intval($transaction['transaction_id'])] ?? array() as $file): ?><a href="cash_custody_attachment.hnt?id=<?= intval($file['attachment_id']) ?>" target="_blank" title="<?= ccEsc($file['original_name']) ?>"><i class="bi bi-paperclip"></i></a> <?php endforeach; ?></td>
<td class="cc-no-print"><?php if($transaction['transaction_type']==='expense' && $transaction['status']==='pending'): ?><div class="cc-actions"><form onsubmit="return ccSubmit(this,'اعتماد المصروف؟')"><input type="hidden" name="action" value="review_expense"><input type="hidden" name="decision" value="approve"><input type="hidden" name="transaction_id" value="<?= intval($transaction['transaction_id']) ?>"><input type="hidden" name="custody_id" value="<?= $custodyId ?>"><button class="cc-btn cc-primary policy_<?= intval($sc_id) ?>_edits">اعتماد</button></form><form onsubmit="return ccSubmit(this,'رفض المصروف؟')"><input type="hidden" name="action" value="review_expense"><input type="hidden" name="decision" value="reject"><input type="hidden" name="transaction_id" value="<?= intval($transaction['transaction_id']) ?>"><input type="hidden" name="custody_id" value="<?= $custodyId ?>"><button class="cc-btn cc-danger policy_<?= intval($sc_id) ?>_edits">رفض</button></form></div><?php elseif($custody['status']==='open' && $transaction['status']==='approved' && floatval($transaction['amount'])>0 && empty($transaction['has_reversal'])): ?><button class="cc-btn cc-danger policy_<?= intval($sc_id) ?>_edits" type="button" onclick="ccReverse(<?= intval($transaction['transaction_id']) ?>,'<?= ccEsc($transaction['document_number']) ?>')">عكس</button><?php endif; ?></td>
</tr><?php endforeach; ?><?php if(!$transactions): ?><tr><td colspan="11" class="cc-empty">لا توجد حركات مسجلة.</td></tr><?php endif; ?></tbody></table></section>

<section class="cc-card cc-scroll"><h2>سجل التدقيق</h2><table class="cc-table"><thead><tr><th>التاريخ والوقت</th><th>المستخدم</th><th>نوع السجل</th><th>العملية</th></tr></thead><tbody><?php foreach($auditRows as $audit): ?><tr><td><?= ccEsc(date('Y-m-d H:i', intval($audit['performed_at']))) ?></td><td><?= ccEsc($audit['user_name']) ?></td><td><?= ccEsc($audit['entity_type'].' #'.$audit['entity_id']) ?></td><td><?= ccEsc($audit['action_type']) ?></td></tr><?php endforeach; ?><?php if(!$auditRows): ?><tr><td colspan="4" class="cc-empty">لا توجد عمليات تدقيق مسجلة.</td></tr><?php endif; ?></tbody></table></section>

<div class="cc-modal" id="expenseModal"><div class="cc-modal-box"><div class="cc-modal-head"><h2>تسجيل مصروف عهدة</h2><button class="cc-close" onclick="ccClose('expenseModal')">×</button></div><form onsubmit="return ccSubmit(this)" enctype="multipart/form-data"><input type="hidden" name="action" value="add_expense"><input type="hidden" name="custody_id" value="<?= $custodyId ?>"><input type="hidden" name="formuid" value="<?= ccEsc(ccUuid()) ?>">
<div class="cc-form-grid"><div class="cc-field"><label>التاريخ *</label><input type="date" name="transaction_date" value="<?= date('Y-m-d') ?>" required></div><div class="cc-field"><label>التصنيف *</label><select name="category_id" required><option value="">اختر</option><?php foreach($categories as $category): ?><option value="<?= intval($category['category_id']) ?>"><?= ccEsc($category['category_name']) ?></option><?php endforeach; ?></select></div><div class="cc-field"><label>المبلغ قبل الضريبة *</label><input id="expenseNet" type="number" step="0.01" min="0.01" name="net_amount" oninput="ccCalcVat()" required></div><div class="cc-field"><label>نسبة الضريبة %</label><input id="expenseRate" type="number" step="0.01" min="0" max="100" name="vat_rate" value="<?= ccEsc($vatRate) ?>" oninput="ccCalcVat()"></div><div class="cc-field"><label>مبلغ الضريبة</label><input id="expenseVat" type="number" step="0.01" min="0" name="vat_amount" value="0.00"></div><div class="cc-field"><label>رقم الفاتورة</label><input name="invoice_number" maxlength="100"></div>
<div class="cc-field"><label>مورد مسجل</label><select name="supplier_id" id="expenseSupplier" onchange="ccSupplierChanged()"><option value="0">غير محدد / كتابة يدوية</option><?php foreach($suppliers as $supplier): ?><option value="<?= intval($supplier['supplier_id']) ?>" data-name="<?= ccEsc($supplier['supplier_name']) ?>" data-vat="<?= ccEsc($supplier['vat_number']) ?>"><?= ccEsc($supplier['supplier_name']) ?></option><?php endforeach; ?></select></div><div class="cc-field"><label>اسم المورد</label><input name="supplier_name" id="expenseSupplierName" maxlength="255"></div><div class="cc-field"><label>الرقم الضريبي للمورد</label><input name="supplier_vat_number" id="expenseSupplierVat" maxlength="50"></div>
<div class="cc-field"><label>مركز التكلفة</label><select name="cost_center_id"><option value="0">غير محدد</option><?php foreach($costCenters as $center): ?><option value="<?= intval($center['cost_center_id']) ?>"><?= ccEsc($center['cost_center_code'].' - '.$center['cost_center_name_ar']) ?></option><?php endforeach; ?></select></div><div class="cc-field"><label>طريقة الدفع</label><select name="payment_method"><option value="cash">نقدي</option><option value="bank">تحويل بنكي</option><option value="card">بطاقة</option><option value="other">أخرى</option></select></div><div class="cc-field"><label>رقم المرجع</label><input name="reference_number" maxlength="150"></div><div class="cc-field"><label>المرفق <?= $attachmentRequired?'*':'' ?></label><input type="file" name="attachment" accept=".pdf,.jpg,.jpeg,.png" <?= $attachmentRequired?'required':'' ?>></div><div class="cc-field" style="grid-column:1/-1"><label>البيان *</label><textarea name="description" required></textarea></div></div><div class="cc-actions" style="margin-top:16px"><button class="cc-btn cc-primary" type="submit">حفظ المصروف</button><button class="cc-btn cc-secondary" type="button" onclick="ccClose('expenseModal')">إلغاء</button></div></form></div></div>

<div class="cc-modal" id="returnModal"><div class="cc-modal-box"><div class="cc-modal-head"><h2>رد مبلغ من العهدة</h2><button class="cc-close" onclick="ccClose('returnModal')">×</button></div><form onsubmit="return ccSubmit(this,'تأكيد تسجيل المبلغ المردود؟')"><input type="hidden" name="action" value="add_return"><input type="hidden" name="custody_id" value="<?= $custodyId ?>"><input type="hidden" name="formuid" value="<?= ccEsc(ccUuid()) ?>"><div class="cc-form-grid"><div class="cc-field"><label>التاريخ *</label><input type="date" name="transaction_date" value="<?= date('Y-m-d') ?>" required></div><div class="cc-field"><label>المبلغ *</label><input type="number" step="0.01" min="0.01" max="<?= ccEsc($custody['totals']['balance']) ?>" name="amount" required></div><div class="cc-field"><label>طريقة الرد</label><select name="payment_method"><option value="cash">نقدي</option><option value="bank">تحويل بنكي</option></select></div><div class="cc-field"><label>رقم المرجع</label><input name="reference_number"></div><div class="cc-field" style="grid-column:1/-1"><label>البيان</label><textarea name="description">رد مبلغ من العهدة</textarea></div></div><div class="cc-actions" style="margin-top:16px"><button class="cc-btn cc-primary">حفظ</button></div></form></div></div>

<div class="cc-modal" id="settleModal"><div class="cc-modal-box"><div class="cc-modal-head"><h2>تسوية العهدة</h2><button class="cc-close" onclick="ccClose('settleModal')">×</button></div><div class="cc-alert">الرصيد الحالي: <?= ccMoney($custody['totals']['balance']) ?> ر.س. الإقفال المباشر يتطلب رصيداً صفرياً، أو يمكن ترحيل الرصيد الموجب إلى عهدة جديدة.</div><form onsubmit="return ccSubmit(this,'سيتم إقفال العهدة الحالية. هل تريد المتابعة؟')"><input type="hidden" name="action" value="settle"><input type="hidden" name="custody_id" value="<?= $custodyId ?>"><input type="hidden" name="formuid" value="<?= ccEsc(ccUuid()) ?>"><div class="cc-form-grid"><div class="cc-field"><label>الإجراء *</label><select name="settlement_action"><option value="close">إقفال العهدة</option><option value="carry">إقفال وترحيل الرصيد لعهدة جديدة</option></select></div><div class="cc-field"><label>تاريخ التسوية *</label><input type="date" name="settlement_date" value="<?= date('Y-m-d') ?>" required></div><div class="cc-field" style="grid-column:1/-1"><label>ملاحظات</label><textarea name="notes"></textarea></div></div><div class="cc-actions" style="margin-top:16px"><button class="cc-btn cc-warning">تنفيذ التسوية</button></div></form></div></div>
<div class="cc-modal" id="reverseModal"><div class="cc-modal-box"><div class="cc-modal-head"><h2>عكس حركة مالية</h2><button class="cc-close" onclick="ccClose('reverseModal')">×</button></div><div class="cc-alert">لن يتم تعديل أو حذف المستند الأصلي. سيُنشأ مستند عكسي مستقل.</div><form onsubmit="return ccSubmit(this,'تأكيد إنشاء حركة العكس؟')"><input type="hidden" name="action" value="reverse_transaction"><input type="hidden" name="custody_id" value="<?= $custodyId ?>"><input type="hidden" name="transaction_id" id="reverse_transaction_id"><input type="hidden" name="formuid" id="reverse_formuid"><div class="cc-field"><label>المستند</label><input id="reverse_document" disabled></div><div class="cc-field"><label>سبب العكس *</label><textarea name="reason" required></textarea></div><div class="cc-actions" style="margin-top:16px"><button class="cc-btn cc-danger">إنشاء حركة عكس</button></div></form></div></div>
<script>
function ccCalcVat(){const n=parseFloat(document.getElementById('expenseNet').value)||0,r=parseFloat(document.getElementById('expenseRate').value)||0;document.getElementById('expenseVat').value=(n*r/100).toFixed(2)}
function ccSupplierChanged(){const s=document.getElementById('expenseSupplier'),o=s.options[s.selectedIndex];if(o&&o.value!=='0'){document.getElementById('expenseSupplierName').value=o.dataset.name||'';document.getElementById('expenseSupplierVat').value=o.dataset.vat||''}}
function ccReverse(id,documentNumber){document.getElementById('reverse_transaction_id').value=id;document.getElementById('reverse_document').value=documentNumber;document.getElementById('reverse_formuid').value=ccNewUid();ccOpen('reverseModal')}
</script>
<?php ccRenderEnd($cashCustodyCsrf); ?>

