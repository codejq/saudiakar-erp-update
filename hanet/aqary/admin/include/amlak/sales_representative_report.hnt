<?php
/**
 * Monthly sales representative collection and commission report.
 */
$sc_title = 'تقرير عمولات مندوبي المبيعات';
$sc_id = '49';

include_once '../../../nocash.hnt';
include_once '../../../header.hnt';
require_once __DIR__ . '/sales_representative_helpers.hnt';

$selectedYear = isset($_GET['year']) ? intval($_GET['year']) : intval(date('Y'));
if ($selectedYear < 2000 || $selectedYear > 2100) {
    $selectedYear = intval(date('Y'));
}

$yearStart = mktime(0, 0, 0, 1, 1, $selectedYear);
$yearEnd = mktime(0, 0, 0, 1, 1, $selectedYear + 1);
$monthNames = array(
    1 => 'يناير', 2 => 'فبراير', 3 => 'مارس', 4 => 'أبريل',
    5 => 'مايو', 6 => 'يونيو', 7 => 'يوليو', 8 => 'أغسطس',
    9 => 'سبتمبر', 10 => 'أكتوبر', 11 => 'نوفمبر', 12 => 'ديسمبر'
);
$months = array();
for ($month = 1; $month <= 12; $month++) {
    $months[$month] = array('collected' => 0, 'commission' => 0, 'receipts' => 0, 'representatives' => array());
}

$reportError = '';
$sql = "SELECT
            s.idsanad,
            s.sanadrakam,
            s.sanaddate,
            s.mostagername,
            s.depositeamount,
            s.mybyan,
            s.payment_type,
            s.sales_representative_userid,
            s.sales_commission_type,
            s.sales_commission_value,
            s.sales_commission_amount,
            u.name AS representative_name,
            u.username AS representative_username
        FROM sanad s
        LEFT JOIN user u ON u.userid = s.sales_representative_userid
        WHERE s.sanaddate >= '{$yearStart}'
          AND s.sanaddate < '{$yearEnd}'
          AND s.depositeamount > 0
        ORDER BY s.sanaddate, s.idsanad";
$result = mysql_query($sql, $link);
if (!$result) {
    $reportError = mysql_error($link);
} else {
    while ($row = mysql_fetch_assoc($result)) {
        $monthNumber = intval(date('n', intval($row['sanaddate'])));
        $representativeId = intval($row['sales_representative_userid']);
        $representativeKey = 'representative_' . $representativeId;
        $representativeName = 'النظام / بدون مندوب';
        if ($representativeId > 0) {
            $representativeName = trim((string)$row['representative_name']) !== ''
                ? $row['representative_name']
                : ($row['representative_username'] ?: 'مستخدم محذوف #' . $representativeId);
        }

        if (!isset($months[$monthNumber]['representatives'][$representativeKey])) {
            $months[$monthNumber]['representatives'][$representativeKey] = array(
                'userid' => $representativeId,
                'name' => $representativeName,
                'collected' => 0,
                'commission' => 0,
                'receipts' => array(),
            );
        }

        $collectedAmount = floatval($row['depositeamount']);
        $commissionAmount = floatval($row['sales_commission_amount']);
        $months[$monthNumber]['collected'] += $collectedAmount;
        $months[$monthNumber]['commission'] += $commissionAmount;
        $months[$monthNumber]['receipts']++;
        $months[$monthNumber]['representatives'][$representativeKey]['collected'] += $collectedAmount;
        $months[$monthNumber]['representatives'][$representativeKey]['commission'] += $commissionAmount;
        $months[$monthNumber]['representatives'][$representativeKey]['receipts'][] = $row;
    }
}

$annualCollected = 0;
$annualCommission = 0;
$annualReceipts = 0;
foreach ($months as $monthData) {
    $annualCollected += $monthData['collected'];
    $annualCommission += $monthData['commission'];
    $annualReceipts += $monthData['receipts'];
}

$currentSettings = amlakGetSalesCommissionSettings($link);
function salesRepresentativePaymentTypeLabel($paymentType) {
    $labels = array(1 => 'نقدي', 2 => 'شيك', 3 => 'أخرى', 4 => 'تحويل', 5 => 'شبكة');
    return isset($labels[intval($paymentType)]) ? $labels[intval($paymentType)] : 'غير محدد';
}
?>

<style>
.sales-summary-card { border:0; box-shadow:0 2px 10px rgba(15,23,42,.08); }
.sales-month-card { border:0; box-shadow:0 2px 12px rgba(15,23,42,.08); }
.sales-month-card .card-header { background:linear-gradient(135deg,#15803d,#0f766e); color:#fff; }
.sales-detail-row { background:#f8fafc; }
</style>

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="mb-1"><i class="bi bi-person-badge-fill text-success me-2"></i><?= htmlspecialchars($sc_title, ENT_QUOTES, 'UTF-8') ?></h3>
            <div class="text-muted">
                الإعداد الحالي:
                <?= $currentSettings['type'] === 'percentage' ? 'نسبة' : 'مبلغ ثابت' ?>
                <?= number_format($currentSettings['value'], 2) ?>
                <?= $currentSettings['type'] === 'percentage' ? '%' : 'ريال لكل سند' ?>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="reports.hnt" class="btn btn-outline-secondary"><i class="bi bi-arrow-return-right me-1"></i>التقارير</a>
            <a href="/aqary/admin/option.sales-representative.hnt" class="btn btn-outline-success"><i class="bi bi-gear me-1"></i>إعداد العمولة</a>
        </div>
    </div>

    <?php if ($reportError !== '') { ?>
        <div class="alert alert-danger">
            تعذر تحميل التقرير. افتح إدارة الأملاك مرة واحدة لتطبيق تحديث قاعدة البيانات ثم حاول مجدداً.
            <div class="small mt-2"><?= htmlspecialchars($reportError, ENT_QUOTES, 'UTF-8') ?></div>
        </div>
    <?php } ?>

    <form method="get" class="card sales-summary-card mb-4">
        <div class="card-body d-flex flex-wrap align-items-end gap-3">
            <div>
                <label for="year" class="form-label">السنة</label>
                <select name="year" id="year" class="form-select" onchange="this.form.submit()">
                    <?php for ($year = intval(date('Y')) + 1; $year >= intval(date('Y')) - 10; $year--) { ?>
                        <option value="<?= $year ?>" <?= $year === $selectedYear ? 'selected' : '' ?>><?= $year ?></option>
                    <?php } ?>
                </select>
            </div>
            <div class="ms-auto text-nowrap"><strong>إجمالي التحصيل:</strong> <?= number_format($annualCollected, 2) ?> ريال</div>
            <div class="text-nowrap"><strong>إجمالي العمولات:</strong> <?= number_format($annualCommission, 2) ?> ريال</div>
            <div class="text-nowrap"><strong>عدد السندات:</strong> <?= number_format($annualReceipts) ?></div>
        </div>
    </form>

    <?php foreach ($months as $monthNumber => $monthData) { ?>
        <div class="card sales-month-card mb-4">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i><?= $monthNames[$monthNumber] ?> <?= $selectedYear ?></h5>
                <div>
                    التحصيل: <strong><?= number_format($monthData['collected'], 2) ?></strong> ريال
                    <span class="mx-2">|</span>
                    العمولات: <strong><?= number_format($monthData['commission'], 2) ?></strong> ريال
                </div>
            </div>
            <div class="card-body p-0">
                <?php if (empty($monthData['representatives'])) { ?>
                    <div class="text-center text-muted p-4">لا توجد سندات قبض في هذا الشهر.</div>
                <?php } else { ?>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>المندوب</th>
                                    <th>عدد السندات</th>
                                    <th>المبلغ المحصل</th>
                                    <th>العمولة</th>
                                    <th>التفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                            <?php foreach ($monthData['representatives'] as $representativeKey => $representative) {
                                $collapseId = 'sales-details-' . $selectedYear . '-' . $monthNumber . '-' . intval($representative['userid']);
                            ?>
                                <tr>
                                    <td><strong><?= htmlspecialchars($representative['name'], ENT_QUOTES, 'UTF-8') ?></strong></td>
                                    <td><?= count($representative['receipts']) ?></td>
                                    <td><?= number_format($representative['collected'], 2) ?> ريال</td>
                                    <td class="text-success fw-bold"><?= number_format($representative['commission'], 2) ?> ريال</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#<?= $collapseId ?>">
                                            <i class="bi bi-list-ul me-1"></i>عرض العمليات
                                        </button>
                                    </td>
                                </tr>
                                <tr class="sales-detail-row">
                                    <td colspan="5" class="p-0 border-0">
                                        <div class="collapse" id="<?= $collapseId ?>">
                                            <div class="table-responsive p-3">
                                                <table class="table table-sm table-bordered bg-white mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>السند</th><th>التاريخ</th><th>المستأجر</th><th>البيان</th>
                                                            <th>طريقة الدفع</th><th>المحصل</th><th>قاعدة العمولة</th><th>العمولة</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    <?php foreach ($representative['receipts'] as $receipt) {
                                                        $commissionRule = $receipt['sales_commission_type'] === 'fixed'
                                                            ? number_format($receipt['sales_commission_value'], 2) . ' ريال ثابت'
                                                            : number_format($receipt['sales_commission_value'], 2) . '%';
                                                    ?>
                                                        <tr>
                                                            <td><a href="read_recive_voucher_template.hnt?idsanad=<?= intval($receipt['idsanad']) ?>&paymentvou=0&voucer_type=" target="_blank">#<?= intval($receipt['idsanad']) ?></a></td>
                                                            <td><?= date('d/m/Y', intval($receipt['sanaddate'])) ?></td>
                                                            <td><?= htmlspecialchars($receipt['mostagername'], ENT_QUOTES, 'UTF-8') ?></td>
                                                            <td><?= htmlspecialchars($receipt['mybyan'], ENT_QUOTES, 'UTF-8') ?></td>
                                                            <td><?= salesRepresentativePaymentTypeLabel($receipt['payment_type']) ?></td>
                                                            <td><?= number_format($receipt['depositeamount'], 2) ?> ريال</td>
                                                            <td><?= $commissionRule ?></td>
                                                            <td><?= number_format($receipt['sales_commission_amount'], 2) ?> ريال</td>
                                                        </tr>
                                                    <?php } ?>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <?php } ?>
                            </tbody>
                        </table>
                    </div>
                <?php } ?>
            </div>
        </div>
    <?php } ?>
</div>

