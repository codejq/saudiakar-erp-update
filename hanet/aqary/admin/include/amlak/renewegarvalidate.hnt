//####################aksat ##############################//
function addmothes($month,$year,$addmonth)
{
$sum1=$month+$addmonth;
if(($sum1/12)>1){$year=$year+intval(($sum1/12));$month=fmod($sum1,12);
	if($month==0){ $year=$year-1;$month=12;}
}
if(($sum1/12)<=1){$month=$sum1;}
$a[0]=$month;$a[1]=$year;
return $a;
}

if($hnt_dll || $hnt_supper_dll ==5){
$numberofmonths=(($st_year0 -  $st_year )*(365))+
(($st_month0 - $st_month )*(30.41666666666666))+($st_date0 - $st_date );
$numberofmonths=($numberofmonths/30.41666666666666);
$namberofaksat=ceil($numberofmonths/$duration);
}

if(!$hnt_dll && $hnt_supper_dll !=5){
$numberofmonths=(($st_year0 -  $st_year )*(354))+
(($st_month0 - $st_month )*(29.5))+($st_date0 - $st_date );
$numberofmonths=($numberofmonths/29.5);
$namberofaksat=ceil($numberofmonths/$duration);
}

