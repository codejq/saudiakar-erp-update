                        <?php if (!empty($availableExpenses)) { ?><label class="form-check mb-0"><input class="form-check-input" type="checkbox" id="bulkSelectAllExpenses"> <span class="form-check-label">تحديد كل المصروفات</span></label><?php } ?>
