            <div class="col-md-4" id="bulkReferenceWrap" style="display:none"><label class="form-label" for="bulkReference">رقم الشيك / الحوالة</label><input class="form-control" name="checkrakam" id="bulkReference" maxlength="50"></div>
            <div class="col-md-4" id="bulkCheckDateWrap" style="display:none"><label class="form-label" for="bulkCheckDate">تاريخ الشيك</label><input class="form-control datepicker-input" name="checkdate" id="bulkCheckDate" autocomplete="off"></div>
            <div class="col-md-4" id="bulkCheckBankWrap" style="display:none"><label class="form-label" for="bulkCheckBank">البنك</label><input class="form-control" name="checkbank" id="bulkCheckBank" maxlength="50"></div>
            <div class="col-12"><label class="form-label" for="bulkNote">ملاحظات</label><input class="form-control" name="sanadnote" id="bulkNote" maxlength="245"></div>
            <div class="col-12 text-center"><button class="btn btn-success btn-lg px-5" id="bulkSubmit" type="submit" <?= !empty($invalidRows) ? 'disabled' : '' ?>><i class="bi bi-check2-all me-1"></i>تسليم التحصيلات المحددة</button></div>
        </div>
    </form>
</div>

<script>
(function ($) {
    var isHijri = <?= $calendarType ? 'false' : 'true' ?>;
    var batchBeforeExpenses = <?= json_encode((float)$batchTotal) ?>;
    var hasInvalidRows = <?= !empty($invalidRows) ? 'true' : 'false' ?>;

    function money(value) {
        return Number(value || 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    }

    function updateExpenseSummary() {
        var expenseTotal = 0;
        $('.bulk-expense-checkbox:checked').each(function () {
            expenseTotal += parseFloat($(this).data('amount')) || 0;
        });
        expenseTotal = Math.round(expenseTotal * 100) / 100;
        var finalTotal = Math.round((batchBeforeExpenses - expenseTotal) * 100) / 100;
        var invalidExpenses = finalTotal < 1;
        $('#bulkExpenseTotal').text(money(expenseTotal));
        $('#bulkFinalTotal,#bulkFinalSummary').text(money(finalTotal));
        $('#bulkFinalTotal,#bulkFinalSummary').toggleClass('text-danger', invalidExpenses).toggleClass('text-success', !invalidExpenses);
        $('#bulkExpenseWarning').toggleClass('d-none', !invalidExpenses);
        $('#bulkSubmit').prop('disabled', hasInvalidRows || invalidExpenses);

        var boxes = $('.bulk-expense-checkbox');
        var checked = boxes.filter(':checked').length;
        $('#bulkSelectAllExpenses').prop('checked', boxes.length > 0 && checked === boxes.length)
            .prop('indeterminate', checked > 0 && checked < boxes.length);
        return !invalidExpenses;
    }

    $('.datepicker-input').data('calendartype', isHijri ? 'hijri' : 'gregorian').datepicker({format:'dd/mm/yyyy',language:'ar',rtl:true,autoclose:true,todayHighlight:true,calendarType:isHijri?'hijri':'gregorian'});
    $('#bulkSelectAllExpenses').on('change', function () {
        $('.bulk-expense-checkbox').prop('checked', this.checked);
        updateExpenseSummary();
    });
    $('.bulk-expense-checkbox').on('change', updateExpenseSummary);
    $('#bulkPaymentType').on('change', function () {
        var method = parseInt(this.value || '1', 10);
        var showDetails = method !== 1;
        $('#bulkReferenceWrap,#bulkCheckDateWrap,#bulkCheckBankWrap').toggle(showDetails);
        $('#bulkBankWrap').toggle(method === 4);
        if (!showDetails) $('#bulkReference,#bulkCheckDate,#bulkCheckBank').val('');
        if (method !== 4) { $('#bulkBankSelect').val(''); $('#bulkBankId').val('0'); }
    });
    $('#bulkBankSelect').on('change', function () {
        var option = $(this).find('option:selected');
        $('#bulkBankId').val(option.val() || '0');
        if (option.val()) $('#bulkCheckBank').val((option.data('bank') || '') + ' - ' + (option.data('holder') || ''));
    });
    $('#bulkDeliveryForm').on('submit', function (event) {
        event.preventDefault();
        if (!updateExpenseSummary()) {
            document.getElementById('bulkExpenseWarning').scrollIntoView({behavior:'smooth', block:'center'});
            return;
        }
        if (!this.checkValidity()) { this.reportValidity(); return; }
        var formData = new FormData(this);
        var button = $('#bulkSubmit');
        var original = button.html();
        button.prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i>جاري التسليم...');
        $.ajax({url:'sendmony-bulk.hnt',method:'POST',data:formData,processData:false,contentType:false,dataType:'json'})
            .done(function (response) {
                if (!response.success) { $('#bulkDeliveryMessage').html($('<div class="alert alert-danger">').text(response.message || 'تعذر تنفيذ التسليم.')); return; }
                var totalText = response.total ? ' الإجمالي: ' + response.total : '';
                var expenseText = response.expenses_total && parseFloat(response.expenses_total) > 0 ? ' المصروفات المخصومة: ' + response.expenses_total : '';
                $('#bulkDeliveryMessage').html($('<div class="alert alert-success">').text(response.message + totalText + expenseText));
                if (response.redirect) window.setTimeout(function () { window.location.href = response.redirect; }, 900);
            }).fail(function (xhr) {
                var response = xhr.responseJSON || {};
                $('#bulkDeliveryMessage').html($('<div class="alert alert-danger">').text(response.message || 'تعذر الاتصال بالخادم أثناء التسليم.'));
                button.prop('disabled', false).html(original);
            }).always(function () {
                if (!$('#bulkDeliveryMessage .alert-success').length) {
                    button.html(original);
                    updateExpenseSummary();
                }
            });
    });
    updateExpenseSummary();
})(jQuery);
</script>

<?php require '../../../foter.hnt'; ?>
