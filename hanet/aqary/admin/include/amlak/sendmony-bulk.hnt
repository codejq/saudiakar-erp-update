<?php
/**
 * Review and atomically deliver several collected rents to the property owner.
 * One sanadsarf row is created per eradat row to preserve all legacy links.
 */
$sc_title = 'تسليم عدة تحصيلات للمالك';
$sc_id = '138';

$is_ajax_request = isset($_POST['ajax_submit']) && $_POST['ajax_submit'] === '1';
if ($is_ajax_request) {
    require_once '../../../reqloginajax.hnt';
} else {
    include_once '../../../nocash.hnt';
    include_once '../../../header.hnt';
}

require_once '../uCal.class.hnt';
$dcal = new uCal();
date_default_timezone_set('Asia/Riyadh');

function bulkDeliveryEsc($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function bulkDeliveryJson($success, $message, $extra = array(), $status = 200) {
    if (!headers_sent()) {
        http_response_code($status);
        header('Content-Type: application/json; charset=utf-8');
    }
    echo json_encode(array_merge(array('success' => $success, 'message' => $message), $extra), JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
    exit;
}

function bulkDeliveryToken() {
    try {
        return bin2hex(random_bytes(24));
    } catch (Throwable $exception) {
        return hash('sha256', session_id() . microtime(true) . mt_rand());
    }
}

function bulkDeliveryIds($input) {
    if (!is_array($input)) {
        $input = preg_split('/[^0-9]+/', (string)$input, -1, PREG_SPLIT_NO_EMPTY);
    }
    $ids = array();
    foreach ($input as $value) {
        $id = intval($value);
        if ($id > 0) $ids[$id] = $id;
    }
    return array_values($ids);
}

function bulkDeliveryTimestamp($value, $isGregorian, $dcal) {
    $parts = explode('/', trim((string)$value));
    if (count($parts) !== 3) return 0;
    $day = intval($parts[0]);
    $month = intval($parts[1]);
    $year = intval($parts[2]);
    if ($day < 1 || $month < 1 || $month > 12) return 0;
    try {
        if (!$isGregorian) {
            $converted = $dcal->u2g($day, $month, $year);
            $day = intval($converted['day']);
            $month = intval($converted['month']);
            $year = intval($converted['year']);
        }
    } catch (Throwable $exception) {
        return 0;
    }
    if (!checkdate($month, $day, $year)) return 0;
    return mktime(0, 0, 0, $month, $day, $year);
}

function bulkDeliveryFinancials($row, $property) {
    $rate = floatval($property['persentage']);
    if ($rate > 100) $rate = $rate / 100;
    $base = floatval($row['amount']) - floatval($row['services']) - floatval($row['mysa3ee']) - floatval($row['mywater']) - floatval($row['tamen']);
    $ownerWater = $property['addwaterto'] === 'malek' ? floatval($row['mywater']) : 0;
    $ownerInsurance = $property['addtameento'] === 'malek' ? floatval($row['tamen']) : 0;
    $officeCommission = round(($rate / 100) * $base, 2);
    return array(
        'base' => round($base, 2),
        'commission_rate' => $rate,
        'office_commission' => $officeCommission,
        'owner_net' => round($ownerWater + $ownerInsurance + $base - $officeCommission, 2),
    );
}

function bulkDeliveryOwnerNet($row, $property) {
    $financials = bulkDeliveryFinancials($row, $property);
    return $financials['owner_net'];
}

function bulkDeliveryRows($ids, $propertyId, $link, $forUpdate = false) {
    if (empty($ids) || count($ids) > 1000) return array();
    $idSql = implode(',', array_map('intval', $ids));
    $sql = "SELECT e.*, s.period, s.bankid AS sanad_bankid,
                   ad.rakam, ad.hnt_dll_type, st.aqarsubtypename,
                   COALESCE(NULLIF(t.mostagername,''), e.mostagername) AS tenant_name,
                   COALESCE(b.ownerid2,0) AS source_ownerid
            FROM eradat e
            LEFT JOIN sanad s ON s.idsanad=CAST(e.sanadrakam AS UNSIGNED)
            LEFT JOIN amlakdetails ad ON ad.idsubaqar=e.idsubaqar
            LEFT JOIN aqarsubtype st ON st.aqarsubtype=ad.aqarsubtype
            LEFT JOIN mostagereen t ON t.mostagerid=e.mostagerid
            LEFT JOIN bankacounts b ON b.id=s.bankid
            WHERE e.idaqar='" . intval($propertyId) . "'
              AND e.iderad IN ({$idSql})
              AND e.tasfia=''
            ORDER BY e.iderad" . ($forUpdate ? ' FOR UPDATE' : '');
    $result = mysql_query($sql, $link);
    $rows = array();
    if ($result) {
        while ($row = mysql_fetch_assoc($result)) $rows[] = $row;
    }
    return $rows;
}

function bulkDeliveryExpenses($ids, $propertyId, $link, $forUpdate = false) {
    if (empty($ids) || count($ids) > 1000) return array();
    $idSql = implode(',', array_map('intval', $ids));
    $sql = "SELECT idmasrof, amount, payeddue, payeddate
            FROM masrofat
            WHERE idaqar='" . intval($propertyId) . "'
              AND fund_source=0
              AND tasfia=''
              AND idmasrof IN ({$idSql})
            ORDER BY idmasrof" . ($forUpdate ? ' FOR UPDATE' : '');
    $result = mysql_query($sql, $link);
    $rows = array();
    if ($result) {
        while ($row = mysql_fetch_assoc($result)) $rows[] = $row;
    }
    return $rows;
}

if (empty($_SESSION['bulk_delivery_csrf'])) {
    $_SESSION['bulk_delivery_csrf'] = bulkDeliveryToken();
}

$action = isset($_POST['action']) ? (string)$_POST['action'] : 'review';
$propertyId = isset($_POST['idaqar']) ? max(0, intval($_POST['idaqar'])) : 0;
$selectedIds = bulkDeliveryIds(isset($_POST['iderad_ids']) ? $_POST['iderad_ids'] : array());
$selectedExpenseIds = bulkDeliveryIds(isset($_POST['expense_ids']) ? $_POST['expense_ids'] : array());

if ($is_ajax_request && $action === 'create_bulk') {
    $postedCsrf = isset($_POST['csrf_token']) ? (string)$_POST['csrf_token'] : '';
    if ($postedCsrf === '' || !hash_equals((string)$_SESSION['bulk_delivery_csrf'], $postedCsrf)) {
        bulkDeliveryJson(false, 'انتهت صلاحية النموذج. أعد تحميل صفحة المراجعة.', array(), 403);
    }
    if ($propertyId < 1 || empty($selectedIds) || count($selectedIds) > 1000) {
        bulkDeliveryJson(false, 'قائمة التحصيلات أو العقار غير صحيحة.', array(), 422);
    }

    $formUid = isset($_POST['formuid']) ? preg_replace('/[^a-zA-Z0-9_-]/', '', (string)$_POST['formuid']) : '';
    if (strlen($formUid) < 24) {
        bulkDeliveryJson(false, 'معرف العملية غير صحيح. أعد تحميل الصفحة.', array(), 422);
    }
    $escapedUidPrefix = mysql_real_escape_string($formUid . '-%', $link);
    $duplicateResult = mysql_query("SELECT sanadid FROM sanadsarf WHERE formuid LIKE '{$escapedUidPrefix}' ORDER BY sanadid", $link);
    if ($duplicateResult && mysql_num_rows($duplicateResult) > 0) {
        $existingIds = array();
        while ($existing = mysql_fetch_assoc($duplicateResult)) $existingIds[] = intval($existing['sanadid']);
        bulkDeliveryJson(true, 'تم تنفيذ هذه العملية مسبقاً ولم تتكرر السندات.', array(
            'duplicate' => true,
            'voucher_ids' => $existingIds,
            'redirect' => 'sendmony.hnt?idaqar=' . $propertyId,
        ));
    }

    $propertyResult = mysql_query("SELECT idaqar, aqarname, ownername, persentage, addwaterto, addtameento FROM amlak WHERE idaqar='{$propertyId}' LIMIT 1", $link);
    $property = $propertyResult ? mysql_fetch_assoc($propertyResult) : false;
    if (!$property) bulkDeliveryJson(false, 'العقار المحدد غير موجود.', array(), 404);

    $beneficiary = trim(isset($_POST['mostafeed']) ? (string)$_POST['mostafeed'] : '');
    $description = trim(isset($_POST['bayan']) ? (string)$_POST['bayan'] : '');
    $note = trim(isset($_POST['sanadnote']) ? (string)$_POST['sanadnote'] : '');
    if ($beneficiary === '' || $description === '') {
        bulkDeliveryJson(false, 'اسم المستلم وبيان السند مطلوبان.', array(), 422);
    }
    if (mb_strlen($beneficiary, 'UTF-8') > 245 || mb_strlen($description, 'UTF-8') > 200 || mb_strlen($note, 'UTF-8') > 245) {
        bulkDeliveryJson(false, 'أحد الحقول النصية أطول من الحد المسموح.', array(), 422);
    }

    $calendarType = isset($_POST['local_hnt_dll_type']) ? intval($_POST['local_hnt_dll_type']) : 1;
    $voucherDate = bulkDeliveryTimestamp(isset($_POST['sanadrealdate']) ? $_POST['sanadrealdate'] : '', $calendarType, $dcal);
    $receivedDate = bulkDeliveryTimestamp(isset($_POST['money_received_date']) ? $_POST['money_received_date'] : '', $calendarType, $dcal);
    $actualDate = bulkDeliveryTimestamp(isset($_POST['money_actual_date']) ? $_POST['money_actual_date'] : '', $calendarType, $dcal);
    if (!$voucherDate || !$receivedDate || !$actualDate) {
        bulkDeliveryJson(false, 'أحد التواريخ المدخلة غير صحيح.', array(), 422);
    }

    $paymentType = isset($_POST['payment_type']) && in_array(intval($_POST['payment_type']), array(1,2,3,4,5), true) ? intval($_POST['payment_type']) : 1;
    $bankId = isset($_POST['bankid']) ? max(0, intval($_POST['bankid'])) : 0;
    if ($bankId > 0) {
        $bankCheck = mysql_query("SELECT id FROM bankacounts WHERE id='{$bankId}' AND ownerid2 IN (0,'{$propertyId}') LIMIT 1", $link);
        if (!$bankCheck || mysql_num_rows($bankCheck) === 0) {
            bulkDeliveryJson(false, 'الحساب البنكي المحدد غير متاح لهذا العقار.', array(), 422);
        }
    }

    $checkNumber = trim(isset($_POST['checkrakam']) ? (string)$_POST['checkrakam'] : '');
    $checkDate = trim(isset($_POST['checkdate']) ? (string)$_POST['checkdate'] : '');
    $checkBank = trim(isset($_POST['checkbank']) ? (string)$_POST['checkbank'] : '');
    $employee = (isset($_SESSION['useridv']) ? intval($_SESSION['useridv']) : 0) . '-' . (isset($_SESSION['namev']) ? (string)$_SESSION['namev'] : '');
    $settlementMarker = time();
    $voucherIds = array();
    $batchTotal = 0;

    if (!mysql_query('START TRANSACTION', $link)) {
        bulkDeliveryJson(false, 'تعذر بدء عملية التسليم.', array(), 500);
    }
    $rows = bulkDeliveryRows($selectedIds, $propertyId, $link, true);
    if (count($rows) !== count($selectedIds)) {
        mysql_query('ROLLBACK', $link);
        bulkDeliveryJson(false, 'تغيرت حالة أحد التحصيلات أو تم تسليمه من مستخدم آخر. أعد فتح القائمة.', array(), 409);
    }

    $expenses = empty($selectedExpenseIds) ? array() : bulkDeliveryExpenses($selectedExpenseIds, $propertyId, $link, true);
    if (count($expenses) !== count($selectedExpenseIds)) {
        mysql_query('ROLLBACK', $link);
        bulkDeliveryJson(false, 'تغيرت حالة أحد المصروفات المحددة أو تم خصمه من مستخدم آخر. أعد فتح القائمة.', array(), 409);
    }

    $totalBeforeExpenses = 0;
    foreach ($rows as &$calculationRow) {
        $calculationRow['financials'] = bulkDeliveryFinancials($calculationRow, $property);
        $totalBeforeExpenses += $calculationRow['financials']['owner_net'];
    }
    unset($calculationRow);
    $totalBeforeExpenses = round($totalBeforeExpenses, 2);

    $totalExpenses = 0;
    foreach ($expenses as $expense) $totalExpenses += floatval($expense['amount']);
    $totalExpenses = round($totalExpenses, 2);
    $finalBatchTotal = round($totalBeforeExpenses - $totalExpenses, 2);
    if ($finalBatchTotal < 1) {
        mysql_query('ROLLBACK', $link);
        bulkDeliveryJson(false, 'إجمالي المصروفات المحددة أكبر من أو يساوي المبلغ المستحق للمالك. ألغِ بعض المصروفات ثم حاول مجدداً.', array(), 422);
    }

    $failed = '';
    $remainingBeforeExpenses = $totalBeforeExpenses;
    $remainingPayable = $finalBatchTotal;
    $expenseIdsCsv = implode(',', array_map('intval', $selectedExpenseIds));
    $voucherExpenseIds = array();
    $voucherExpenseIdsLength = 0;
    foreach ($selectedExpenseIds as $expenseId) {
        $expenseIdText = (string)intval($expenseId);
        $additionalLength = strlen($expenseIdText) + ($voucherExpenseIdsLength > 0 ? 1 : 0);
        if ($voucherExpenseIdsLength + $additionalLength > 500) break;
        $voucherExpenseIds[] = $expenseIdText;
        $voucherExpenseIdsLength += $additionalLength;
    }
    $voucherExpenseIdsCsv = implode(',', $voucherExpenseIds);
    $expenseDetailsHtml = '';
    if (!empty($expenses)) {
        $expenseDetailsHtml = '<tr><td colspan="2"><strong>المصروفات المخصومة من الدفعة:</strong><ul>';
        foreach (array_slice($expenses, 0, 15) as $expense) {
            $expenseDetailsHtml .= '<li>#' . intval($expense['idmasrof']) . ' - ' .
                bulkDeliveryEsc(mb_substr((string)$expense['payeddue'], 0, 100, 'UTF-8')) . ' - ' . number_format(floatval($expense['amount']), 2) . '</li>';
        }
        if (count($expenses) > 15) $expenseDetailsHtml .= '<li>وعدد ' . (count($expenses) - 15) . ' مصروفات إضافية</li>';
        $expenseDetailsHtml .= '</ul><strong>إجمالي المصروفات: ' . number_format($totalExpenses, 2) . '</strong></td></tr>';
    }
    $lastRowIndex = count($rows) - 1;
    foreach ($rows as $rowIndex => $row) {
        $financials = $row['financials'];
        $ownerNet = $financials['owner_net'];
        if ($ownerNet < 1) {
            $failed = 'صافي التحصيل رقم ' . intval($row['iderad']) . ' أقل من ريال واحد ولا يمكن تسليمه.';
            break;
        }
        if ($rowIndex === $lastRowIndex) {
            $settlementAmount = round($remainingPayable, 2);
        } else {
            $settlementAmount = $remainingBeforeExpenses > 0
                ? round($remainingPayable * ($ownerNet / $remainingBeforeExpenses), 2)
                : 0;
            $settlementAmount = max(0, min($ownerNet, $settlementAmount));
        }
        $expenseShare = round($ownerNet - $settlementAmount, 2);
        $remainingBeforeExpenses = round($remainingBeforeExpenses - $ownerNet, 2);
        $remainingPayable = round($remainingPayable - $settlementAmount, 2);
        $rowUid = $formUid . '-' . intval($row['iderad']);
        $rowDescription = $description . ' - تحصيل رقم ' . intval($row['iderad']);
        $rowBreakdown = '<table class="calc-table"><tr><td>رقم التحصيل</td><td>' . intval($row['iderad']) . '</td></tr>' .
                        '<tr><td>المبلغ المحصل</td><td>' . number_format(floatval($row['amount']), 2) . '</td></tr>' .
                        '<tr><td>السعي/التجديد</td><td>' . number_format(floatval($row['mysa3ee']), 2) . '</td></tr>' .
                        '<tr><td>الخدمات</td><td>' . number_format(floatval($row['services']), 2) . '</td></tr>' .
                        '<tr><td>عمولة المكتب (' . number_format(floatval($financials['commission_rate']), 2) . '%)</td><td>' . number_format(floatval($financials['office_commission']), 2) . '</td></tr>' .
                        '<tr><td>صافي المالك قبل المصروفات</td><td>' . number_format($ownerNet, 2) . '</td></tr>' .
                        '<tr><td>حصة التحصيل من المصروفات المخصومة</td><td>' . number_format($expenseShare, 2) . '</td></tr>' .
                        '<tr><td>صافي التسليم</td><td>' . number_format($settlementAmount, 2) . '</td></tr>' .
                        ($rowIndex === 0 ? $expenseDetailsHtml : '') . '</table>';
        $moneySource = intval($row['source_ownerid']) > 0 ? 1 : 0;
        $rowExpenseIds = $rowIndex === 0 ? $voucherExpenseIdsCsv : '';

        $sql = "INSERT INTO sanadsarf SET
                    sanadate='" . intval($voucherDate) . "', aqarid='{$propertyId}', amount='" . number_format($settlementAmount, 2, '.', '') . "',
                    bayan='" . mysql_real_escape_string($rowDescription, $link) . "', note='" . mysql_real_escape_string($note, $link) . "',
                    mostafeed='" . mysql_real_escape_string($beneficiary, $link) . "', qayedtype=3,
                    mowazaf='" . mysql_real_escape_string($employee, $link) . "', extradata='" . mysql_real_escape_string($rowBreakdown, $link) . "',
                    checkrakam='" . mysql_real_escape_string($checkNumber, $link) . "', checkdate='" . mysql_real_escape_string($checkDate, $link) . "',
                    checkbank='" . mysql_real_escape_string($checkBank, $link) . "', tasfia='{$settlementMarker}',
                    idsubaqar='" . intval($row['idsubaqar']) . "', iderad='" . intval($row['iderad']) . "', masrofatarray='" . mysql_real_escape_string($rowExpenseIds, $link) . "',
                    payment_type='{$paymentType}', bankid='{$bankId}', money_source='{$moneySource}',
                    money_received_date='" . intval($receivedDate) . "', money_actual_date='" . intval($actualDate) . "',
                    formuid='" . mysql_real_escape_string($rowUid, $link) . "'";
        if (!mysql_query($sql, $link)) {
            $failed = 'تعذر إنشاء سند التحصيل رقم ' . intval($row['iderad']) . ': ' . mysql_error($link);
            break;
        }
        $voucherIds[] = intval(mysql_insert_id($link));
        $updateSql = "UPDATE eradat SET tasfia='{$settlementMarker}', formuid='" . mysql_real_escape_string($rowUid, $link) . "'
                      WHERE iderad='" . intval($row['iderad']) . "' AND idaqar='{$propertyId}' AND tasfia='' LIMIT 1";
        if (!mysql_query($updateSql, $link) || mysql_affected_rows($link) !== 1) {
            $failed = 'تعذر تحديث التحصيل رقم ' . intval($row['iderad']) . ' لأنه تغير أثناء العملية.';
            break;
        }
        $batchTotal += $settlementAmount;
    }

    if ($failed === '' && !empty($selectedExpenseIds)) {
        $expenseFormUid = $formUid . '-' . intval($rows[0]['iderad']);
        $expenseUpdateSql = "UPDATE masrofat
                             SET tasfia='{$settlementMarker}', formuid='" . mysql_real_escape_string($expenseFormUid, $link) . "'
                             WHERE idaqar='{$propertyId}' AND fund_source=0 AND tasfia=''
                               AND idmasrof IN ({$expenseIdsCsv})";
        if (!mysql_query($expenseUpdateSql, $link) || mysql_affected_rows($link) !== count($selectedExpenseIds)) {
            $failed = 'تعذر اعتماد المصروفات المحددة لأنها تغيرت أثناء العملية.';
        }
    }

    if ($failed !== '') {
        mysql_query('ROLLBACK', $link);
        bulkDeliveryJson(false, $failed . ' لم يتم تسليم أي تحصيل.', array(), 409);
    }
    if (!mysql_query('COMMIT', $link)) {
        mysql_query('ROLLBACK', $link);
        bulkDeliveryJson(false, 'تعذر إكمال عملية التسليم. لم يتم اعتماد العملية.', array(), 500);
    }

    $_SESSION['bulk_delivery_csrf'] = bulkDeliveryToken();
    bulkDeliveryJson(true, 'تم تسليم ' . count($voucherIds) . ' تحصيلات للمالك بنجاح.', array(
        'voucher_ids' => $voucherIds,
        'total' => number_format($batchTotal, 2),
        'expenses_total' => number_format($totalExpenses, 2),
        'redirect' => 'sendmony.hnt?idaqar=' . $propertyId,
    ));
}

if ($propertyId < 1 || empty($selectedIds) || count($selectedIds) > 1000) {
    ?>
    <div class="container-fluid py-4" dir="rtl"><div class="alert alert-danger">اختر تحصيلاً واحداً على الأقل من صفحة التسليم.</div><a class="btn btn-secondary" href="sendmony-select-aqar.hnt">عودة</a></div>
    <?php require '../../../foter.hnt'; exit;
}

$propertyResult = mysql_query("SELECT idaqar, aqarname, ownername, persentage, addwaterto, addtameento FROM amlak WHERE idaqar='{$propertyId}' LIMIT 1", $link);
$property = $propertyResult ? mysql_fetch_assoc($propertyResult) : false;
$rows = $property ? bulkDeliveryRows($selectedIds, $propertyId, $link) : array();
if (!$property || count($rows) !== count($selectedIds)) {
    ?>
    <div class="container-fluid py-4" dir="rtl"><div class="alert alert-danger">بعض التحصيلات المحددة غير موجودة أو تم تسليمها بالفعل. أعد فتح القائمة.</div><a class="btn btn-secondary" href="sendmony.hnt?idaqar=<?= intval($propertyId) ?>">عودة</a></div>
    <?php require '../../../foter.hnt'; exit;
}

$calendarType = (isset($hnt_dll) && ($hnt_dll || (isset($hnt_supper_dll) && $hnt_supper_dll == 5))) ? 1 : 0;
if ($calendarType) {
    $currentDate = date('d/m/Y');
} else {
    $hijriToday = $dcal->g2u(intval(date('d')), intval(date('m')), intval(date('Y')));
    $currentDate = intval($hijriToday['day']) . '/' . intval($hijriToday['month']) . '/' . intval($hijriToday['year']);
}
$batchTotal = 0;
$batchOfficeCommission = 0;
$batchSaee = 0;
$invalidRows = array();
foreach ($rows as &$row) {
    $rowFinancials = bulkDeliveryFinancials($row, $property);
    $row['owner_net'] = $rowFinancials['owner_net'];
    $row['office_commission'] = $rowFinancials['office_commission'];
    $row['commission_rate'] = $rowFinancials['commission_rate'];
    $batchTotal += $row['owner_net'];
    $batchOfficeCommission += $row['office_commission'];
    $batchSaee += floatval($row['mysa3ee']);
    if ($row['owner_net'] < 1) $invalidRows[] = intval($row['iderad']);
}
unset($row);
$batchTotal = round($batchTotal, 2);
$batchOfficeCommission = round($batchOfficeCommission, 2);
$batchSaee = round($batchSaee, 2);

$availableExpenses = array();
$expenseResult = mysql_query("SELECT idmasrof, amount, payeddue, payeddate
                              FROM masrofat
                              WHERE idaqar='{$propertyId}' AND fund_source=0 AND tasfia=''
                              ORDER BY payeddate DESC, idmasrof DESC", $link);
if ($expenseResult) {
    while ($expense = mysql_fetch_assoc($expenseResult)) {
        if ($calendarType) {
            $expense['formatted_date'] = date('d/m/Y', intval($expense['payeddate']));
        } else {
            try {
                $expenseHijri = $dcal->g2u(intval(date('d', intval($expense['payeddate']))), intval(date('m', intval($expense['payeddate']))), intval(date('Y', intval($expense['payeddate']))));
                $expense['formatted_date'] = intval($expenseHijri['day']) . '/' . intval($expenseHijri['month']) . '/' . intval($expenseHijri['year']);
            } catch (Throwable $exception) {
                $expense['formatted_date'] = date('d/m/Y', intval($expense['payeddate']));
            }
        }
        $availableExpenses[] = $expense;
    }
}

$bankAccounts = array();
$bankResult = mysql_query("SELECT id, bankname, acountholder, acountnumber, iban FROM bankacounts WHERE ownerid2 IN (0,'{$propertyId}') ORDER BY ownerid2 DESC, id DESC", $link);
if ($bankResult) while ($bank = mysql_fetch_assoc($bankResult)) $bankAccounts[] = $bank;
$formUid = bulkDeliveryToken();
?>

<style>
.bulk-title{background:linear-gradient(135deg,#0f766e,#15803d);color:#fff;border-radius:.8rem;padding:1rem 1.25rem}
.bulk-card{border:0;box-shadow:0 2px 14px rgba(15,23,42,.09)}
