<?php
$sc_title = 'تسجيل مصروفات المكتب';
$sc_id = '40';

$is_ajax_request = isset($_POST['ajax_submit']) && $_POST['ajax_submit'] === '1';
if ($is_ajax_request) {
    require_once '../../../reqloginajax.hnt';
} else {
    include_once '../../../nocash.hnt';
    include_once '../../../header.hnt';
}
date_default_timezone_set('Asia/Riyadh');

function officeExpenseEsc($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function officeExpenseToken() {
    try {
        return bin2hex(random_bytes(24));
    } catch (Throwable $exception) {
        return hash('sha256', session_id() . microtime(true) . mt_rand());
    }
}

function officeExpenseValidDate($value) {
    $timezone = new DateTimeZone('Asia/Riyadh');
    $date = DateTimeImmutable::createFromFormat('!Y-m-d', (string)$value, $timezone);
    $errors = DateTimeImmutable::getLastErrors();
    if ($date === false || ($errors !== false && ($errors['warning_count'] || $errors['error_count']))) {
        return false;
    }
    return $date->format('Y-m-d') === $value ? $date : false;
}

if (empty($_SESSION['office_expense_csrf'])) {
    $_SESSION['office_expense_csrf'] = officeExpenseToken();
}

$formError = '';
$createdCategory = null;
$postedAction = isset($_POST['action']) ? (string)$_POST['action'] : '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $postedToken = isset($_POST['csrf_token']) ? (string)$_POST['csrf_token'] : '';
    if ($postedToken === '' || !hash_equals((string)$_SESSION['office_expense_csrf'], $postedToken)) {
        $formError = 'انتهت صلاحية نموذج الحفظ. أعد تحميل الصفحة ثم حاول مرة أخرى.';
    } elseif ($postedAction === 'add_category') {
        $categoryName = trim(isset($_POST['category_name']) ? (string)$_POST['category_name'] : '');
        if ($categoryName === '' || mb_strlen($categoryName, 'UTF-8') > 120) {
            $formError = 'أدخل اسم تصنيف صحيحاً لا يتجاوز 120 حرفاً.';
        } else {
            $escapedCategory = mysql_real_escape_string($categoryName, $link);
            $existingCategory = mysql_query("SELECT idmasrofcod FROM masrofattakweed WHERE TRIM(masrofkind)='{$escapedCategory}' LIMIT 1", $link);
            if ($existingCategory && mysql_num_rows($existingCategory) > 0) {
                $formError = 'هذا التصنيف موجود مسبقاً.';
            } elseif (mysql_query("INSERT INTO masrofattakweed (masrofkind, formuid) VALUES ('{$escapedCategory}', 'office-expense-custom')", $link)) {
                $createdCategory = array('id' => intval(mysql_insert_id($link)), 'name' => $categoryName);
                if ($is_ajax_request) {
                    echo json_encode(array(
                        'success' => true,
                        'message' => 'تمت إضافة التصنيف وأصبح متاحاً في القائمة.',
                        'category' => $createdCategory,
                    ), JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
                    exit;
                }
                header('Location: office_expense.hnt?category_added=1');
                exit;
            } else {
                $formError = 'تعذر إضافة التصنيف: ' . mysql_error($link);
            }
        }
    } elseif ($postedAction === 'save_expense') {
        $amount = isset($_POST['amount']) ? round(floatval($_POST['amount']), 2) : 0;
        $categoryId = isset($_POST['idmasrofcod']) ? intval($_POST['idmasrofcod']) : 0;
        $customCategory = trim(isset($_POST['custom_category']) ? (string)$_POST['custom_category'] : '');
        $expenseDateValue = trim(isset($_POST['expense_date']) ? (string)$_POST['expense_date'] : '');
        $expenseDate = officeExpenseValidDate($expenseDateValue);
        $paidByUserId = isset($_POST['paid_by_userid']) ? max(0, intval($_POST['paid_by_userid'])) : 0;
        $beneficiaryUserId = isset($_POST['beneficiary_userid']) ? max(0, intval($_POST['beneficiary_userid'])) : 0;
        $beneficiaryName = trim(isset($_POST['beneficiary_name']) ? (string)$_POST['beneficiary_name'] : '');
        $paidBy = '';
        $createdByUserId = isset($_SESSION['useridv']) ? max(0, intval($_SESSION['useridv'])) : 0;
        $createdAt = time();
        $description = trim(isset($_POST['payeddue']) ? (string)$_POST['payeddue'] : '');
        $formUid = isset($_POST['formuid']) ? preg_replace('/[^a-f0-9]/i', '', (string)$_POST['formuid']) : '';

        if ($amount <= 0 || $amount > 99999999.99) {
            $formError = 'أدخل مبلغاً صحيحاً أكبر من صفر.';
        } elseif ($expenseDate === false) {
            $formError = 'تاريخ المصروف غير صحيح.';
        } elseif ($paidByUserId <= 0) {
            $formError = 'اختر المستخدم الذي دفع المصروف.';
        } elseif (mb_strlen($beneficiaryName, 'UTF-8') > 245 || mb_strlen($description, 'UTF-8') > 245) {
            $formError = 'اسم المستفيد أو البيان أطول من الحد المسموح.';
        } elseif (strlen($formUid) < 24) {
            $formError = 'تعذر التحقق من العملية. أعد تحميل الصفحة.';
        }

        if ($formError === '') {
            $paidByResult = mysql_query("SELECT userid, name, username FROM user WHERE userid='{$paidByUserId}' LIMIT 1", $link);
            $paidByRow = $paidByResult ? mysql_fetch_assoc($paidByResult) : false;
            if (!$paidByRow) {
                $formError = 'المستخدم المحدد في حقل دفع بواسطة غير موجود.';
            } else {
                $paidBy = trim((string)$paidByRow['name']) !== '' ? (string)$paidByRow['name'] : (string)$paidByRow['username'];
            }
        }

        if ($formError === '' && $beneficiaryUserId > 0) {
            $beneficiaryResult = mysql_query("SELECT userid, name, username FROM user WHERE userid='{$beneficiaryUserId}' LIMIT 1", $link);
            $beneficiaryRow = $beneficiaryResult ? mysql_fetch_assoc($beneficiaryResult) : false;
            if (!$beneficiaryRow) {
                $formError = 'المستخدم المحدد كمستفيد غير موجود.';
            } else {
                $beneficiaryName = trim((string)$beneficiaryRow['name']) !== '' ? (string)$beneficiaryRow['name'] : (string)$beneficiaryRow['username'];
            }
        } elseif ($formError === '' && $beneficiaryName === '') {
            $formError = 'اختر المستفيد من المستخدمين أو اكتب اسمه.';
        }

        if ($formError === '' && $categoryId === -1) {
            if ($customCategory === '' || mb_strlen($customCategory, 'UTF-8') > 120) {
                $formError = 'اكتب اسم التصنيف الآخر.';
            } else {
                $escapedCustom = mysql_real_escape_string($customCategory, $link);
                $categoryResult = mysql_query("SELECT idmasrofcod FROM masrofattakweed WHERE TRIM(masrofkind)='{$escapedCustom}' LIMIT 1", $link);
                $categoryRow = $categoryResult ? mysql_fetch_assoc($categoryResult) : false;
                if ($categoryRow) {
                    $categoryId = intval($categoryRow['idmasrofcod']);
                } elseif (mysql_query("INSERT INTO masrofattakweed (masrofkind, formuid) VALUES ('{$escapedCustom}', 'office-expense-custom')", $link)) {
                    $categoryId = intval(mysql_insert_id($link));
                    $createdCategory = array('id' => $categoryId, 'name' => $customCategory);
                } else {
                    $formError = 'تعذر حفظ التصنيف الجديد: ' . mysql_error($link);
                }
            }
        }

        if ($formError === '' && $categoryId > 0) {
            $categoryCheck = mysql_query("SELECT idmasrofcod FROM masrofattakweed WHERE idmasrofcod='{$categoryId}' LIMIT 1", $link);
            if (!$categoryCheck || mysql_num_rows($categoryCheck) === 0) {
                $formError = 'تصنيف المصروف المحدد غير موجود.';
            }
        } elseif ($formError === '' && $categoryId <= 0) {
            $formError = 'اختر تصنيف المصروف.';
        }

        if ($formError === '') {
            $escapedUid = mysql_real_escape_string($formUid, $link);
            $duplicate = mysql_query("SELECT idmasrof FROM masrofat WHERE idaqar=0 AND formuid='{$escapedUid}' LIMIT 1", $link);
            if ($duplicate && mysql_num_rows($duplicate) > 0) {
                if ($is_ajax_request) {
                    echo json_encode(array(
                        'success' => true,
                        'duplicate' => true,
                        'message' => 'هذه العملية محفوظة مسبقاً ولم تتم إضافتها مرة أخرى.',
                        'csrf_token' => (string)$_SESSION['office_expense_csrf'],
                        'formuid' => officeExpenseToken(),
                    ), JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
                    exit;
                }
                header('Location: office_expense.hnt?saved=1');
                exit;
            }

            $escapedPaidBy = mysql_real_escape_string($paidBy, $link);
            $escapedBeneficiaryName = mysql_real_escape_string($beneficiaryName, $link);
            $escapedDescription = mysql_real_escape_string($description, $link);
            $expenseTimestamp = $expenseDate->getTimestamp();
            $sql = "INSERT INTO masrofat
                    (idaqar, idsubaqar, idmasrofcod, amount, payedby, paid_by_userid,
                     beneficiary_userid, beneficiary_name, created_by_userid, created_at,
                     payeddue, payeddate, tasfia, formuid, fund_source)
                    VALUES
                    (0, 0, '{$categoryId}', '" . number_format($amount, 2, '.', '') . "', '{$escapedPaidBy}', '{$paidByUserId}',
                     '{$beneficiaryUserId}', '{$escapedBeneficiaryName}', '{$createdByUserId}', '" . intval($createdAt) . "', '{$escapedDescription}',
                     '" . intval($expenseTimestamp) . "', '', '{$escapedUid}', 0)";
            if (mysql_query($sql, $link)) {
                $expenseId = intval(mysql_insert_id($link));
                $categoryName = '';
                $savedCategoryResult = mysql_query("SELECT masrofkind FROM masrofattakweed WHERE idmasrofcod='{$categoryId}' LIMIT 1", $link);
                $savedCategory = $savedCategoryResult ? mysql_fetch_assoc($savedCategoryResult) : false;
                if ($savedCategory) {
                    $categoryName = (string)$savedCategory['masrofkind'];
                }
                $_SESSION['office_expense_csrf'] = officeExpenseToken();
                if ($is_ajax_request) {
                    echo json_encode(array(
                        'success' => true,
                        'message' => 'تم تسجيل مصروف المكتب بنجاح.',
                        'csrf_token' => (string)$_SESSION['office_expense_csrf'],
                        'formuid' => officeExpenseToken(),
                        'category' => $createdCategory,
                        'expense' => array(
                            'id' => $expenseId,
                            'date' => $expenseDate->format('d/m/Y'),
                            'category' => $categoryName,
                            'description' => $description,
                            'paid_by' => $paidBy,
                            'beneficiary' => $beneficiaryName,
                            'created_by' => isset($_SESSION['namev']) ? (string)$_SESSION['namev'] : '',
                            'created_at' => date('d/m/Y H:i', $createdAt),
                            'amount' => number_format($amount, 2),
                        ),
                        'created_by_userid' => $createdByUserId,
                        'created_at_value' => $createdAt,
                    ), JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
                    exit;
                }
                header('Location: office_expense.hnt?saved=1');
                exit;
            }
            $formError = 'تعذر حفظ المصروف: ' . mysql_error($link);
        }
    }
}

if ($is_ajax_request) {
    echo json_encode(array(
        'success' => false,
        'message' => $formError !== '' ? $formError : 'الطلب غير صحيح.',
    ), JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
    exit;
}

$categories = array();
$categoryResult = mysql_query('SELECT idmasrofcod, masrofkind FROM masrofattakweed ORDER BY masrofkind, idmasrofcod', $link);
if ($categoryResult) {
    while ($category = mysql_fetch_assoc($categoryResult)) {
        $categories[] = $category;
    }
}

$users = array();
$userResult = mysql_query("SELECT userid, name, username
                           FROM user
                           ORDER BY CASE WHEN TRIM(name)='' THEN username ELSE name END, userid", $link);
if ($userResult) {
    while ($user = mysql_fetch_assoc($userResult)) {
        $user['display_name'] = trim((string)$user['name']) !== '' ? $user['name'] : $user['username'];
        $users[] = $user;
    }
}

$recentExpenses = array();
$recentResult = mysql_query("SELECT m.idmasrof, m.amount, m.payedby, m.beneficiary_name,
                                   m.payeddue, m.payeddate, m.created_at,
                                   COALESCE(NULLIF(c.masrofkind, ''), CONCAT('تصنيف #', m.idmasrofcod)) AS category_name,
                                   COALESCE(NULLIF(creator.name, ''), creator.username, '') AS created_by_name
                            FROM masrofat m
                            LEFT JOIN masrofattakweed c ON c.idmasrofcod=m.idmasrofcod
                            LEFT JOIN user creator ON creator.userid=m.created_by_userid
                            WHERE m.idaqar=0
                            ORDER BY m.payeddate DESC, m.idmasrof DESC
                            LIMIT 30", $link);
if ($recentResult) {
    while ($expense = mysql_fetch_assoc($recentResult)) {
        $recentExpenses[] = $expense;
    }
}

$defaultPaidByUserId = isset($_POST['paid_by_userid']) ? intval($_POST['paid_by_userid']) : (isset($_SESSION['useridv']) ? intval($_SESSION['useridv']) : 0);
$defaultBeneficiaryUserId = isset($_POST['beneficiary_userid']) ? intval($_POST['beneficiary_userid']) : 0;
$defaultBeneficiaryName = isset($_POST['beneficiary_name']) ? (string)$_POST['beneficiary_name'] : '';
$hiddenCreatedByUserId = isset($_SESSION['useridv']) ? intval($_SESSION['useridv']) : 0;
$hiddenCreatedAt = time();
$newFormUid = officeExpenseToken();
?>

