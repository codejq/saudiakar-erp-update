                            <?php } ?>
                            <option value="-1" <?= isset($_POST['idmasrofcod']) && intval($_POST['idmasrofcod']) === -1 ? 'selected' : '' ?>>أخرى — إضافة تصنيف جديد</option>
                        </select>
                    </div>
                    <div class="col-md-6" id="customCategoryWrap">
                        <label class="form-label" for="custom_category">اسم التصنيف الآخر</label>
