        <div class="col-xl-4">
            <form method="post" class="card office-expense-card h-100" id="officeExpenseCategoryForm">
                <div class="card-header bg-white py-3"><strong><i class="bi bi-tags text-primary me-1"></i>إضافة تصنيف</strong></div>
