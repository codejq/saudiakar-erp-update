    <div class="card office-expense-card mt-4">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
            <strong><i class="bi bi-clock-history me-1"></i>آخر مصروفات المكتب</strong>
            <span class="badge bg-secondary"><span id="recentExpenseCount"><?= count($recentExpenses) ?></span> عملية معروضة</span>
        </div>
        <div class="table-responsive office-expense-table">
            <table class="table table-hover table-striped mb-0">
                <thead><tr><th>الرقم</th><th>تاريخ المصروف</th><th>التصنيف</th><th>البيان</th><th>دفع بواسطة</th><th>المستفيد</th><th>أنشأه</th><th>وقت الإنشاء</th><th>المبلغ</th></tr></thead>
                <tbody id="recentOfficeExpenses">
                <?php foreach ($recentExpenses as $expense) { ?>
                    <tr>
                        <td>#<?= intval($expense['idmasrof']) ?></td>
                        <td><?= date('d/m/Y', intval($expense['payeddate'])) ?></td>
                        <td><?= officeExpenseEsc($expense['category_name']) ?></td>
                        <td><?= officeExpenseEsc($expense['payeddue']) ?></td>
                        <td><?= officeExpenseEsc($expense['payedby']) ?></td>
                        <td><?= officeExpenseEsc($expense['beneficiary_name']) ?></td>
                        <td><?= officeExpenseEsc($expense['created_by_name']) ?></td>
                        <td><?= intval($expense['created_at']) > 0 ? date('d/m/Y H:i', intval($expense['created_at'])) : '—' ?></td>
                        <td class="fw-bold text-danger"><?= number_format(floatval($expense['amount']), 2) ?> <?= officeExpenseEsc(isset($myomla) && $myomla !== '' ? $myomla : 'ريال') ?></td>
                    </tr>
                <?php } ?>
                <?php if (empty($recentExpenses)) { ?><tr class="office-expense-empty"><td colspan="9" class="text-center text-muted py-5">لم تسجل مصروفات مكتب بعد.</td></tr><?php } ?>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function ($) {
    var category = document.getElementById('idmasrofcod');
    var customWrap = document.getElementById('customCategoryWrap');
    var customInput = document.getElementById('custom_category');
    var beneficiarySelect = document.getElementById('beneficiary_userid');
    var beneficiaryNameWrap = document.getElementById('beneficiaryNameWrap');
    var beneficiaryNameInput = document.getElementById('beneficiary_name');
    var currencyLabel = <?= json_encode(isset($myomla) && $myomla !== '' ? $myomla : 'ريال', JSON_UNESCAPED_UNICODE | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

    function showMessage(type, message) {
        if (typeof showBootstrapNotification === 'function') {
            showBootstrapNotification(type, message);
        }
        var alertType = type === 'success' ? 'success' : (type === 'warning' ? 'warning' : 'danger');
        $('#officeExpenseMessage').html(
            $('<div>').addClass('alert alert-' + alertType).attr('role', 'alert').text(message)
        );
        window.scrollTo({top: 0, behavior: 'smooth'});
    }

    function appendCategory(categoryData, selectIt) {
        if (!categoryData || !categoryData.id) return;
        var value = String(categoryData.id);
        var option = Array.prototype.find.call(category.options, function (item) { return item.value === value; });
        if (!option) {
            option = new Option(categoryData.name, value, false, false);
            category.insertBefore(option, category.querySelector('option[value="-1"]'));
        }
        if (selectIt) {
            category.value = value;
            $(category).trigger('change');
        }
    }

    function updateRequestTokens(response) {
        if (response.csrf_token) {
            $('input[name="csrf_token"]').val(response.csrf_token);
        }
        if (response.formuid) {
            $('#officeExpenseForm input[name="formuid"]').val(response.formuid);
        }
        if (response.created_by_userid !== undefined) {
            $('#created_by_userid').val(response.created_by_userid);
        }
        if (response.created_at_value) {
            $('#created_at').val(response.created_at_value);
        }
    }

    function prependExpense(expense) {
        if (!expense) return;
        var $row = $('<tr>');
        $('<td>').text('#' + expense.id).appendTo($row);
        $('<td>').text(expense.date).appendTo($row);
        $('<td>').text(expense.category).appendTo($row);
        $('<td>').text(expense.description).appendTo($row);
        $('<td>').text(expense.paid_by).appendTo($row);
        $('<td>').text(expense.beneficiary).appendTo($row);
        $('<td>').text(expense.created_by).appendTo($row);
        $('<td>').text(expense.created_at).appendTo($row);
        $('<td>').addClass('fw-bold text-danger').text(expense.amount + ' ' + currencyLabel).appendTo($row);
        $('#recentOfficeExpenses .office-expense-empty').remove();
        $('#recentOfficeExpenses').prepend($row);
        var count = parseInt($('#recentExpenseCount').text(), 10) || 0;
        $('#recentExpenseCount').text(Math.min(count + 1, 30));
        var $rows = $('#recentOfficeExpenses tr');
        if ($rows.length > 30) $rows.last().remove();
    }

    function toggleCustomCategory() {
        var show = category && category.value === '-1';
        customWrap.style.display = show ? '' : 'none';
        customInput.required = show;
        if (!show) customInput.value = '';
    }
    if (category) {
        $(category).on('change', toggleCustomCategory);
        toggleCustomCategory();
    }

    function toggleBeneficiaryName() {
        var manualName = !beneficiarySelect || beneficiarySelect.value === '0' || beneficiarySelect.value === '';
        beneficiaryNameWrap.style.display = manualName ? '' : 'none';
        beneficiaryNameInput.disabled = !manualName;
        beneficiaryNameInput.required = manualName;
        if (!manualName) beneficiaryNameInput.value = '';
    }
    if (beneficiarySelect) {
        $(beneficiarySelect).on('change', toggleBeneficiaryName);
        toggleBeneficiaryName();
    }
    if ($.fn.select2) {
        $('#paid_by_userid, #beneficiary_userid').select2({
            dir: 'rtl',
            width: '100%',
            language: 'ar'
        });
    }

    $('#officeExpenseForm').on('submit', function (event) {
        event.preventDefault();
        var form = this;
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        var formData = new FormData(form);
        formData.append('ajax_submit', '1');
        var $button = $('#saveOfficeExpense').prop('disabled', true);

        $.ajax({
            url: 'office_expense.hnt',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json'
        }).done(function (response) {
            if (!response.success) {
                showMessage('danger', response.message || 'تعذر حفظ المصروف.');
                return;
            }
            updateRequestTokens(response);
            appendCategory(response.category, true);
            if (!response.duplicate) prependExpense(response.expense);
            $('#amount, #payeddue, #custom_category, #beneficiary_name').val('');
            $('#beneficiary_userid').val('0').trigger('change');
            if (!response.category) {
                $('#idmasrofcod').val('').trigger('change');
            }
            showMessage(response.duplicate ? 'warning' : 'success', response.message);
        }).fail(function (xhr) {
            var response = xhr.responseJSON || {};
            showMessage('danger', response.message || 'تعذر الاتصال بالخادم أثناء حفظ المصروف.');
        }).always(function () {
            $button.prop('disabled', false);
        });
    });

    $('#officeExpenseCategoryForm').on('submit', function (event) {
        event.preventDefault();
        var form = this;
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        var formData = new FormData(form);
        formData.append('ajax_submit', '1');
        var $button = $('#addOfficeExpenseCategory').prop('disabled', true);

        $.ajax({
            url: 'office_expense.hnt',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json'
        }).done(function (response) {
            if (!response.success) {
                showMessage('danger', response.message || 'تعذر إضافة التصنيف.');
                return;
            }
            appendCategory(response.category, true);
            $('#category_name').val('');
            showMessage('success', response.message);
        }).fail(function (xhr) {
            var response = xhr.responseJSON || {};
            showMessage('danger', response.message || 'تعذر الاتصال بالخادم أثناء إضافة التصنيف.');
        }).always(function () {
            $button.prop('disabled', false);
        });
    });
})(jQuery);
</script>
