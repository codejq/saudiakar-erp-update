                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" for="amount">المبلغ <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input class="form-control" type="number" min="0.01" max="99999999.99" step="0.01" name="amount" id="amount" required value="<?= officeExpenseEsc(isset($_POST['amount']) ? $_POST['amount'] : '') ?>">
                            <span class="input-group-text"><?= officeExpenseEsc(isset($myomla) && $myomla !== '' ? $myomla : 'ريال') ?></span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" for="expense_date">التاريخ <span class="text-danger">*</span></label>
                        <input class="form-control" type="date" name="expense_date" id="expense_date" required value="<?= officeExpenseEsc(isset($_POST['expense_date']) ? $_POST['expense_date'] : date('Y-m-d')) ?>">
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" for="paid_by_userid">دفع بواسطة <span class="text-danger">*</span></label>
                        <select class="form-select" name="paid_by_userid" id="paid_by_userid" required>
                            <option value="">اختر المستخدم</option>
                            <?php foreach ($users as $user) { ?>
                                <option value="<?= intval($user['userid']) ?>" <?= intval($user['userid']) === $defaultPaidByUserId ? 'selected' : '' ?>><?= officeExpenseEsc($user['display_name']) ?><?= $user['username'] !== $user['display_name'] ? ' (' . officeExpenseEsc($user['username']) . ')' : '' ?></option>
                            <?php } ?>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" for="beneficiary_userid">المستفيد</label>
                        <select class="form-select" name="beneficiary_userid" id="beneficiary_userid">
                            <option value="0">كتابة اسم مستفيد</option>
                            <?php foreach ($users as $user) { ?>
                                <option value="<?= intval($user['userid']) ?>" <?= intval($user['userid']) === $defaultBeneficiaryUserId ? 'selected' : '' ?>><?= officeExpenseEsc($user['display_name']) ?><?= $user['username'] !== $user['display_name'] ? ' (' . officeExpenseEsc($user['username']) . ')' : '' ?></option>
                            <?php } ?>
                        </select>
                    </div>
                    <div class="col-12" id="beneficiaryNameWrap">
                        <label class="form-label" for="beneficiary_name">اسم المستفيد <span class="text-danger">*</span></label>
                        <input class="form-control" type="text" maxlength="245" name="beneficiary_name" id="beneficiary_name" value="<?= officeExpenseEsc($defaultBeneficiaryName) ?>" placeholder="اكتب اسم الشخص أو الجهة المستفيدة">
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="payeddue">البيان</label>
                        <textarea class="form-control" rows="3" maxlength="245" name="payeddue" id="payeddue" placeholder="تفاصيل المصروف أو رقم الفاتورة"><?= officeExpenseEsc(isset($_POST['payeddue']) ? $_POST['payeddue'] : '') ?></textarea>
                    </div>
