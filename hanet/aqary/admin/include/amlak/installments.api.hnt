<?php
/**
 * Installments API - Handle installment operations
 *
 * Actions:
 * - get_installment
 * - record_payment
 * - update_installment
 * - cancel_installment
 * - get_payment_history
 * - calculate_late_fees
 *
 * @version 2.0-debug
 * @date 2025-01-18
 */

define('API_VERSION', '2.0-debug-' . filemtime(__FILE__));

// Suppress deprecation warnings for clean JSON output
error_reporting(E_ERROR | E_PARSE);
ini_set('display_errors', '0');

// Aggressive cache clearing
if (function_exists('opcache_invalidate')) {
    opcache_invalidate(__FILE__, true);
}
if (function_exists('opcache_reset')) {
    @opcache_reset();
}

// Set response type to JSON and prevent caching
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-cache, no-store, must-revalidate');
header('Pragma: no-cache');
header('Expires: 0');

// Include required files
include_once "../../../reqloginajax.hnt";
include_once "../../../connectdb.hnt";
include_once "../../../data.hnt";
include_once "../../include/functions.hnt";
require_once 'CalendarManager.class.hnt';
require_once '../../../lib/storage/helpers.php';
require_once 'sales_representative_helpers.hnt';

// Initialize
$calendar = new CalendarManager();

// Initialize user data from session
$user_data = ['name' => (string)($_SESSION['namev'] ?? ''), 'userid' => intval($_SESSION['useridv'] ?? 0)];

// Get action and trim whitespace
$action = isset($_REQUEST['action']) ? trim($_REQUEST['action']) : '';



// Response array
$response = ['success' => false, 'message' => '', 'data' => null];

/**
 * Calculate the actual cumulative increase stored with an installment.
 */
function calculateStoredRentIncreasePercent($baseRentAmount, $originalPeriodicRent) {
    $baseRentAmount = floatval($baseRentAmount);
    $originalPeriodicRent = floatval($originalPeriodicRent);
    if ($originalPeriodicRent <= 0) {
        return 0;
    }
    return round((($baseRentAmount / $originalPeriodicRent) - 1) * 100, 2);
}

function getStoredBaseRent($installment) {
    if (floatval($installment['base_rent_amount'] ?? 0) > 0) {
        return floatval($installment['base_rent_amount']);
    }
    return floatval($installment['kastvalue'] ?? 0)
        - floatval($installment['water'] ?? 0)
        - floatval($installment['sa3ee'] ?? 0)
        - floatval($installment['services'] ?? 0);
}

// Check if action is provided
if (empty($action)) {
    $response['message'] = 'لم يتم تحديد العملية المطلوبة (action parameter is missing)';
    $response['data'] = [
        'error' => 'No action specified',
        'available_actions' => ['get_installment', 'record_payment', 'update_installment', 'cancel_installment', 'get_payment_history', 'calculate_late_fees', 'add_installment', 'mark_all_paid', 'bulk_payment']
    ];
    echo json_encode($response, JSON_UNESCAPED_UNICODE);
    exit;
}

try {
    switch ($action) {
        case 'debug_info':
            // Special debug endpoint
            $response['success'] = true;
            $response['message'] = 'Debug information';
            $response['data'] = [
                'api_version' => API_VERSION,
                'file_path' => __FILE__,
                'file_mtime' => date('Y-m-d H:i:s', filemtime(__FILE__)),
                'current_time' => date('Y-m-d H:i:s'),
                'received_action' => $action,
                'all_params' => array_keys($_REQUEST),
                'php_version' => PHP_VERSION,
                'opcache_enabled' => function_exists('opcache_get_status') ? opcache_get_status() : 'Not available'
            ];
            break;

        case 'get_installment':
            $response = getInstallment($_REQUEST, $link, $calendar);
            break;

        case 'record_payment':
            $response = recordPayment($_REQUEST, $link, $user_data);
            break;

        case 'update_installment':
            $response = updateInstallment($_REQUEST, $link, $calendar, $user_data);
            break;

        case 'cancel_installment':
            $response = cancelInstallment($_REQUEST, $link, $user_data);
            break;

        case 'get_payment_history':
            $response = getPaymentHistory($_REQUEST, $link);
            break;

        case 'calculate_late_fees':
            $response = calculateLateFees($_REQUEST, $link, $user_data);
            break;

        case 'add_installment':
            $response = addInstallment($_REQUEST, $link, $user_data, $calendar);
            break;

        case 'mark_all_paid':
            $response = markAllAsPaid($_REQUEST, $link, $user_data);
            break;

        case 'bulk_payment':
            $response = bulkPayment($_REQUEST, $link, $user_data);
            break;

        default:
            $validActions = ['get_installment', 'record_payment', 'update_installment', 'cancel_installment', 'get_payment_history', 'calculate_late_fees', 'add_installment', 'mark_all_paid', 'bulk_payment'];
            $response['message'] = 'عملية غير صالحة: "' . htmlspecialchars($action) . '"';
            $response['data'] = [
                'received_action' => $action,
                'action_length' => strlen($action),
                'action_bytes' => bin2hex($action),
                'valid_actions' => $validActions,
                'hint' => 'العمليات المتاحة: ' . implode(', ', $validActions),
                'all_request_keys' => array_keys($_REQUEST)
            ];
    }
} catch (Exception $e) {
    $response['success'] = false;
    $response['message'] = 'خطأ: ' . $e->getMessage();
    $response['data'] = [
        'error_type' => 'exception',
        'action_attempted' => $action,
        'file' => basename($e->getFile()),
        'line' => $e->getLine()
    ];
}

// Add API version to all responses for debugging
$response['_api_version'] = API_VERSION;
$response['_timestamp'] = time();



// Output JSON response
echo json_encode($response, JSON_UNESCAPED_UNICODE);
exit;

/**
 * Get single installment data
 */
function getInstallment($data, $link, $calendar) {
    $response = ['success' => false, 'message' => '', 'data' => null];

    $kastid = isset($data['kastid']) ? intval($data['kastid']) : 0;

    $sql = "SELECT a.*, e.calendar_type, e.vat_type
            FROM aksat a
            LEFT JOIN egar e ON a.egar_id = e.rakam3akdid
            WHERE a.kastid = '$kastid'";
    $result = mysql_query($sql, $link);

    if ($row = mysql_fetch_assoc($result)) {
        $calendarType = isset($row['calendar_type']) ? intval($row['calendar_type']) : 0;
        $vat_type = isset($row['vat_type']) ? intval($row['vat_type']) : 0;

        // Format date for display (Arabic text format)
        $row['kastdate_formatted'] = $calendar->formatDateForDisplay($row['kastdate'], $calendarType);

        // Format date for datepicker input (dd/mm/yyyy format)
        $row['kastdate_input'] = date('d/m/Y', $row['kastdate']);

        // Calculate VAT based on contract type
        $commesion_vat = 0;
        $depositeamount_vat = 0;
        
        if ($vat_type > 0) {
            $rentValue = getStoredBaseRent($row);
            $commesion_vat = $row['sa3ee'] * 0.15;
            
            if ($vat_type == 2) {
                $depositeamount_vat = $rentValue * 0.15;
            }
        }

        // Calculate total and remaining amounts including VAT
        $totalAmount = $row['kastvalue'] + $commesion_vat + $depositeamount_vat;

        $row['total_amount'] = $totalAmount;
        $row['amount_remaining'] = $totalAmount - ($row['amount_paid'] ?? 0);
        $row['commesion_vat'] = $commesion_vat;
        $row['depositeamount_vat'] = $depositeamount_vat;

        $response['success'] = true;
        $response['data'] = $row;
    } else {
        $response['message'] = 'القسط غير موجود';
    }

    return $response;
}

/**
 * Record payment for installment
 */
function recordPayment($data, $link, $user_data, $ownTransaction = true) {
    $response = ['success' => false, 'message' => '', 'data' => null];

    // The bulk payment runs many of these inside its own transaction.
    if ($ownTransaction) mysql_query("START TRANSACTION", $link);

    try {
        $kastid = isset($data['kastid']) ? intval($data['kastid']) : 0;
        $amount = isset($data['amount']) ? floatval($data['amount']) : 0;
        $paymentDate = isset($data['payment_date']) ? $data['payment_date'] : date('d/m/Y');
        $paymentMethod = isset($data['payment_method']) ? mysql_real_escape_string($data['payment_method']) : 'cash';
        $referenceNumber = isset($data['reference_number']) ? mysql_real_escape_string($data['reference_number']) : '';
        $notes = isset($data['notes']) ? mysql_real_escape_string($data['notes']) : '';
        // Money without a receipt never reaches accounting.
        $createReceipt = true;
        $bankid  = isset($data['bankid']) ? floatval($data['bankid']) : 0;
        // Get installment
        // Get installment with contract VAT info in single query
        $sql = "SELECT a.*, e.vat_type, e.sales_representative_userid
                FROM aksat a
                LEFT JOIN egar e ON e.rakam3akdid = a.egar_id
                WHERE a.kastid = '$kastid'";
        $result = mysql_query($sql, $link);
        $installment = mysql_fetch_assoc($result);

        if (!$installment) {
            throw new Exception('القسط غير موجود');
        }

        // Calculate VAT based on contract type
        $commesion_vat = 0;
        $depositeamount_vat = 0;
        $vat_type = $installment['vat_type'] ?? 0;
        
        if ($vat_type > 0) {
            $rentValue = getStoredBaseRent($installment);
            $commesion_vat = number_format(($installment['sa3ee'] * 0.15), 2, '.', '');
            
            if ($vat_type == 2) {
                $depositeamount_vat = number_format(($rentValue * 0.15), 2, '.', '');
            }
        }

        // Calculate total amount
        $totalAmount = $installment['kastvalue'] + $commesion_vat + $depositeamount_vat ;

        // Calculate new amount paid
        // Older screens update only one of the two paid fields; the larger one is the truth.
        $currentPaid = max(floatval($installment['amount_paid'] ?? 0), floatval($installment['dof3at'] ?? 0));
        $newAmountPaid = round($currentPaid + $amount, 2);
        $newAmountRemaining = round($totalAmount - $newAmountPaid, 2);

        // Validate amount
        if ($amount <= 0) {
            throw new Exception('المبلغ يجب أن يكون أكبر من صفر');
        }

        if ($newAmountPaid > $totalAmount + 0.01) {
            throw new Exception('المبلغ المدفوع أكبر من المطلوب');
        }

        // Determine new status
        $newStatus = 'paid';
        if ($newAmountRemaining > 0.01) {
            $newStatus = 'partial';
        }

        // Parse payment date
        list($day, $month, $year) = explode('/', $paymentDate);
        if ($year < 1900) {
            // Hijri date
            $calendar = new CalendarManager();
            $paymentTimestamp = $calendar->dateToTimestamp($paymentDate, 0);
        } else {
            $paymentTimestamp = mktime(0, 0, 0, $month, $day, $year);
        }

        // Get old payment tracking fields for compatibility with sanad.hnt system
        $oldDof3at = $currentPaid;
        $oldDof3atTafsel = isset($installment['dof3at_tafsel']) ? $installment['dof3at_tafsel'] : '';

        // Calculate new dof3at (old system field)
        $newDof3at = $oldDof3at + $amount;

        // Build dof3at_tafsel (payment breakdown like in sanad.hnt)
        $newDof3atTafsel = trim($oldDof3atTafsel);
        if ($newDof3atTafsel) {
            $newDof3atTafsel .= ' + ' . $amount;
        } else {
            $newDof3atTafsel = (string)$amount;
        }

        // Update installment (update BOTH old and new payment tracking fields)
        $sql = "UPDATE aksat SET
                status = '$newStatus',
                amount_paid = '$newAmountPaid',
                amount_remaining = '$newAmountRemaining',
                paid_date = '$paymentTimestamp',
                dof3at = '$newDof3at',
                dof3at_tafsel = '$newDof3atTafsel',
                iscomplete = " . ($newStatus == 'paid' ? 1 : 0) . ",
                updated_at = " . time() . "
                WHERE kastid = '$kastid'";

        if (!mysql_query($sql, $link)) {
            throw new Exception('فشل تحديث القسط: ' . mysql_error($link));
        }

        // Record payment history
        $sql = "INSERT INTO aksat_payment_history SET
                kastid = '$kastid',
                payment_date = '$paymentTimestamp',
                amount_paid = '$amount',
                payment_method = '$paymentMethod',
                reference_number = '$referenceNumber',
                notes = '$notes',
                created_by_userid = " . ($user_data['userid'] ?? 1) . ",
                created_at = " . time();

        if (!mysql_query($sql, $link)) {
            throw new Exception('فشل تسجيل تاريخ الدفعة');
        }
        $paymentHistoryId = mysql_insert_id();

        // Create receipt if requested (following sanad_process.hnt approach)
        $sanadId = null;
        if ($createReceipt) {
            // Get contract, tenant and property info
            $sql = "SELECT e.*, m.mostagername, m.mostagerid, m.mostagervatnumber,
                           ad.idaqar, ad.idsubaqar, a.aqarname
                    FROM egar e
                    LEFT JOIN mostagereen m ON e.mostagerid = m.mostagerid
                    LEFT JOIN amlakdetails ad ON e.rakam3akdid = ad.rakam3akdid
                    LEFT JOIN amlak a ON ad.idaqar = a.idaqar
                    WHERE e.rakam3akdid = " . $installment['egar_id'];
            $contractResult = mysql_query($sql, $link);
            $contract = mysql_fetch_assoc($contractResult);

            if (!$contract || intval($contract['idaqar'] ?? 0) <= 0) {
                throw new Exception('القسط غير مرتبط بعقد ووحدة حالياً؛ سجل الدفعة من سند القبض.');
            }
            if ($contract) {
                // Check if this is the first payment or a subsequent payment
                // Only record fees (water, sa3ee, services) on FIRST payment
                $mysa3ee = $installment['sa3ee'];
                $mywater = $installment['water'];
                $myservices = $installment['services'];

                // If there was previous payment (oldDof3at > 0), don't include fees again
                if ($oldDof3at > 0) {
                    $mysa3ee = 0;
                    $mywater = 0;
                    $myservices = 0;
                }

                // Calculate VAT
                $commesion_vat = 0;
                $rentValue = getStoredBaseRent($installment);
                $depositeamount_vat = 0;

                if (isset($contract["vat_type"])) {
                    if ($contract["vat_type"] == 1) {
                        $commesion_vat = number_format(($mysa3ee * 0.15), 2, '.', '');
                    }
                    if ($contract["vat_type"] == 2) {
                        $commesion_vat = number_format(($mysa3ee * 0.15), 2, '.', '');
                        $depositeamount_vat = number_format(($rentValue * 0.15), 2, '.', '');
                    }
                }
                $total_vat = $commesion_vat + $depositeamount_vat;
                $receiptRentVat = $total_vat;
                $mytamen = 0;
                require_once __DIR__ . '/receipt_components_store.hnt';
                $receiptBreakdown = receiptComponentsPrepare($link, $kastid, $amount, $contract, $oldDof3at);
                if ($receiptBreakdown !== null) {
                    $receiptParts = receiptComponentsMoney($receiptBreakdown['components']);
                    $mysa3ee = $receiptParts['commission'];
                    $mywater = $receiptParts['water'];
                    $myservices = $receiptParts['services'];
                    $mytamen = $receiptParts['insurance'];
                    $commesion_vat = $receiptParts['commission_vat'];
                    $receiptRentVat = $receiptParts['rent_vat'];
                    $total_vat = $commesion_vat + $receiptRentVat;
                }

                // Generate unique form ID
                $formuid = !empty($data['receipt_formuid']) ? mysql_real_escape_string($data['receipt_formuid'], $link) : str_replace('.', '', microtime() . rand(11111, 99999));

                // Map payment method to nakda value (following sanad.hnt convention)
                // payment_method is already numeric: 1=cash, 2=check, 3=other, 4=transfer, 5=network
                $nakda = intval($paymentMethod);
                if ($nakda < 1 || $nakda > 5) {
                    $nakda = 1; // Default to cash if invalid
                }

                // Build payment description
                $mybyan = 'دفعة قسط إيجار - قسط رقم ' . $installment['kastname'];
                if (!empty($notes)) {
                    $mybyan .= ' - ' . $notes;
                }

                // Get period (full date format dd/mm/yyyy)
                $period = date('d/m/Y', $paymentTimestamp);
                $receiptSalesRepresentativeId = isset($data['sales_representative_userid'])
                    ? intval($data['sales_representative_userid'])
                    : intval($contract['sales_representative_userid'] ?? 0);
                $salesCommission = amlakCalculateSalesCommissionSnapshot(
                    $amount,
                    $receiptSalesRepresentativeId,
                    $link
                );

                // Insert revenue record (eradat table) - only include fees on first payment
                $sql = "INSERT INTO eradat SET
                        idaqar='" . $contract['idaqar'] . "',
                        idsubaqar='" . $contract['idsubaqar'] . "',
                        mostagername='" . mysql_real_escape_string($contract['mostagername']) . "',
                        mostagerid='" . $contract['mostagerid'] . "',
                        recivername='" . mysql_real_escape_string($user_data['name'] ?? 'Admin') . "',
                        amount='$amount',
                        paymentdate='$paymentTimestamp',
                        pymentdesription='" . mysql_real_escape_string($mybyan) . "',
                        sanadrakam='0',
                        kastid='$kastid',
                        mysa3ee='$mysa3ee',
                        mywater='$mywater',
                        bankid = '$bankid ',
                        services='$myservices',
                        tamen='$mytamen',
                        formuid='$formuid'";

                if (!mysql_query($sql, $link)) {
                    throw new Exception('فشل تسجيل الإيراد');
                }

                // Insert receipt voucher (sanad table - following sanad_process.hnt structure)
                $sql = "INSERT INTO sanad SET
                        period='$period',
                        mostagerid='" . $contract['mostagerid'] . "',
                        mostagername='" . mysql_real_escape_string($contract['mostagername']) . "',
                        depositeamount='$amount',
                        recivername='" . mysql_real_escape_string($user_data['name'] ?? 'Admin') . "',
                        mybyan='" . mysql_real_escape_string($mybyan) . "',
                        sanadrakam='0',
                        idaqar='" . $contract['idaqar'] . "',
                        idsubaqar='" . $contract['idsubaqar'] . "',
                        sanaddate='$paymentTimestamp',
                        cheqnumber='" . mysql_real_escape_string($referenceNumber) . "',
                        cheqon='',
                        cheqdate1='',
                        attachedimages='',
                        kastid='$kastid',
                        commesion_vat='$commesion_vat',
                        depositeamount_vat='$receiptRentVat',
                        payment_type='$nakda',
                        sales_representative_userid='" . $salesCommission['representative_userid'] . "',
                        sales_commission_type='" . $salesCommission['type'] . "',
                        sales_commission_value='" . $salesCommission['value'] . "',
                        sales_commission_amount='" . $salesCommission['amount'] . "',
                        notes='" . addslashes($notes) . "',
                        bankid = '$bankid ',
                        formuid='$formuid'";

                if (!mysql_query($sql, $link)) {
                    throw new Exception('فشل حفظ سند القبض');
                }
                $sanadId = mysql_insert_id();

                // Update sanadrakam with the auto-generated ID
                if ($sanadId > 0) {
                    if ($receiptBreakdown !== null) receiptComponentsStore($link, $sanadId, $receiptBreakdown);
                    mysql_query("UPDATE eradat SET sanadrakam = '$sanadId' WHERE formuid = '$formuid'", $link);
                    mysql_query("UPDATE sanad SET sanadrakam = '$sanadId' WHERE formuid = '$formuid'", $link);

                    // Generate QR code for receipt
                    $qr_path = qr_path('vouchers.receive', "$sanadId.png");
                    ensure_dir(dirname($qr_path));

                    require_once('../../../phpqrcode.php');
                    global $vat_number;
                    $vat_number = isset($vat_number) ? $vat_number : '';
                    $barcodedata = "سند قبض رقم : $sanadId \r\n العميل: " . $contract['mostagername'] . "  \r\n  المبلغ : $amount
                        \r\n الضريبة : $total_vat \r\n الرقم الضريبي : $vat_number
                        \r\n البيان : $mybyan \r\n تاريخ الدفع  :   " . date("d/m/Y", $paymentTimestamp) . " \r\n تاريخ الاصدار : " . date("d/m/Y") . "
                    ";
                    QRcode::png($barcodedata, $qr_path, 'L', 2, 2);

                    // Log sanad creation
                    if (function_exists('loginfo')) {
                        loginfo("critical", "insert", $barcodedata, "", "sanad", $sanadId, $link);
                    }

                    // Update payment history with sanad ID
                    mysql_query("UPDATE aksat_payment_history SET sanad_id = '$sanadId' WHERE payment_history_id = '$paymentHistoryId'", $link);
                }
            }
        }

        // Update contract status if needed
        updateContractStatusFromInstallments($installment['egar_id'], $link);

        // Commit transaction
        if ($ownTransaction) mysql_query("COMMIT", $link);

        $response['success'] = true;
        $response['message'] = 'تم تسجيل الدفعة بنجاح' . ($sanadId ? ' وتم إنشاء سند القبض رقم ' . $sanadId : '');
        $response['data'] = [
            'new_amount_paid' => $newAmountPaid,
            'new_amount_remaining' => $newAmountRemaining,
            'new_status' => $newStatus,
            'payment_history_id' => $paymentHistoryId,
            'sanad_id' => $sanadId
        ];

    } catch (Throwable $e) {
        if (!$ownTransaction) throw $e;
        mysql_query("ROLLBACK", $link);
        $response['message'] = $e->getMessage();
    }

    return $response;
}

/**
 * Update installment details
 */
function updateInstallment($data, $link, $calendar, $user_data) {
    $response = ['success' => false, 'message' => '', 'data' => null];

    mysql_query("START TRANSACTION", $link);

    try {
        $kastid = isset($data['kastid']) ? intval($data['kastid']) : 0;

        // Get old values for history
        $sql = "SELECT * FROM aksat WHERE kastid = '$kastid'";
        $result = mysql_query($sql, $link);
        $oldValues = mysql_fetch_assoc($result);

        if (!$oldValues) {
            throw new Exception('القسط غير موجود');
        }

        // Always load the contract. It supplies both the calendar and the
        // original periodic rent used for the installment snapshot.
        $contractSql = "SELECT calendar_type, depositeamount
                        FROM egar
                        WHERE rakam3akdid = " . intval($oldValues['egar_id']) . "
                        LIMIT 1";
        $contractResult = mysql_query($contractSql, $link);
        $contract = $contractResult ? mysql_fetch_assoc($contractResult) : false;
        if (!$contract) {
            throw new Exception('العقد غير موجود');
        }
        $calendarType = intval($contract['calendar_type'] ?? 0);

        // Parse date if provided
        $kastdate = $oldValues['kastdate'];
        if (isset($data['kastdate']) && !empty($data['kastdate'])) {
            $kastdate = $calendar->dateToTimestamp($data['kastdate'], $calendarType);
        }

        // Get new values
        $kastname = isset($data['kastname']) ? mysql_real_escape_string($data['kastname']) : $oldValues['kastname'];
        $existingBaseRent = floatval($oldValues['base_rent_amount'] ?? 0);
        if ($existingBaseRent <= 0) {
            $existingBaseRent = floatval($oldValues['kastvalue'])
                - floatval($oldValues['water'] ?? 0)
                - floatval($oldValues['sa3ee'] ?? 0)
                - floatval($oldValues['services'] ?? 0);
        }
        $kastvalue = isset($data['kastvalue']) ? floatval($data['kastvalue']) : $existingBaseRent;
        $water = isset($data['water']) ? floatval($data['water']) : $oldValues['water'];
        $sa3ee = isset($data['sa3ee']) ? floatval($data['sa3ee']) : $oldValues['sa3ee'];
        $services = isset($data['services']) ? floatval($data['services']) : $oldValues['services'];
        $status = isset($data['status']) ? mysql_real_escape_string($data['status']) : $oldValues['status'];
        $lateFee = isset($data['late_fee']) ? floatval($data['late_fee']) : $oldValues['late_fee'];

        // Recalculate amounts if values changed
        $storedInstallmentValue = $kastvalue + $water + $sa3ee + $services;
        $rentIncreasePercent = calculateStoredRentIncreasePercent(
            $kastvalue,
            $contract['depositeamount'] ?? 0
        );
        $totalAmount = $storedInstallmentValue + $lateFee;
        $amountRemaining = $totalAmount - ($oldValues['amount_paid'] ?? 0);

        // Update installment
        $sql = "UPDATE aksat SET
                kastname = '$kastname',
                kastvalue = '$storedInstallmentValue',
                base_rent_amount = '$kastvalue',
                rent_increase_percent = '$rentIncreasePercent',
                kastdate = '$kastdate',
                water = '$water',
                sa3ee = '$sa3ee',
                services = '$services',
                status = '$status',
                late_fee = '$lateFee',
                amount_remaining = '$amountRemaining',
                updated_at = " . time() . "
                WHERE kastid = '$kastid'";

        if (!mysql_query($sql, $link)) {
            throw new Exception('فشل تحديث القسط: ' . mysql_error($link));
        }

        // Log to history - using local function defined in this file
        // Note: contract_lifecycle.api.hnt cannot be required as it's a standalone API endpoint
        // that calls exit() at the end, which would terminate this script
        logInstallmentChange($kastid, 'updated', $oldValues, $data, $user_data, $link);

        // Commit transaction
        mysql_query("COMMIT", $link);

        $response['success'] = true;
        $response['message'] = 'تم تحديث القسط بنجاح';

    } catch (Exception $e) {
        mysql_query("ROLLBACK", $link);
        $response['message'] = $e->getMessage();
    }

    return $response;
}

/**
 * Cancel installment (soft delete)
 */
function cancelInstallment($data, $link, $user_data) {
    $response = ['success' => false, 'message' => '', 'data' => null];

    mysql_query("START TRANSACTION", $link);

    try {
        $kastid = isset($data['kastid']) ? intval($data['kastid']) : 0;

        // Check if already paid
        $sql = "SELECT status, amount_paid FROM aksat WHERE kastid = '$kastid'";
        $result = mysql_query($sql, $link);
        $installment = mysql_fetch_assoc($result);

        if (!$installment) {
            throw new Exception('القسط غير موجود');
        }

        if ($installment['amount_paid'] > 0) {
            throw new Exception('لا يمكن إلغاء قسط تم دفعه جزئياً أو كلياً');
        }

        // Update status to cancelled
        $sql = "UPDATE aksat SET
                status = 'cancelled',
                updated_at = " . time() . "
                WHERE kastid = '$kastid'";

        if (!mysql_query($sql, $link)) {
            throw new Exception('فشل إلغاء القسط: ' . mysql_error($link));
        }

        // Commit transaction
        mysql_query("COMMIT", $link);

        $response['success'] = true;
        $response['message'] = 'تم إلغاء القسط بنجاح';

    } catch (Exception $e) {
        mysql_query("ROLLBACK", $link);
        $response['message'] = $e->getMessage();
    }

    return $response;
}

/**
 * Get payment history for installment
 */
function getPaymentHistory($data, $link) {
    $response = ['success' => false, 'message' => '', 'data' => []];

    $kastid = isset($data['kastid']) ? intval($data['kastid']) : 0;

    $sql = "SELECT aph.*, u.username
            FROM aksat_payment_history aph
            LEFT JOIN users u ON aph.created_by_userid = u.userid
            WHERE aph.kastid = '$kastid'
            ORDER BY aph.payment_date DESC";

    $result = mysql_query($sql, $link);
    $payments = [];

    while ($row = mysql_fetch_assoc($result)) {
        $row['payment_date'] = date('Y-m-d', $row['payment_date']);

        // Translate payment method
        $paymentMethods = [
            'cash' => 'نقدي',
            'bank_transfer' => 'تحويل بنكي',
            'check' => 'شيك',
            'online' => 'دفع إلكتروني'
        ];
        $row['payment_method_ar'] = $paymentMethods[$row['payment_method']] ?? $row['payment_method'];

        $payments[] = $row;
    }

    $response['success'] = true;
    $response['data'] = $payments;

    return $response;
}

/**
 * Calculate late fees for overdue installments
 */
function calculateLateFees($data, $link, $user_data) {
    $response = ['success' => false, 'message' => '', 'data' => null];

    mysql_query("START TRANSACTION", $link);

    try {
        $egarId = isset($data['egar_id']) ? intval($data['egar_id']) : 0;
        $lateFeePercentage = isset($data['late_fee_percentage']) ? floatval($data['late_fee_percentage']) : 0.01; // 1% default
        $lateFeePerDay = isset($data['late_fee_per_day']) ? floatval($data['late_fee_per_day']) : 0;
        $maxLateFee = isset($data['max_late_fee']) ? floatval($data['max_late_fee']) : 0;

        $now = time();
        $totalFees = 0;
        $updatedCount = 0;

        // Get overdue installments
        $sql = "SELECT * FROM aksat
                WHERE egar_id = '$egarId'
                AND status = 'overdue'
                AND kastdate < $now
                AND idsubaqar > 0";

        $result = mysql_query($sql, $link);

        while ($installment = mysql_fetch_assoc($result)) {
            // Calculate days overdue
            $daysOverdue = ceil(($now - $installment['kastdate']) / (60 * 60 * 24));

            // Calculate late fee
            $baseAmount = $installment['amount_remaining'] > 0 ? $installment['amount_remaining'] :
                         ($installment['kastvalue'] + ($installment['water'] ?? 0) +
                          ($installment['sa3ee'] ?? 0) + ($installment['services'] ?? 0));

            $lateFee = 0;
            if ($lateFeePerDay > 0) {
                $lateFee = $lateFeePerDay * $daysOverdue;
            } else {
                $lateFee = $baseAmount * $lateFeePercentage * $daysOverdue;
            }

            // Apply max late fee if set
            if ($maxLateFee > 0 && $lateFee > $maxLateFee) {
                $lateFee = $maxLateFee;
            }

            // Update installment with late fee
            $sql2 = "UPDATE aksat SET
                    late_fee = '$lateFee',
                    amount_remaining = amount_remaining + ($lateFee - IFNULL(late_fee, 0)),
                    updated_at = " . time() . "
                    WHERE kastid = " . $installment['kastid'];

            mysql_query($sql2, $link);

            $totalFees += $lateFee;
            $updatedCount++;
        }

        // Commit transaction
        mysql_query("COMMIT", $link);

        $response['success'] = true;
        $response['message'] = "تم حساب غرامات التأخير لـ $updatedCount قسط";
        $response['data'] = [
            'updated_count' => $updatedCount,
            'total_fees' => $totalFees
        ];

    } catch (Exception $e) {
        mysql_query("ROLLBACK", $link);
        $response['message'] = $e->getMessage();
    }

    return $response;
}

/**
 * Update contract status based on installment statuses
 */
function updateContractStatusFromInstallments($egarId, $link) {
    // Check for overdue installments
    $sql = "SELECT COUNT(*) as count FROM aksat
            WHERE egar_id = '$egarId'
            AND status = 'overdue'
            AND idsubaqar > 0";
    $result = mysql_query($sql, $link);
    $row = mysql_fetch_assoc($result);

    if ($row['count'] > 0) {
        // Has overdue installments - set contract to active_arrears
        $sql = "UPDATE egar SET
                status = 'active_arrears',
                updated_at = " . time() . "
                WHERE rakam3akdid = '$egarId'
                AND status = 'active'";
        mysql_query($sql, $link);
    } else {
        // No overdue installments - set back to active if was in arrears
        $sql = "UPDATE egar SET
                status = 'active',
                updated_at = " . time() . "
                WHERE rakam3akdid = '$egarId'
                AND status = 'active_arrears'";
        mysql_query($sql, $link);
    }
}

/**
 * Log installment change to history
 */
function logInstallmentChange($kastid, $action, $oldValues, $newValues, $user_data, $link) {
    $changedFields = [];
    foreach ($newValues as $key => $value) {
        if (isset($oldValues[$key]) && $oldValues[$key] != $value) {
            $changedFields[] = $key;
        }
    }

    $sql = "INSERT INTO egar_history SET
            rakam3akdid = " . $oldValues['egar_id'] . ",
            action = 'installment_$action',
            old_values = '" . mysql_real_escape_string(json_encode($oldValues)) . "',
            new_values = '" . mysql_real_escape_string(json_encode($newValues)) . "',
            changed_fields = '" . implode(',', $changedFields) . "',
            changed_by_userid = " . ($user_data['userid'] ?? 1) . ",
            changed_at = " . time() . ",
            ip_address = '" . mysql_real_escape_string($_SERVER['REMOTE_ADDR']) . "',
            notes = 'تعديل القسط رقم " . $oldValues['kastname'] . "'";

    mysql_query($sql, $link);
}

/**
 * Add new installment
 */
function addInstallment($data, $link, $user_data, $calendar) {
    $response = ['success' => false, 'message' => '', 'data' => null];

    mysql_query("START TRANSACTION", $link);

    try {
        $egarId = isset($data['egar_id']) ? intval($data['egar_id']) : 0;
        $idsubaqar = isset($data['idsubaqar']) ? intval($data['idsubaqar']) : 0;
        $kastname = isset($data['kastname']) ? mysql_real_escape_string($data['kastname']) : '';
        $kastvalue = isset($data['kastvalue']) ? floatval($data['kastvalue']) : 0;
        $water = isset($data['water']) ? floatval($data['water']) : 0;
        $sa3ee = isset($data['sa3ee']) ? floatval($data['sa3ee']) : 0;
        $services = isset($data['services']) ? floatval($data['services']) : 0;
        $kastdate = isset($data['kastdate']) ? $data['kastdate'] : date('d/m/Y');

        if (!$egarId) {
            throw new Exception('معرف العقد مطلوب (egar_id)');
        }
        if (!$kastname || trim($kastname) == '') {
            throw new Exception('اسم القسط مطلوب (kastname)');
        }
        if ($kastvalue <= 0) {
            throw new Exception('قيمة القسط يجب أن تكون أكبر من صفر (kastvalue)');
        }

        // Get contract to determine calendar type
        $sql = "SELECT calendar_type, depositeamount FROM egar WHERE rakam3akdid = '$egarId'";
        $result = mysql_query($sql, $link);
        $contract = mysql_fetch_assoc($result);

        if (!$contract) {
            throw new Exception('العقد غير موجود');
        }

        $calendarType = $contract['calendar_type'] ?? 0;

        // Convert date to timestamp
        $kastTimestamp = $calendar->dateToTimestamp($kastdate, $calendarType);

        // Calculate total amount
        $storedInstallmentValue = $kastvalue + $water + $sa3ee + $services;
        $rentIncreasePercent = calculateStoredRentIncreasePercent(
            $kastvalue,
            $contract['depositeamount'] ?? 0
        );
        $totalAmount = $storedInstallmentValue;

        // Insert new installment
        $sql = "INSERT INTO aksat SET
                egar_id = '$egarId',
                idsubaqar = '$idsubaqar',
                kastname = '$kastname',
                kastvalue = '$storedInstallmentValue',
                base_rent_amount = '$kastvalue',
                rent_increase_percent = '$rentIncreasePercent',
                water = '$water',
                sa3ee = '$sa3ee',
                services = '$services',
                kastdate = '$kastTimestamp',
                status = 'pending',
                iscomplete = 0,
                amount_paid = 0,
                amount_remaining = '$totalAmount',
                late_fee = 0,
                created_at = " . time() . ",
                updated_at = " . time();

        if (!mysql_query($sql, $link)) {
            throw new Exception('فشل إضافة القسط: ' . mysql_error($link));
        }

        $kastid = mysql_insert_id();

        // Commit transaction
        mysql_query("COMMIT", $link);

        $response['success'] = true;
        $response['message'] = 'تم إضافة القسط بنجاح';
        $response['data'] = ['kastid' => $kastid];

    } catch (Exception $e) {
        mysql_query("ROLLBACK", $link);
        $response['message'] = $e->getMessage();
    }

    return $response;
}

/**
 * Mark all unpaid installments as paid
 */
function markAllAsPaid($data, $link, $user_data) {
    $response = ['success' => false, 'message' => '', 'data' => null];

    require_once __DIR__ . '/receipt_commission_helpers.hnt';
    $fullAccess = receiptCommissionRows($link, 'SELECT g.allprevilage FROM user u JOIN usergroups g ON g.groupid=u.groupid WHERE u.userid=?', [intval($_SESSION['useridv'] ?? 0)]);
    $token = $data['csrf_token'] ?? '';
    if (empty($fullAccess[0]['allprevilage'])) {
        $response['message'] = 'هذه العملية لأصحاب الصلاحيات الكاملة فقط.';
        return $response;
    }
    if (!is_string($token) || empty($_SESSION['bulk_payment_csrf']) || !hash_equals($_SESSION['bulk_payment_csrf'], $token)) {
        $response['message'] = 'انتهت صلاحية الصفحة. أعد تحميلها.';
        return $response;
    }

    mysql_query("START TRANSACTION", $link);

    try {
        $egarId = isset($data['egar_id']) ? intval($data['egar_id']) : 0;

        if (!$egarId) {
            throw new Exception('معرف العقد مطلوب');
        }

        $now = time();

        // Get count of unpaid installments
        $sql = "SELECT COUNT(*) as count FROM aksat
                WHERE egar_id = '$egarId'
                AND iscomplete = 0
                AND status NOT IN ('cancelled', 'paid')";
        $result = mysql_query($sql, $link);
        $row = mysql_fetch_assoc($result);
        $count = $row['count'];

        if ($count == 0) {
            throw new Exception('لا توجد أقساط غير مدفوعة');
        }

        // No money is received here, so the paid amounts are not changed.
        $sql = "UPDATE aksat SET
                status = 'paid',
                iscomplete = 1,
                amount_remaining = 0,
                updated_at = '$now'
                WHERE egar_id = '$egarId'
                AND iscomplete = 0
                AND status NOT IN ('cancelled', 'paid')";

        if (!mysql_query($sql, $link)) {
            throw new Exception('فشل تحديث الأقساط: ' . mysql_error($link));
        }

        // Update contract status
        updateContractStatusFromInstallments($egarId, $link);

        // Commit transaction
        mysql_query("COMMIT", $link);

        $response['success'] = true;
        if (function_exists('loginfo')) loginfo('critical', 'update', "تحديد $count قسط كمدفوع بلا سندات، عقد $egarId", '', 'aksat', $egarId, $link);
        $response['message'] = "تم تحديد $count قسط كمدفوع بلا سندات قبض";
        $response['data'] = ['updated_count' => $count];

    } catch (Exception $e) {
        mysql_query("ROLLBACK", $link);
        $response['message'] = $e->getMessage();
    }

    return $response;
}

/**
 * Record bulk payment across multiple installments.
 * One receipt per installment, oldest first, through recordPayment(); all or nothing.
 */
function bulkPayment($data, $link, $user_data) {
    require_once __DIR__ . '/receipt_components_store.hnt';
    $response = ['success' => false, 'message' => '', 'data' => null];

    if (!receiptCommissionCan($link, '41', 'adds')) {
        $response['message'] = 'ليس لديك صلاحية إضافة سند قبض.';
        return $response;
    }
    $token = $data['csrf_token'] ?? '';
    if (!is_string($token) || empty($_SESSION['bulk_payment_csrf']) || !hash_equals($_SESSION['bulk_payment_csrf'], $token)) {
        $response['message'] = 'انتهت صلاحية الصفحة. أعد تحميلها.';
        return $response;
    }

    mysql_query("START TRANSACTION", $link);

    try {
        $egarId = isset($data['egar_id']) ? intval($data['egar_id']) : 0;
        $uid = (string)($data['formuid'] ?? '');
        $method = intval($data['payment_method'] ?? 0);
        $bankId = $method === 1 ? 0 : intval($data['bankid'] ?? 0);
        $dateParts = explode('/', trim((string)($data['payment_date'] ?? '')));
        if ($egarId <= 0) throw new Exception('معرف العقد مطلوب');
        if (!preg_match('/^[a-f0-9]{32}$/D', $uid)) throw new Exception('تعذر التحقق من العملية. أعد تحميل الصفحة.');
        if (!in_array($method, [1, 2, 3, 4, 5], true)) throw new Exception('طريقة الدفع غير صحيحة');
        if (count($dateParts) !== 3 || !ctype_digit(implode('', $dateParts)) || (intval($dateParts[2]) >= 1900 && !checkdate(intval($dateParts[1]), intval($dateParts[0]), intval($dateParts[2])))) {
            throw new Exception('تاريخ الدفع غير صحيح');
        }
        $left = receiptCommissionCents(trim((string)($data['amount'] ?? '')));
        if ($left <= 0) throw new Exception('المبلغ يجب أن يكون أكبر من صفر');

        // Serialize payments of the contract; a repeated submit returns the first result.
        $contract = receiptCommissionRows($link, 'SELECT * FROM egar WHERE rakam3akdid=? FOR UPDATE', [$egarId])[0] ?? null;
        if (!$contract) throw new Exception('العقد غير موجود');
        $done = receiptCommissionRows($link, 'SELECT idsanad FROM sanad WHERE formuid LIKE ? ORDER BY idsanad', ['bulk' . $uid . '%']);
        if ($done) {
            mysql_query("COMMIT", $link);
            return ['success' => true, 'message' => 'تم تنفيذ هذه الدفعة مسبقاً ولم تتكرر.', 'data' => ['receipts' => array_column($done, 'idsanad'), 'paid_count' => 0, 'partial_count' => 0]];
        }
        $unit = receiptCommissionRows($link, 'SELECT idaqar FROM amlakdetails WHERE rakam3akdid=? LIMIT 1', [$egarId])[0] ?? null;
        if (!$unit) throw new Exception('العقد غير مرتبط بوحدة حالياً؛ سجل الدفعة من سند القبض.');
        $scope = receiptCommissionScope($link, 's');
        if (!receiptCommissionRows($link, "SELECT s.idaqar FROM amlak s WHERE s.idaqar=? AND {$scope}", [intval($unit['idaqar'])])) throw new Exception('العقار خارج صلاحيات المستخدم.');
        if ($bankId > 0 && !receiptCommissionRows($link, 'SELECT id FROM bankacounts WHERE id=? AND ownerid2 IN (0,?)', [$bankId, intval($unit['idaqar'])])) throw new Exception('الحساب البنكي غير صحيح.');

        $installments = receiptCommissionRows($link, "SELECT * FROM aksat WHERE egar_id=? AND idsubaqar>0 AND iscomplete=0
            AND status NOT IN ('cancelled','paid','waived') ORDER BY kastdate,kastid FOR UPDATE", [$egarId]);
        $plan = [];
        $open = 0;
        foreach ($installments as $installment) {
            $rentValue = getStoredBaseRent($installment);
            $vatType = intval($contract['vat_type']);
            // Same total recordPayment() checks.
            $total = receiptComponentsCents($installment['kastvalue'])
                + ($vatType > 0 ? receiptComponentsCents(round($installment['sa3ee'] * 0.15, 2)) : 0)
                + ($vatType === 2 ? receiptComponentsCents(round($rentValue * 0.15, 2)) : 0);
            $needed = $total - receiptComponentsCents(max(floatval($installment['amount_paid']), floatval($installment['dof3at'])));
            if ($needed <= 1) continue;
            $open += $needed;
            $pay = min($left, $needed);
            if ($pay > 0) $plan[] = ['kastid' => intval($installment['kastid']), 'pay' => $pay, 'full' => $pay === $needed];
            $left -= $pay;
        }
        if (!$plan) throw new Exception('لا توجد أقساط غير مدفوعة');
        if ($left > 0) throw new Exception('المبلغ أكبر من إجمالي المتبقي على العقد: ' . number_format($open / 100, 2));
        if (count($plan) > 60) throw new Exception('عدد الأقساط كبير؛ قسّم الدفعة.');

        $receipts = [];
        $paidCount = $partialCount = 0;
        foreach ($plan as $index => $item) {
            $result = recordPayment([
                'kastid' => $item['kastid'], 'amount' => number_format($item['pay'] / 100, 2, '.', ''),
                'payment_date' => implode('/', $dateParts), 'payment_method' => (string)$method, 'bankid' => $bankId,
                'reference_number' => (string)($data['reference_number'] ?? ''),
                'notes' => trim('دفعة جماعية ' . (string)($data['notes'] ?? '')),
                'create_receipt' => 1, 'receipt_formuid' => 'bulk' . $uid . $index,
                'sales_representative_userid' => intval($contract['sales_representative_userid'] ?? 0),
            ], $link, $user_data, false);
            if (empty($result['data']['sanad_id'])) throw new Exception('تعذر إنشاء سند أحد الأقساط.');
            $receipts[] = intval($result['data']['sanad_id']);
            if ($item['full']) $paidCount++; else $partialCount++;
        }
        mysql_query("COMMIT", $link);
        $response['success'] = true;
        $response['message'] = 'تم تسجيل الدفعة وإنشاء ' . count($receipts) . ' سند قبض: ' . implode('، ', $receipts);
        $response['data'] = ['paid_count' => $paidCount, 'partial_count' => $partialCount, 'receipts' => $receipts];
    } catch (Throwable $e) {
        mysql_query("ROLLBACK", $link);
        error_log('Bulk payment: ' . $e->getMessage());
        $response['message'] = $e instanceof Exception && !($e instanceof mysqli_sql_exception) ? $e->getMessage() : 'تعذر تسجيل الدفعة الجماعية. لم يحفظ شيء.';
    }

    return $response;
}
?>
