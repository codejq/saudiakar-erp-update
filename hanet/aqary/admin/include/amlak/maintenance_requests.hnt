<aside>
<section class="mr-card" id="attachments"><h2><i class="bi bi-paperclip"></i> المرفقات</h2><?php foreach($request['attachments'] as $attachment): ?><div style="padding:8px 0;border-bottom:1px solid #e6ebef"><a target="_blank" href="maintenance_request_attachment.hnt?id=<?= intval($attachment['attachment_id']) ?>"><i class="bi bi-file-earmark"></i> <?= mrEsc($attachment['original_name']) ?></a><small style="display:block;color:#667085"><?= number_format(intval($attachment['file_size'])/1024,1) ?> KB</small></div><?php endforeach; ?><?php if(!$request['attachments']): ?><div class="mr-empty">لا توجد مرفقات.</div><?php endif; ?><?php if($maintenanceCanEdit): ?><form class="mr-ajax-form" enctype="multipart/form-data" style="margin-top:12px"><input type="hidden" name="action" value="upload_attachment"><input type="hidden" name="request_id" value="<?= $requestId ?>"><input type="hidden" name="csrf_token" value="<?= mrEsc($maintenanceCsrf) ?>"><div class="mr-field"><label>إضافة مرفق</label><input type="file" name="attachment" required accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx"></div><button class="mr-btn mr-primary" type="submit" style="margin-top:8px">رفع</button></form><?php endif; ?></section>
<section class="mr-card" id="timeline"><h2><i class="bi bi-clock-history"></i> سجل المتابعة الكامل</h2><?php if($maintenanceCanEdit): ?><form class="mr-ajax-form" style="margin-bottom:18px"><input type="hidden" name="action" value="add_note"><input type="hidden" name="request_id" value="<?= $requestId ?>"><input type="hidden" name="csrf_token" value="<?= mrEsc($maintenanceCsrf) ?>"><div class="mr-field"><label>نوع المتابعة</label><select name="note_type"><option value="note">ملاحظة داخلية</option><option value="tenant_contact">تواصل مع المستأجر</option><option value="vendor_contact">تواصل مع المورد</option><option value="visit">زيارة ميدانية</option></select></div><div class="mr-field" style="margin-top:8px"><label>التفاصيل *</label><textarea name="note" rows="3" required></textarea></div><button class="mr-btn mr-primary" type="submit" style="margin-top:8px">إضافة متابعة</button></form><?php endif; ?><div class="mr-timeline"><?php foreach($request['events'] as $event): ?><div class="mr-event"><strong><?= mrEsc(array('created'=>'إنشاء الطلب','updated'=>'تحديث البيانات','status_changed'=>'تغيير الحالة','item_added'=>'إضافة بند','item_status_changed'=>'تحديث بند','attachment_added'=>'إضافة مرفق','note'=>'ملاحظة داخلية','tenant_contact'=>'تواصل مع المستأجر','vendor_contact'=>'تواصل مع المورد','visit'=>'زيارة ميدانية')[$event['event_type']] ?? $event['event_type']) ?></strong><?php if($event['from_status'] || $event['to_status']): ?><div><?= mrEsc($event['from_status'] ? mrStatusLabel($event['from_status']) : '') ?><?= $event['to_status'] && $event['to_status']!==$event['from_status'] ? ' ← '.mrEsc(mrStatusLabel($event['to_status'])) : '' ?></div><?php endif; ?><div><?= nl2br(mrEsc($event['note'])) ?></div><small><?= date('Y-m-d H:i',intval($event['event_at'])) ?> — <?= mrEsc($event['user_name'] ?: $event['username'] ?: 'النظام') ?></small><?php if(trim((string)$event['event_data']) !== '' && $event['event_data'] !== '[]'): ?><details><summary>تفاصيل فنية</summary><pre style="white-space:pre-wrap"><?= mrEsc(json_encode(json_decode($event['event_data'],true),JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT)) ?></pre></details><?php endif; ?></div><?php endforeach; ?></div></section>
</aside></div>

<?php else:
$stats = $maintenanceService->getStats();
$filters = array('search'=>trim((string)($_GET['search'] ?? '')),'status'=>trim((string)($_GET['status'] ?? '')),'priority'=>trim((string)($_GET['priority'] ?? '')),'assigned_userid'=>intval($_GET['assigned_userid'] ?? 0),'idaqar'=>intval($_GET['idaqar'] ?? 0),'mostagerid'=>intval($_GET['mostagerid'] ?? 0));
$list = $maintenanceService->listRequests($filters,intval($_GET['page'] ?? 1),25);
?>
<div class="mr-stats"><div class="mr-stat"><strong><?= intval($stats['total'] ?? 0) ?></strong><span>كل الطلبات</span></div><div class="mr-stat"><strong><?= intval($stats['open_count'] ?? 0) ?></strong><span>جديدة ومجدولة</span></div><div class="mr-stat"><strong><?= intval($stats['in_progress_count'] ?? 0) ?></strong><span>قيد التنفيذ</span></div><div class="mr-stat"><strong><?= intval($stats['waiting_parts_count'] ?? 0) ?></strong><span>بانتظار قطع</span></div><div class="mr-stat"><strong><?= intval($stats['completed_count'] ?? 0) ?></strong><span>مكتملة</span></div><div class="mr-stat"><strong><?= intval($stats['urgent_count'] ?? 0) ?></strong><span>عاجلة مفتوحة</span></div></div>
<section class="mr-card"><h2><i class="bi bi-funnel"></i> البحث والتصفية</h2><form method="get" class="mr-form-grid"><div class="mr-field mr-span-2"><label>بحث شامل</label><input name="search" value="<?= mrEsc($filters['search']) ?>" placeholder="رقم الطلب، المشكلة، المستأجر، العقار، الوحدة، المورد أو المستخدم"></div><div class="mr-field"><label>الحالة</label><select name="status"><option value="">كل الحالات</option><?php foreach($allStatuses as $status): ?><option value="<?= $status ?>" <?= $filters['status']===$status?'selected':'' ?>><?= mrEsc(mrStatusLabel($status)) ?></option><?php endforeach; ?></select></div><div class="mr-field"><label>الأولوية</label><select name="priority"><option value="">كل الأولويات</option><?php foreach(array('low','normal','high','urgent') as $priority): ?><option value="<?= $priority ?>" <?= $filters['priority']===$priority?'selected':'' ?>><?= mrEsc(mrPriorityLabel($priority)) ?></option><?php endforeach; ?></select></div><div class="mr-field"><label>المستخدم المكلف</label><select name="assigned_userid"><option value="0">الكل</option><?php mrSelectOptions($lookups['users'],'userid',array('name','username'),$filters['assigned_userid']); ?></select></div><div class="mr-field"><label>العقار</label><select name="idaqar"><option value="0">الكل</option><?php mrSelectOptions($lookups['properties'],'idaqar',array('aqarname','aqaraddress'),$filters['idaqar']); ?></select></div><div class="mr-field"><label>المستأجر</label><select name="mostagerid"><option value="0">الكل</option><?php mrSelectOptions($lookups['tenants'],'mostagerid',array('mostagername','mostagertel'),$filters['mostagerid']); ?></select></div><div class="mr-field"><label>&nbsp;</label><div class="mr-actions"><button class="mr-btn mr-primary" type="submit">بحث</button><a class="mr-btn mr-secondary" href="maintenance_requests.hnt">مسح</a></div></div></form></section>
<section class="mr-card"><div class="mr-section-title"><h2>الطلبات (<?= intval($list['total']) ?>)</h2></div><div class="mr-table-wrap"><table class="mr-table"><thead><tr><th>رقم الطلب</th><th>العنوان</th><th>العقار / الوحدة</th><th>المستأجر</th><th>المكلف</th><th>الأولوية</th><th>الحالة</th><th>الموعد</th><th></th></tr></thead><tbody><?php foreach($list['rows'] as $row): ?><tr><td><?= mrEsc($row['request_number']) ?></td><td><strong><?= mrEsc($row['title']) ?></strong><br><small><?= mrEsc(mrCategoryLabel($row['category'])) ?></small></td><td><?= mrEsc(($row['aqarname'] ?: '-') . ($row['unit_number'] ? ' - '.$row['aqarsubtypename'].' '.$row['unit_number'] : '')) ?></td><td><?= mrEsc($row['tenant_name_snapshot'] ?: '-') ?></td><td><?= mrEsc($row['assigned_name'] ?: $row['assigned_username'] ?: 'غير مسند') ?></td><td class="mr-priority-<?= mrEsc($row['priority']) ?>"><?= mrEsc(mrPriorityLabel($row['priority'])) ?></td><td><span class="mr-badge <?= mrEsc(mrStatusClass($row['status'])) ?>"><?= mrEsc(mrStatusLabel($row['status'])) ?></span></td><td><?= mrEsc($row['scheduled_at'] ?: $row['due_at'] ?: '-') ?></td><td><a class="mr-btn mr-secondary" href="maintenance_requests.hnt?id=<?= intval($row['request_id']) ?>">فتح</a></td></tr><?php endforeach; ?><?php if(!$list['rows']): ?><tr><td colspan="9" class="mr-empty">لا توجد طلبات مطابقة.</td></tr><?php endif; ?></tbody></table></div><?php if($list['pages']>1): ?><div class="mr-pagination"><?php for($page=max(1,$list['page']-3);$page<=min($list['pages'],$list['page']+3);$page++): ?><a class="mr-btn <?= $page===$list['page']?'mr-primary':'mr-secondary' ?>" href="<?= mrEsc(mrPageUrl(array('page'=>$page))) ?>"><?= $page ?></a><?php endfor; ?></div><?php endif; ?></section>

<?php if($maintenanceCanAdd): ?><div class="mr-modal" id="mrCreateModal"><div class="mr-modal-box"><div class="mr-modal-head"><h2>إنشاء طلب صيانة</h2><button class="mr-close" type="button" onclick="mrCloseModal('mrCreateModal')">×</button></div><form class="mr-ajax-form" enctype="multipart/form-data"><input type="hidden" name="action" value="create_request"><input type="hidden" name="csrf_token" value="<?= mrEsc($maintenanceCsrf) ?>"><input type="hidden" name="formuid" value="<?= mrEsc(bin2hex(random_bytes(16))) ?>"><?php mrRenderRequestFields($lookups,array(),'create',false); ?><div class="mr-actions" style="margin-top:15px"><button class="mr-btn mr-primary" type="submit"><i class="bi bi-check-circle"></i> إنشاء الطلب</button><button class="mr-btn mr-secondary" type="button" onclick="mrCloseModal('mrCreateModal')">إلغاء</button></div></form></div></div><?php endif; ?>
<?php endif; ?>
</main>

<script>
(function(){
    const api='maintenance_requests.api.hnt';
    const csrfToken=<?= json_encode($maintenanceCsrf, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    function flash(message,type){const box=document.getElementById('mrFlash');box.textContent=message;box.className='mr-flash '+type;box.scrollIntoView({behavior:'smooth',block:'center'});}
    function execute(form){
        const button=form.querySelector('button[type="submit"]'); if(button) button.disabled=true;
        fetch(api,{method:'POST',body:new FormData(form),credentials:'same-origin'}).then(function(response){return response.json();}).then(function(result){
            if(!result.success) throw new Error(result.message||'تعذر تنفيذ العملية.');
            flash(result.message||'تم الحفظ.','success');
            if(result.redirect) window.location.href=result.redirect; else window.location.reload();
        }).catch(function(error){flash(error.message||'حدث خطأ غير متوقع.','error');if(button) button.disabled=false;});
    }
    window.mrSubmit=function(form){
        const question=form.dataset.confirm||'';
        if(question){
            if(typeof window.confirm==='function' && window.confirm.length>=3){window.confirm(question,'تأكيد',function(){execute(form);});}
            else if(window.confirm(question)){execute(form);}
        } else execute(form);
        return false;
    };
    document.querySelectorAll('.mr-ajax-form').forEach(function(form){form.addEventListener('submit',function(event){event.preventDefault();window.mrSubmit(form);});});
    window.mrOpenModal=function(id){const modal=document.getElementById(id);if(modal){modal.classList.add('open');document.body.style.overflow='hidden';setTimeout(function(){mrInitSelect2(modal,true);},0);}};
    window.mrCloseModal=function(id){const modal=document.getElementById(id);if(modal){modal.classList.remove('open');document.body.style.overflow='';}};
    window.mrToggle=function(id){const el=document.getElementById(id);if(el) el.style.display=el.style.display==='none'?'block':'none';};
    function triggerSelect(select){if(window.jQuery && jQuery.fn.select2) jQuery(select).trigger('change.select2');}
    function triggerSelectChange(select){
        if(window.jQuery)jQuery(select).trigger('change');
        else select.dispatchEvent(new Event('change',{bubbles:true}));
    }
    function syncTenantFromUnit(unit,unitData){
        const option=unit.selectedOptions[0],tenant=document.getElementById(unit.dataset.tenantId);
        if(!tenant)return;
        const tenantId=unitData&&typeof unitData.tenant_id!=='undefined'?String(unitData.tenant_id):(option?(option.dataset.tenant||'0'):'0');
        if(option&&unitData){option.dataset.tenant=tenantId;option.dataset.property=String(unitData.property_id||'');}
        tenant.value=tenantId;
        tenant.disabled=unit.value!=='0';
        triggerSelectChange(tenant);
    }
    function resetUnitForProperty(propertySelect,clearSelection){
        const unit=document.getElementById(propertySelect.dataset.unitId);if(!unit)return;
        unit.disabled=propertySelect.value==='0';
        if(clearSelection){unit.value='0';triggerSelectChange(unit);}
        triggerSelect(unit);
    }
    document.querySelectorAll('.mr-property-select').forEach(function(select){resetUnitForProperty(select,false);select.addEventListener('change',function(){resetUnitForProperty(select,true);});});
    document.querySelectorAll('.mr-unit-select').forEach(function(select){select.addEventListener('change',function(){
        let unitData=null;
        if(window.jQuery&&jQuery.fn.select2&&jQuery(select).hasClass('select2-hidden-accessible')){
            const selectedData=jQuery(select).select2('data');unitData=selectedData&&selectedData.length?selectedData[0]:null;
        }
        syncTenantFromUnit(select,unitData);
    });syncTenantFromUnit(select);});
    function mrInitSelect2(scope,forceModal){
        if(!(window.jQuery&&jQuery.fn.select2))return;
        jQuery(scope).find('select').each(function(){
            const selectElement=this,$select=jQuery(selectElement),modal=$select.closest('.mr-modal'),insideModal=modal.length>0;
            if($select.hasClass('select2-hidden-accessible')){
                const needsAjaxUnit=$select.hasClass('mr-unit-select');
                if(!needsAjaxUnit&&(!insideModal||!forceModal))return;
                $select.select2('destroy');
            }
            const options={theme:'bootstrap-5',width:'100%',dir:'rtl',dropdownParent:insideModal?modal.find('.mr-modal-box').first():jQuery(document.body),language:{noResults:function(){return 'لا توجد وحدات مطابقة في العقار المحدد';},searching:function(){return 'جاري البحث...';},inputTooShort:function(){return 'اكتب للبحث';}}};
            if($select.hasClass('mr-unit-select')){
                options.ajax={url:api,type:'POST',dataType:'json',delay:250,data:function(params){const property=document.getElementById(selectElement.dataset.propertyId);return {action:'lookup_units',csrf_token:csrfToken,idaqar:property?property.value:0,q:params.term||'',page:params.page||1};},processResults:function(data){return {results:data&&data.success?data.results:[],pagination:data&&data.pagination?data.pagination:{more:false}};},cache:true};
                options.minimumInputLength=0;
            }
            $select.select2(options);
            if($select.hasClass('mr-unit-select')){
                $select.off('select2:select.mrUnit').on('select2:select.mrUnit',function(event){syncTenantFromUnit(selectElement,event.params.data||null);});
            }
            $select.trigger('change.select2');
        });
    }
    window.mrInitSelect2=mrInitSelect2;
    if(window.jQuery){jQuery(function(){setTimeout(function(){mrInitSelect2(document,true);},0);});}
    else{document.addEventListener('DOMContentLoaded',function(){mrInitSelect2(document,true);});}
    document.querySelectorAll('.mr-modal').forEach(function(modal){modal.addEventListener('click',function(event){if(event.target===modal)window.mrCloseModal(modal.id);});});
})();
</script>
<?php require_once dirname(__DIR__, 3) . '/foter.hnt'; ?>
