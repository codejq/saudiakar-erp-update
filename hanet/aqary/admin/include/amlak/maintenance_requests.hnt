<?php
/** Maintenance request dashboard, lifecycle, logistics and audit trail. */
$sc_title = 'طلبات الصيانة';
require_once __DIR__ . '/maintenance_requests_bootstrap.hnt';

$lookups = $maintenanceService->getLookups();
$allStatuses = array('new','assigned','scheduled','in_progress','waiting_parts','on_hold','completed','verified','cancelled');
$statusTransitions = array(
    'new'=>array('assigned','scheduled','cancelled'),
    'assigned'=>array('scheduled','in_progress','on_hold','cancelled'),
    'scheduled'=>array('in_progress','on_hold','cancelled'),
    'in_progress'=>array('waiting_parts','on_hold','completed','cancelled'),
    'waiting_parts'=>array('in_progress','on_hold','cancelled'),
    'on_hold'=>array('assigned','scheduled','in_progress','cancelled'),
    'completed'=>array('verified','in_progress'), 'verified'=>array(), 'cancelled'=>array('new')
);
$requestId = intval($_GET['id'] ?? 0);
$request = $requestId > 0 ? $maintenanceService->getRequestDetails($requestId) : null;
if ($requestId > 0 && !$request) {
    http_response_code(404);
}

function mrSelectOptions($rows, $valueKey, $labelKeys, $selected, $extraAttributes = null)
{
    foreach ($rows as $row) {
        $parts = array();
        foreach ($labelKeys as $key) {
            $value = trim((string)($row[$key] ?? ''));
            if ($value !== '') $parts[] = $value;
        }
        $attributes = $extraAttributes ? call_user_func($extraAttributes, $row) : '';
        $value = intval($row[$valueKey] ?? 0);
        echo '<option value="' . $value . '" ' . ($value === intval($selected) ? 'selected' : '') . ' ' . $attributes . '>' . mrEsc(implode(' - ', $parts)) . '</option>';
    }
}

function mrRenderRequestFields($lookups, $record, $prefix, $isEdit)
{
    $record = is_array($record) ? $record : array();
    $propertyId = intval($record['idaqar'] ?? 0);
    $unitId = intval($record['idsubaqar'] ?? 0);
    $tenantId = intval($record['mostagerid'] ?? 0);
    $assignedId = intval($record['assigned_userid'] ?? 0);
?>
<div class="mr-form-grid">
    <div class="mr-field mr-span-2"><label>عنوان الطلب *</label><input name="title" maxlength="255" value="<?= mrEsc($record['title'] ?? '') ?>" required></div>
    <div class="mr-field"><label>التصنيف</label><select name="category">
        <?php foreach(array('plumbing','electricity','air_conditioning','carpentry','elevator','appliance','structural','cleaning','safety','other') as $category): ?>
        <option value="<?= $category ?>" <?= ($record['category'] ?? 'other')===$category?'selected':'' ?>><?= mrEsc(mrCategoryLabel($category)) ?></option><?php endforeach; ?>
    </select></div>
    <div class="mr-field"><label>الأولوية</label><select name="priority">
        <?php foreach(array('low','normal','high','urgent') as $priority): ?><option value="<?= $priority ?>" <?= ($record['priority'] ?? 'normal')===$priority?'selected':'' ?>><?= mrEsc(mrPriorityLabel($priority)) ?></option><?php endforeach; ?>
    </select></div>
    <div class="mr-field mr-span-4"><label>وصف المشكلة *</label><textarea name="description" rows="3" required><?= mrEsc($record['description'] ?? '') ?></textarea></div>

    <div class="mr-field"><label>العقار</label><select name="idaqar" id="<?= $prefix ?>_property" class="mr-property-select" data-unit-id="<?= $prefix ?>_unit"><option value="0">غير محدد</option><?php mrSelectOptions($lookups['properties'], 'idaqar', array('aqarname','aqaraddress'), $propertyId); ?></select></div>
    <div class="mr-field"><label>الوحدة</label><select name="idsubaqar" id="<?= $prefix ?>_unit" class="mr-unit-select" data-property-id="<?= $prefix ?>_property" data-tenant-id="<?= $prefix ?>_tenant"><option value="0" data-tenant="0">غير محددة</option><?php if($unitId>0): ?><option value="<?= $unitId ?>" data-property="<?= $propertyId ?>" data-tenant="<?= $tenantId ?>" selected><?= mrEsc(trim(($record['aqarsubtypename'] ?? '').' - '.($record['unit_number'] ?? $unitId),' -')) ?></option><?php endif; ?></select></div>
    <div class="mr-field"><label>المستأجر</label><select name="mostagerid" id="<?= $prefix ?>_tenant"><option value="0">غير محدد</option><?php mrSelectOptions($lookups['tenants'], 'mostagerid', array('mostagername','mostagertel'), $tenantId); ?></select></div>
    <div class="mr-field"><label>المستخدم المكلف</label><select name="assigned_userid"><option value="0">غير مسند</option><?php mrSelectOptions($lookups['users'], 'userid', array('name','username'), $assignedId); ?></select></div>

    <div class="mr-field"><label>مصدر البلاغ</label><select name="reported_by_type"><?php foreach(array('tenant'=>'المستأجر','user'=>'موظف','owner'=>'المالك','other'=>'أخرى') as $key=>$label): ?><option value="<?= $key ?>" <?= ($record['reported_by_type'] ?? 'tenant')===$key?'selected':'' ?>><?= $label ?></option><?php endforeach; ?></select></div>
    <div class="mr-field"><label>اسم المبلّغ</label><input name="reported_by_name" maxlength="244" value="<?= mrEsc($record['reported_by_name'] ?? '') ?>"></div>
    <div class="mr-field"><label>وسيلة التواصل</label><input name="reported_by_contact" maxlength="150" value="<?= mrEsc($record['reported_by_contact'] ?? '') ?>"></div>
    <div class="mr-field"><label>الموقع داخل العقار</label><input name="location_details" maxlength="500" value="<?= mrEsc($record['location_details'] ?? '') ?>"></div>

    <div class="mr-field"><label>موعد الزيارة المفضل</label><input type="datetime-local" name="preferred_visit_at" value="<?= mrEsc(mrDateTimeLocal($record['preferred_visit_at'] ?? '')) ?>"></div>
    <div class="mr-field"><label>الموعد المجدول</label><input type="datetime-local" name="scheduled_at" value="<?= mrEsc(mrDateTimeLocal($record['scheduled_at'] ?? '')) ?>"></div>
    <div class="mr-field"><label>الموعد المستهدف للإنجاز</label><input type="datetime-local" name="due_at" value="<?= mrEsc(mrDateTimeLocal($record['due_at'] ?? '')) ?>"></div>
    <div class="mr-field mr-check"><label><input type="checkbox" name="requires_tenant_presence" value="1" <?= !empty($record['requires_tenant_presence'])?'checked':'' ?>> يتطلب حضور المستأجر</label></div>

    <div class="mr-field"><label>المورد / المقاول</label><input name="vendor_name" maxlength="244" value="<?= mrEsc($record['vendor_name'] ?? '') ?>"></div>
    <div class="mr-field"><label>هاتف المورد</label><input name="vendor_phone" maxlength="100" value="<?= mrEsc($record['vendor_phone'] ?? '') ?>"></div>
    <div class="mr-field"><label>التكلفة التقديرية</label><input type="number" min="0" step="0.01" name="estimated_cost" value="<?= mrEsc($record['estimated_cost'] ?? 0) ?>"></div>
    <?php if ($isEdit): ?><div class="mr-field"><label>التكلفة الفعلية</label><input type="number" min="0" step="0.01" name="actual_cost" value="<?= mrEsc($record['actual_cost'] ?? 0) ?>"></div><?php endif; ?>

    <div class="mr-field mr-span-2"><label>تعليمات الدخول والوصول</label><textarea name="access_instructions" rows="2"><?= mrEsc($record['access_instructions'] ?? '') ?></textarea></div>
    <div class="mr-field"><label>مرفق اختياري</label><input type="file" name="attachment" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx"></div>
    <?php if ($isEdit): ?><div class="mr-field"><label>ملاحظة التحديث</label><input name="update_note" maxlength="500" placeholder="سبب أو ملخص التعديل"></div><?php endif; ?>
</div>
<?php
}
?>
