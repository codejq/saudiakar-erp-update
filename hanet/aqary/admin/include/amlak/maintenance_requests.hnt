le{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.mr-cost{font-weight:800;color:#087f5b}.select2-container{width:100%!important}.mr-modal .select2-container--open,.mr-modal .select2-dropdown{z-index:10070!important}
