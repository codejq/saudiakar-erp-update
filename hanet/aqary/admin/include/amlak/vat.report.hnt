<script>
/**
 * VAT Report - Modern JavaScript
 */

document.addEventListener('DOMContentLoaded', function() {
    console.log('VAT Report page initialized');

    // Initialize date inputs
    initializeDateInputs();
});

/**
 * Initialize date input validation
 */
function initializeDateInputs() {
    const dateInputs = document.querySelectorAll('.date-input');

    dateInputs.forEach(input => {
        input.addEventListener('input', function() {
            // Allow only numbers and slashes
            this.value = this.value.replace(/[^\d/]/g, '');

            // Auto-format as DD/MM/YYYY
            let value = this.value.replace(/\//g, '');
            if (value.length >= 2) {
                value = value.substring(0, 2) + '/' + value.substring(2);
            }
            if (value.length >= 5) {
                value = value.substring(0, 5) + '/' + value.substring(5, 9);
            }
            this.value = value;
        });

        // Validate on blur
        input.addEventListener('blur', function() {
            validateDate(this);
        });
    });
}

/**
 * Validate date format DD/MM/YYYY
 */
function validateDate(input) {
    const value = input.value;
    const pattern = /^(\d{2})\/(\d{2})\/(\d{4})$/;
    const match = value.match(pattern);

    if (!match) {
        input.setCustomValidity('الرجاء إدخال التاريخ بالصيغة DD/MM/YYYY');
        return false;
    }

    const day = parseInt(match[1], 10);
    const month = parseInt(match[2], 10);
    const year = parseInt(match[3], 10);

    if (day < 1 || day > 31 || month < 1 || month > 12 || year < 1900) {
        input.setCustomValidity('التاريخ المدخل غير صحيح');
        return false;
    }

    input.setCustomValidity('');
    return true;
}

/**
 * Open print view
 */
function openPrintView() {
    const form = document.getElementById('reportForm');
    const reportInput = document.getElementById('report');

    // Set report flag
    reportInput.value = '1';

    // Submit form
    form.submit();
    reportInput.value = '0';
}

/**
 * Export the whole period to Excel
 */
function exportToExcel() {
    const query = new URLSearchParams({
        start_date: document.getElementById('start_date').value,
        end_date: document.getElementById('end_date').value,
        export: 'xls'
    });
    window.location.href = '?' + query.toString();
}
</script>

