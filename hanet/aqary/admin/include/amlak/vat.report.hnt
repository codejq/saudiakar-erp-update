<?php
/**
 * VAT Tax Declarations Report
 * Generates detailed VAT reports for specific date ranges with export capabilities
 */

$sc_title = "الإقرارات الضريبية";
$sc_id = "136";

include_once "../../../nocash.hnt";

// Export of the whole period, before any HTML output
if (($_GET['export'] ?? '') === 'xls') {
    include_once "../../../reqloginajax.hnt";
    require_once '../uCal.class.hnt';
    require_once __DIR__ . '/receipt_search.hnt';
    $receiptFilters = receiptSearchFilters(['startfrom' => $_GET['start_date'] ?? '', 'enddate' => $_GET['end_date'] ?? ''] + $_GET, new uCal);
    if (!$receiptFilters['from'] || !$receiptFilters['to']) {
        http_response_code(400);
        header('Content-Type: text/plain; charset=UTF-8');
        exit('اختر فترة صحيحة أولاً.');
    }
    [$receiptWhere, $receiptValues] = receiptSearchWhere($receiptFilters);
    $receiptRows = receiptCommissionRows($link, "SELECT s.idsanad, s.mostagername, (s.commesion_vat + s.depositeamount_vat) AS vat, s.depositeamount, s.recivername, s.mybyan, a.aqarname, s.sanaddate, s.period
        FROM sanad s LEFT JOIN amlak a ON a.idaqar = s.idaqar {$receiptWhere} AND (s.commesion_vat > 0 OR s.depositeamount_vat > 0)
        ORDER BY " . RECEIPT_DATE_ORDER_SQL . " DESC, s.idsanad DESC", $receiptValues);
    $cell = function ($value) {
        $value = (string)$value;
        // Stored text must not run as a spreadsheet formula.
        if ($value !== '' && !is_numeric($value) && strpos("=+-@\t\r", $value[0]) !== false) $value = "'" . $value;
        return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    };
    $cents = 0;
    header('Content-Type: application/vnd.ms-excel; charset=UTF-8');
    header('Content-Disposition: attachment; filename="VAT_Report_' . date('Ymd_His') . '.xls"');
    echo '<html lang="ar" dir="rtl"><head><meta charset="UTF-8"></head><body><table border="1"><tr>';
    foreach (['رقم السند', 'اسم المستأجر', 'الضريبة', 'مبلغ السند', 'المستلم', 'البيان', 'العقار', 'التاريخ', 'ملاحظة'] as $heading) echo '<th>' . $heading . '</th>';
    echo '</tr>';
    foreach ($receiptRows as $row) {
        $cents += (int)round($row['vat'] * 100);
        $tooLarge = (float)$row['vat'] > (float)$row['depositeamount'];
        echo '<tr><td>' . implode('</td><td>', array_map($cell, [$row['idsanad'], $row['mostagername'], $row['vat'], $row['depositeamount'], $row['recivername'], 'ضريبة ' . $row['mybyan'],
            $row['aqarname'], (int)$row['sanaddate'] < 86400 ? $row['period'] : date('d/m/Y', (int)$row['sanaddate']), $tooLarge ? 'الضريبة أكبر من مبلغ السند' : ''])) . '</td></tr>';
    }
    echo '<tr><th colspan="2">إجمالي الفترة</th><th>' . number_format($cents / 100, 2, '.', '') . '</th><td colspan="6"></td></tr></table></body></html>';
    exit;
}

$_SERVER['HTTP_REFERER'] = "index.hnt";

if (isset($_REQUEST['report']) && $_REQUEST['report']) {
    include_once "../../../report_header.hnt";
} else {
    include_once "../../../header.hnt";
}

require '../arabicTools.class.hnt';
require '../uCal.class.hnt';
$dcal = new uCal;
require_once __DIR__ . '/receipt_search.hnt';

// The form and the page links both use GET, so paging keeps the period.
$receiptFilters = receiptSearchFilters(['startfrom' => $_GET['start_date'] ?? '', 'enddate' => $_GET['end_date'] ?? ''] + $_GET, $dcal);
$receiptPeriodSet = $receiptFilters['from'] && $receiptFilters['to'];
$intial_start = date('d/m/Y', $receiptFilters['from'] ?: strtotime('-3 months'));
$intial_end = date('d/m/Y', $receiptFilters['to'] ?: time());
?>

