}

[$receiptWhere, $receiptValues] = receiptSearchWhere($receiptFilters);
$receiptWhere .= ($receiptWhere === '' ? ' WHERE ' : ' AND ') . '(s.commesion_vat > 0 OR s.depositeamount_vat > 0)';

// Pagination
$receiptCount = receiptCommissionRows($link, "SELECT COUNT(*) AS receipts, COALESCE(SUM(s.commesion_vat + s.depositeamount_vat), 0) AS total
    FROM sanad s LEFT JOIN amlak a ON a.idaqar = s.idaqar {$receiptWhere}", $receiptValues)[0];
$rownum = (int)$receiptCount['receipts'];
$rowperpage = $receiptFilters['rowperpage'];
$pagenum = (int)ceil($rownum / $rowperpage);
$receiptPage = max(1, min($receiptFilters['page'], $pagenum));
$limit = ($receiptPage - 1) * $rowperpage . ',' . $rowperpage;
// Printing shows the whole period.
if (!empty($_GET['report'])) {
    $pagenum = 1;
    $limit = '0,' . max(1, $rownum);
}
?>

        <!-- Stats and Pagination Bar -->
        <div class="stats-bar screenonly">
            <div class="stats-info">
                <i class="bi bi-file-text"></i>
                عدد السندات: <span class="stats-count"><?= number_format($rownum) ?></span> سند
            </div>

            <div class="pagination">
                <?php
                $xi = 1;
                if ($pagenum == 1) {
                    $xi = 2;
                }

                while ($xi <= $pagenum) {
                    $activeClass = ($receiptPage == $xi) ? 'active' : '';

                    if (($xi > ($receiptPage - 4) && $xi < ($receiptPage + 4)) ||
                        $xi == 1 || $xi == $pagenum ||
                        $xi < 4 || $xi > ($pagenum - 4)) {
                        echo "<button type='button' class='page-btn {$activeClass}' onclick=\"window.location.href='?" . htmlspecialchars(http_build_query(array_diff_key(receiptSearchQuery($receiptFilters), ['startfrom' => 1, 'enddate' => 1])
                            + ['start_date' => $intial_start, 'end_date' => $intial_end, 'report' => empty($_REQUEST['report']) ? 0 : 1, 'page' => $xi]), ENT_QUOTES, 'UTF-8') . "'\">{$xi}</button>";
                    } elseif ($xi == ($receiptPage - 4) || $xi == ($receiptPage + 4)) {
                        echo "<span style='padding: 0 0.25rem;'>...</span>";
                    }
                    $xi++;
                }
                ?>
            </div>
        </div>

