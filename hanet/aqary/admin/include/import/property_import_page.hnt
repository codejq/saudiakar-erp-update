<?php

$aqaryRoot = dirname(__DIR__, 3);
$importEntity = isset($importEntity) ? (string)$importEntity : '';
$importDepartmentId = isset($importDepartmentId) ? intval($importDepartmentId) : 0;

$pageDefinitions = [
    'arady' => ['title' => 'استيراد الأراضي', 'screen' => 3],
    'emara' => ['title' => 'استيراد العمائر', 'screen' => 15],
    'vila' => ['title' => 'استيراد الفلل', 'screen' => 26],
    'generic' => ['title' => 'استيراد قسم عام', 'screen' => 26],
];
if (!isset($pageDefinitions[$importEntity])) {
    http_response_code(404);
    exit('نوع الاستيراد غير صالح.');
}

$sc_title = $pageDefinitions[$importEntity]['title'];
$sc_id = (string)$pageDefinitions[$importEntity]['screen'];
include_once $aqaryRoot . '/nocash.hnt';
include_once $aqaryRoot . '/header.hnt';

require_once __DIR__ . '/ExcelTableReader.class.hnt';
require_once __DIR__ . '/PropertyImportService.class.hnt';

function property_import_stage_directory(): string
{
    $directory = storage_path('app/tmp/property-import');
    ensure_dir($directory);
    return rtrim($directory, '/\\') . DIRECTORY_SEPARATOR;
}

function property_import_cleanup_stages(string $directory): void
{
    $cutoff = time() - 7200;
    foreach (glob($directory . '*.json') ?: [] as $path) {
        if (is_file($path) && filemtime($path) < $cutoff) {
            @unlink($path);
        }
    }
}

function property_import_stage_path(string $token, int $userId): string
{
    if (!preg_match('/^[a-f0-9]{32}$/', $token)) {
        throw new RuntimeException('رمز ملف الاستيراد غير صالح.');
    }
    return property_import_stage_directory() . $userId . '-' . $token . '.json';
}

function property_import_escape($value): string
{
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

$userId = intval($_SESSION['useridv'] ?? 0);
$canImport = $userId > 0
    && intval($_SESSION['canaddv'] ?? 0) !== 0
    && empty($exitscreen);
$service = null;
$config = null;
$fields = [];
$staged = null;
$stageToken = '';
$resultSummary = null;
$pageError = '';
$processingStagePath = '';
$originalStagePath = '';
$importCompleted = false;

try {
    if ($importEntity === 'generic' && $importDepartmentId < 1) {
        $config = [
            'title' => 'استيراد قسم عام',
            'back_url' => '/aqary/admin/index.hnt',
            'back_label' => 'العودة إلى الأقسام',
        ];
    } else {
        $service = new PropertyImportService($link, $importEntity, $importDepartmentId);
        $config = $service->getConfig();
        $fields = $service->getFields();
        $sc_title = $config['title'];
    }

    if (!$canImport) {
        throw new RuntimeException('ليس لديك صلاحية إضافة سجلات جديدة.');
    }

    if (!isset($_SESSION['property_import_csrf']) || !is_string($_SESSION['property_import_csrf'])) {
        $_SESSION['property_import_csrf'] = bin2hex(random_bytes(24));
    }

    $action = (string)($_POST['import_action'] ?? '');
    if ($action === 'upload') {
        @set_time_limit(300);
        $csrf = (string)($_POST['csrf_token'] ?? '');
        if (!hash_equals((string)$_SESSION['property_import_csrf'], $csrf)) {
            throw new RuntimeException('انتهت صلاحية نموذج الاستيراد. أعد فتح الصفحة.');
        }
        if (!$service) {
            throw new RuntimeException('اختر القسم العام قبل رفع الملف.');
        }
        if (!isset($_FILES['excel_file']) || !is_array($_FILES['excel_file'])) {
            throw new RuntimeException('اختر ملف Excel أولاً.');
        }
        $file = $_FILES['excel_file'];
        if (intval($file['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK) {
            throw new RuntimeException('فشل رفع ملف Excel. تأكد من حجم الملف ثم حاول مرة أخرى.');
        }
        if (intval($file['size'] ?? 0) < 1 || intval($file['size']) > 10 * 1024 * 1024) {
            throw new RuntimeException('حجم ملف Excel يجب ألا يتجاوز 10 ميجابايت.');
        }
        $extension = strtolower(pathinfo((string)$file['name'], PATHINFO_EXTENSION));
        if (!in_array($extension, ['xlsx', 'xls'], true)) {
            throw new RuntimeException('الامتداد غير مسموح. استخدم XLSX أو XLS.');
        }
        if (!is_uploaded_file((string)$file['tmp_name'])) {
            throw new RuntimeException('ملف الرفع غير صالح.');
        }

        $rawRows = ExcelTableReader::read((string)$file['tmp_name'], (string)$file['name']);
        $prepared = $service->prepareRows($rawRows);
        $stageToken = bin2hex(random_bytes(16));
        $staged = [
            'version' => 1,
            'created_at' => time(),
            'user_id' => $userId,
            'entity' => $importEntity,
            'department_id' => $importDepartmentId,
            'file_name' => basename((string)$file['name']),
            'headers' => $prepared['headers'],
            'rows' => $prepared['rows'],
            'header_row' => $prepared['header_row'],
            'auto_mapping' => $prepared['auto_mapping'],
        ];

        $stageDirectory = property_import_stage_directory();
        property_import_cleanup_stages($stageDirectory);
        $encodedStage = json_encode($staged, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
        if ($encodedStage === false || file_put_contents(property_import_stage_path($stageToken, $userId), $encodedStage, LOCK_EX) === false) {
            throw new RuntimeException('تعذر حفظ معاينة الاستيراد مؤقتاً.');
        }
    } elseif ($action === 'import') {
        @set_time_limit(300);
        if (!$service) {
            throw new RuntimeException('اختر القسم العام قبل الاستيراد.');
        }
        $csrf = (string)($_POST['csrf_token'] ?? '');
        if (!hash_equals((string)$_SESSION['property_import_csrf'], $csrf)) {
            throw new RuntimeException('انتهت صلاحية نموذج الاستيراد. أعد رفع الملف.');
        }
        $stageToken = (string)($_POST['stage_token'] ?? '');
        $stagePath = property_import_stage_path($stageToken, $userId);
        $processingPath = substr($stagePath, 0, -5) . '.processing.json';
        if (!is_file($stagePath) && is_file($processingPath)) {
            if (filemtime($processingPath) >= time() - 600) {
                throw new RuntimeException('تتم معالجة هذا الملف حالياً. لا تعد إرسال النموذج.');
            }
            @rename($processingPath, $stagePath);
        }
        if (!is_file($stagePath) || filemtime($stagePath) < time() - 7200) {
            throw new RuntimeException('انتهت صلاحية ملف الاستيراد المؤقت. أعد رفعه.');
        }
        if ((string)($_POST['mapping_reviewed'] ?? '') !== '1') {
            throw new RuntimeException('يجب تأكيد مراجعة مطابقة الحقول قبل الاستيراد.');
        }
        if (!@rename($stagePath, $processingPath)) {
            throw new RuntimeException('بدأت معالجة الملف في طلب آخر. انتظر نتيجة الاستيراد.');
        }
        $processingStagePath = $processingPath;
        $originalStagePath = $stagePath;
        $staged = json_decode((string)file_get_contents($processingStagePath), true);
        if (!is_array($staged)
            || intval($staged['user_id'] ?? 0) !== $userId
            || (string)($staged['entity'] ?? '') !== $importEntity
            || intval($staged['department_id'] ?? 0) !== $importDepartmentId) {
            throw new RuntimeException('ملف الاستيراد المؤقت لا يخص هذه الصفحة أو هذا المستخدم.');
        }

        $mapping = is_array($_POST['mapping'] ?? null) ? $_POST['mapping'] : [];
        $skipDuplicates = isset($_POST['skip_duplicates']) && $_POST['skip_duplicates'] === '1';
        $resultSummary = $service->import($staged, $mapping, $userId, $skipDuplicates);
        $importCompleted = true;
        $donePath = substr($stagePath, 0, -5) . '.done.json';
        if (!@rename($processingStagePath, $donePath)) {
            @unlink($processingStagePath);
        }
        $processingStagePath = '';
        $originalStagePath = '';
        $staged = null;
        $stageToken = '';
    }
} catch (Throwable $error) {
    if (!$importCompleted && $processingStagePath !== '' && is_file($processingStagePath) && $originalStagePath !== '') {
        @rename($processingStagePath, $originalStagePath);
    }
    $pageError = $error->getMessage();
    error_log('Property Excel import [' . $importEntity . '] user ' . $userId . ': ' . $error->getMessage());
}

$departments = [];
if ($importEntity === 'generic' && $importDepartmentId < 1) {
    $departmentResult = mysql_query(
        "SELECT dep_id, dep_name FROM departments_name
         WHERE dep_isactive='1' AND (dep_isdeleted='' OR dep_isdeleted='0' OR dep_isdeleted IS NULL)
         ORDER BY dep_order, dep_name",
        $link
    );
    while ($departmentResult && ($department = mysql_fetch_array($departmentResult))) {
        $departments[] = $department;
    }
}

$selfUrl = '/aqary/admin/' . basename((string)($_SERVER['SCRIPT_NAME'] ?? ''));
if ($importEntity === 'generic' && $importDepartmentId > 0) {
    $selfUrl .= '?dep_id=' . $importDepartmentId;
}
?>

