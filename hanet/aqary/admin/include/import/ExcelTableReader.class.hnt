<?php

/**
 * Small, dependency-free reader for import spreadsheets.
 *
 * Supported inputs:
 * - Office Open XML workbooks (.xlsx)
 * - Excel 2003 XML workbooks (.xls containing SpreadsheetML)
 * - HTML-table exports saved with an .xls extension
 *
 * Binary BIFF .xls files are rejected with a clear message because parsing
 * them safely requires a third-party spreadsheet package.
 */
class ExcelTableReader
{
    private const MAX_ROWS = 5001; // Header plus 5,000 data rows.
    private const MAX_COLUMNS = 150;
    private const MAX_SHEET_XML_BYTES = 40 * 1024 * 1024;

    public static function read(string $path, string $originalName): array
    {
        if (!is_file($path) || !is_readable($path)) {
            throw new RuntimeException('تعذر قراءة ملف Excel المرفوع.');
        }

        $extension = strtolower(pathinfo($originalName, PATHINFO_EXTENSION));
        $signature = (string)file_get_contents($path, false, null, 0, 8);

        if ($extension === 'xlsx' || strncmp($signature, "PK\x03\x04", 4) === 0) {
            return self::readXlsx($path);
        }

        if ($extension === 'xls') {
            if (strncmp($signature, "\xD0\xCF\x11\xE0", 4) === 0) {
                throw new RuntimeException('هذا ملف Excel قديم بصيغة ثنائية. افتحه في Excel واحفظه بصيغة XLSX ثم أعد رفعه.');
            }

            $contents = (string)file_get_contents($path);
            if (stripos($contents, '<table') !== false) {
                return self::readHtmlTable($contents);
            }
            if (stripos($contents, '<Workbook') !== false || stripos($contents, ':Workbook') !== false) {
                return self::readSpreadsheetXml($contents);
            }
        }

        throw new RuntimeException('صيغة الملف غير مدعومة. استخدم ملف XLSX، أو ملف XLS يحتوي جدول HTML/XML.');
    }

    private static function readXlsx(string $path): array
    {
        if (!class_exists('ZipArchive') || !class_exists('DOMDocument')) {
            throw new RuntimeException('امتدادات ZIP وXML المطلوبة لقراءة XLSX غير مفعلة على الخادم.');
        }

        $zip = new ZipArchive();
        if ($zip->open($path) !== true) {
            throw new RuntimeException('ملف XLSX تالف أو غير قابل للفتح.');
        }

        try {
            $sharedStrings = self::readSharedStrings($zip);
            $sheetPath = self::findFirstWorksheet($zip);
            $sheetStat = $zip->statName($sheetPath);
            if (!$sheetStat || intval($sheetStat['size'] ?? 0) > self::MAX_SHEET_XML_BYTES) {
                throw new RuntimeException('ورقة Excel كبيرة جداً. الحد الأقصى 5000 صف للاستيراد الواحد.');
            }

            $sheetXml = $zip->getFromName($sheetPath);
            if ($sheetXml === false) {
                throw new RuntimeException('تعذر قراءة ورقة العمل الأولى.');
            }

            $document = self::loadXml($sheetXml, 'تعذر تحليل ورقة Excel.');
            $rows = [];
            foreach ($document->getElementsByTagName('row') as $rowNode) {
                $row = [];
                $nextColumn = 0;
                foreach ($rowNode->getElementsByTagName('c') as $cellNode) {
                    $reference = $cellNode->getAttribute('r');
                    $columnIndex = $reference !== ''
                        ? self::columnIndexFromReference($reference)
                        : $nextColumn;
                    $nextColumn = $columnIndex + 1;

                    if ($columnIndex < 0 || $columnIndex >= self::MAX_COLUMNS) {
                        continue;
                    }

                    $type = $cellNode->getAttribute('t');
                    $value = '';
                    if ($type === 'inlineStr') {
                        $value = self::collectTextNodes($cellNode);
                    } else {
                        $valueNode = $cellNode->getElementsByTagName('v')->item(0);
                        $value = $valueNode ? $valueNode->textContent : '';
                        if ($type === 's' && $value !== '') {
                            $value = $sharedStrings[intval($value)] ?? '';
                        } elseif ($type === 'b') {
                            $value = $value === '1' ? '1' : '0';
                        }
                    }
                    $row[$columnIndex] = self::cleanCell($value);
                }

                if (self::rowHasValue($row)) {
                    $rows[] = self::normalizeRowWidth($row);
                    if (count($rows) >= self::MAX_ROWS) {
                        break;
                    }
                }
            }

            if (count($rows) < 2) {
                throw new RuntimeException('لم يتم العثور على عناوين وبيانات قابلة للاستيراد في ورقة Excel الأولى.');
            }
            return $rows;
        } finally {
            $zip->close();
        }
    }

    private static function readSharedStrings(ZipArchive $zip): array
    {
        $xml = $zip->getFromName('xl/sharedStrings.xml');
        if ($xml === false) {
            return [];
        }
        if (strlen($xml) > self::MAX_SHEET_XML_BYTES) {
            throw new RuntimeException('ملف النصوص داخل Excel كبير جداً.');
        }

        $document = self::loadXml($xml, 'تعذر قراءة نصوص ملف Excel.');
        $strings = [];
        foreach ($document->getElementsByTagName('si') as $item) {
            $strings[] = self::collectTextNodes($item);
        }
        return $strings;
    }

    private static function findFirstWorksheet(ZipArchive $zip): string
    {
        $workbookXml = $zip->getFromName('xl/workbook.xml');
        $relationshipsXml = $zip->getFromName('xl/_rels/workbook.xml.rels');
        if ($workbookXml !== false && $relationshipsXml !== false) {
            $workbook = self::loadXml($workbookXml, 'تعذر قراءة بنية ملف Excel.');
            $sheet = $workbook->getElementsByTagName('sheet')->item(0);
            $relationshipId = $sheet
                ? $sheet->getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships', 'id')
                : '';

            if ($relationshipId !== '') {
                $relationships = self::loadXml($relationshipsXml, 'تعذر قراءة علاقات ملف Excel.');
                foreach ($relationships->getElementsByTagName('Relationship') as $relationship) {
                    if ($relationship->getAttribute('Id') !== $relationshipId) {
                        continue;
                    }
                    $target = str_replace('\\', '/', $relationship->getAttribute('Target'));
                    $target = ltrim($target, '/');
                    if (str_starts_with($target, 'xl/')) {
                        return $target;
                    }
                    return 'xl/' . preg_replace('#^(\.\./)+#', '', $target);
                }
            }
        }

        if ($zip->locateName('xl/worksheets/sheet1.xml') !== false) {
            return 'xl/worksheets/sheet1.xml';
        }
        throw new RuntimeException('لم يتم العثور على ورقة عمل داخل ملف XLSX.');
    }

    private static function readHtmlTable(string $contents): array
    {
        $contents = self::ensureUtf8($contents);
        $document = new DOMDocument('1.0', 'UTF-8');
        $previous = libxml_use_internal_errors(true);
        $loaded = $document->loadHTML('<?xml encoding="UTF-8">' . $contents, LIBXML_NONET | LIBXML_NOERROR | LIBXML_NOWARNING);
        libxml_clear_errors();
        libxml_use_internal_errors($previous);
        if (!$loaded) {
            throw new RuntimeException('تعذر تحليل جدول Excel القديم.');
        }

        $table = $document->getElementsByTagName('table')->item(0);
        if (!$table) {
            throw new RuntimeException('لم يتم العثور على جدول داخل ملف Excel.');
        }

        $rows = [];
        foreach ($table->getElementsByTagName('tr') as $tr) {
            $row = [];
            foreach ($tr->childNodes as $cell) {
                if (!in_array(strtolower($cell->nodeName), ['td', 'th'], true)) {
                    continue;
                }
                $row[] = self::cleanCell($cell->textContent);
                if (count($row) >= self::MAX_COLUMNS) {
                    break;
                }
            }
            if (self::rowHasValue($row)) {
                $rows[] = $row;
                if (count($rows) >= self::MAX_ROWS) {
                    break;
                }
            }
        }

        if (count($rows) < 2) {
            throw new RuntimeException('لم يتم العثور على عناوين وبيانات قابلة للاستيراد.');
        }
        return $rows;
    }

    private static function readSpreadsheetXml(string $contents): array
    {
        $contents = self::ensureUtf8($contents);
        $document = self::loadXml($contents, 'تعذر تحليل ملف Excel XML.');
        $rows = [];
        foreach ($document->getElementsByTagName('Row') as $rowNode) {
            $row = [];
            $columnIndex = 0;
            foreach ($rowNode->getElementsByTagName('Cell') as $cellNode) {
                $index = $cellNode->getAttributeNS('urn:schemas-microsoft-com:office:spreadsheet', 'Index');
                if ($index !== '') {
                    $columnIndex = max(0, intval($index) - 1);
                }
                if ($columnIndex >= self::MAX_COLUMNS) {
                    break;
                }
                $dataNode = $cellNode->getElementsByTagName('Data')->item(0);
                $row[$columnIndex] = self::cleanCell($dataNode ? $dataNode->textContent : '');
                $columnIndex++;
            }
            if (self::rowHasValue($row)) {
                $rows[] = self::normalizeRowWidth($row);
                if (count($rows) >= self::MAX_ROWS) {
                    break;
                }
            }
        }

        if (count($rows) < 2) {
            throw new RuntimeException('لم يتم العثور على عناوين وبيانات قابلة للاستيراد.');
        }
        return $rows;
    }

    private static function loadXml(string $xml, string $errorMessage): DOMDocument
    {
        $document = new DOMDocument();
        $previous = libxml_use_internal_errors(true);
        $loaded = $document->loadXML($xml, LIBXML_NONET | LIBXML_COMPACT);
        libxml_clear_errors();
        libxml_use_internal_errors($previous);
        if (!$loaded) {
            throw new RuntimeException($errorMessage);
        }
        return $document;
    }

    private static function collectTextNodes(DOMNode $node): string
    {
        $text = '';
        if ($node instanceof DOMElement) {
            foreach ($node->getElementsByTagName('t') as $textNode) {
                $text .= $textNode->textContent;
            }
        }
        return self::cleanCell($text);
    }

    private static function columnIndexFromReference(string $reference): int
    {
        if (!preg_match('/^([A-Z]+)/i', $reference, $matches)) {
            return -1;
        }
        $letters = strtoupper($matches[1]);
        $index = 0;
        for ($i = 0, $length = strlen($letters); $i < $length; $i++) {
            $index = ($index * 26) + (ord($letters[$i]) - 64);
        }
        return $index - 1;
    }

    private static function normalizeRowWidth(array $row): array
    {
        if (!$row) {
            return [];
        }
        $width = min(self::MAX_COLUMNS, max(array_keys($row)) + 1);
        $normalized = array_fill(0, $width, '');
        foreach ($row as $index => $value) {
            if ($index >= 0 && $index < $width) {
                $normalized[$index] = $value;
            }
        }
        return $normalized;
    }

    private static function rowHasValue(array $row): bool
    {
        foreach ($row as $value) {
            if (trim((string)$value) !== '') {
                return true;
            }
        }
        return false;
    }

    private static function cleanCell($value): string
    {
        $value = self::ensureUtf8((string)$value);
        $value = str_replace(["\xC2\xA0", "\r\n", "\r"], [' ', "\n", "\n"], $value);
        $value = preg_replace('/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/u', '', $value) ?? $value;
        return trim(mb_substr($value, 0, 5000, 'UTF-8'));
    }

    private static function ensureUtf8(string $value): string
    {
        if ($value === '' || mb_check_encoding($value, 'UTF-8')) {
            return $value;
        }
        $encoding = mb_detect_encoding($value, ['Windows-1256', 'Windows-1252', 'ISO-8859-1'], true);
        return mb_convert_encoding($value, 'UTF-8', $encoding ?: 'Windows-1256');
    }
}

