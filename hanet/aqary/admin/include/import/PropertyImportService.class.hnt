<?php

class PropertyImportService
{
    private $link;
    private string $entity;
    private int $departmentId;
    private array $config;
    private array $columns = [];
    private array $fields = [];

    public function __construct($link, string $entity, int $departmentId = 0)
    {
        $this->link = $link;
        $this->entity = $entity;
        $this->departmentId = $departmentId;
        $this->config = $this->buildConfig();
        $this->columns = $this->loadColumns($this->config['table']);
        $this->fields = $this->buildFields();
    }

    public function getConfig(): array
    {
        return $this->config;
    }

    public function getFields(): array
    {
        return $this->fields;
    }

    public function prepareRows(array $rawRows): array
    {
        $headerIndex = $this->detectHeaderRow($rawRows);
        $sourceHeaders = $rawRows[$headerIndex] ?? [];
        $width = count($sourceHeaders);
        if ($width < 1) {
            throw new RuntimeException('تعذر تحديد صف عناوين الأعمدة في الملف.');
        }

        $headers = [];
        $usedHeaders = [];
        for ($index = 0; $index < $width; $index++) {
            $header = trim((string)($sourceHeaders[$index] ?? ''));
            if ($header === '') {
                $header = 'العمود ' . ($index + 1);
            }
            $baseHeader = $header;
            $suffix = 2;
            while (isset($usedHeaders[$header])) {
                $header = $baseHeader . ' (' . $suffix . ')';
                $suffix++;
            }
            $usedHeaders[$header] = true;
            $headers[] = $header;
        }

        $rows = [];
        for ($index = $headerIndex + 1, $count = count($rawRows); $index < $count; $index++) {
            $sourceRow = $rawRows[$index];
            $row = [];
            $hasValue = false;
            for ($column = 0; $column < $width; $column++) {
                $value = trim((string)($sourceRow[$column] ?? ''));
                $row[] = $value;
                if ($value !== '') {
                    $hasValue = true;
                }
            }
            if ($hasValue) {
                $rows[] = ['excel_row' => $index + 1, 'values' => $row];
            }
        }

        if (!$rows) {
            throw new RuntimeException('لا توجد صفوف بيانات بعد صف العناوين.');
        }

        return [
            'headers' => $headers,
            'rows' => $rows,
            'header_row' => $headerIndex + 1,
            'auto_mapping' => $this->autoMap($headers),
        ];
    }

    public function import(array $staged, array $submittedMapping, int $userId, bool $skipDuplicates): array
    {
        if ($userId < 1) {
            throw new RuntimeException('انتهت جلسة المستخدم. سجل الدخول مرة أخرى.');
        }

        $headers = is_array($staged['headers'] ?? null) ? $staged['headers'] : [];
        $rows = is_array($staged['rows'] ?? null) ? $staged['rows'] : [];
        if (!$headers || !$rows) {
            throw new RuntimeException('بيانات ملف الاستيراد غير متاحة أو انتهت صلاحيتها.');
        }

        $allowedTargets = array_fill_keys(array_keys($this->fields), true);
        $mapping = [];
        $usedTargets = [];
        foreach ($headers as $index => $header) {
            $target = trim((string)($submittedMapping[$index] ?? ''));
            if ($target === '') {
                continue;
            }
            if (!isset($allowedTargets[$target])) {
                throw new RuntimeException('تم اختيار حقل غير مسموح به في خريطة الاستيراد.');
            }
            if (isset($usedTargets[$target])) {
                throw new RuntimeException('لا يمكن ربط أكثر من عمود Excel بالحقل نفسه: ' . $this->fields[$target]['label']);
            }
            $usedTargets[$target] = true;
            $mapping[intval($index)] = $target;
        }

        $meaningfulMappings = array_filter(
            $mapping,
            static fn($target) => $target !== '__city_name'
        );
        if (!$mapping || !$meaningfulMappings) {
            throw new RuntimeException('اختر حقلاً واحداً على الأقل لاستيراده.');
        }

        $writableColumns = array_keys($this->columns);
        $primaryKey = $this->config['primary_key'];
        $writableColumns = array_values(array_filter(
            $writableColumns,
            fn($column) => $column !== $primaryKey && stripos($this->columns[$column]['Extra'], 'auto_increment') === false
        ));

        if (!$writableColumns) {
            throw new RuntimeException('لا توجد حقول قابلة للاستيراد في الجدول المحدد.');
        }

        $quotedColumns = implode(', ', array_map(fn($column) => '`' . $column . '`', $writableColumns));
        $placeholders = implode(', ', array_fill(0, count($writableColumns), '?'));
        $insertSql = 'INSERT INTO `' . $this->config['table'] . '` (' . $quotedColumns . ') VALUES (' . $placeholders . ')';
        $insertStatement = mysqli_prepare($this->link, $insertSql);
        if (!$insertStatement) {
            throw new RuntimeException('تعذر تجهيز عملية الاستيراد.');
        }

        $lookups = $this->loadLookups();
        $duplicateStatement = $this->prepareDuplicateStatement($skipDuplicates);
        $summary = [
            'total' => count($rows),
            'inserted' => 0,
            'skipped' => 0,
            'failed' => 0,
            'errors' => [],
        ];

        mysqli_begin_transaction($this->link);
        try {
            foreach ($rows as $rowPosition => $rowData) {
                $excelRow = intval($rowData['excel_row'] ?? ($rowPosition + 2));
                $values = is_array($rowData['values'] ?? null) ? $rowData['values'] : [];

                try {
                    $mapped = [];
                    foreach ($mapping as $columnIndex => $target) {
                        $mapped[$target] = trim((string)($values[$columnIndex] ?? ''));
                    }

                    if (!$this->mappedRowHasValue($mapped)) {
                        $summary['skipped']++;
                        continue;
                    }

                    $this->resolveVirtualFields($mapped, $lookups, $excelRow);
                    $record = $this->defaultRecord($writableColumns, $userId, $rowPosition);
                    foreach ($mapped as $target => $value) {
                        if (str_starts_with($target, '__') || !array_key_exists($target, $record) || $value === '') {
                            continue;
                        }
                        $record[$target] = $this->normalizeValue($target, $value, $excelRow);
                    }

                    if ($skipDuplicates && $duplicateStatement && $this->isDuplicate($duplicateStatement, $record)) {
                        $summary['skipped']++;
                        continue;
                    }

                    $insertValues = [];
                    foreach ($writableColumns as $column) {
                        $insertValues[] = (string)($record[$column] ?? '');
                    }
                    if (!mysqli_stmt_execute($insertStatement, $insertValues)) {
                        throw new RuntimeException('تعذر حفظ السجل.');
                    }
                    $summary['inserted']++;
                } catch (Throwable $rowError) {
                    $summary['failed']++;
                    if (count($summary['errors']) < 100) {
                        $summary['errors'][] = [
                            'row' => $excelRow,
                            'message' => $rowError->getMessage(),
                        ];
                    }
                }
            }

            mysqli_commit($this->link);
        } catch (Throwable $error) {
            mysqli_rollback($this->link);
            throw $error;
        } finally {
            mysqli_stmt_close($insertStatement);
            if ($duplicateStatement) {
                mysqli_stmt_close($duplicateStatement);
            }
        }

        return $summary;
    }

    private function buildConfig(): array
    {
        $configs = [
            'arady' => [
                'title' => 'استيراد الأراضي',
                'table' => 'arady',
                'primary_key' => 'ardid',
                'number_field' => 'ardrakam',
                'screen_id' => 3,
                'back_url' => '/aqary/admin/include/updateard.hnt',
                'back_label' => 'العودة إلى الأراضي',
            ],
            'emara' => [
                'title' => 'استيراد العمائر',
                'table' => 'emara',
                'primary_key' => 'emaraid',
                'number_field' => 'emararakam',
                'screen_id' => 15,
                'back_url' => '/aqary/admin/include/emara/updatemara.hnt',
                'back_label' => 'العودة إلى العمائر',
            ],
            'vila' => [
                'title' => 'استيراد الفلل',
                'table' => 'vila',
                'primary_key' => 'vilaid',
                'number_field' => 'vilarakam',
                'screen_id' => 26,
                'back_url' => '/aqary/admin/include/vila/updatvila.hnt',
                'back_label' => 'العودة إلى الفلل',
            ],
        ];

        if (isset($configs[$this->entity])) {
            return $configs[$this->entity] + ['entity' => $this->entity, 'department_id' => 0];
        }

        if ($this->entity !== 'generic' || $this->departmentId < 1) {
            throw new RuntimeException('نوع الاستيراد غير صالح.');
        }

        $departmentResult = mysql_query(
            "SELECT dep_id, dep_name, dep_table_name FROM departments_name
             WHERE dep_id='" . $this->departmentId . "'
               AND (dep_isdeleted='' OR dep_isdeleted='0' OR dep_isdeleted IS NULL)
             LIMIT 1",
            $this->link
        );
        $department = $departmentResult ? mysql_fetch_array($departmentResult) : false;
        if (!$department || !preg_match('/^[A-Za-z0-9_]+$/', (string)$department['dep_table_name'])) {
            throw new RuntimeException('القسم العام المطلوب غير موجود أو غير صالح للاستيراد.');
        }

        return [
            'entity' => 'generic',
            'department_id' => $this->departmentId,
            'title' => 'استيراد قسم ' . $department['dep_name'],
            'table' => $department['dep_table_name'],
            'primary_key' => 'id',
            'number_field' => '',
            'screen_id' => 26,
            'back_url' => '/aqary/admin/include/geniric_departments/dep_showwall.hnt?dep_id=' . $this->departmentId,
            'back_label' => 'العودة إلى القسم',
        ];
    }

    private function loadColumns(string $table): array
    {
        if (!preg_match('/^[A-Za-z0-9_]+$/', $table)) {
            throw new RuntimeException('اسم جدول الاستيراد غير صالح.');
        }
        $result = mysql_query('SHOW FULL COLUMNS FROM `' . $table . '`', $this->link);
        if (!$result) {
            throw new RuntimeException('تعذر قراءة حقول جدول الاستيراد.');
        }
        $columns = [];
        while ($column = mysql_fetch_array($result)) {
            $columns[$column['Field']] = $column;
        }
        return $columns;
    }

    private function buildFields(): array
    {
        $labels = $this->standardLabels();
        if (in_array($this->entity, ['emara', 'vila'], true)) {
            $labels['block'] = [
                'label' => 'الشارع الرئيسي',
                'aliases' => ['شارع رئيسي', 'main street'],
            ];
            $labels['share3'] = [
                'label' => 'الشارع الفرعي',
                'aliases' => ['شارع فرعي', 'secondary street', 'sub street'],
            ];
        }
        $genericLabels = [];
        if ($this->entity === 'generic') {
            $fieldResult = mysql_query(
                "SELECT fld_name, fld_en_name, fld_type FROM department_field
                 WHERE dep_id='" . $this->departmentId . "'
                   AND (fld_isactive='' OR fld_isactive='1' OR fld_isactive IS NULL)
                 ORDER BY fld_id",
                $this->link
            );
            while ($fieldResult && ($field = mysql_fetch_array($fieldResult))) {
                $column = (string)$field['fld_en_name'];
                $fieldType = intval($field['fld_type']);
                if (isset($this->columns[$column]) && !in_array($fieldType, [0, 6, 7], true)) {
                    $genericLabels[$column] = [
                        'label' => trim((string)$field['fld_name']) ?: $column,
                        'aliases' => [$column, trim((string)$field['fld_name'])],
                        'kind' => $fieldType === 5 ? 'boolean' : 'string',
                    ];
                }
            }
        }

        $excluded = [
            $this->config['primary_key'], 'custummerid', 'custumerid', 'formuid',
            'mapid', 'malekid', 'oldmalekid', 'polypath', 'ploypath', 'googlexyz',
            'statusx', 'reversedby', 'reversedfor', 'soldto',
        ];
        $fields = [];
        foreach ($this->columns as $column => $metadata) {
            if (in_array($column, $excluded, true)) {
                continue;
            }
            if ($this->entity === 'generic' && !isset($genericLabels[$column]) && $column !== 'masderid') {
                continue;
            }
            $definition = $genericLabels[$column] ?? $labels[$column] ?? [];
            $label = $definition['label'] ?? $column;
            $aliases = array_values(array_unique(array_filter(array_merge(
                [$column, $label],
                $definition['aliases'] ?? []
            ))));
            $fields[$column] = [
                'label' => $label,
                'aliases' => $aliases,
                'kind' => $definition['kind'] ?? $this->kindFromSqlType((string)$metadata['Type'], $column),
                'type' => (string)$metadata['Type'],
            ];
        }

        if ($this->entity !== 'generic' && isset($this->columns['mokhatatid'])) {
            $fields = [
                '__city_name' => [
                    'label' => 'اسم المدينة (للتعرف على المخطط)',
                    'aliases' => ['المدينة', 'اسم المدينة', 'city', 'city name', 'cityname'],
                    'kind' => 'lookup',
                    'type' => 'virtual',
                ],
                '__mokhatat_name' => [
                    'label' => 'اسم أو رقم المخطط',
                    'aliases' => ['المخطط', 'اسم المخطط', 'رقم المخطط', 'mokhatat', 'plan', 'plan name'],
                    'kind' => 'lookup',
                    'type' => 'virtual',
                ],
            ] + $fields;
        }

        if (isset($this->columns['masderid'])) {
            $fields = [
                '__masder_name' => [
                    'label' => 'اسم المصدر أو الوسيط',
                    'aliases' => ['المصدر', 'اسم المصدر', 'الوسيط', 'اسم الوسيط', 'source', 'broker'],
                    'kind' => 'lookup',
                    'type' => 'virtual',
                ],
            ] + $fields;
        }

        if ($this->entity !== 'generic' && isset($this->columns['hedod'])) {
            $fields = [
                '__hedod_north' => [
                    'label' => 'الحد الشمالي',
                    'aliases' => ['حد شمالي', 'الشمالي', 'north boundary'],
                    'kind' => 'virtual',
                    'type' => 'virtual',
                ],
                '__hedod_south' => [
                    'label' => 'الحد الجنوبي',
                    'aliases' => ['حد جنوبي', 'الجنوبي', 'south boundary'],
                    'kind' => 'virtual',
                    'type' => 'virtual',
                ],
                '__hedod_east' => [
                    'label' => 'الحد الشرقي',
                    'aliases' => ['حد شرقي', 'الشرقي', 'east boundary'],
                    'kind' => 'virtual',
                    'type' => 'virtual',
                ],
                '__hedod_west' => [
                    'label' => 'الحد الغربي',
                    'aliases' => ['حد غربي', 'الغربي', 'west boundary'],
                    'kind' => 'virtual',
                    'type' => 'virtual',
                ],
            ] + $fields;
        }

        return $fields;
    }

