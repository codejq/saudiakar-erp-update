            'madakhel' => ['label' => 'عدد المداخل', 'aliases' => ['المداخل', 'entrances'], 'kind' => 'integer'],
            'dakhl' => ['label' => 'الدخل', 'aliases' => ['الدخل السنوي', 'income'], 'kind' => 'decimal'],
            'benamesaha' => ['label' => 'مساحة البناء', 'aliases' => ['المساحة المبنية', 'building area'], 'kind' => 'decimal'],
            'kabou' => ['label' => 'قبو', 'aliases' => ['يوجد قبو', 'basement'], 'kind' => 'boolean'],
            'moager' => ['label' => 'مؤجر', 'aliases' => ['حالة التأجير', 'rented'], 'kind' => 'boolean'],
