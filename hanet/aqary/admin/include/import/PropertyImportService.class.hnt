            'secretinfo' => ['label' => 'بيانات سرية', 'aliases' => ['معلومات سرية']],
        ];

        $serviceLabels = [
            1 => 'مياه', 2 => 'كهرباء', 3 => 'سفلت', 4 => 'مدارس', 5 => 'مستشفى',
            6 => 'تطل على ساحة', 7 => 'جوار مسجد', 8 => 'جوار شركات', 9 => 'جوار مزرعة',
            10 => 'هاتف', 11 => 'البيع بالقطعة', 12 => 'البيع بالمتر المربع',
            13 => 'على الشور', 14 => 'قابل للتفاوض',
        ];
        for ($number = 1; $number <= 23; $number++) {
            $field = 's' . $number;
            $label = $serviceLabels[$number] ?? ('خاصية ' . $number);
            $labels[$field] = ['label' => $label, 'aliases' => [$field, $label], 'kind' => 'boolean'];
        }

        for ($number = 1; $number <= 10; $number++) {
            $ownerLabels = [1 => 'اسم المالك', 2 => 'جوال المالك', 3 => 'عنوان المالك', 4 => 'رقم الصك', 5 => 'هاتف منزل المالك', 6 => 'هاتف عمل المالك', 7 => 'صندوق بريد المالك', 8 => 'بريد المالك الإلكتروني', 9 => 'جهة عمل المالك', 10 => 'ملاحظات المالك'];
            $labels['malekbayan' . $number] = ['label' => $ownerLabels[$number], 'aliases' => ['malekbayan' . $number, $ownerLabels[$number]]];
            $labels['oldmalekbayan' . $number] = ['label' => $ownerLabels[$number] . ' السابق', 'aliases' => ['oldmalekbayan' . $number, $ownerLabels[$number] . ' السابق']];
        }
        return $labels;
    }

    private function detectHeaderRow(array $rows): int
    {
        $aliasIndex = $this->aliasIndex();
        $bestIndex = 0;
        $bestScore = -1;
        $limit = min(20, count($rows));
        for ($index = 0; $index < $limit; $index++) {
            $matches = [];
            $nonEmpty = 0;
            foreach ($rows[$index] as $value) {
                $normalized = self::normalizeLabel((string)$value);
                if ($normalized === '') {
                    continue;
                }
                $nonEmpty++;
                if (isset($aliasIndex[$normalized])) {
                    $matches[$aliasIndex[$normalized]] = true;
                }
            }
            $score = (count($matches) * 100) + $nonEmpty;
            if ($score > $bestScore) {
                $bestScore = $score;
                $bestIndex = $index;
            }
        }
        return $bestIndex;
    }

    private function autoMap(array $headers): array
    {
        $aliasIndex = $this->aliasIndex();
        $mapping = [];
        $used = [];
        foreach ($headers as $index => $header) {
            $normalized = self::normalizeLabel((string)$header);
            $target = $aliasIndex[$normalized] ?? '';
            if ($target !== '' && !isset($used[$target])) {
                $mapping[$index] = $target;
                $used[$target] = true;
            } else {
                $mapping[$index] = '';
            }
        }
        return $mapping;
    }

    private function aliasIndex(): array
    {
        $index = [];
        foreach ($this->fields as $field => $definition) {
            foreach ($definition['aliases'] as $alias) {
                $normalized = self::normalizeLabel((string)$alias);
                if ($normalized !== '' && !isset($index[$normalized])) {
                    $index[$normalized] = $field;
                }
            }
        }
        return $index;
    }

    private static function normalizeLabel(string $value): string
    {
        $value = mb_strtolower(trim($value), 'UTF-8');
        $value = strtr($value, [
            'أ' => 'ا', 'إ' => 'ا', 'آ' => 'ا', 'ى' => 'ي', 'ة' => 'ه', 'ؤ' => 'و', 'ئ' => 'ي',
            '٠' => '0', '١' => '1', '٢' => '2', '٣' => '3', '٤' => '4',
            '٥' => '5', '٦' => '6', '٧' => '7', '٨' => '8', '٩' => '9',
        ]);
        $value = preg_replace('/[\x{0640}\x{064B}-\x{065F}\x{0670}]/u', '', $value) ?? $value;
        return preg_replace('/[^\p{L}\p{N}]+/u', '', $value) ?? '';
    }

    private function loadLookups(): array
    {
        $lookups = [
            'cities' => [],
            'plans' => [],
            'plan_ids' => [],
            'sources' => [],
            'source_ids' => [],
        ];
        if ($this->entity !== 'generic' && isset($this->columns['mokhatatid'])) {
            $result = mysql_query(
                'SELECT m.mokhatatid, m.mokhatatname, m.cityid, c.cityname
                 FROM mokhatat m LEFT JOIN city c ON c.cityid=m.cityid',
                $this->link
            );
            while ($result && ($row = mysql_fetch_array($result))) {
                $cityKey = self::normalizeLabel((string)$row['cityname']);
                if ($cityKey !== '') {
                    $lookups['cities'][$cityKey][] = intval($row['cityid']);
                }
                $lookups['plan_ids'][intval($row['mokhatatid'])] = intval($row['cityid']);
                $planKey = self::normalizeLabel((string)$row['mokhatatname']);
                if ($planKey !== '') {
                    $lookups['plans'][$planKey][] = [
                        'id' => intval($row['mokhatatid']),
                        'city_id' => intval($row['cityid']),
                    ];
                }
            }
        }

        if (isset($this->columns['masderid'])) {
            $result = mysql_query('SELECT masderid, masdername FROM masder', $this->link);
            while ($result && ($row = mysql_fetch_array($result))) {
                $lookups['source_ids'][intval($row['masderid'])] = true;
                $key = self::normalizeLabel((string)$row['masdername']);
                if ($key !== '') {
                    $lookups['sources'][$key][] = intval($row['masderid']);
                }
            }
        }
        return $lookups;
    }

    private function resolveVirtualFields(array &$mapped, array $lookups, int $excelRow): void
    {
        $boundaryFields = ['__hedod_north', '__hedod_south', '__hedod_east', '__hedod_west'];
        $hasSeparateBoundary = false;
        foreach ($boundaryFields as $boundaryField) {
            if (isset($mapped[$boundaryField]) && trim($mapped[$boundaryField]) !== '') {
                $hasSeparateBoundary = true;
                break;
            }
        }
        if ($hasSeparateBoundary) {
            $boundaries = array_pad(explode(';', (string)($mapped['hedod'] ?? ''), 4), 4, '');
            foreach ($boundaryFields as $index => $boundaryField) {
                if (isset($mapped[$boundaryField]) && trim($mapped[$boundaryField]) !== '') {
                    $boundaries[$index] = trim($mapped[$boundaryField]);
                }
            }
            $mapped['hedod'] = implode(';', array_slice($boundaries, 0, 4));
        }

        if (isset($mapped['__masder_name']) && trim($mapped['__masder_name']) !== '') {
            $key = self::normalizeLabel($mapped['__masder_name']);
            $matches = array_values(array_unique($lookups['sources'][$key] ?? []));
            if (count($matches) === 1) {
                $mapped['masderid'] = (string)$matches[0];
            } elseif (!$matches) {
                throw new RuntimeException('المصدر أو الوسيط غير موجود: ' . $mapped['__masder_name']);
            } else {
                throw new RuntimeException('اسم المصدر أو الوسيط مكرر: ' . $mapped['__masder_name']);
            }
        } elseif (isset($mapped['masderid']) && trim($mapped['masderid']) !== '') {
            $sourceNumber = self::normalizeNumber($mapped['masderid']);
            if (!is_numeric($sourceNumber) || (float)$sourceNumber != (int)$sourceNumber) {
                throw new RuntimeException('معرّف المصدر غير صالح: ' . $mapped['masderid']);
            }
            $sourceId = intval($sourceNumber);
            if ($sourceId !== 0 && !isset($lookups['source_ids'][$sourceId])) {
                throw new RuntimeException('معرّف المصدر غير موجود: ' . $sourceId);
            }
        }

        $planValue = trim((string)($mapped['__mokhatat_name'] ?? ''));
        $explicitPlan = trim((string)($mapped['mokhatatid'] ?? ''));
        $cityValue = trim((string)($mapped['__city_name'] ?? ''));
        $cityIds = [];
        if ($cityValue !== '') {
            $cityKey = self::normalizeLabel($cityValue);
            $cityIds = array_values(array_unique($lookups['cities'][$cityKey] ?? []));
            if (!$cityIds) {
                throw new RuntimeException('المدينة غير موجودة: ' . $cityValue);
            }
        }

        if ($planValue === '' && $explicitPlan !== '') {
            $planNumber = self::normalizeNumber($explicitPlan);
            if (is_numeric($planNumber) && (float)$planNumber == (int)$planNumber) {
                $planId = intval($planNumber);
                if ($planId !== 0 && !isset($lookups['plan_ids'][$planId])) {
                    throw new RuntimeException('معرّف المخطط غير موجود: ' . $planId);
                }
                if ($planId !== 0 && $cityIds && !in_array(intval($lookups['plan_ids'][$planId]), $cityIds, true)) {
                    throw new RuntimeException('المخطط المحدد لا يتبع المدينة المحددة.');
                }
                $mapped['mokhatatid'] = (string)$planId;
                return;
            }
            $planValue = $explicitPlan;
        }
        if ($planValue === '') {
            return;
        }

        $planKey = self::normalizeLabel($planValue);
        $candidates = $lookups['plans'][$planKey] ?? [];
        if ($cityIds) {
            $candidates = array_values(array_filter(
                $candidates,
                static fn($candidate) => in_array(intval($candidate['city_id']), $cityIds, true)
            ));
        }

        if (count($candidates) === 1) {
            $mapped['mokhatatid'] = (string)$candidates[0]['id'];
            return;
        }
        if (!$candidates) {
            throw new RuntimeException('المخطط غير موجود' . ($cityValue !== '' ? ' في المدينة المحددة' : '') . ': ' . $planValue);
        }
        throw new RuntimeException('اسم المخطط مكرر؛ اربط عمود المدينة أيضاً: ' . $planValue);
    }

    private function defaultRecord(array $columns, int $userId, int $rowPosition): array
    {
        $record = [];
        foreach ($columns as $column) {
            $metadata = $this->columns[$column];
            if ($metadata['Default'] !== null) {
                $record[$column] = (string)$metadata['Default'];
            } else {
                $record[$column] = $this->isNumericSqlType((string)$metadata['Type']) ? '0' : '';
            }
        }

        foreach (['custummerid', 'custumerid'] as $userColumn) {
            if (array_key_exists($userColumn, $record)) {
                $record[$userColumn] = (string)$userId;
            }
        }
        if (array_key_exists('st_date', $record)) {
            $record['st_date'] = (string)time();
        }
        if (array_key_exists('enbleslideshow', $record)) {
            $record['enbleslideshow'] = '1';
        }
        if (array_key_exists('formuid', $record)) {
            $record['formuid'] = sprintf('%010d%s%04d', random_int(0, 9999999999), (string)time(), $rowPosition % 10000);
        }
        return $record;
    }

    private function normalizeValue(string $field, string $value, int $excelRow): string
    {
        $definition = $this->fields[$field] ?? null;
        $kind = $definition['kind'] ?? 'string';
        if ($value === '') {
            return in_array($kind, ['integer', 'decimal', 'boolean', 'date'], true) ? '0' : '';
        }

        if ($kind === 'boolean') {
            $normalized = self::normalizeLabel($value);
            $falseValues = array_map([self::class, 'normalizeLabel'], [
                '0', 'لا', 'no', 'false', 'خطأ', 'غير متوفر', 'لا يوجد', 'غير مباشر', 'وسيط', 'غير مباشر (وسيط)',
            ]);
            $trueValues = array_map([self::class, 'normalizeLabel'], [
                '1', 'نعم', 'yes', 'true', 'صح', 'متوفر', 'يوجد', 'مباشر', 'من المالك مباشر', 'x', '✓',
            ]);
            if (in_array($normalized, $falseValues, true)) {
                return '0';
            }
            if (in_array($normalized, $trueValues, true)) {
                return '1';
            }
            throw new RuntimeException('قيمة نعم/لا غير صالحة في ' . $definition['label'] . ': ' . $value);
        }
        if ($field === 'ardtype') {
            $normalized = self::normalizeLabel($value);
            $landTypes = [
                'استثماريه' => '1', 'استثماري' => '1',
                'سكنيه' => '2', 'سكني' => '2',
                'تجاريه' => '3', 'تجاري' => '3',
                'ارضخام' => '4', 'خام' => '4',
                'اخري' => '5',
            ];
            if (isset($landTypes[$normalized])) {
                return $landTypes[$normalized];
            }
            $number = self::normalizeNumber($value);
            if (in_array($number, ['1', '2', '3', '4', '5'], true)) {
                return $number;
            }
            throw new RuntimeException('نوع أرض غير صالح: ' . $value);
        }
        if ($kind === 'integer') {
            $number = self::normalizeNumber($value);
            if (!is_numeric($number)) {
                throw new RuntimeException('قيمة رقمية غير صالحة في ' . $definition['label'] . ': ' . $value);
            }
            return (string)intval(round((float)$number));
        }
        if ($kind === 'decimal') {
            $number = self::normalizeNumber($value);
            if (!is_numeric($number)) {
                throw new RuntimeException('قيمة رقمية غير صالحة في ' . $definition['label'] . ': ' . $value);
            }
            return (string)(float)$number;
        }
        if ($kind === 'date') {
            return (string)$this->normalizeDate($value, $definition['label']);
        }

        $maxLength = $this->varcharLength((string)($this->columns[$field]['Type'] ?? ''));
        if ($maxLength > 0 && mb_strlen($value, 'UTF-8') > $maxLength) {
            throw new RuntimeException('القيمة أطول من المسموح في ' . $definition['label'] . ' (الحد ' . $maxLength . ' حرفاً).');
        }
        return $value;
    }

    private function normalizeDate(string $value, string $label): int
    {
        $numeric = self::normalizeNumber($value);
        if (is_numeric($numeric)) {
            $number = (float)$numeric;
            if ($number >= 20000 && $number <= 100000) {
                return (int)round(($number - 25569) * 86400);
            }
            if ($number > 100000000) {
                return (int)$number;
            }
        }

        $value = str_replace(['.', '\\'], ['/', '/'], trim($value));
        foreach (['d/m/Y', 'd-m-Y', 'Y/m/d', 'Y-m-d', 'm/d/Y'] as $format) {
            $date = DateTime::createFromFormat('!' . $format, $value);
            $errors = DateTime::getLastErrors();
            if ($date && ($errors === false || ($errors['warning_count'] === 0 && $errors['error_count'] === 0))) {
                return $date->getTimestamp();
            }
        }
        throw new RuntimeException('تاريخ غير صالح في ' . $label . ': ' . $value);
    }

    private static function normalizeNumber(string $value): string
    {
        $value = strtr(mb_strtolower(trim($value), 'UTF-8'), [
            '٠' => '0', '١' => '1', '٢' => '2', '٣' => '3', '٤' => '4',
            '٥' => '5', '٦' => '6', '٧' => '7', '٨' => '8', '٩' => '9',
            '٫' => '.', '٬' => '', ',' => '', '−' => '-',
        ]);
        $value = preg_replace('/(?:ر\.?\s*س\.?|ريال(?:اً)?|sar)/iu', '', $value) ?? $value;
        $value = preg_replace('/[\s\x{00A0}]+/u', '', $value) ?? $value;
        if (preg_match('/^\((.+)\)$/', $value, $matches)) {
            $value = '-' . $matches[1];
        }
        return preg_match('/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$/', $value) ? $value : '';
    }

    private function prepareDuplicateStatement(bool $skipDuplicates)
    {
        $numberField = $this->config['number_field'];
        if (!$skipDuplicates || $numberField === '' || !isset($this->columns[$numberField])) {
            return null;
        }
        $sql = 'SELECT `' . $this->config['primary_key'] . '` FROM `' . $this->config['table'] . '` WHERE `' . $numberField . '`=?';
        if (isset($this->columns['mokhatatid'])) {
            $sql .= ' AND `mokhatatid`=?';
        }
        $sql .= ' LIMIT 1';
        $statement = mysqli_prepare($this->link, $sql);
        if (!$statement) {
            throw new RuntimeException('تعذر تجهيز فحص السجلات المكررة.');
        }
        return $statement;
    }

    private function isDuplicate($statement, array $record): bool
    {
        $numberField = $this->config['number_field'];
        $number = trim((string)($record[$numberField] ?? ''));
        if ($number === '') {
            return false;
        }
        $params = [$number];
        if (isset($this->columns['mokhatatid'])) {
            $params[] = (string)intval($record['mokhatatid'] ?? 0);
        }
        if (!mysqli_stmt_execute($statement, $params)) {
            throw new RuntimeException('تعذر فحص السجلات المكررة.');
        }
        mysqli_stmt_store_result($statement);
        $isDuplicate = mysqli_stmt_num_rows($statement) > 0;
        mysqli_stmt_free_result($statement);
        return $isDuplicate;
    }

    private function mappedRowHasValue(array $mapped): bool
    {
        foreach ($mapped as $value) {
            if (trim((string)$value) !== '') {
                return true;
            }
        }
        return false;
    }

    private function kindFromSqlType(string $type, string $column): string
    {
        if (preg_match('/^tinyint\(1\)/i', $type) || preg_match('/^s\d+$/', $column)) {
            return 'boolean';
        }
        if (preg_match('/^(tinyint|smallint|mediumint|int|bigint)/i', $type)) {
            return in_array($column, ['st_date', 'en_date'], true) ? 'date' : 'integer';
        }
        if (preg_match('/^(decimal|double|float)/i', $type)) {
            return 'decimal';
        }
        return 'string';
    }

    private function isNumericSqlType(string $type): bool
    {
        return (bool)preg_match('/^(tinyint|smallint|mediumint|int|bigint|decimal|double|float|bit)/i', $type);
    }

    private function varcharLength(string $type): int
    {
        return preg_match('/^(?:var)?char\((\d+)\)/i', $type, $matches) ? intval($matches[1]) : 0;
    }
}
