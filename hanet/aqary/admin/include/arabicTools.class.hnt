   		+ see licenes.txt 
   Homepage:	http://www.hnt4arab.info   
   Public methods:
   		arabicDate($format, $timestamp)  
		 - returns date/time in $format after converting $timestamp    
		dateHejri2Geo($formated_hejri)
		- returns date/time converted from Hejri to Georgian
   Updates:
   		06-05-2003 Added dateHejri2Geo function (thanks to SMS Future school Group)
		27-07-2026 Use uCal as the single Umm al-Qura conversion engine
   		
*/

if (!class_exists('ArabicTools')) {
class ArabicTools {

	private static function getUCalInstance() {
		static $calendar = null;

		if ($calendar === null) {
			if (!class_exists('uCal', false)) {
				require_once __DIR__ . '/uCal.class.hnt';
			}
			$calendar = new uCal();
		}

		return $calendar;
	}

	static function _ardInt($float) {

		if ( $float< -0.0000001)
				return ceil( $float-0.0000001);
		else
				return floor( $float+0.0000001);

 }


	static function arabicDate($format, $timestamp) {
	if($timestamp==""){$timestamp=0;}
	$format=trim($format);
	if (substr($format,0,1)=='*') {
                $use_span=true; 
		$format=substr($format,1);
        } else $use_span=false;
	$type=substr($format,0,3);

	$arDay = array("Sat"=>"السبت",
	         "Sun"=>"الأحد",
	         "Mon"=>"الإثنين",
	         "Tue"=>"الثلاثاء",
	         "Wed"=>"الأربعاء",
	         "Thu"=>"الخميس",
	         "Fri"=>"الجمعة");
	$ampm=array('am'=>'صباحا','pm'=>'مساء');

 
	list($d,$m,$y,$dayname,$monthname,$am)=explode(' ',date('d m Y D M a', $timestamp));

	if ($type=='hj:') {
		$dateo = self::getUCalInstance()->g2u(
			intval($d),
			intval($m),
			intval($y)
		);
		$d = $dateo['day'];
		$m = $dateo['month'];
		$y = $dateo['year'];
		$format=substr($format,3);

		$hjMonth = array("محرم",
		         "صفر",
		         "ربيع أول",
		          "ربيع ثاني",
		         "جماد أول",
		         "جماد ثاني",
		         "رجب",
		         "شعبان",
		         "رمضان",
		         "شوال",
		         "ذو القعدة",
		         "ذو الحجة");
		$format=str_replace('j', $d, $format);
		$format=str_replace('d', str_pad($d,2,0,STR_PAD_LEFT), $format);
		$format=str_replace('l', $arDay[$dayname], $format);
		$format=str_replace('F', $hjMonth[$m-1], $format);
		$format=str_replace('m', str_pad($m,2,0,STR_PAD_LEFT), $format);
		$format=str_replace('n', $m, $format);
		$format=str_replace('Y', $y, $format);
		$format=str_replace('y', substr($y,2), $format);
		$format=str_replace('a', substr($ampm[$am],0,1), $format);
		$format=str_replace('A', $ampm[$am], $format);
	} elseif ($type=='ar:') {
		$format=substr($format,3);
		$arMonth=array("Jan"=>"يناير",
		      "Feb"=>"فبراير",
		      "Mar"=>"مارس",
		      "Apr"=>"ابريل",
		      "May"=>"مايو",
		      "Jun"=>"يونيو",
		      "Jul"=>"يوليو",
		      "Aug"=>"اغسطس",
		      "Sep"=>"سبتمبر",
		      "Oct"=>"اكتوبر",
		      "Nov"=>"نوفمبر",
		      "Dec"=>"ديسمبر");
		$format=str_replace('l', $arDay[$dayname], $format);
		$format=str_replace('F', $arMonth[$monthname], $format);
		$format=str_replace('a', substr($ampm[$am],0,1), $format);
		$format=str_replace('A', $ampm[$am], $format);
        }
	$date = date($format, $timestamp);
	if ($use_span) return '<span dir="rtl" lang="ar-sa">'.$date.'</span>'; 
	else return $date;
  }

	static function dateHejri2Geo($hijriDate) {
		// hijriDate must be dd/mm/yyyy
		$parts = explode('/', trim($hijriDate));
		if (count($parts) !== 3) {
			throw new InvalidArgumentException(
				"Invalid Hijri date format; expected dd/mm/yyyy"
			);
		}

		list($d, $m, $y) = $parts;
		$dateo = self::getUCalInstance()->u2g(
			intval($d),
			intval($m),
			intval($y)
		);

		// Preserve the legacy return contract: d-m-Y without forced padding.
		return $dateo['day'] . "-" . $dateo['month'] . "-" . $dateo['year'];
	} 









}
}

?>
