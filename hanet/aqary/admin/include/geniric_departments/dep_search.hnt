$qry_id = isset($_REQUEST['qry_id']) ? intval($_REQUEST['qry_id']) : 0;

// Validate required parameters
if (!$dep_id || !$qry_id) {
    echo "<!DOCTYPE html><html dir='rtl'><head><meta charset='UTF-8'></head><body>";
    echo "<div class='alert alert-danger text-center mt-5'>";
    echo "<i class='bi bi-exclamation-triangle me-2'></i>";
    echo "معذرة: لم أستطع تحديد القسم أو الاستعلام المطلوب. <a href='../../index.hnt' class='alert-link'>انقر هنا للعودة</a>";
    echo "</div></body></html>";
    exit();
}

// Include authentication and database
include_once "../../../nocash.hnt";
include_once "../../../connectdb.hnt";

// Fetch department data
$sql = "SELECT * FROM departments_name WHERE dep_id = '" . intval($dep_id) . "' LIMIT 1";
