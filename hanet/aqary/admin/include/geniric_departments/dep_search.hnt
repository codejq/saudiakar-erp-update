                <i class="bi bi-info-circle me-2"></i>
                <strong>تعليمات البحث:</strong> قم بملء حقول البحث أدناه ثم اضغط على زر "بحث" لعرض النتائج المطابقة.
            </div>

            <!-- Search Form -->
            <form id="searchForm" method="post">
                <input type="hidden" name="dep_id" value="<?= intval($dep_id); ?>">
                <input type="hidden" name="qry_id" value="<?= intval($qry_id); ?>">

                <div class="row">
                    <?php
                    // Fetch all department fields into an array for quick lookup
                    $sql = "SELECT * FROM department_field WHERE dep_id = '" . intval($dep_id) . "'";
                    $result = mysql_query($sql, $link);
                    $allfielddata = array();

                    while ($field_data = mysql_fetch_array($result)) {
                        $allfielddata[$field_data['fld_en_name']] = $field_data;
                    }

                    // Fetch query field configuration
                    $sql = "SELECT * FROM dep_query_field WHERE query_id = '" . intval($qry_id) . "'";
                    $result = mysql_query($sql, $link);

                    $i = 0;
                    $sqlwhere = "\" WHERE 1=1 ";
                    $searchFields = array();

                    while ($field_data = mysql_fetch_array($result)) {
                        $row = isset($allfielddata[$field_data['sqlfildname']]) ? $allfielddata[$field_data['sqlfildname']] : null;

                        if (!$row) {
                            continue; // Skip if field configuration not found
                        }

                        // Build SQL WHERE clause for JavaScript
                        $operator = ($i == 0) ? "AND" : $field_data['sqloprator'];
                        $sqlLogic = $field_data['sqllogic'];
                        $fieldName = $field_data['sqlfildname'];

                        // Determine if we need quotes and percentage signs
                        $needsQuotes = !in_array($sqlLogic, array('<', '>', '='));
                        $percentage = ($sqlLogic == 'like') ? '%25' : '';
                        $quote = $needsQuotes ? "'" : "";

                        $sqlwhere .= " " . $operator . " " . $fieldName . " " . $sqlLogic . " ";
                        $sqlwhere .= $quote . $percentage . "\"+document.getElementById('search_field_" . $i . "').value+\"" . $percentage . $quote;

                        // Store field info for rendering
                        $searchFields[] = array(
                            'index' => $i,
                            'field_data' => $field_data,
                            'row' => $row
                        );

                        $i++;
                    }

                    $sqlwhere .= "\"";
                    $sqlwhere = str_replace("\r", "", $sqlwhere);
                    $sqlwhere = str_replace("\n", "", $sqlwhere);

                    // Render search fields
                    foreach ($searchFields as $fieldInfo) {
                        $idx = $fieldInfo['index'];
                        $field_data = $fieldInfo['field_data'];
                        $row = $fieldInfo['row'];

                        echo '<div class="col-md-6">';
                        echo '<div class="search-field-group">';
                        echo '<label class="search-field-label" for="search_field_' . $idx . '">';
                        echo '<i class="bi bi-funnel me-1"></i>';
                        echo htmlspecialchars($field_data['sqlfild_ar_name'], ENT_QUOTES, 'UTF-8');
                        echo '</label>';

                        switch ($row['fld_type']) {
                            case 3: // Select dropdown
                            case 4: // Radio (rendered as select for better UX)
                                $field_allvalues = explode("\r\n", $row['fld_values']);
                                echo '<select name="' . htmlspecialchars($row['fld_en_name'], ENT_QUOTES, 'UTF-8') . '" ';
                                echo 'id="search_field_' . $idx . '" class="form-select search-field-select">';

                                // Add empty option for optional search
                                echo '<option value="">-- اختر ' . htmlspecialchars($field_data['sqlfild_ar_name'], ENT_QUOTES, 'UTF-8') . ' --</option>';

                                $currentValue = isset($field_data['datavalue']) ? $field_data['datavalue'] : '';
                                foreach ($field_allvalues as $value) {
                                    $value = trim($value);
                                    if (empty($value)) continue;

                                    $selected = ($currentValue == $value) ? ' selected' : '';
                                    echo '<option value="' . htmlspecialchars($value, ENT_QUOTES, 'UTF-8') . '"' . $selected . '>';
                                    echo htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
                                    echo '</option>';
                                }
                                echo '</select>';
                                break;

                            default: // Text input (cases 0, 1, 2, 5, 6, 7)
                                $currentValue = isset($field_data['datavalue']) ? $field_data['datavalue'] : '';
                                $placeholder = isset($field_data['fld_values']) ? $field_data['fld_values'] : '';

                                echo '<input type="text" ';
                                echo 'name="' . htmlspecialchars($field_data['sqlfildname'], ENT_QUOTES, 'UTF-8') . '" ';
                                echo 'id="search_field_' . $idx . '" ';
                                echo 'class="form-control search-field-input" ';
                                echo 'value="' . htmlspecialchars($currentValue, ENT_QUOTES, 'UTF-8') . '" ';

                                if (!empty($placeholder)) {
                                    echo 'placeholder="' . htmlspecialchars($placeholder, ENT_QUOTES, 'UTF-8') . '" ';
                                }

                                echo '>';
                                break;
                        }

                        echo '</div>'; // search-field-group
                        echo '</div>'; // col-md-6
                    }
                    ?>
                </div>

                <!-- Search Buttons -->
                <div class="search-button-container">
                    <button type="button" class="btn btn-search-primary" onclick="buildAndSearch();">
                        <i class="bi bi-search me-2"></i>
                        بحث
                    </button>
                    <button type="button" class="btn btn-search-reset" onclick="resetSearchForm();">
                        <i class="bi bi-x-circle me-2"></i>
                        إعادة تعيين
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
/**
 * Build SQL WHERE clause and redirect to results page
 * Preserves the search logic from the original implementation
 */
function buildAndSearch() {
    // Build SQL WHERE clause

    // Validate that at least one field has a value
    var hasValue = false;
    var form = document.getElementById('searchForm');
    var inputs = form.querySelectorAll('input[type="text"], select');

    for (var i = 0; i < inputs.length; i++) {
        if (inputs[i].value && inputs[i].value.trim() !== '' && inputs[i].id.startsWith('search_field_')) {
            hasValue = true;
            break;
        }
    }

    if (!hasValue) {
        showBootstrapNotification('يرجى ملء حقل واحد على الأقل للبحث', 'warning', 3000);
        return;
    }

    // The saved search and the typed values only; the page builds the filter itself.
    var params = new URLSearchParams();
    params.set('dep_id', '<?= intval($dep_id); ?>');
    params.set('qry_id', '<?= intval($qry_id); ?>');
    for (var k = 0; k < <?= count($searchFields) ?>; k++) {
        var box = document.getElementById('search_field_' + k);
        params.set('q[' + k + ']', box ? box.value.trim() : '');
    }
    window.location.href = "dep_showwall.hnt?" + params.toString();
}

/**
 * Reset the search form to initial state
 */
function resetSearchForm() {
    var form = document.getElementById('searchForm');
    var inputs = form.querySelectorAll('input[type="text"]');
    var selects = form.querySelectorAll('select');

    // Clear all text inputs
    for (var i = 0; i < inputs.length; i++) {
        if (inputs[i].id.startsWith('search_field_')) {
            inputs[i].value = '';
        }
    }

    // Reset all selects to first option
    for (var i = 0; i < selects.length; i++) {
        if (selects[i].id.startsWith('search_field_')) {
            selects[i].selectedIndex = 0;
        }
    }

    showBootstrapNotification('تم إعادة تعيين حقول البحث', 'info', 2000);
}

/**
 * Handle Enter key press in text fields
 */
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('searchForm');
    var inputs = form.querySelectorAll('input[type="text"]');

    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener('keypress', function(e) {
            if (e.key === 'Enter' || e.keyCode === 13) {
                e.preventDefault();
                buildAndSearch();
            }
        });
    }
});

/**
 * Bootstrap notification function (should be in header.hnt, but included here for safety)
 */
if (typeof showBootstrapNotification !== 'function') {
    function showBootstrapNotification(message, type, duration) {
        // Fallback to alert if Bootstrap notification not available
        alert(message);
    }
}
</script>

