$dep_data = mysql_fetch_array($result);

if (!$dep_data) {
    echo "<!DOCTYPE html><html dir='rtl'><head><meta charset='UTF-8'></head><body>";
    echo "<div class='alert alert-danger text-center mt-5'>";
    echo "<i class='bi bi-exclamation-triangle me-2'></i>";
    echo "القسم المطلوب غير موجود. <a href='../../index.hnt' class='alert-link'>انقر هنا للعودة</a>";
    echo "</div></body></html>";
    exit();
}

// Fetch query configuration
$sql = "SELECT * FROM department_query WHERE qry_id = '" . intval($qry_id) . "' LIMIT 1";
$result = mysql_query($sql, $link);
$dep_search = mysql_fetch_array($result);

if (!$dep_search) {
    echo "<!DOCTYPE html><html dir='rtl'><head><meta charset='UTF-8'></head><body>";
    echo "<div class='alert alert-danger text-center mt-5'>";
    echo "<i class='bi bi-exclamation-triangle me-2'></i>";
    echo "الاستعلام المطلوب غير موجود. <a href='../../index.hnt' class='alert-link'>انقر هنا للعودة</a>";
    echo "</div></body></html>";
    exit();
}

// Set page title variables
