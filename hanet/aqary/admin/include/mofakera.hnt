            <div class="reminder-table">
                <table class="table table-hover mb-0" id="remindersTable" data-aqary-bulk data-resource="message" data-screen="71">
                    <thead>
                        <tr>
                            <th class="text-center screenonly" style="width:45px">
                                <input type="checkbox" class="form-check-input aqary-select-all" aria-label="تحديد كل التذكيرات الظاهرة">
                            </th>
                            <th width="40%">الرسالة</th>
                            <th class="text-center">الساعة</th>
                            <th class="text-center">بداية التذكير</th>
                            <th class="text-center">نهاية التذكير</th>
