/**
 * The catalog filtered to what the signed-in user may see.
 *
 * @return array<string, array{ar: string, en: string, url: string, perm: string, k: string}>
 */
function aqaryAssistantScreensFor($link): array
{
    $screens = array();
    foreach (aqaryAssistantCatalog() as $key => $row) {
        if (aqaryScreenCan($link, $row[3], 'sees')) {
            $screens[$key] = array('ar' => $row[0], 'en' => $row[1], 'url' => $row[2], 'perm' => $row[3], 'k' => $row[4]);
        }
    }
    return $screens;
}
