/**
 * Screens the assistant may open or suggest. Each entry is checked against the user's own
 * screen permissions (lib/screen_permissions.hnt), so the model only ever sees, and the user
 * only ever gets links to, screens the user may open.
 *
 * key => [Arabic title, English title, URL, permission screen (legacy ID or key), keywords]
 */

