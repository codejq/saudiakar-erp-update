<?php
/**
 * AI assistant: property requests (request.hnt) and the land / building / villa offers
 * (arady.hnt, emara.hnt, vila.hnt): search, add and edit.
 *
 * Search answers come from the company's data. Add / edit come back as a draft card the user
 * checks and confirms; confirm() then saves through the same columns the screens use, with the
 * same screen permissions. Owner and broker details are hidden from users the screens hide them from.
 */

require_once dirname(__DIR__, 2) . '/include/request_match.hnt';

final class AqaryAssistantListings
{
    public const STATUS = array('' => 'متاح', '1' => 'محجوز', '2' => 'مباع', '4' => 'مؤرشف');
    private const STATUS_WORDS = array('available' => '', 'reserved' => '1', 'sold' => '2', 'archived' => '4');
    private const DIRECT = array('1' => 'من المالك مباشرة', '0' => 'عن طريق وسيط');

    private $link;
    private $userId;
    private $fullAccess = null;

    public function __construct(mysqli $link, int $userId)
    {
        $this->link = $link;
        $this->userId = $userId;
    }

