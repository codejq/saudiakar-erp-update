<?php
/**
 * AI Integration Module - Main Dashboard
 * نظام الذكاء الاصطناعي
 *
 * @charset UTF-8
 * @version 2.0
 */

$sc_title = "الذكاء الاصطناعي - AI Integration";
$sc_id = "300";
include_once "../../nocash.hnt";

$canscroll = 0;
$showdhmltazkeer = 0;
include_once "../../header.hnt";

// Include database connection
require_once('../../connectdb.hnt');

// Load configuration
$config_data = require('config/api_config.hnt');
$ai_config = $config_data['config'];
$features = $ai_config['features'];

// Check if setup is needed
$setup_needed = false;
if (empty($ai_config['deepseek_api_key']) && empty($ai_config['api_key'])) {
    $setup_needed = true;
}

// Check if tables exist
$tables_exist = true;
$required_tables = ['ai_usage_log', 'ai_cache', 'ai_generated_content'];
foreach ($required_tables as $table) {
    $check_sql = "SHOW TABLES LIKE '" . mysqli_real_escape_string($link, $table) . "'";
    $result = mysqli_query($link, $check_sql);
    if (!$result || mysqli_num_rows($result) == 0) {
        $tables_exist = false;
    }
}

// Get quick stats if tables exist
$total_requests = 0;
$total_cost = 0;
$monthly_requests = 0;
if ($tables_exist) {
    // Today's stats
    $stats_sql = "SELECT COUNT(*) as requests, SUM(cost) as cost
                  FROM ai_usage_log
                  WHERE DATE(created_date) = CURDATE()";
    $stmt = mysqli_prepare($link, $stats_sql);
    if ($stmt) {
        mysqli_stmt_execute($stmt);
        $result = mysqli_stmt_get_result($stmt);
        if ($result) {
            $stats = mysqli_fetch_assoc($result);
            $total_requests = $stats['requests'] ?? 0;
            $total_cost = $stats['cost'] ?? 0;
        }
        mysqli_stmt_close($stmt);
    }

    // Monthly stats
    $monthly_sql = "SELECT COUNT(*) as requests FROM ai_usage_log WHERE MONTH(created_date) = MONTH(CURDATE())";
    $stmt = mysqli_prepare($link, $monthly_sql);
    if ($stmt) {
        mysqli_stmt_execute($stmt);
        $result = mysqli_stmt_get_result($stmt);
        if ($result) {
            $stats = mysqli_fetch_assoc($result);
            $monthly_requests = $stats['requests'] ?? 0;
        }
        mysqli_stmt_close($stmt);
    }
}

$is_admin = ($_SESSION['userforv'] == 'admin');
?>

