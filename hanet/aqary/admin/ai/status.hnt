        <!-- Budget Usage -->
        <div class="status-card">
            <h5 class="mb-3">💰 استخدام الميزانية</h5>

            <div class="mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span><strong>الميزانية اليومية:</strong></span>
