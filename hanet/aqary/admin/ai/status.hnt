 */

$sc_title = "لوحة معلومات الذكاء الاصطناعي";
$sc_id = "301";
include_once "../../nocash.hnt";

$canscroll = 0;
$showdhmltazkeer = 0;
include_once "../../header.hnt";

// Include database connection and libraries
require_once('../../connectdb.hnt');
require_once('lib/OpenRouterAPI.class.php');



// Load configuration
$config_data = require('config/api_config.hnt');
$ai_config = $config_data['config'];
$ai_models = $config_data['models'];

// Check if tables exist
$tables_status = [];
$required_tables = ['ai_usage_log', 'ai_cache', 'ai_generated_content'];

foreach ($required_tables as $table) {
    $check_sql = "SHOW TABLES LIKE ?";
    $stmt = mysqli_prepare($link, $check_sql);
    if ($stmt) {
        mysqli_stmt_bind_param($stmt, 's', $table);
        mysqli_stmt_execute($stmt);
        $result = mysqli_stmt_get_result($stmt);
        $tables_status[$table] = ($result && mysqli_num_rows($result) > 0);
        mysqli_stmt_close($stmt);
    } else {
        $tables_status[$table] = false;
    }
}

// Get today's usage stats
$today_sql = "SELECT
              COUNT(*) as total_requests,
              SUM(total_tokens) as total_tokens,
              SUM(cost) as total_cost,
              AVG(response_time) as avg_response_time
              FROM ai_usage_log
              WHERE DATE(created_date) = CURDATE()";
$stmt = mysqli_prepare($link, $today_sql);
if ($stmt) {
    mysqli_stmt_execute($stmt);
    $result = mysqli_stmt_get_result($stmt);
    $today_stats = mysqli_fetch_assoc($result);
    if (!$today_stats['total_requests']) {
        $today_stats = [
            'total_requests' => 0,
            'total_tokens' => 0,
            'total_cost' => 0,
            'avg_response_time' => 0
        ];
    }
    mysqli_stmt_close($stmt);
} else {
    $today_stats = [
        'total_requests' => 0,
        'total_tokens' => 0,
        'total_cost' => 0,
        'avg_response_time' => 0
    ];
}

// Get monthly usage stats
$month_sql = "SELECT
              COUNT(*) as total_requests,
              SUM(total_tokens) as total_tokens,
              SUM(cost) as total_cost
              FROM ai_usage_log
              WHERE MONTH(created_date) = MONTH(CURDATE())
              AND YEAR(created_date) = YEAR(CURDATE())";
$stmt = mysqli_prepare($link, $month_sql);
if ($stmt) {
    mysqli_stmt_execute($stmt);
    $result = mysqli_stmt_get_result($stmt);
    $month_stats = mysqli_fetch_assoc($result);
    if (!$month_stats['total_requests']) {
        $month_stats = [
            'total_requests' => 0,
            'total_tokens' => 0,
            'total_cost' => 0
        ];
    }
    mysqli_stmt_close($stmt);
} else {
    $month_stats = [
        'total_requests' => 0,
        'total_tokens' => 0,
        'total_cost' => 0
    ];
}

// Get cache stats
$cache_sql = "SELECT
              COUNT(*) as total_cached,
              SUM(hit_count) as total_hits,
              COUNT(CASE WHEN expires_at > NOW() THEN 1 END) as active_cached
              FROM ai_cache";
$stmt = mysqli_prepare($link, $cache_sql);
if ($stmt) {
    mysqli_stmt_execute($stmt);
    $result = mysqli_stmt_get_result($stmt);
    $cache_stats = mysqli_fetch_assoc($result);
    mysqli_stmt_close($stmt);
} else {
    $cache_stats = [
        'total_cached' => 0,
        'total_hits' => 0,
        'active_cached' => 0
    ];
}

// Get top features
$features_sql = "SELECT feature, COUNT(*) as count, SUM(cost) as cost
                FROM ai_usage_log
                WHERE DATE(created_date) = CURDATE()
                GROUP BY feature
                ORDER BY count DESC
                LIMIT 5";
$stmt = mysqli_prepare($link, $features_sql);
$top_features = [];
if ($stmt) {
    mysqli_stmt_execute($stmt);
    $result = mysqli_stmt_get_result($stmt);
    while ($row = mysqli_fetch_assoc($result)) {
        $top_features[] = $row;
    }
    mysqli_stmt_close($stmt);
}

// Calculate budget percentages
$daily_budget_used = ($today_stats['total_cost'] / $ai_config['daily_budget']) * 100;
$monthly_budget_used = ($month_stats['total_cost'] / $ai_config['monthly_budget']) * 100;

// System health checks
$health_checks = [
    'api_key_configured' => !empty($ai_config['deepseek_api_key']) || !empty($ai_config['api_key']),
    'tables_installed' => !in_array(false, $tables_status),
    'curl_enabled' => function_exists('curl_init'),
    'cache_working' => $tables_status['ai_cache'] ?? false,
    'logging_working' => $tables_status['ai_usage_log'] ?? false
];

$system_healthy = !in_array(false, $health_checks);
?>
