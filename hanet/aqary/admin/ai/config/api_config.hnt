    ],

    // High Quality
    'gpt-4-turbo' => [
        'id' => 'openai/gpt-4-turbo-preview',
        'name' => 'GPT-4 Turbo',
        'context_length' => 128000,
        'cost_per_1k_input' => 0.01,
        'cost_per_1k_output' => 0.03,
        'use_for' => ['analysis', 'reports', 'valuation']
    ],

    // Alternative: Claude 3
    'claude-3-sonnet' => [
        'id' => 'anthropic/claude-3-sonnet',
        'name' => 'Claude 3 Sonnet',
        'context_length' => 200000,
        'cost_per_1k_input' => 0.003,
        'cost_per_1k_output' => 0.015,
        'use_for' => ['analysis', 'long_documents']
    ],

    // Budget Option
    'gpt-3.5-turbo-0125' => [
        'id' => 'openai/gpt-3.5-turbo-0125',
        'name' => 'GPT-3.5 Turbo (Latest)',
        'context_length' => 16385,
        'cost_per_1k_input' => 0.0005,
        'cost_per_1k_output' => 0.0015,
        'use_for' => ['chatbot', 'quick_tasks']
    ]
];

// Error Messages (Arabic)
$ai_errors = [
    'api_key_missing' => 'مفتاح API مفقود. الرجاء تكوين المفتاح في ملف الإعدادات.',
    'rate_limit_exceeded' => 'تم تجاوز الحد المسموح من الطلبات. الرجاء المحاولة لاحقاً.',
    'budget_exceeded' => 'تم تجاوز الميزانية اليومية/الشهرية.',
    'network_error' => 'خطأ في الاتصال بخادم الذكاء الاصطناعي.',
    'invalid_response' => 'استجابة غير صالحة من API.',
    'model_not_found' => 'النموذج المطلوب غير متاح.',
    'timeout' => 'انتهت مهلة الطلب. الرجاء المحاولة مرة أخرى.',
    'content_filtered' => 'تم تصفية المحتوى بسبب سياسات الأمان.',
];

return [
    'config' => $ai_config,
    'models' => $ai_models,
    'errors' => $ai_errors
];
?>
