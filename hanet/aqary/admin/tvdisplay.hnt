<script>
function deleteDisplay(id, name) {
    if (!confirm('هل أنت متأكد من حذف شاشة العرض: ' + name + '؟\n\nسيتم حذف جميع الشرائح المرتبطة بها.')) {
        return;
    }

    window.location.href = 'tvdisplay_editor.hnt?action=delete&id=' + id;
}

// Opens the TV player in its own window covering the screen; the player then goes full screen on the first click.
function openTvPlayer(url) {
    const features = 'popup=yes,left=0,top=0,width=' + screen.availWidth + ',height=' + screen.availHeight;
    const win = window.open(url, 'tvplayer', features);
    if (!win) return true;   // popup blocked: follow the link in a new tab instead
    win.focus();
    return false;
}
</script>

