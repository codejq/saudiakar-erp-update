<?php
// Set page variables
$sc_title = "السندات الحرة";
$sc_id = "135";

// Include authentication and headers
include_once "../../nocash.hnt";
include_once "../../header.hnt";

// Include SQL configuration
require "sql.hnt";
require_once __DIR__ . '/../include/amlak/receipt_commission_helpers.hnt';
date_default_timezone_set('Asia/Riyadh');
$voucherStats = array('receipts'=>0,'gross'=>0,'commission'=>0,'system_receipts'=>0);
try {
    $voucherScope = receiptCommissionScope($link);
    $voucherStats = receiptCommissionRows($link,"SELECT COUNT(*) receipts,COALESCE(SUM(s.depositeamount),0) gross,
        COALESCE(SUM(s.sales_commission_amount),0) commission,
        COALESCE(SUM(s.sales_representative_userid=0),0) system_receipts FROM sanad s
        WHERE s.sanaddate>=? AND s.sanaddate<? AND {$voucherScope}",
        array(strtotime(date('Y-m-01')),strtotime(date('Y-m-01').' +1 month')))[0];
} catch (Throwable $voucherStatsError) { error_log('Voucher hub: '.$voucherStatsError->getMessage()); }
?>

