<script>
function updatecode() {
    $('#pincodeval').val($('#pincode').val());
}
</script>

<?php
// Build WHERE clause for search
$where = "";
if ($search) {
    $where = " WHERE
        id LIKE '%" . addslashes($search) . "%' OR
        ryial LIKE '%" . addslashes($search) . "%' OR
        halala LIKE '%" . addslashes($search) . "%' OR
        sanaddate LIKE '%" . addslashes($search) . "%' OR
        receivedfrom LIKE '%" . addslashes($search) . "%' OR
        chekorcash LIKE '%" . addslashes($search) . "%' OR
        checknumber LIKE '%" . addslashes($search) . "%' OR
        bankname LIKE '%" . addslashes($search) . "%' OR
        checknumberen LIKE '%" . addslashes($search) . "%' OR
        banknameen LIKE '%" . addslashes($search) . "%' OR
        thrsumof LIKE '%" . addslashes($search) . "%' OR
        dueto LIKE '%" . addslashes($search) . "%' OR
        fmanger LIKE '%" . addslashes($search) . "%' OR
        accountant LIKE '%" . addslashes($search) . "%' OR
        casher LIKE '%" . addslashes($search) . "%' OR
        receivedby LIKE '%" . addslashes($search) . "%' ";
}

// Pagination
if ($voucherExpenseLinksReady && $voucherCategory>=0) {
    $searchCondition=trim($where);
    $where=$searchCondition!=='' ? ' WHERE ('.preg_replace('/^WHERE\s+/i','',$searchCondition).') AND idmasrofcod='.intval($voucherCategory) : ' WHERE idmasrofcod='.intval($voucherCategory);
}
$sql = "SELECT COUNT(id) as dd FROM $table $where";
$rownum = mysql_fetch_array(mysql_query($sql, $link));
$rownum = $rownum['dd'];
$rowperpage = isset($rowperpage) ? intval($rowperpage) : 100;
$pagenum = ceil($rownum / $rowperpage);

// Display pagination
echo '<div class="alert alert-info mb-3">';
echo '<i class="bi bi-info-circle me-2"></i>';
echo 'عدد السندات: <strong>' . $rownum . '</strong> سند';
echo '</div>';

if ($pagenum > 1) {
    echo '<nav aria-label="Page navigation"><ul class="pagination justify-content-center">';
    $serchquerystring = "&search=" . urlencode($search) . "&paymentvou=" . $paymentvou . '&idmasrofcod=' . $voucherCategory;

    for ($xi = 1; $xi <= $pagenum; $xi++) {
        $active = ($page == $xi) ? 'active' : '';
        if (($xi > ($page - 4) && $xi < ($page + 4)) || $xi == 1 || $xi == $pagenum || $xi < 4 || $xi > ($pagenum - 4)) {
            echo '<li class="page-item ' . $active . '"><a class="page-link" href="allsanad.hnt?page=' . $xi . $serchquerystring . '">' . $xi . '</a></li>';
        } elseif ($xi == ($page - 4) || $xi == ($page + 4)) {
            echo '<li class="page-item disabled"><span class="page-link">...</span></li>';
        }
    }
    echo '</ul></nav>';
}

// Calculate limit
$limit = ($page - 1) * $rowperpage;
$limit = $limit . "," . $rowperpage;
if ($page == 1 || $page == '') {
    $limit = $rowperpage;
}

// Get vouchers
$voucherExtraColumns=$voucherExpenseLinksReady ? ",expense_id,idmasrofcod,COALESCE((SELECT c.masrofkind FROM masrofattakweed c WHERE c.idmasrofcod=payment_voucher.idmasrofcod LIMIT 1),'غير مصنف') category_name" : '';
$sql = "SELECT id, ryial, halala, sanaddate, receivedfrom, thrsumof, dueto {$voucherExtraColumns} FROM $table $where ORDER BY id DESC LIMIT $limit";
$result = mysql_query($sql, $link);
?>

            <!-- Vouchers Table -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="bi bi-hash me-1"></i>رقم السند</th>
                                    <th>جزء</th>
                                    <th><i class="bi bi-currency-exchange me-1"></i><?= isset($myomla) ? $myomla : 'ريال' ?></th>
                                    <th><i class="bi bi-calendar me-1"></i>التاريخ</th>
                                    <th><i class="bi bi-person me-1"></i>الاسم</th>
