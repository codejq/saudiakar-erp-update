<?php
/**
 * All Vouchers - View and Manage Vouchers
 * Modern refactored version
 */

// Extract POST variables
extract($_REQUEST);

// Initialize variables
$paymentvou = isset($paymentvou) ? intval($paymentvou) : 0;
$search = isset($search) ? trim($search) : '';
$page = isset($page) ? intval($page) : 1;
$deletevou = isset($deletevou) ? intval($deletevou) : 0;
$pincodeval = isset($pincodeval) ? trim($pincodeval) : '';

// Set page variables
if ($paymentvou == 1) {
    $sc_title = "سندات الصرف";
    $sc_id = "135";
    $table = "payment_voucher";
} else {
    $sc_title = "سندات القبض";
    $sc_id = "135";
    $table = "recive_voucher";
}

include_once "../../nocash.hnt";
include_once "../../header.hnt";
require_once __DIR__ . '/../include/amlak/expense_payment_voucher_helpers.hnt';
$paymentvou=intval($_REQUEST['paymentvou'] ?? 0);
$table=$paymentvou===1 ? 'payment_voucher' : 'recive_voucher';
$voucherExpenseLinksReady=$paymentvou===1 && expensePaymentVoucherReady($link);
$voucherCategories=$paymentvou===1 ? expensePaymentVoucherCategories($link) : array();
$voucherCategory=max(-1,intval($_GET['idmasrofcod'] ?? -1));

// Load global variables
$result = mysql_query("SELECT * FROM global", $link);
if ($result) {
    while ($gl = mysql_fetch_array($result)) {
        if (isset($gl['variblename']) && isset($gl['valuribalevalue'])) {
            $GLOBALS[$gl['variblename']] = $gl['valuribalevalue'];
        }
    }
}

// Set defaults
if (!isset($sharwidth) || !$sharwidth) {
    $sharwidth = "99";
    $sharheight = "89";
}

if (!isset($passcode) || !$passcode) {
    $passcode = "2255";
}

require "../../hjerymelady.ip";

// Handle delete
if ($deletevou) {
    $linkedExpense=$voucherExpenseLinksReady ? receiptCommissionRows($link,'SELECT expense_id FROM payment_voucher WHERE id=? AND expense_id IS NOT NULL',array(intval($deletevou))) : array();
    if ($linkedExpense) {
        echo '<div class="alert alert-warning">هذا السند مرتبط بمصروف مكتب؛ لا يمكن حذفه منفرداً.</div>';
    } else {
    $sql = "SELECT id, ryial, halala, sanaddate, receivedfrom, thrsumof, dueto FROM $table WHERE id='" . intval($deletevou) . "'";
    $row = mysql_fetch_array(mysql_query($sql, $link));
    if ($row['id']) {
        loginfo("critical", "delete", "تم حذف السند الحر رقم: {$row['id']}
        <br>البيان: {$row['thrsumof']} {$row['receivedfrom']}
        <br>المبلغ: {$row['ryial']} {$row['halala']}
        <br>التاريخ: {$row['dueto']}
        <br>المستخدم: " . $_SESSION['usernamev'], "", $table, $row['id'], $link);
    }
    mysql_query("DELETE FROM $table WHERE id='" . intval($deletevou) . "'", $link);
    echo "<script>showBootstrapNotification('تم حذف السند بنجاح', 'success', 3000);</script>";
    }
}
?>

<!-- Main Content -->
<div class="container-fluid mt-4">
