                                بحث في السندات
                            </label>
                            <input type="text" class="form-control" name="search" id="search"
                                   value="<?= htmlspecialchars($search) ?>"
                                   placeholder="ابحث برقم السند، الاسم، المبلغ، التاريخ...">
                        </div>

                        <?php if ($voucherExpenseLinksReady) { ?><div class="col-md-3"><label class="form-label" for="idmasrofcod">تصنيف المصروف</label><select class="form-select" name="idmasrofcod" id="idmasrofcod"><option value="-1">جميع التصنيفات</option><option value="0" <?= $voucherCategory===0 ? 'selected' : '' ?>>سندات قديمة غير مصنفة</option><?php foreach ($voucherCategories as $voucherCategoryRow) { ?><option value="<?= intval($voucherCategoryRow['idmasrofcod']) ?>" <?= $voucherCategory===intval($voucherCategoryRow['idmasrofcod']) ? 'selected' : '' ?>><?= receiptCommissionEsc($voucherCategoryRow['masrofkind']) ?></option><?php } ?></select></div><?php } ?>
                        <div class="<?= $voucherExpenseLinksReady ? 'col-md-3' : 'col-md-6' ?> d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-1"></i>
                                بحث
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="document.getElementById('search').value=''; if(this.form.elements.idmasrofcod) $(this.form.elements.idmasrofcod).val('-1').trigger('change'); this.form.submit();">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                عرض الكل
                            </button>
                            <button type="button" class="btn btn-warning" onclick="window.location.href='voucherhome.hnt';">
                                <i class="bi bi-arrow-left me-1"></i>
                                عودة
                            </button>
