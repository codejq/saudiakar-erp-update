                                    <th><i class="bi bi-file-text me-1"></i>البيان</th>
                                    <th>المبلغ حروف</th>
                                    <th class="text-center">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
<?php
while ($row = mysql_fetch_array($result)) {
?>
                                <tr>
                                    <td><strong><?= htmlspecialchars($row['id']) ?></strong></td>
                                    <td><?= htmlspecialchars($row['halala']) ?></td>
                                    <td><?= htmlspecialchars($row['ryial']) ?></td>
                                    <td><?= htmlspecialchars($row['sanaddate']) ?></td>
                                    <td><?= htmlspecialchars($row['receivedfrom']) ?></td>
                                    <?php if ($voucherExpenseLinksReady) { ?><td><?= receiptCommissionEsc($row['category_name']) ?><?php if (!empty($row['expense_id'])) { ?><small class="d-block text-muted">مصروف #<?= intval($row['expense_id']) ?></small><?php } ?></td><?php } ?>
                                    <td><?= htmlspecialchars($row['dueto']) ?></td>
                                    <td><?= htmlspecialchars($row['thrsumof']) ?></td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-primary"
                                                    onclick="window.location.href='../../admin/include/amlak/selectprintform.hnt?formtype=recivevoucher&id=<?= $row['id'] ?>&paymentvou=<?= $paymentvou ?>&voucer_type=free';"
                                                    title="طباعة">
                                                <i class="bi bi-printer"></i>
                                            </button>
                                            <button type="button" class="btn btn-info"
                                                    onclick="openvbs('<?= isset($server) ? $server : '' ?>/aqary/admin/hnt-office/read_word_voucher.hnt?id=<?= $row['id'] ?>&paymentvou=<?= $paymentvou ?>');"
                                                    title="وورد">
                                                <i class="bi bi-file-word"></i>
                                            </button>
                                            <?php if (empty($row['expense_id'])) { ?><button type="button" class="btn btn-danger <?= "policy_" . $sc_id . "_deleetes" ?>"
                                                    onclick="confirm('ادخل كلمة المرور الخاصة بالحذف <br> <input type=password name=pincode id=pincode onkeyup=\'updatecode();\'>', 'صلاحية الحذف', function() {
                                                        if($('#pincodeval').val() !='<?= $passcode ?>') {
                                                            alert('كود خاطئ');
                                                            return;
                                                        }
                                                        window.location.href ='allsanad.hnt?paymentvou=<?= $paymentvou ?>&deletevou=<?= $row['id'] ?>';
                                                    });"
                                                    title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button><?php } ?>
                                        </div>
                                    </td>
                                </tr>
<?php
}
?>
                            </tbody>
                        </table>
