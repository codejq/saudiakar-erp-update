<?php
/** Compatibility redirect only. Each destination runs its own report query. */
require_once __DIR__ . '/voucher_report_routes.hnt';
$routes=voucherReportRoutes();
$key=isset($_GET['view']) && is_string($_GET['view']) && isset($routes[$_GET['view']]) ? $_GET['view'] : 'receipts';
$query=$_GET;
unset($query['view']);
$target=$routes[$key]['file'];
if ($query) $target.='?'.http_build_query($query);
header('Location: '.$target,true,302);
exit;