        <?php foreach ($rows as $r) { ?><tr><td><?= receiptCommissionEsc($view==='method' ? ($methods[intval($r['label'])] ?? 'أخرى') : $r['label']) ?><?php if ($view==='representatives' && intval($r['representative_userid'])>0) { ?> <a class="btn btn-sm btn-outline-secondary voucher-screen" href="representative_statement.hnt?<?= receiptCommissionEsc(http_build_query(array('representative'=>intval($r['representative_userid']),'from'=>$startValue,'to'=>$endValue))) ?>">كشف الحساب والصرف</a><?php } ?></td><td><?= intval($r['receipts']) ?></td><td><?= number_format($r['gross'],2) ?></td><td><?= number_format($r['commission'],2) ?></td><td><?= number_format($r['paid'],2) ?></td><td><?= number_format($r['outstanding'],2) ?></td></tr><?php } ?>
