    'posting'=>'الترحيل','settlement'=>'التسوية','rule'=>'نوع العمولة','vat'=>'الضريبة','keyword'=>'البحث','receiver'=>'المحصل','min'=>'المبلغ من','max'=>'المبلغ إلى');
