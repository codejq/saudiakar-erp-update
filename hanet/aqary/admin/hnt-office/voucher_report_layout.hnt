.voucher-report-table th{white-space:nowrap;background:#f1f3f5}.voucher-report-table td{vertical-align:middle}
/* Printed report: plain black on white with single borders. */
.voucher-print .voucher-report-title{background:none;color:#000;border-radius:0;padding:0 0 2mm;border-bottom:2px solid #000;text-align:center;display:block!important}
.voucher-print .voucher-report-title h3{font-size:20px;font-weight:bold;margin:0 0 1mm}
.voucher-print .card.voucher-report-kpi{border:1px solid #555!important;border-radius:0}
/* report_header.hnt does not load Bootstrap: the totals sit in one row of boxes. */
.voucher-print .row{display:flex;flex-wrap:wrap;gap:2mm;margin:0 0 4mm}.voucher-print .row>div{flex:1 1 15%;min-width:28mm}
.voucher-print .voucher-report-kpi .card-body{padding:1.5mm 2mm;text-align:center}.voucher-print .fs-5{font-size:15px}.voucher-print .fw-bold{font-weight:bold}
.voucher-print .voucher-report-table table{width:100%}.voucher-print .voucher-report-table th,.voucher-print .voucher-report-table td{padding:1.5mm;text-align:center}
.voucher-print .card{border:0!important;box-shadow:none!important}
.voucher-print .card-header{background:none!important;border:0;padding:2mm 0}
.voucher-print .voucher-report-table table{border-collapse:collapse;border:1px solid #555}
.voucher-print .voucher-report-table th,.voucher-print .voucher-report-table td{border:1px solid #555!important;background:#fff!important;color:#000;box-shadow:none!important}
.voucher-print .voucher-report-table th{background:#f0f0f0!important}
@media print{.voucher-screen{display:none!important}.voucher-report-table td,.voucher-report-table th{font-size:10px!important;padding:4px!important}.card{box-shadow:none!important}
    .voucher-report-table thead{display:table-header-group}.voucher-report-table tr{break-inside:avoid;page-break-inside:avoid}
    .voucher-report-table th{-webkit-print-color-adjust:exact;print-color-adjust:exact}.table-responsive{overflow:visible!important}}
