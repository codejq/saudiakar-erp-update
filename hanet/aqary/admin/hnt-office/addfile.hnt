<?
include_once "../../reqlogin.hnt";
include_once "../../connectdb.hnt";

$thefolder=(string)($_REQUEST['thefolder'] ?? '');
$upload=$_FILES['file'] ?? null;
if(is_array($upload) && ($upload['error'] ?? 1)===UPLOAD_ERR_OK)
{
$thefolderx=base64_encode($thefolder);
$file_name=basename(str_replace("\\","/",(string)$upload['name']));
$file_name2=urlencode($file_name);
// Apache reads every extension in a name, so all of them are checked.
$blocked=preg_match('/(^\.|\.(php\d*|phtml|phar|pht|hnt|inc|cgi|pl|py|asp|aspx|jsp|exe|bat|cmd|vbs|htaccess)(\.|$))/i',$file_name);
if(strpos($thefolderx,"/")===false && is_dir("data/".$thefolderx) && $file_name!=="" && !$blocked){
$target="data/".$thefolderx."/".$file_name2;
if(file_exists($target)){
rename($target,"data/".$thefolderx."/".time().$file_name2);
}
if(move_uploaded_file($upload['tmp_name'],$target)){
echo htmlspecialchars($target,ENT_QUOTES,'UTF-8');
}
}
}
?>

<script>
parent.readfiles.location.href='readfiles.hnt?sfolder='+<?=json_encode($thefolder,JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT|JSON_INVALID_UTF8_SUBSTITUTE);?>;
parent.closeavi();
</script>
