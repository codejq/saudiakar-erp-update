<?php
define('VOUCHER_REPORT_KEY','representatives');
require __DIR__ . '/voucher_report_init.hnt';
$voucherReport=voucherReportLoad($link,$voucherReport,function($link,$state) {
    $dataset=voucherReportShareDataset($state);
    $totals=voucherReportShareTotals($link,$dataset);
    $rows=voucherReportRows($link,'SELECT r.representative_userid,r.representative_name label,COUNT(DISTINCT r.idsanad) receipts,
        SUM(r.depositeamount) gross,SUM(r.share_commission) commission,SUM(r.share_paid) paid,SUM(r.share_outstanding) outstanding
        FROM ('.$dataset['sql'].') r GROUP BY r.representative_userid,r.representative_name ORDER BY commission DESC,label',$dataset['params']);
    return array('totals'=>$totals,'rows'=>$rows,'totalRows'=>count($rows));
});
require __DIR__ . '/voucher_report_layout.hnt';
