<script>
/**
 * Bootstrap Toast Notification System
 */
function showBootstrapNotification(message, type = 'success', duration = 3000) {
    const toastId = 'toast-' + Date.now();

    const iconMap = {
        'success': 'bi-check-circle-fill text-success',
        'error': 'bi-x-circle-fill text-danger',
        'warning': 'bi-exclamation-triangle-fill text-warning',
        'loading': 'bi-hourglass-split text-info'
    };

    const bgMap = {
        'success': 'bg-success-subtle',
        'error': 'bg-danger-subtle',
        'warning': 'bg-warning-subtle',
        'loading': 'bg-info-subtle'
    };

    const icon = iconMap[type] || iconMap['success'];
    const bgClass = bgMap[type] || bgMap['success'];

    const toastHtml = `
        <div id="${toastId}" class="toast ${bgClass} border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body d-flex align-items-center gap-3 p-3">
                <i class="bi ${icon} fs-4"></i>
                <div class="flex-grow-1" dir="rtl">${message}</div>
                ${type !== 'loading' ? '<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>' : ''}
            </div>
        </div>
    `;

    const container = document.getElementById('toast-container');
    container.insertAdjacentHTML('beforeend', toastHtml);

    const toastElement = document.getElementById(toastId);
    const toast = new bootstrap.Toast(toastElement, {
        autohide: type !== 'loading',
        delay: duration
    });

    toast.show();

    toastElement.addEventListener('hidden.bs.toast', function() {
        toastElement.remove();
    });

    return toast;
}

/**
 * Show/Hide Progress Overlay
 */
function showProgress(show = true, text = 'جاري المعالجة...') {
    const overlay = document.getElementById('progressOverlay');
    const progressText = document.getElementById('progressText');

    if (show) {
        progressText.textContent = text;
        overlay.classList.add('active');
    } else {
        overlay.classList.remove('active');
    }
}

/**
 * Load and Display Current Companies
 */
const companyMigrationToken = <?= json_encode($companyMigrationToken, JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT) ?>;
const companyMigrationAllowed = <?= $companyMigrationAllowed ? 'true' : 'false' ?>;
const companyMainDatabase = <?= json_encode($qdb_db, JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT) ?>;

function companyMigrationForm(database) {
    if (!companyMigrationAllowed) return '';
    const form = document.createElement('form');
    form.method = 'post';
    form.action = '/aqary/admin/option.companyies.hnt';
    form.className = 'w-100 mt-2';
    for (const [name, value] of Object.entries({action:'migrate_company', company_database:database, company_migration_csrf:companyMigrationToken})) {
        const input = document.createElement('input');
        input.type = 'hidden'; input.name = name; input.value = value;
        form.appendChild(input);
    }
    const button = document.createElement('button');
    button.type = 'submit'; button.className = 'btn btn-sm w-100 ' + (database === companyMainDatabase ? 'btn-outline-light' : 'btn-outline-success');
    button.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>تحديث الشركة';
    form.appendChild(button);
    return form.outerHTML;
}

function loadCompanies() {
    const container = document.getElementById('currentCompanies');
    const select = document.getElementById('selectCompany');
    const countDisplay = document.getElementById('companiesCount');

    // Show loading state
    container.innerHTML = `
        <div class="loading-skeleton"></div>
        <div class="loading-skeleton"></div>
        <div class="loading-skeleton"></div>
    `;

    fetch('../ajax/listcompaniesnames.php?id=0&ajax=true')
        .then(response => response.json())
        .then(data => {
            // Build HTML for companies grid
            let companiesHTML = `
                <div class="company-card main-company">
                    <div class="company-icon">
                        <i class="bi bi-building-fill"></i>
                    </div>
                    <h5 class="company-name">الشركة الرئيسية</h5>
                    <span class="company-badge">أساسية</span>
                    ${companyMigrationForm(companyMainDatabase)}
                </div>
            `;

            // Add other companies
            data.forEach((company, index) => {
                const companyNumber = (company.databasname.match(/_company_(\d+)$/) || [])[1] || (index + 1);
                companiesHTML += `
                    <div class="company-card">
                        <div class="company-icon" style="color: #3498DB;">
                            <i class="bi bi-building"></i>
                        </div>
                        <h5 class="company-name">الشركة رقم ${companyNumber}</h5>
                        <span class="company-badge">فرع</span>
                        ${companyMigrationForm(company.databasname)}
                    </div>
                `;
            });

            container.innerHTML = companiesHTML;

            // Update count display
            const totalCount = data.length + 1; // +1 for main company
            countDisplay.textContent = `${totalCount} ${totalCount === 1 ? 'شركة' : totalCount === 2 ? 'شركتان' : 'شركات'}`;

            // Update select dropdown
            let selectOptions = `
                <option value="">قاعدة بيانات جديدة فارغة</option>
                <option value="aqary">نسخة من الشركة الرئيسية</option>
            `;

            data.forEach((company, index) => {
                const companyNumber = (company.databasname.match(/_company_(\d+)$/) || [])[1] || (index + 1);
                selectOptions += `
                    <option value="${company.databasname}">نسخة من الشركة رقم ${companyNumber}</option>
                `;
            });

            select.innerHTML = selectOptions;

            // Show success notification
            if (data.length > 0) {
                showBootstrapNotification(`تم تحميل ${data.length} ${data.length === 1 ? 'شركة' : data.length === 2 ? 'شركتين' : 'شركات'} بنجاح`, 'success', 2000);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            container.innerHTML = `
                <div class="company-card main-company">
                    <div class="company-icon">
                        <i class="bi bi-building-fill"></i>
                    </div>
                    <h5 class="company-name">الشركة الرئيسية</h5>
                    <span class="company-badge">أساسية</span>
                    ${companyMigrationForm(companyMainDatabase)}
                </div>
            `;
            showBootstrapNotification('فشل تحميل قائمة الشركات', 'error', 5000);
        });
}

/**
 * Create New Company
 */
function createCompany(copyFromCompany) {
    // Show progress
    showProgress(true, 'جاري إنشاء الشركة الجديدة...');

    // Prepare form data
    const formData = new FormData();
    formData.append('company_template', copyFromCompany);
    formData.append('makedefult', 'false');

    fetch('../ajax/createcompany.php', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        showProgress(false);

        if (data && data[0]) {
            const result = data[0].result;

            // Check if creation was successful
            if (result.includes('تم') || result.includes('نجح') || result.includes('Success')) {
                showBootstrapNotification(result, 'success', 5000);
                // Reload companies list
                setTimeout(() => {
                    loadCompanies();
                }, 1000);
            } else {
                showBootstrapNotification(result, 'warning', 5000);
            }
        } else {
            showBootstrapNotification('تم إنشاء الشركة بنجاح', 'success', 5000);
            setTimeout(() => {
                loadCompanies();
            }, 1000);
        }
    })
    .catch(error => {
        showProgress(false);
        console.error('Error:', error);
        showBootstrapNotification('حدث خطأ أثناء إنشاء الشركة', 'error', 5000);
    });
}

/**
 * Document Ready
 */
$(document).ready(function() {
    $(document).on('submit', 'form', function() {
        if (this.querySelector('input[name="action"][value="migrate_company"]')) {
            showProgress(true, 'يرجى الانتظار، جارٍ تحديث التطبيق...');
            $(this).find('button[type="submit"]').prop('disabled', true);
        }
    });
    // Load companies on page load
    loadCompanies();

    // Handle form submission
    $('#createCompanyForm').on('submit', function(e) {
        e.preventDefault();

        const selectedCompany = $('#selectCompany').val();
        const sourceText = selectedCompany === '' ? 'قاعدة بيانات فارغة' :
                          selectedCompany === 'aqary' ? 'الشركة الرئيسية' :
                          'الشركة المحددة';

        // Confirm before creating
        if (confirm(`هل أنت متأكد من إنشاء شركة جديدة من ${sourceText}؟\n\nسيتم إنشاء قاعدة بيانات منفصلة للشركة الجديدة.`)) {
            createCompany(selectedCompany);
        }
    });

    // Prevent double submission
    $('#btnCreateCompany').on('click', function() {
        if ($(this).prop('disabled')) {
            return false;
        }
    });

    // Show welcome message
    setTimeout(() => {
        showBootstrapNotification('يمكنك الآن إدارة الشركات والفروع', 'success', 3000);
    }, 500);
});
</script>

