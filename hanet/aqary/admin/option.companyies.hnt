<?php
/**
 * Company Management - Create and Manage Multiple Companies/Branches
 * Allows creation of new companies as database copies or fresh installations
 */

$sc_title = "إدارة الشركات والفروع";
$sc_id = "84";

if (session_status() === PHP_SESSION_NONE) session_start();
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    // Legacy includes extract request globals: company, actor and roles are never inputs.
    $_POST = array_intersect_key($_POST, array_fill_keys(['action','company_database','company_migration_csrf'], true));
    $_GET = []; $_REQUEST = $_POST;
}
include_once "../connectdb.hnt";
include_once "../header.hnt";
require_once __DIR__.'/include/company_migration_helpers.hnt';
$companyMigrationAllowed = aqaryCompanyCanMigrate($link);
$companyMigrationToken = aqaryCompanyMigrationToken();
$companyMigrationNotice = ''; $companyMigrationFailed = false;
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        if (($_POST['action'] ?? '') !== 'migrate_company') throw new RuntimeException('اختر عملية صحيحة.');
        $companyMigrationNotice = aqaryRunCompanyMigration($link, $_POST);
    } catch (Throwable $error) {
        error_log('Company migration: '.$error->getMessage());
        $companyMigrationFailed = true;
        $companyMigrationNotice = $error instanceof RuntimeException && !($error instanceof mysqli_sql_exception)
            ? $error->getMessage() : 'تعذر تحديث الشركة. راجع سجل الخادم وأعد المحاولة.';
    }
}
