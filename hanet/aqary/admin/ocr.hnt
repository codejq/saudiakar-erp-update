<?php
/**
 * التعرف الضوئي للمستندات: upload an image or a PDF, read it with the company's OCR provider
 * (the bundled local Indra service, or the external server set in System Options -> المساعد الذكي)
 * and get the result as HTML: a preview, the HTML source, and a downloadable .html file.
 * Access: screen key `ocr_reader` (registered by the migration under the AI hub 300, falling back to it).
 */
$sc_title = 'التعرف الضوئي للمستندات';
$sc_id = '';
require_once __DIR__ . '/../reqlogin.hnt';
require_once __DIR__ . '/ai/assistant/service.hnt';
require_once dirname(__DIR__) . '/lib/ocr/ocr_html.hnt';

const AQARY_OCR_PAGE_MAX_BYTES = 20971520; // 20 MB

$ocrUser = intval($_SESSION['useridv'] ?? 0);
$ocrAllowed = $link instanceof mysqli && $ocrUser > 0 && aqaryScreenCan($link, 'ocr_reader', 'sees');
if (empty($_SESSION['ai_assistant_csrf'])) $_SESSION['ai_assistant_csrf'] = bin2hex(random_bytes(24));
$ocrCsrf = (string)$_SESSION['ai_assistant_csrf'];
$ocrError = '';
$ocrResult = null;
$ocrMode = ($_POST['mode'] ?? 'document') === 'auto' ? 'auto' : 'document';

if ($ocrAllowed && ($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
    try {
        // Over post_max_size PHP drops the whole request body (no fields, no files).
        if (!$_POST && !$_FILES && intval($_SERVER['CONTENT_LENGTH'] ?? 0) > 0) throw new InvalidArgumentException('حجم الملف أكبر من الحد المسموح به على الخادم.');
        if (!hash_equals($ocrCsrf, (string)($_POST['csrf_token'] ?? ''))) throw new InvalidArgumentException('انتهت صلاحية النموذج. أعد تحميل الصفحة.');
        $file = $_FILES['document'] ?? null;
        if (!$file || !is_array($file) || is_array($file['error'] ?? null) || ($file['error'] ?? UPLOAD_ERR_NO_FILE) === UPLOAD_ERR_NO_FILE) {
            throw new InvalidArgumentException('اختر صورة أو ملف PDF.');
        }
        if (in_array($file['error'], array(UPLOAD_ERR_INI_SIZE, UPLOAD_ERR_FORM_SIZE), true) || intval($file['size']) > AQARY_OCR_PAGE_MAX_BYTES) {
            throw new InvalidArgumentException('حجم الملف أكبر من 20 ميجابايت.');
        }
        if ($file['error'] !== UPLOAD_ERR_OK || !is_uploaded_file($file['tmp_name'])) throw new InvalidArgumentException('تعذّر رفع الملف. حاول مرة أخرى.');
        // Trust the content, not the browser's type or the file name.
        $mime = function_exists('finfo_open') ? (string)finfo_file(finfo_open(FILEINFO_MIME_TYPE), $file['tmp_name']) : (string)mime_content_type($file['tmp_name']);
        if (!in_array($mime, AqaryOcrRuntime::MEDIA, true)) throw new InvalidArgumentException('يُقبل فقط الصور (JPG، PNG، WEBP، GIF، BMP، TIFF) أو ملفات PDF.');

        $bytes = (string)file_get_contents($file['tmp_name']);
        $name = mb_substr(basename((string)$file['name']), 0, 150);
        $remote = (new AqaryAssistant($link, $ocrUser))->ocrRemote();
        // OCR can take a while: release the session lock so the user's other pages keep working.
        session_write_close();
        @set_time_limit(300);
        $read = AqaryOcrRuntime::read($bytes, $mime, $ocrMode, $remote);

        $body = '';
        $pages = $read['page_list'] ?: array(array('index' => 0, 'markdown' => $read['markdown'], 'text' => $read['text'], 'confidence' => null));
        foreach ($pages as $page) {
            $inner = AqaryOcrHtml::fromMarkdown($page['markdown'] !== '' ? $page['markdown'] : $page['text']);
            $body .= '<section class="ocr-page">' . (count($pages) > 1 ? '<div class="ocr-page-label">صفحة ' . ($page['index'] + 1) . "</div>\n" : '')
                . ($inner !== '' ? $inner : '<p class="ocr-page-label">(لم يُعثر على نص في هذه الصفحة)</p>') . "</section>\n";
        }
        $confs = array_filter(array_column($pages, 'confidence'), 'is_float');
        $ocrResult = array(
            'name' => $name,
            'mime' => $mime,
            'body' => $body,
            'document' => AqaryOcrHtml::document(pathinfo($name, PATHINFO_FILENAME) . ' — OCR', $body),
            'text' => $read['text'],
            'pages' => max(1, $read['pages']),
            'ms' => $read['ms'],
            'confidence' => $confs ? array_sum($confs) / count($confs) : null,
            'remote' => $remote !== null,
            'preview' => strpos($mime, 'image/') === 0 && strlen($bytes) <= 6291456 && $mime !== 'image/tiff'
                ? 'data:' . $mime . ';base64,' . base64_encode($bytes) : '',
        );
        unset($bytes);
    } catch (InvalidArgumentException $error) {
        $ocrError = $error->getMessage();
    } catch (RuntimeException $error) {
        $ocrError = $error->getMessage(); // AqaryOcrRuntime::read gives Arabic messages meant for the user
    } catch (Throwable $error) {
        error_log('OCR page: ' . $error->getMessage());
        $ocrError = 'تعذّرت قراءة الملف. حاول مرة أخرى.';
    }
}

include_once __DIR__ . '/../nocash.hnt';
include_once __DIR__ . '/../header.hnt';
$ocrEsc = function ($v) { return htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8'); };
?>
<style>
<?= AqaryOcrHtml::css() ?>
.ocr-shell .ocr-drop{border:2px dashed #94a3b8;border-radius:12px;padding:28px;text-align:center;background:#f8fafc;cursor:pointer;transition:.15s}
.ocr-shell .ocr-drop.drag,.ocr-shell .ocr-drop:hover{border-color:#066d96;background:#eff6ff}
.ocr-shell .ocr-drop input{display:none}
.ocr-shell .ocr-output{background:#fff;border:1px solid #e2e8f0;border-radius:8px;max-height:70vh;overflow:auto}
.ocr-shell .ocr-source{font-family:Consolas,monospace;font-size:.8rem;direction:ltr;text-align:left;min-height:50vh}
.ocr-shell .ocr-preview img{max-width:100%;max-height:70vh;border:1px solid #e2e8f0;border-radius:8px}
@media print{
  body *{visibility:hidden}
  #ocrPrintable,#ocrPrintable *{visibility:visible}
  #ocrPrintable{position:absolute;inset:0 0 auto 0;max-height:none;overflow:visible;border:0}
}
</style>
<div class="container-fluid py-4 ocr-shell" dir="rtl" style="max-width:1400px">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #189c2aff 0%, #066d96ff 100%);">
            <h4 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i><?= $ocrEsc($sc_title) ?></h4>
        </div>
        <div class="card-body p-4">
            <?php if (!$ocrAllowed) { ?>
                <div class="alert alert-warning mb-0">ليست لديك صلاحية استخدام هذه الشاشة. راجع مدير النظام.</div>
            <?php } else { ?>
                <?php if ($ocrError !== '') { ?><div class="alert alert-danger"><?= $ocrEsc($ocrError) ?></div><?php } ?>
                <form method="post" enctype="multipart/form-data" id="ocrForm">
                    <input type="hidden" name="csrf_token" value="<?= $ocrEsc($ocrCsrf) ?>">
                    <input type="hidden" name="MAX_FILE_SIZE" value="<?= AQARY_OCR_PAGE_MAX_BYTES ?>">
                    <label class="ocr-drop d-block mb-3" id="ocrDrop">
                        <input type="file" name="document" id="ocrFile" required
                               accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff,application/pdf,.jpg,.jpeg,.png,.webp,.gif,.bmp,.tif,.tiff,.pdf">
                        <i class="bi bi-cloud-arrow-up" style="font-size:42px;color:#066d96"></i>
                        <div class="fw-bold mt-2" id="ocrFileName">اسحب الملف هنا أو اضغط للاختيار</div>
                        <div class="small text-muted">صور (JPG، PNG، WEBP، GIF، BMP، TIFF) أو PDF — حتى 20 ميجابايت</div>
                    </label>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="mode" id="ocrModeDoc" value="document" <?= $ocrMode === 'document' ? 'checked' : '' ?>>
                            <label class="form-check-label" for="ocrModeDoc">مستند</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="mode" id="ocrModeAuto" value="auto" <?= $ocrMode === 'auto' ? 'checked' : '' ?>>
                            <label class="form-check-label" for="ocrModeAuto">تلقائي (يتعرّف أيضاً على لوحات السيارات)</label>
                        </div>
                        <button class="btn btn-success ms-auto" id="ocrSubmit"><i class="bi bi-magic me-1"></i>استخراج النص</button>
                    </div>
                    <div class="small text-muted mt-2" id="ocrWait" hidden><span class="spinner-border spinner-border-sm me-1"></span>جارٍ قراءة المستند… قد يستغرق ملف PDF الكبير دقيقة أو أكثر.</div>
                </form>
            <?php } ?>
        </div>
    </div>

    <?php if ($ocrResult) { ?>
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center gap-2">
            <strong class="me-2"><i class="bi bi-filetype-html me-1"></i>النتيجة: <span dir="auto"><?= $ocrEsc($ocrResult['name']) ?></span></strong>
            <span class="badge bg-light text-dark border"><?= intval($ocrResult['pages']) ?> صفحة</span>
            <span class="badge bg-light text-dark border"><?= number_format($ocrResult['ms'] / 1000, 1) ?> ث</span>
            <?php if ($ocrResult['confidence'] !== null) { ?><span class="badge bg-light text-dark border">الدقة <?= round($ocrResult['confidence'] * 100) ?>%</span><?php } ?>
            <span class="badge bg-light text-dark border"><?= $ocrResult['remote'] ? 'خدمة خارجية' : 'الخدمة المحلية' ?></span>
            <div class="ms-auto d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-primary" id="ocrDownload"><i class="bi bi-download me-1"></i>تنزيل HTML</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-copy="html"><i class="bi bi-code-slash me-1"></i>نسخ HTML</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-copy="text"><i class="bi bi-clipboard me-1"></i>نسخ النص</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1"></i>طباعة</button>
            </div>
        </div>
        <div class="card-body p-3">
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#ocrTabPreview" type="button">المعاينة</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#ocrTabSource" type="button">كود HTML</button></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="ocrTabPreview">
                    <div class="row g-3">
                        <div class="<?= $ocrResult['preview'] ? 'col-lg-7' : 'col-12' ?>">
                            <div class="ocr-output ocr-doc" id="ocrPrintable"><?= $ocrResult['body'] ?></div>
                        </div>
                        <?php if ($ocrResult['preview']) { ?>
                            <div class="col-lg-5 ocr-preview text-center"><img src="<?= $ocrEsc($ocrResult['preview']) ?>" alt="الصورة الأصلية"></div>
                        <?php } ?>
                    </div>
                </div>
                <div class="tab-pane fade" id="ocrTabSource">
                    <textarea class="form-control ocr-source" id="ocrSource" readonly spellcheck="false"><?= $ocrEsc($ocrResult['document']) ?></textarea>
                </div>
            </div>
            <textarea id="ocrText" hidden><?= $ocrEsc($ocrResult['text']) ?></textarea>
        </div>
    </div>
    <?php } ?>
</div>
<script>
(function () {
    var drop = document.getElementById('ocrDrop'), input = document.getElementById('ocrFile'), label = document.getElementById('ocrFileName');
    var form = document.getElementById('ocrForm');
    var allowed = /^(image\/(jpeg|png|webp|gif|bmp|tiff)|application\/pdf)$/;
    function show(file) {
        if (!file) return;
        if (file.type && !allowed.test(file.type)) { alert('يُقبل فقط الصور أو ملفات PDF.'); input.value = ''; label.textContent = 'اسحب الملف هنا أو اضغط للاختيار'; return; }
        if (file.size > <?= AQARY_OCR_PAGE_MAX_BYTES ?>) { alert('حجم الملف أكبر من 20 ميجابايت.'); input.value = ''; return; }
        label.textContent = file.name;
    }
    if (drop && input) {
        input.addEventListener('change', function () { show(input.files[0]); });
        ['dragenter', 'dragover'].forEach(function (e) { drop.addEventListener(e, function (ev) { ev.preventDefault(); drop.classList.add('drag'); }); });
        ['dragleave', 'drop'].forEach(function (e) { drop.addEventListener(e, function (ev) { ev.preventDefault(); drop.classList.remove('drag'); }); });
        drop.addEventListener('drop', function (ev) {
            if (!ev.dataTransfer.files.length) return;
            try { var dt = new DataTransfer(); dt.items.add(ev.dataTransfer.files[0]); input.files = dt.files; } catch (e) { input.files = ev.dataTransfer.files; }
            show(input.files[0]);
        });
    }
    if (form) form.addEventListener('submit', function () {
        document.getElementById('ocrSubmit').disabled = true;
        document.getElementById('ocrWait').hidden = false;
    });

    var source = document.getElementById('ocrSource');
    if (!source) return;
    var fileName = <?= json_encode($ocrResult ? (pathinfo($ocrResult['name'], PATHINFO_FILENAME) ?: 'document') . '-ocr.html' : '', JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP) ?>;
    document.getElementById('ocrDownload').addEventListener('click', function () {
        var url = URL.createObjectURL(new Blob([source.value], { type: 'text/html;charset=utf-8' }));
        var a = document.createElement('a');
        a.href = url; a.download = fileName;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    });
    document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var value = btn.getAttribute('data-copy') === 'html' ? source.value : document.getElementById('ocrText').value;
            var done = function () { var old = btn.innerHTML; btn.innerHTML = '<i class="bi bi-check2 me-1"></i>تم النسخ'; setTimeout(function () { btn.innerHTML = old; }, 1500); };
            if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(value).then(done);
            else { var t = document.createElement('textarea'); t.value = value; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove(); done(); }
        });
    });
})();
</script>
<?php require __DIR__ . '/../foter.hnt'; ?>
