<?php
$sc_title = 'إعدادات عمولة مندوبي المبيعات';
$sc_id = '84';

include_once '../nocash.hnt';
include_once '../header.hnt';
require_once __DIR__ . '/include/amlak/sales_representative_helpers.hnt';

if (empty($_SESSION['sales_representative_settings_csrf'])) {
    try {
        $_SESSION['sales_representative_settings_csrf'] = bin2hex(random_bytes(24));
    } catch (Throwable $exception) {
        $_SESSION['sales_representative_settings_csrf'] = hash('sha256', session_id() . microtime(true));
    }
}

$message = '';
$messageType = 'success';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $postedToken = isset($_POST['csrf_token']) ? (string)$_POST['csrf_token'] : '';
    if (!hash_equals($_SESSION['sales_representative_settings_csrf'], $postedToken)) {
        $message = 'تعذر التحقق من الطلب. حدّث الصفحة وحاول مرة أخرى.';
        $messageType = 'danger';
    } else {
        $commissionType = isset($_POST['commission_type']) && $_POST['commission_type'] === 'fixed'
            ? 'fixed'
            : 'percentage';
        $commissionValue = isset($_POST['commission_value'])
            ? floatval(str_replace(',', '', $_POST['commission_value']))
            : 0;

        if ($commissionValue < 0 || ($commissionType === 'percentage' && $commissionValue > 100)) {
            $message = $commissionType === 'percentage'
                ? 'يجب أن تكون النسبة بين 0 و100.'
                : 'يجب ألا تكون العمولة الثابتة سالبة.';
            $messageType = 'danger';
        } else {
            $commissionValue = round($commissionValue, 2);
            $savedType = amlakSaveGlobalSetting(
                'sales_representative_commission_type',
                $commissionType,
                $link
            );
            $savedValue = amlakSaveGlobalSetting(
                'sales_representative_commission_value',
                $commissionValue,
                $link
            );
            if ($savedType && $savedValue) {
                $message = 'تم حفظ إعدادات عمولة مندوبي المبيعات.';
            } else {
                $message = 'تعذر حفظ الإعدادات: ' . mysql_error($link);
                $messageType = 'danger';
            }
        }
    }
}

$settings = amlakGetSalesCommissionSettings($link);
?>

<div class="container py-4" dir="rtl">
    <div class="card border-0 shadow-sm">
        <div class="card-header text-white d-flex justify-content-between align-items-center"
             style="background:linear-gradient(135deg,#15803d,#0f766e);">
            <h4 class="mb-0"><i class="bi bi-person-badge-fill me-2"></i><?= htmlspecialchars($sc_title, ENT_QUOTES, 'UTF-8') ?></h4>
            <a href="/aqary/admin/option.hnt" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-return-right me-1"></i>العودة للإعدادات
            </a>
        </div>
        <div class="card-body p-4">
            <?php if ($message !== '') { ?>
                <div class="alert alert-<?= $messageType ?>"><?= htmlspecialchars($message, ENT_QUOTES, 'UTF-8') ?></div>
            <?php } ?>

            <div class="alert alert-info">
                يتم أخذ نسخة من نوع العمولة وقيمتها ومبلغها عند إنشاء كل سند قبض. تغيير الإعداد لاحقاً لا يغيّر السندات السابقة.
                عند عدم اختيار مندوب تكون العملية باسم النظام وعمولتها صفر.
            </div>

            <form method="post" class="row g-3">
                <input type="hidden" name="csrf_token" value="<?= htmlspecialchars($_SESSION['sales_representative_settings_csrf'], ENT_QUOTES, 'UTF-8') ?>">
                <div class="col-md-6">
                    <label for="commission_type" class="form-label">طريقة حساب العمولة</label>
                    <select name="commission_type" id="commission_type" class="form-select">
                        <option value="percentage" <?= $settings['type'] === 'percentage' ? 'selected' : '' ?>>نسبة من المبلغ المحصل</option>
                        <option value="fixed" <?= $settings['type'] === 'fixed' ? 'selected' : '' ?>>مبلغ ثابت لكل سند</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="commission_value" class="form-label">قيمة العمولة</label>
                    <div class="input-group">
                        <input type="number" min="0" step="0.01" name="commission_value" id="commission_value"
                               class="form-control" value="<?= number_format($settings['value'], 2, '.', '') ?>" required>
                        <span class="input-group-text" id="commission_unit"></span>
                    </div>
                    <div class="form-text">القيمة الافتراضية صفر.</div>
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i>حفظ الإعدادات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    const type = document.getElementById('commission_type');
    const value = document.getElementById('commission_value');
    const unit = document.getElementById('commission_unit');
    function refreshCommissionType() {
        const isPercentage = type.value === 'percentage';
        unit.textContent = isPercentage ? '%' : 'ريال';
        value.max = isPercentage ? '100' : '';
    }
    type.addEventListener('change', refreshCommissionType);
    refreshCommissionType();
})();
</script>

<?php require '../foter.hnt'; ?>
